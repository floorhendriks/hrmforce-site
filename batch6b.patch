+export function sectorsFor(lang) {
+  const L = (o) => (o[lang] || o.nl);
+  const ui = SEC_UI[lang] || SEC_UI.nl;
+  const sectors = SECTORS.map((s) => ({ key: s.key, landing: s.landing, label: L(s.label), blurb: L(s.blurb) }));
+  return { ui, sectors };
+}
