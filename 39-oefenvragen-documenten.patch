@@ -0,0 +1,65 @@
+---
+/* Aanvraagformulier voor de oefenvragen. Post naar /api/oefenmateriaal, dat het
+   document als bijlage naar de kandidaat stuurt met oefenen@hrmforce.com in cc.
+   Zonder javascript valt het terug op een gewone formulierpost naar hetzelfde
+   adres; de bezoeker ziet dan de bevestiging van de server. */
+const { lang = "nl", onderdeel, titel, bron = "", knop, placeholder, klasse = "" } = Astro.props;
+const BEVESTIGING = {
+  nl: { ok: "Gelukt. Je oefenvragen zijn onderweg naar je mailbox.", fout: "Er ging iets mis bij het versturen. Probeer het nog eens of mail naar oefenen@hrmforce.com.", bezig: "Bezigâ€¦" },
+  en: { ok: "Done. Your practice questions are on their way to your inbox.", fout: "Something went wrong while sending. Please try again or email oefenen@hrmforce.com.", bezig: "Workingâ€¦" },
+  de: { ok: "Geschafft. Ihre Ãœbungsfragen sind auf dem Weg in Ihr Postfach.", fout: "Beim Senden ist etwas schiefgelaufen. Bitte erneut versuchen oder an oefenen@hrmforce.com mailen.", bezig: "LÃ¤uftâ€¦" },
+  fr: { ok: "C'est fait. Vos questions d'entraÃ®nement arrivent dans votre boÃ®te mail.", fout: "Une erreur est survenue lors de l'envoi. RÃ©essayez ou Ã©crivez Ã  oefenen@hrmforce.com.", bezig: "En coursâ€¦" },
+  es: { ok: "Listo. Tus preguntas de prÃ¡ctica van camino a tu correo.", fout: "Algo saliÃ³ mal al enviar. IntÃ©ntalo de nuevo o escribe a oefenen@hrmforce.com.", bezig: "Enviandoâ€¦" },
+  ro: { ok: "Gata. ÃŽntrebÄƒrile tale de exersare sunt pe drum spre inbox.", fout: "A apÄƒrut o eroare la trimitere. ÃŽncearcÄƒ din nou sau scrie la oefenen@hrmforce.com.", bezig: "Se trimiteâ€¦" },
+};
+const b = BEVESTIGING[lang] || BEVESTIGING.nl;
+---
+<form class={`oa-form ${klasse}`} method="POST" action="/api/oefenmateriaal"
+      data-oefenaanvraag data-ok={b.ok} data-fout={b.fout} data-bezig={b.bezig}>
+  <input type="hidden" name="onderdeel" value={onderdeel} />
+  <input type="hidden" name="taal" value={lang} />
+  <input type="hidden" name="titel" value={titel} />
+  <input type="hidden" name="bron" value={bron} />
+  <input type="email" name="email" required placeholder={placeholder} aria-label={placeholder} />
+  <button type="submit" class="btn btn-primary">{knop}</button>
+</form>
+<p class="oa-melding" hidden></p>
+
+<style is:global>
+  .oa-melding { margin: 10px 0 0; font-size: 14px; font-weight: 600; }
+  .oa-melding.ok { color: #1a7f4b; }
+  .oa-melding.fout { color: #b3261e; }
+  .vv-cta .oa-melding { color: #fff; }
+</style>
+
+<script>
+  /* EÃ©n afhandelaar voor alle aanvraagformulieren op de pagina. */
+  document.addEventListener("submit", function (ev) {
+    var form = ev.target;
+    if (!form || !form.matches || !form.matches("form[data-oefenaanvraag]")) return;
+    ev.preventDefault();
+    var knop = form.querySelector("button[type=submit]");
+    var melding = form.parentNode.querySelector(".oa-melding");
+    var oudeTekst = knop ? knop.textContent : "";
+    if (knop) { knop.disabled = true; knop.textContent = form.dataset.bezig; }
+    if (melding) { melding.hidden = true; melding.className = "oa-melding"; }
+    var data = {};
+    new FormData(form).forEach(function (v, k) { data[k] = v; });
+    fetch("/api/oefenmateriaal", {
+      method: "POST", headers: { "Content-Type": "application/json" }, body: JSON.stringify(data),
+    }).then(function (r) { return r.json().catch(function () { return {}; }); })
+      .then(function (uit) {
+        if (knop) { knop.disabled = false; knop.textContent = oudeTekst; }
+        if (!melding) return;
+        var gelukt = uit && uit.ok;
+        melding.textContent = gelukt ? form.dataset.ok : form.dataset.fout;
+        melding.className = "oa-melding " + (gelukt ? "ok" : "fout");
+        melding.hidden = false;
+        if (gelukt) form.reset();
+      })
+      .catch(function () {
+        if (knop) { knop.disabled = false; knop.textContent = oudeTekst; }
+        if (melding) { melding.textContent = form.dataset.fout; melding.className = "oa-melding fout"; melding.hidden = false; }
+      });
+  });
+</script>
