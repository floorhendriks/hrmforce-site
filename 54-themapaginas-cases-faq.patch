+        meet: { title: "Ce que dit le règlement IA", items: [
+          { t: "Le recrutement est à haut risque", d: "Les systèmes d'IA pour le recrutement, la sélection et l'évaluation figurent à l'annexe III. Cela impose documentation, supervision humaine, journalisation et information du candidat." },
+          { t: "La date a bougé", d: "Ces obligations de l'annexe III sont passées du 2 août 2026 au 2 décembre 2027 par l'omnibus numérique. L'annexe I suit au 2 août 2028." },
+          { t: "Ce qui s'applique déjà", d: "L'obligation de transparence de l'article 50 s'applique depuis le 2 août 2026 : si une personne parle avec un système d'IA, cela doit être clair. Le marquage des contenus générés avait un délai jusqu'au 2 décembre 2026." },
+          { t: "Interdit depuis février 2025", d: "La reconnaissance des émotions au travail et dans l'éducation est interdite. Un système qui déduit une humeur de l'image ou de la voix en relève." },
+        ] },
+        tests: { title: "Pour aller plus loin", intro: "Les pages que ce sujet touche chez hrmforce.", cta: "Voir", kaarten: [
