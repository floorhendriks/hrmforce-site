diff --git a/src/components/Themapagina.astro b/src/components/Themapagina.astro
new file mode 100644
index 0000000..58a5693
--- /dev/null
+++ b/src/components/Themapagina.astro
@@ -0,0 +1,140 @@
+---
+// Themapagina: een vaste opbouw voor pagina's die om een algemene term draaien
+// (persoonlijkheidstest, capaciteitentest, AI in assessments). De tekst komt uit
+// een datamodule, de kaarten verwijzen naar bestaande pagina's.
+import { localizePath, localizeExisting, demoPath } from "../i18n/utils.js";
+import validPaths from "../data/valid-paths.js";
+const { t, lang, kaarten = [] } = Astro.props;
+const demoHref = demoPath(lang);
+const tarievenHref = localizeExisting("/tarieven/", lang, validPaths);
+const links = kaarten.map((p) => localizeExisting(p, lang, validPaths));
+const onderbouwingHref = t.onderbouwing && t.onderbouwing.link
+  ? localizeExisting(t.onderbouwing.link.href, lang, validPaths)
+  : null;
+const faqLd = t.faq && t.faq.items && t.faq.items.length
+  ? {
+      "@context": "https://schema.org",
+      "@type": "FAQPage",
+      mainEntity: t.faq.items.map((i) => ({
+        "@type": "Question",
+        name: i.q,
+        acceptedAnswer: { "@type": "Answer", text: i.a },
+      })),
+    }
+  : null;
+---
+{faqLd && <script type="application/ld+json" is:inline set:html={JSON.stringify(faqLd)}></script>}
+
+<div class="crumb"><div class="wrap">
+  <a href={localizePath("/", lang)}>Home</a> › <span>{t.crumb}</span>
+</div></div>
+
+<section class="ahero"><div class="wrap" style="display:block">
+  <div class="eyebrow">{t.hero.eyebrow}</div>
+  <h1>{t.hero.title}</h1>
+  <p class="tp-lead">{t.hero.lead}</p>
+</div></section>
+
+<section><div class="wrap" style="display:block">
+  <div class="tp-intro">{t.intro.map((p) => (<p>{p}</p>))}</div>
+
+  <h2 class="section-title tp-h2">{t.meet.title}</h2>
+  <div class="tp-grid">
+    {t.meet.items.map((i) => (
+      <div class="tp-vak">
+        <h3>{i.t}</h3>
+        <p>{i.d}</p>
+      </div>
+    ))}
+  </div>
+</div></section>
+
+<section class="bg-soft"><div class="wrap" style="display:block">
+  <h2 class="section-title">{t.tests.title}</h2>
+  <p class="tp-sub">{t.tests.intro}</p>
+  <div class="tp-kaarten">
+    {t.tests.kaarten.map((k, i) => (
+      <a class="tp-kaart" href={links[i] || "#"}>
+        <span class="tp-kaart-t">{k.t}</span>
+        <span class="tp-kaart-d">{k.d}</span>
+        <span class="tp-kaart-c">{t.tests.cta} &rarr;</span>
+      </a>
+    ))}
+  </div>
+</div></section>
+
+<section><div class="wrap" style="display:block">
