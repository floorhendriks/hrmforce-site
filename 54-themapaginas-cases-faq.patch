+      en: {
+        meta: { title: "Psychological assessment: what it involves and your rights | Hrmforce", description: "What a psychological assessment involves, which parts it consists of, how to prepare and which rights you have as a candidate." },
+        crumb: "Psychological assessment",
+        hero: { eyebrow: "Psychological assessment", title: "Psychological assessment", lead: "A psychological assessment is an assessment in which a psychologist is involved. Below you read which parts it consists of, how long it takes and which rights you have as a candidate." },
+        intro: [
+          "An employer wants to know whether someone fits a role and the organisation. An interview alone answers that only partly: an interviewer's judgement depends heavily on rapport. A psychological assessment adds standardised measurement, so candidates are held to the same yardstick.",
+          "In practice a psychological assessment means questionnaires and tests, followed by a conversation with a psychologist who interprets the outcome.",
+        ],
+        meet: { title: "What it consists of", items: [
+          { t: "Aptitude test", d: "Measures working and thinking level and learning ability, with a time limit per part." },
+          { t: "Personality questionnaire", d: "Maps behaviour at work: collaboration, handling pressure and working style. No time limit here." },
+          { t: "Drivers and interests", d: "Shows what gives someone energy and which work fits that." },
+          { t: "The conversation", d: "A psychologist discusses the outcomes, tests them against examples from your work and writes the report." },
+        ] },
+        tests: { title: "Read on", intro: "The pages candidates and clients read most.", cta: "View", kaarten: [
+          { t: "Online assessments", d: "Which questionnaires exist and what you use them for." },
+          { t: "Preparation", d: "What to expect before, during and after, plus practice material." },
+          { t: "Assessment overview", d: "All instruments in a row, per career stage." },
+          { t: "Pricing", d: "What an assessment costs and what a licence includes." },
+        ] },
+        stappen: { title: "How an assessment runs", items: [
+          { t: "Invitation", d: "You get an email with login details and an explanation of the parts and the time involved." },
+          { t: "Online part", d: "You take the tests and questionnaires at home or on site. The invitation states how much time the parts take together." },
+          { t: "Conversation and report", d: "Then comes the conversation. The report describes the outcomes against the requirements of the role." },
+        ] },
+        onderbouwing: { title: "Your rights as a candidate", tekst: [
+          "If a psychologist registered with the Dutch professional body NIP is involved, their code applies. It gives you the right to read the report first and to decide whether it goes to the client.",
+          "The GDPR applies as well: you may know which data are processed, how long they are kept and who can see them. The privacy and trust page describes how hrmforce handles this.",
+        ], link: { label: "Read more about privacy and trust", href: "/trust/" } },
+        faq: { title: "Frequently asked questions", items: [
+          { q: "What is the difference between a psychological assessment and an assessment?", a: "The terms are used interchangeably. Assessment is the broader word for any standardised evaluation. A psychological assessment usually points to a process in which a psychologist interprets the outcomes and writes the report." },
+          { q: "May I see the report first?", a: "Under the NIP professional code you may. You read the report first and decide whether it is shared. Ask beforehand whether that code applies." },
+          { q: "Can I refuse?", a: "Taking part is voluntary. Refusing can affect the procedure, so raise your objections with the client beforehand." },
+          { q: "How do I prepare?", a: "Be rested, read the invitation and practise with example questions for the aptitude part. For the personality part, answering honestly helps most." },
