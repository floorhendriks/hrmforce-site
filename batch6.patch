diff --git a/src/components/IntegratieDetail.astro b/src/components/IntegratieDetail.astro
new file mode 100644
index 0000000..a08c62d
--- /dev/null
+++ b/src/components/IntegratieDetail.astro
@@ -0,0 +1,45 @@
+---
+import { localizePath } from "../i18n/utils.js";
+const { sys, ui, lang } = Astro.props;
+const name = sys.name;
+const S = (str) => str.replaceAll("{s}", name);
+const blurb = sys.blurb[lang] ?? sys.blurb.nl;
+const contactHref = localizePath("/contact/", lang);
+const intHref = localizePath("/integraties/", lang);
+const _canon = new URL(Astro.url.pathname, "https://hrmforce.com").href;
+const _crumbLd = { "@context":"https://schema.org","@type":"BreadcrumbList", itemListElement:[
+  {"@type":"ListItem",position:1,name:"Home",item:"https://hrmforce.com/"},
+  {"@type":"ListItem",position:2,name:ui.crumb,item:new URL(intHref,"https://hrmforce.com").href},
+  {"@type":"ListItem",position:3,name:name,item:_canon},
+]};
+---
+<script type="application/ld+json" is:inline set:html={JSON.stringify(_crumbLd)}></script>
+
+<div class="crumb"><div class="wrap"><a href={localizePath("/", lang)}>Home</a> › <a href={intHref}>{ui.crumb}</a> › <span>{name}</span></div></div>
+
+<section class="ahero"><div class="wrap" style="display:block">
+  <div class="eyebrow" style="color:var(--gold)">{ui.eyebrow} · {sys.category}</div>
+  <h1>{ui.heroA}{name}</h1>
+  <p style="color:#c4d2e6;font-size:18px;max-width:760px;margin-top:10px">{ui.introA}{name}{ui.introB}</p>
+  <div class="btns" style="margin-top:18px"><a href={contactHref} class="btn btn-primary">{ui.p} &rarr;</a></div>
+</div></section>
+
+<section><div class="wrap" style="max-width:820px">
+  <div class="eyebrow">{S(ui.whatTitle)}</div>
+  <p class="lead" style="margin:8px 0 26px">{blurb}</p>
+  <h2 class="section-title">{S(ui.connTitle)}</h2>
+  <p style="font-size:17px;color:var(--text);line-height:1.65">{ui.conn}</p>
+  <h2 class="section-title" style="margin-top:34px">{ui.enTitle}</h2>
+  <ul class="traits">{ui.en.map((x) => <li>{S(x)}</li>)}</ul>
+  <p style="margin-top:26px;padding:16px 20px;background:var(--bg-soft);border:1px solid var(--line);border-left:4px solid var(--gold);border-radius:12px;color:var(--muted);font-size:14px;line-height:1.6">{S(ui.disc)}</p>
+  <div style="margin-top:24px"><a href={intHref} class="btn btn-ghost">← {ui.back}</a></div>
+</div></section>
+
+<section class="cta"><div class="wrap" style="padding:56px 0;text-align:center">
+  <h2 style="color:#fff">{S(ui.ctaT)}</h2>
+  <p style="color:rgba(255,255,255,.9);max-width:620px;margin:12px auto 0">{ui.ctaX}</p>
+  <div class="btns" style="justify-content:center;margin-top:20px">
+    <a href={contactHref} class="btn btn-light">{ui.p}</a>
+    <a href={localizePath("/tarieven/", lang)} class="btn btn-ghost" style="color:#fff;border-color:rgba(255,255,255,.6)">{ui.sec}</a>
+  </div>
+</div></section>
