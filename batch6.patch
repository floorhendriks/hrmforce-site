+        <b>{sy.name}</b><span>{sy.category}</span>
+      </a>
+    ))}
+  </div>
+</div></section>
+
 <section class="bg-soft"><div class="wrap">
   <div class="eyebrow">{t.how.eyebrow}</div>
   <h2 class="section-title">{t.how.title}</h2>
@@ -105,6 +118,11 @@ const pcats = PARTNER_CATS[lang] || PARTNER_CATS.nl;
   .pt-cat { font-size: 11px; font-weight: 700; letter-spacing: .4px; text-transform: uppercase; color: var(--gold); }
   .pt-card[hidden] { display: none !important; }
   .pt-empty { margin-top: 20px; color: var(--muted, #6b7280); }
+  .int-sys{display:grid;grid-template-columns:repeat(auto-fit,minmax(180px,1fr));gap:12px;margin-top:22px}
+  .int-sys-link{display:flex;flex-direction:column;gap:2px;background:#fff;border:1px solid var(--line);border-radius:12px;padding:14px 16px;text-decoration:none;transition:border-color .2s,box-shadow .2s}
+  .int-sys-link:hover{border-color:var(--gold);box-shadow:var(--shadow-sm)}
+  .int-sys-link b{color:var(--navy)}
+  .int-sys-link span{color:var(--muted);font-size:13px}
 </style>
 
 
