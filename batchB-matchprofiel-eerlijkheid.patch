+/* Homepage matchprofiel-sectie */
+.match-sec{display:grid;grid-template-columns:minmax(0,1.15fr) minmax(0,.85fr);gap:44px;align-items:center}
+.match-copy .lead{margin:8px 0 18px}
+.match-list{list-style:none;margin:0 0 22px;padding:0;display:flex;flex-direction:column;gap:10px}
+.match-list li{display:flex;gap:12px;align-items:flex-start;color:var(--navy);font-weight:600}
+.match-ic{flex:none;width:24px;height:24px;border-radius:50%;background:var(--navy);color:#fff;display:flex;align-items:center;justify-content:center;font-size:14px;font-weight:800}
+.match-visual{position:relative;background:linear-gradient(160deg,var(--navy),var(--navy-deep));border-radius:20px;padding:32px;min-height:220px;display:flex;flex-direction:column;justify-content:center;gap:20px;box-shadow:var(--shadow-md)}
+.mv-card{display:flex;align-items:baseline;gap:8px}
+.mv-score{color:var(--gold);font-size:3rem;font-weight:800;line-height:1;letter-spacing:-.02em}
+.mv-label{color:#c4d2e6;font-size:15px;font-weight:600}
+.mv-bars{display:flex;flex-direction:column;gap:10px}
+.mv-bar{height:10px;border-radius:6px;background:rgba(255,255,255,.14);position:relative;overflow:hidden}
+.mv-bar::after{content:"";position:absolute;inset:0 auto 0 0;width:var(--w);background:linear-gradient(90deg,var(--blue),var(--gold));border-radius:6px}
+@media(max-width:820px){.match-sec{grid-template-columns:1fr;gap:26px}}
