 .../oefentest/numerical-reasoning/index.html  | 14 ++++++++++
 .../razonamiento-numerico/index.html          | 14 ++++++++++
 .../raisonnement-numerique/index.html         | 14 ++++++++++
 .../oefentest/numeriek-redeneren/index.html   | 14 ++++++++++
 .../oefentest/rationament-numeric/index.html  | 14 ++++++++++
 src/data/kenniscentrum-duplicaten.js          | 27 +++++++++++++++++++
 src/pages/[...path].astro                     |  4 +++
 9 files changed, 124 insertions(+), 4 deletions(-)
 create mode 100644 public/de/oefentest/numerisches-denken/index.html
 create mode 100644 public/en/oefentest/numerical-reasoning/index.html
 create mode 100644 public/es/oefentest/razonamiento-numerico/index.html
 create mode 100644 public/fr/oefentest/raisonnement-numerique/index.html
 create mode 100644 public/oefentest/numeriek-redeneren/index.html
