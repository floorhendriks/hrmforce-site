diff --git a/src/data/kenniscentrum-duplicaten.js b/src/data/kenniscentrum-duplicaten.js
new file mode 100644
index 0000000..4fb6b60
--- /dev/null
+++ b/src/data/kenniscentrum-duplicaten.js
@@ -0,0 +1,27 @@
+// Kennisartikelen die onder twee adressen op de site stonden.
+//
+// Bij de migratie uit WordPress kreeg een deel van de artikelen een tweede,
+// genest adres met de oude categorie erin (/kenniscentrum/ontwikkeling/...).
+// Die tweede versie bevat alleen het woord "Verplaatst" en verwijst naar het
+// echte artikel. Ze stonden wel in _redirects, alleen past Cloudflare Pages
+// maar een deel van dat bestand toe, dus ze bleven als gewone pagina in de
+// lucht en concurreerden in Google met het artikel zelf.
+//
+// Door ze hier te noemen bouwt de site ze niet meer. De terugvalpagina uit
+// npm run hsf:redirects vangt het oude adres op, met noindex en een canonical
+// naar het artikel dat blijft.
+export const DUBBELE_ARTIKELEN = {
+  "/kenniscentrum/onderwijs/werkdruk-onderwijs/":
+    "/kenniscentrum/werkdruk-onderwijs/",
+  "/kenniscentrum/ontwikkeling/krachtige-talentontwikkeling-begint-met-onbekend-talent-verkennen/":
+    "/kenniscentrum/krachtige-talentontwikkeling-begint-met-onbekend-talent-verkennen/",
+  "/kenniscentrum/ontwikkeling/lessen-voor-een-goede-hr-vlootschouw-met-ontwikkelaanpak/":
+    "/kenniscentrum/lessen-voor-een-goede-hr-vlootschouw-met-ontwikkelaanpak/",
+  "/kenniscentrum/ontwikkeling/piramide-van-lencioni/":
+    "/assessments/lencioni-teamdynamiek/",
+};
+
+// De paden zoals de catch-all route ze kent: zonder schuine streep ervoor en erachter.
+export const DUBBELE_PADEN = new Set(
+  Object.keys(DUBBELE_ARTIKELEN).map((p) => p.replace(/^\/+|\/+$/g, ""))
+);
diff --git a/src/pages/[...path].astro b/src/pages/[...path].astro
index f6bacd2..b77ab6b 100644
--- a/src/pages/[...path].astro
+++ b/src/pages/[...path].astro
@@ -8,6 +8,7 @@ import { shopInfo } from "../data/assessment-shop.js";
 import { localizePath, sanitizeBodyLinks } from "../i18n/utils.js";
 import LogoSlider from "../components/LogoSlider.astro";
 import validPaths from "../data/valid-paths.js";
+import { DUBBELE_PADEN } from "../data/kenniscentrum-duplicaten.js";
 
 // Gemigreerde kenniscentrum-artikelen uit WordPress. Elk artikel-document in
 // Sanity heeft een volledig 'path'; deze catch-all route rendert ze op dat pad.
@@ -19,6 +20,8 @@ export async function getStaticPaths() {
   // Statische routes hebben voorrang; sluit paden uit die we nu als eigen
   // pagina bouwen (bijv. de sectoren-index) om dubbele routes te voorkomen.
   const OWN = new Set(["sectoren", "en/sectoren", "de/sectoren", "fr/sectoren", "es/sectoren", "ro/sectoren", "sectoren/onderwijs"]);
+  // Artikelen die twee adressen hebben. Het lege "Verplaatst"-adres bouwen we
+  // niet meer; een terugvalpagina stuurt de bezoeker naar het echte artikel.
   // Migratieresten uit WordPress: paden als /?page_id=8355/. Het zijn dubbelen
   // van echte pagina's (templates, testpagina's, tweede versies van Support en
   // de algemene voorwaarden) met een URL zonder betekenis. Ze niet bouwen haalt
@@ -36,6 +39,7 @@ export async function getStaticPaths() {
     .map((a) => ({ ...a, gedeeldeIntro: telling[kop(a.body)] > 1 }))
     .map((a) => ({ p: a.path.replace(/^\/+|\/+$/g, ""), a }))
     .filter((x) => !OWN.has(x.p))
+    .filter((x) => !DUBBELE_PADEN.has(x.p))
     .map((x) => ({ params: { path: x.p }, props: { article: x.a } }));
 }
 
