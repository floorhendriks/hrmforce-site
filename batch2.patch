 @media(max-width:880px){.info-grid{grid-template-columns:1fr 1fr}}
 
-.explain{display:grid;grid-template-columns:1.2fr .8fr;gap:48px;align-items:start}
+.explain{display:grid;grid-template-columns:1.2fr .8fr;gap:48px;align-items:center}
+.explain-fig{border:1px solid var(--line);border-radius:var(--radius);overflow:hidden;box-shadow:var(--shadow-sm);background:#fff}
+.explain-fig img{display:block;width:100%;height:auto}
 .explain p{margin-bottom:14px;color:var(--text)}
 .traits{list-style:none;margin:18px 0;padding:0}
 .traits li{padding:12px 0 12px 34px;position:relative;border-bottom:1px dashed var(--line);font-weight:600;color:var(--navy)}
