---
import "../styles/global.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { getLangFromUrl, localizePath } from "../i18n/utils.js";
import CookieConsent from "../components/CookieConsent.astro";
import { ANALYTICS } from "../data/site-config.js";
import { consentContent } from "../data/consent-content.js";

const {
  title = "Hrmforce",
  description = "Talentmanagement software en online assessments van hrmforce.",
  active = "",
} = Astro.props;

const lang = getLangFromUrl(Astro.url);
const consentT = consentContent[lang] ?? consentContent.nl;
const canonical = new URL(Astro.url.pathname, Astro.site ?? "https://hrmforce.com");

// hreflang: alternatieve taalversies voor pagina's die in alle 6 talen bestaan.
const SITE = "https://hrmforce.com";
const OTHER_LANGS = ["en", "de", "fr", "es", "ro"];
const LOCALIZED_PATHS = new Set([
  "/", "/tarieven/", "/online-assessments/", "/assessment-overzicht/", "/over-ons/",
  "/advies/", "/contact/", "/hrm-oplossingen/", "/support/", "/shop/",
  "/kenniscentrum/", "/voorbereiding/", "/support/f-a-q/", "/klantcases/", "/integraties/",
  "/trust/", "/roi-rekentool/",
]);
const _segs = Astro.url.pathname.split("/").filter(Boolean);
const _hasLang = _segs.length > 0 && OTHER_LANGS.includes(_segs[0]);
let basePath = "/" + (_hasLang ? _segs.slice(1) : _segs).join("/");
if (!basePath.endsWith("/")) basePath += "/";
const _isAssessmentDetail = /^\/assessments\/[^/]+\/$/.test(basePath);
const _localized = LOCALIZED_PATHS.has(basePath) || _isAssessmentDetail;
const hreflangs = _localized
  ? [
      { lang: "nl", href: SITE + basePath },
      ...OTHER_LANGS.map((l) => ({ lang: l, href: SITE + "/" + l + basePath })),
      { lang: "x-default", href: SITE + basePath },
    ]
  : [];

// Organisatie-structured-data (voor Google + AI-samenvattingen)
const orgLd = {
  "@context": "https://schema.org",
  "@type": "Organization",
  name: "hrmforce",
  url: "https://hrmforce.com",
  logo: "https://hrmforce.com/wp-content/uploads/2022/03/HRM-LOGO.svg",
  description: "Talentmanagement software en wetenschappelijk gevalideerde online assessments voor selectie, ontwikkeling en teams.",
  contactPoint: {
    "@type": "ContactPoint",
    telephone: "+31-88-88-321-88",
    email: "service@hrmforce.com",
    contactType: "customer service",
    areaServed: "EU",
    availableLanguage: ["nl", "en", "de", "fr", "es", "ro"],
  },
};
---
<!DOCTYPE html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {hreflangs.map((h) => <link rel="alternate" hreflang={h.lang} href={h.href} />)}
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap"
    />
    <title>{title}</title>
    <script type="application/ld+json" set:html={JSON.stringify(orgLd)} is:inline></script>
  </head>
  <body>
    <Header active={active} />
    <slot />
    <a
      class="sticky-demo"
      href={localizePath("/contact/", lang)}
      aria-label="Plan een gratis demo"
    >
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true">
        <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z" stroke="#fff" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
      </svg>
      <span>Gratis demo</span>
    </a>
    <Footer />
    <script>
      // Uitklapbare FAQ-items
      document.querySelectorAll(".faq-q").forEach((q) => {
        q.addEventListener("click", () => q.parentElement.classList.toggle("open"));
      });
    </script>
    <CookieConsent lang={lang} ga4Id={ANALYTICS.GA4_ID} t={consentT} />
  </body>
</html>

<style>
  .sticky-demo {
    position: fixed;
    right: 20px;
    bottom: 20px;
    z-index: 40;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 12px 20px;
    min-height: 48px;
    background: var(--accent);
    color: #fff;
    font-weight: 700;
    font-size: 15px;
    border-radius: var(--radius-pill);
    box-shadow: 0 10px 26px rgba(217, 93, 21, 0.4);
    transition: background 0.18s ease, transform 0.18s ease, box-shadow 0.18s ease;
  }
  .sticky-demo:hover {
    background: var(--accent-hover);
    transform: translateY(-2px);
    box-shadow: 0 14px 32px rgba(217, 93, 21, 0.46);
    color: #fff;
  }
  .sticky-demo svg { flex-shrink: 0; }
  @media (max-width: 560px) {
    .sticky-demo { right: 14px; bottom: 14px; padding: 12px 18px; }
  }
</style>
