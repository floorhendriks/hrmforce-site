---
import Base from '../layouts/HsfBase.astro';
import Crumbs from '../components/Crumbs.astro';
import MatchCalculator from '../components/MatchCalculator.astro';
import { useT, path, useTf } from '../lib/i18n';
import { familyById, meta } from '../lib/hsf';
import { dlang } from '../lib/hsf-i18n';
interface Props { lang: string; fn: any; alternates: Record<string, string> }
const { lang, fn, alternates } = Astro.props;
const t = useT(lang);
const tf = useTf(lang);
const dl = dlang(lang);
const fam = familyById(fn.family_id);
const mm = (meta as any).match_model;
const title = `${t('match.title')} ${fn.title[dl]} | hrmforce`;
const desc = tf('seo.match-desc', { job: fn.title[dl], n: fn.counts.skills });
---
<Base lang={lang} title={title} description={desc} active="match" alternates={alternates}>
  <Crumbs items={[
    { label: t('nav.home'), href: path(lang) },
    { label: t('nav.match'), href: path(lang, 'match') },
    { label: fn.title[dl] },
  ]} />
  <h1 style="margin-bottom:.2rem">{t('match.title')}</h1>
  <p class="hsf-lead" style="margin-bottom:1rem">
    {fn.title[dl]} · <a href={path(lang, 'functions', fn.slug[dl])}>{t('ui.view-the-profile')}</a>
  </p>
  <MatchCalculator lang={lang} fn={fn} family={fam} />

  <h2>{t('ui.how-the-calculator-computes')}</h2>
  <div class="hsf-tablewrap">
    <table class="hsf-table">
      <thead><tr><th>{t('ui.step')}</th><th>{t('ui.formula')}</th></tr></thead>
      <tbody>
        <tr><td>{t('ui.target-level-per-seniority')}</td><td><code>{mm.seniority}</code></td></tr>
        <tr><td>{t('ui.fit-per-skill')}</td><td><code>{mm.fit_per_skill}</code></td></tr>
        <tr><td>{t('ui.total-fit')}</td><td><code>{mm.total_fit}</code></td></tr>
        <tr><td>{t('ui.knockout')}</td><td><code>{mm.knockout}</code></td></tr>
        <tr><td>{t('ui.advice-bands')}</td><td><code>{`>= ${mm.bands.strong} sterk, >= ${mm.bands.fit_with_development} passend, daaronder onvoldoende`}</code></td></tr>
      </tbody>
    </table>
  </div>
  <p class="hsf-note" style="margin-top:.8rem">
    {t('ui.performing-above-the-target-level-does')}
  </p>
</Base>
