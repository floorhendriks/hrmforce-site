---
/**
 * Volledig profiel, print- en pdf-geoptimaliseerd.
 * Deze pagina is de bron voor de pdf-download: scripts/build-pdfs.mjs rendert
 * hem met Playwright naar public/downloads/<taal>/<slug>.pdf.
 * De pagina staat op noindex, want de beknopte versie is de indexeerbare pagina.
 */
import Base from '../layouts/HsfBase.astro';
import ProfileTable from '../components/ProfileTable.astro';
import CompetencyTable from '../components/CompetencyTable.astro';
import { useT, path, useTf } from '../lib/i18n';
import { familyById, meta, domainMix, constructById } from '../lib/hsf';
import { dlang } from '../lib/hsf-i18n';
import { vt } from '../lib/vocab';
interface Props { lang: string; fn: any }
const { lang, fn } = Astro.props;
const t = useT(lang);
const tf = useTf(lang);
const dl = dlang(lang);
const fam = familyById(fn.family_id);
const mix = domainMix(fn.profile);
const scale = (meta as any).proficiency_scale;
const methods = [...new Set(fn.profile.map((r: any) => r.assessment))]
  .map((m: any) => ({ name: m, ...((meta as any).assessment_methods[m] ?? {}) }));
const byDomain = (meta as any) && domainMix(fn.profile);
---
<Base lang={lang} title={`${fn.title[dl]} | ${t('framework')}`} description={fn.summary[dl]} noindex={true} bodyClass="hsf-print">
  <header style="border-bottom:3px solid var(--hsf-accent);padding-bottom:.8rem;margin-bottom:1.2rem">
    <div style="display:flex;justify-content:space-between;align-items:flex-end;gap:1rem;flex-wrap:wrap">
      <div>
        <img src="/media/wp-content/uploads/2022/03/HRM-LOGO.svg" alt="hrmforce" style="height:42px;width:auto;display:block" />
        <div class="hsf-xs" style="color:var(--hsf-accent);margin-top:.3rem">{t('framework')}</div>
      </div>
      <div class="hsf-xs hsf-muted" style="text-align:right">
        {t('ui.full-job-profile')}<br />
        {fn.id} · {t('ui.version')} {meta.version} · {meta.built}
      </div>
    </div>
  </header>

  <h1 style="margin-bottom:.2rem">{fn.title[dl]}</h1>
  <p class="hsf-small hsf-muted" style="margin-bottom:1rem">
    {fam.id} {fam.name[dl]} · ISCO-08 {fn.isco} · CBS {fn.brc} {vt(fn.brc_naam, dl)} ·
    {' '}{t('ui.seniority')} {fn.seniority_default}
    {fn.aliases[dl].length > 0 && <> · {t('fn.aliases')}: {fn.aliases[dl].join(', ')}</>}
  </p>
  <p class="hsf-lead">{fn.summary[dl]}</p>
  <p>{fn.context[dl]}</p>

  <div class="hsf-card tint" style="margin:1.2rem 0">
    <strong style="color:var(--hsf-navy)">{t('ui.key-figures-for-this-profile')}</strong>
    <p class="hsf-small" style="margin:.4rem 0 0">
      {fn.counts.skills} {t('ui.skills')} ·
      {' '}{fn.counts.competencies} {t('ui.competencies-to-measure')} ·
      {' '}{fn.counts.critical} {t('ui.knockout-skills')} ·
      {' '}{t('ui.centre-of-gravity')}: {mix.slice(0, 3).map((m: any) => `${m.name[dl]} ${Math.round(m.share * 100)}%`).join(', ')}
    </p>
  </div>

  <h2>1  {t('fn.competencies')}</h2>
  <p class="hsf-small hsf-muted">{t('fn.competencies.note')}</p>
  <CompetencyTable rows={fn.competencies} lang={lang} />

  <h2 class="hsf-pagebreak">2  {t('ui.full-skill-profile')}</h2>
  <p class="hsf-small hsf-muted">
    {t('ui.every-skill-in-this-profile-sorted')}
  </p>
  <ProfileTable rows={fn.profile} lang={lang} mode="full" />

  <h2 class="hsf-pagebreak">3  {t('ui.levels-per-seniority')}</h2>
  <p class="hsf-small hsf-muted">
    {t('ui.the-same-profile-with-the-job')}
  </p>
  <div class="hsf-tablewrap">
    <table class="hsf-table">
      <thead>
        <tr>
          <th>{t('tbl.skill')}</th>
          {Object.keys(fn.profile_by_seniority).map((s) => <th class="num">{s}</th>)}
        </tr>
      </thead>
      <tbody>
        {fn.profile.map((r: any) => (
          <tr>
            <td>{r.name[dl]}</td>
            {Object.keys(fn.profile_by_seniority).map((s) => {
              const hit = fn.profile_by_seniority[s].find((x: any) => x.skill_id === r.skill_id);
              return <td class="num">{hit ? 'N' + hit.target_level : '-'}</td>;
            })}
          </tr>
        ))}
      </tbody>
    </table>
  </div>

  <h2 class="hsf-pagebreak">4  {t('level.scale')}</h2>
  <div class="hsf-tablewrap">
    <table class="hsf-table">
      <thead>
        <tr>
          <th class="num">{t('ui.level')}</th><th>{t('ui.label')}</th>
          <th>{t('ui.autonomy')}</th><th>{t('ui.complexity')}</th>
          <th>{t('ui.scope')}</th><th>{t('ui.depth-of-knowledge')}</th>
        </tr>
      </thead>
      <tbody>
        {scale.map((l: any) => (
          <tr>
            <td class="num">{l.code}</td><td><strong>{l.label[dl]}</strong></td>
            <td>{l.autonomy[dl]}</td><td>{l.complexity[dl]}</td><td>{l.scope[dl]}</td><td>{l.depth[dl]}</td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>

  <h2>5  {t('ui.behavioural-anchors-per-skill')}</h2>
  <p class="hsf-small hsf-muted">
    {t('ui.anchors-sit-at-n1-n3-and')}
  </p>
  <div class="hsf-tablewrap">
    <table class="hsf-table">
      <thead><tr><th>{t('tbl.skill')}</th><th>N1</th><th>N3</th><th>N5</th></tr></thead>
      <tbody>
        {fn.profile.map((r: any) => (
          <tr>
            <td><strong>{r.name[dl]}</strong><div class="hsf-xs hsf-muted">{r.definition[dl]}</div></td>
            {r.anchors.map((a: any) => <td class="anchor">{a[dl]}</td>)}
          </tr>
        ))}
      </tbody>
    </table>
  </div>

  <h2 class="hsf-pagebreak">6  {t('ui.assessment-methods-and-validity')}</h2>
  <p class="hsf-small hsf-muted">
    {t('ui.the-validities-are-the-corrected-meta')}
  </p>
  <div class="hsf-tablewrap">
    <table class="hsf-table">
      <thead><tr><th>{t('tbl.assessment')}</th><th class="num">rho</th><th class="num">SD</th><th>{t('ui.what-it-is')}</th></tr></thead>
      <tbody>
        {methods.map((m: any) => (
          <tr>
            <td><strong>{vt(m.name, dl)}</strong></td>
            <td class="num">{m.rho != null ? m.rho.toFixed(2) : '-'}</td>
            <td class="num">{m.sd != null ? m.sd.toFixed(2) : '-'}</td>
            <td class="hsf-xs">{m[dl] ?? ''}</td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>

  <h2>7  {t('fn.instruments')}</h2>
  <div class="hsf-tablewrap">
    <table class="hsf-table">
      <thead><tr><th>{t('tbl.instrument')}</th><th class="num">{t('ui.skills-2')}</th><th>{t('ui.what-it-measures')}</th></tr></thead>
      <tbody>
        {fn.instrument_summary.map((i: any) => (
          <tr><td><strong>{vt(i.instrument, dl)}</strong></td><td class="num">{i.skills}</td><td class="hsf-xs">{vt(i.description, dl)}</td></tr>
        ))}
      </tbody>
    </table>
  </div>

  <h2>8  {t('ui.how-to-use-this-profile')}</h2>
  <ol class="hsf-small">
    <li>{t('ui.agree-the-profile-with-the-hiring')}</li>
    <li>{t('ui.choose-the-assessment-method-per-skill')}</li>
    <li>{t('ui.calibrate-the-assessors-in-a-two')}</li>
    <li>{t('ui.fill-in-the-match-calculator-and')}</li>
  </ol>

  <div class="hsf-card tint" style="margin-top:1.5rem">
    <p class="hsf-xs" style="margin:0">
      {tf('ui.source-note', { framework: t('framework'), version: meta.version, built: meta.built })}
    </p>
  </div>
  <p class="hsf-xs hsf-muted" style="margin-top:.6rem">hrmforce · hrmforce.com · {fn.id}</p>
</Base>
