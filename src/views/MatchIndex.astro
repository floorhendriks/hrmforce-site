---
import Base from '../layouts/HsfBase.astro';
import Crumbs from '../components/Crumbs.astro';
import Search from '../components/Search.astro';
import { useT, path } from '../lib/i18n';
import { families, functionsOfFamily, meta } from '../lib/hsf';
import { dlang } from '../lib/hsf-i18n';
interface Props { lang: string; alternates: Record<string, string> }
const { lang, alternates } = Astro.props;
const t = useT(lang);
const dl = dlang(lang);
const mm = (meta as any).match_model;
const title = `${t('match.title')} | hrmforce`;
const desc = t('seo.pick-a-job-and-calculate-the');
---
<Base lang={lang} title={title} description={desc} active="match" alternates={alternates}>
  <Crumbs items={[{ label: t('nav.home'), href: path(lang) }, { label: t('nav.match') }]} />
  <h1>{t('match.title')}</h1>
  <p class="hsf-lead" style="max-width:64ch">{desc}</p>
  <h2>{t('match.pick')}</h2>
  <Search lang={lang} scope="f" />
  <p class="hsf-note">
    {t('ui.open-a-job-and-click-calculate')}
  </p>
  <div class="hsf-cards">
    {families.map((f: any) => {
      const first = functionsOfFamily(f.id)[0];
      return first ? (
        <a class="hsf-card hsf-card-link" href={path(lang, 'match', first.slug[dl])}>
          <span class="hsf-badge accent">{f.id}</span>
          <h3 style="margin:.5rem 0 .2rem;font-size:1rem">{first.title[dl]}</h3>
          <p class="hsf-xs hsf-muted" style="margin:0">{f.name[dl]} · {first.counts.skills} {t('count.skills')}</p>
        </a>
      ) : null;
    })}
  </div>
  <p class="hsf-note" style="margin-top:1.2rem">{t('match.disclaimer')}</p>
</Base>
