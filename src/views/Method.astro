---
import Base from '../layouts/HsfBase.astro';
import Crumbs from '../components/Crumbs.astro';
import { useT, path } from '../lib/i18n';
import { meta } from '../lib/hsf';
import { dlang } from '../lib/hsf-i18n';
interface Props { lang: string; alternates: Record<string, string> }
const { lang, alternates } = Astro.props;
const t = useT(lang);
const dl = dlang(lang);
const scale = (meta as any).proficiency_scale;
const types = Object.entries((meta as any).skill_types);
const methods = Object.entries((meta as any).assessment_methods);
const stds = Object.entries((meta as any).standards);
const title = `${t('meth.title')} | ${t('framework')}`;
const desc = t('seo.how-the-hrmforce-skills-framework-is');
---
<Base lang={lang} title={title} description={desc} active="method" alternates={alternates}>
  <Crumbs items={[{ label: t('nav.home'), href: path(lang) }, { label: t('meth.title') }]} />
  <h1>{t('meth.title')}</h1>
  <p class="hsf-lead" style="max-width:66ch">{desc}</p>

  <h2>{t('ui.five-layers')}</h2>
  <div class="hsf-tablewrap">
    <table class="hsf-table">
      <thead><tr><th class="num">{t('ui.layer')}</th><th>{t('ui.unit')}</th><th class="num">{t('ui.count')}</th><th>{t('ui.what-the-layer-is-for')}</th></tr></thead>
      <tbody>
        <tr><td class="num">1</td><td>{t('ui.domain')}</td><td class="num">{meta.counts.domains}</td><td>{t('ui.high-level-reporting-and-the-layout')}</td></tr>
        <tr><td class="num">2</td><td>Cluster</td><td class="num">{meta.counts.clusters}</td><td>{t('ui.the-conversation-level-with-the-client')}</td></tr>
        <tr><td class="num">3</td><td>{t('ui.skill-construct')}</td><td class="num">{meta.counts.constructs}</td><td>{t('ui.the-unit-of-measurement-assessment-method')}</td></tr>
        <tr><td class="num">4</td><td>Skill</td><td class="num">{meta.counts.granular_skills}</td><td>{t('ui.the-search-layer-granular-terms-as')}</td></tr>
        <tr><td class="num">5</td><td>{t('ui.behavioural-anchor')}</td><td class="num">{meta.counts.anchors}</td><td>{t('ui.assessment-and-the-development-conversation-anchors')}</td></tr>
      </tbody>
    </table>
  </div>
  <p class="hsf-note">
    {t('ui.why-two-skill-layers-you-cannot')}
  </p>

  <h2>{t('ui.five-skill-types')}</h2>
  <div class="hsf-tablewrap">
    <table class="hsf-table">
      <thead><tr><th class="num">T</th><th>{t('ui.name')}</th><th>{t('ui.what-that-means-for-measurement')}</th></tr></thead>
      <tbody>
        {types.map(([code, v]: any) => (
          <tr>
            <td class="num"><span class="hsf-type" data-t={code}>{code}</span></td>
            <td><strong>{v.label[dl]}</strong></td>
            <td class="hsf-xs">{v.note[dl]}</td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>

  <h2>{t('level.scale')}</h2>
  <div class="hsf-tablewrap">
    <table class="hsf-table">
      <thead><tr><th class="num">{t('ui.level')}</th><th>Label</th><th>{t('ui.autonomy')}</th><th>{t('ui.complexity')}</th><th>{t('ui.scope')}</th><th>{t('ui.depth')}</th></tr></thead>
      <tbody>
        {scale.map((l: any) => (
          <tr>
            <td class="num">{l.code}</td><td><strong>{l.label[dl]}</strong></td>
            <td class="hsf-xs">{l.autonomy[dl]}</td><td class="hsf-xs">{l.complexity[dl]}</td>
            <td class="hsf-xs">{l.scope[dl]}</td><td class="hsf-xs">{l.depth[dl]}</td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>
  <p class="hsf-note">
    {t('ui.five-levels-instead-of-seven-or')}
  </p>

  <h2>{t('ui.assessment-methods-and-validity')}</h2>
  <p class="hsf-small" style="max-width:70ch">
    {t('ui.every-skill-has-a-primary-assessment')}
  </p>
  <div class="hsf-tablewrap">
    <table class="hsf-table">
      <thead><tr><th>{t('tbl.assessment')}</th><th class="num">rho</th><th class="num">SD</th><th>{t('ui.what-it-is')}</th></tr></thead>
      <tbody>
        {methods.sort((a: any, b: any) => (b[1].rho ?? -1) - (a[1].rho ?? -1)).map(([name, m]: any) => (
          <tr>
            <td><strong>{name}</strong></td>
            <td class="num">{m.rho != null ? m.rho.toFixed(2) : '-'}</td>
            <td class="num">{m.sd != null ? m.sd.toFixed(2) : '-'}</td>
            <td class="hsf-xs">{m[dl]}</td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>
  <p class="hsf-note">
    {t('ui.the-spread-matters-as-much-as')}
  </p>

  <h2>{t('ui.international-standards')}</h2>
  <div class="hsf-tablewrap">
    <table class="hsf-table">
      <thead><tr><th>{t('ui.standard')}</th><th>{t('ui.version-2')}</th><th>{t('ui.date')}</th><th>{t('ui.source')}</th></tr></thead>
      <tbody>
        {stds.map(([, s]: any) => (
          <tr>
            <td><strong>{s.name}</strong></td><td>{s.version}</td><td>{s.released}</td>
            <td class="hsf-xs"><a href={s.url} rel="nofollow noopener" target="_blank">{s.url.replace(/^https?:\/\//, '').split('/')[0]}</a></td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>
  <p class="hsf-note">
    {t('ui.the-mapping-is-conceptual-and-not')}
  </p>

  <h2>{t('ui.what-this-framework-is-not')}</h2>
  <ul class="hsf-small">
    <li>{t('ui.not-a-standard-every-profile-is')}</li>
    <li>{t('ui.not-a-decision-rule-a-fit')}</li>
    <li>{t('ui.not-a-normed-measurement-there-are')}</li>
    <li>{t('ui.not-a-replacement-for-rater-training')}</li>
  </ul>

  <div class="hsf-card tint" style="margin-top:2rem">
    <h3 style="margin-top:0">{t('cta.contact')}</h3>
    <p class="hsf-small">{t('cta.contact.sub')}</p>
    <a class="hsf-btn" href="/contact/">{t('cta.contact')}</a>
  </div>
</Base>
