---
import Base from '../layouts/HsfBase.astro';
import Crumbs from '../components/Crumbs.astro';
import Search from '../components/Search.astro';
import { useT, path, useTf } from '../lib/i18n';
import { functions, families, meta, facets } from '../lib/hsf';
import { dlang } from '../lib/hsf-i18n';
interface Props { lang: string; alternates: Record<string, string> }
const { lang, alternates } = Astro.props;
const t = useT(lang);
const tf = useTf(lang);
const dl = dlang(lang);
const byFam = families.map((f: any) => ({
  fam: f, list: functions.filter((x) => x.family_id === f.id)
    .sort((a, b) => a.title[dl].localeCompare(b.title[dl], dl)),
}));
const title = `${meta.counts.functions} ${t('seo.job-profiles-with-skills-and-competencies')} | hrmforce`;
const desc = tf('seo.jobs-index-desc', { n: meta.counts.functions });
const jsonld = {
  '@context': 'https://schema.org', '@type': 'CollectionPage', name: title, description: desc,
  inLanguage: lang, url: new URL(path(lang, 'functions'), Astro.site).toString(),
};
---
<Base lang={lang} title={title} description={desc} active="functions" alternates={alternates} jsonld={jsonld}>
  <Crumbs items={[{ label: t('nav.home'), href: path(lang) }, { label: t('nav.functions') }]} />
  <h1>{t('nav.functions')}</h1>
  <p class="hsf-lead" style="max-width:62ch">
    {tf('ui.jobs-index-lead', { n: meta.counts.functions })}
  </p>
  <Search lang={lang} scope="f" />

  {byFam.map(({ fam, list }) => (
    <section id={fam.id}>
      <h2>{fam.id} {fam.name[dl]} <span class="hsf-badge">{list.length}</span></h2>
      <p class="hsf-small hsf-muted" style="max-width:70ch">{fam.description[dl]}
        {' '}<a href={path(lang, 'families', fam.slug[dl])}>{t('ui.view-the-family')}</a>
      </p>
      <div class="hsf-cards">
        {list.map((f: any) => (
          <a class="hsf-card hsf-card-link" href={path(lang, 'functions', f.slug[dl])}>
            <strong style="color:var(--hsf-navy)">{f.title[dl]}</strong>
            <p class="hsf-xs hsf-muted" style="margin:.35rem 0 .5rem">{f.summary[dl]}</p>
            <div class="hsf-badges">
              <span class="hsf-badge">{f.counts.skills} {t('count.skills')}</span>
              <span class="hsf-badge">{f.counts.competencies} {t('ui.competencies')}</span>
              <span class="hsf-badge">{f.seniority_default}</span>
            </div>
          </a>
        ))}
      </div>
    </section>
  ))}
</Base>
