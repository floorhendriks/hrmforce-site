---
/* Alle documenten van de uitgevers op één pagina, gegroepeerd per instrument.
   De losse PDF's trekken zoekverkeer; vanaf hier komt die bezoeker op de
   pagina van het instrument zelf terecht in plaats van alleen in een PDF. */
import { documentenPerGroep } from "../data/instrument-documenten.js";
import { localizePath } from "../i18n/utils.js";
import { DOCOVER_T } from "../data/component-teksten.js";

const { lang = "nl" } = Astro.props;
const groepen = documentenPerGroep(lang);
const aantal = groepen.reduce((n, g) => n + g.docs.length, 0);

const T = DOCOVER_T;
const t0 = T[lang] || T.nl;
// {aantal} staat als plaatshouder in de tekst, zodat de zin vertaald kan worden.
const t = { ...t0, lead: String(t0.lead).replace("{aantal}", String(aantal)) };
const contactHref = localizePath("/contact/", lang);
---

<div class="crumb"><div class="wrap">
  <a href={localizePath("/", lang)}>Home</a> &rsaquo; <span>{t.crumb}</span>
</div></div>

<section class="ahero"><div class="wrap" style="display:block">
  <div class="eyebrow">{t.eyebrow}</div>
  <h1>{t.h1}</h1>
  <p style="max-width:860px;color:#c4d2e6;font-size:17px;line-height:1.6;margin:10px 0 0">{t.lead}</p>
</div></section>

{groepen.map((g) => (
  <section class="do-sectie"><div class="wrap" style="display:block">
    <div class="eyebrow">{g.bron}</div>
    <h2 class="section-title">{g.naamTaal}</h2>
    <p class="do-lead">{g.leadTaal}</p>
    <ul class="do-lijst">
      {g.docs.map((d) => (
        <li><a href={d.href}>{d.titel}</a> <span class="do-meta">{d.meta}</span></li>
      ))}
    </ul>
    {g.href && <p class="do-naar"><a href={g.href}>{t.naar} &rarr;</a></p>}
  </div></section>
))}

<section class="bg-soft"><div class="wrap" style="display:block">
  <h2 class="section-title">{t.cta}</h2>
  <div class="btns" style="margin-top:14px">
    <a href={contactHref} class="btn btn-primary">{t.ctaLink}</a>
  </div>
</div></section>

<style>
  .do-sectie { padding:34px 0; border-bottom:1px solid var(--line); }
  .do-lead { max-width:820px; color:var(--muted); margin:0 0 14px; }
  .do-lijst { list-style:none; margin:0; padding:0; display:grid; gap:9px; }
  .do-lijst li { font-size:15px; line-height:1.5; }
  .do-lijst a { color:var(--blue); font-weight:600; }
  .do-meta { color:var(--muted); font-size:13px; white-space:nowrap; }
  .do-naar { margin:16px 0 0; }
  .do-naar a { color:var(--navy); font-weight:700; font-size:14.5px; }
</style>
