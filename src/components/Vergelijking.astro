---
import { VERG_UI, COMPETITORS } from "../data/vergelijking-content.js";
import { localizePath } from "../i18n/utils.js";
const { slug, lang = "nl" } = Astro.props;
const t = VERG_UI[lang] || VERG_UI.nl;
const c = COMPETITORS[slug];
const comp = { name: c.name, intro: (c.intro[lang] || c.intro.nl) };
const _canon = new URL(Astro.url.pathname, "https://hrmforce.com").href;
const _crumbLd = { "@context":"https://schema.org","@type":"BreadcrumbList", itemListElement:[
  {"@type":"ListItem",position:1,name:"Home",item:"https://hrmforce.com/"},
  {"@type":"ListItem",position:2,name:t.crumb,item:`https://hrmforce.com${localizePath("/vergelijking/", lang)}`},
  {"@type":"ListItem",position:3,name:`${t.altPrefix} ${comp.name}`,item:_canon},
]};
---
<script type="application/ld+json" is:inline set:html={JSON.stringify(_crumbLd)}></script>
<div class="crumb"><div class="wrap"><a href={localizePath("/", lang)}>Home</a> &rsaquo; <a href={localizePath("/vergelijking/", lang)}>{t.crumb}</a> &rsaquo; <span>{comp.name}</span></div></div>

<section class="ahero"><div class="wrap" style="display:block">
  <div class="eyebrow" style="color:var(--gold)">{t.eyebrow}</div>
  <h1>{t.altPrefix} {comp.name}</h1>
  <p style="color:#c4d2e6;font-size:18px;max-width:760px;margin-top:10px">{comp.intro}</p>
  <p style="color:#93a7c4;font-size:13px;max-width:760px;margin-top:12px">{t.neutralNote}</p>
</div></section>

<section class="bg-soft"><div class="wrap">
  <div class="eyebrow" style="color:var(--gold)">{t.edgeTitle}</div>
  <h2 class="section-title" style="margin-bottom:8px">{t.edgeTitle}</h2>
  <p class="lead" style="max-width:820px;margin:0 0 22px">{t.verdict}</p>
  <ul class="vg-edges">
    {t.edges.map((e) => (<li><span class="vg-check" aria-hidden="true">&check;</span><span>{e}</span></li>))}
  </ul>
</div></section>

<section><div class="wrap">
  <div class="eyebrow">{t.diffTitle}</div>
  <h2 class="section-title" style="margin-bottom:26px">{t.diffTitle}</h2>
  <div class="vg-grid">
    {t.diffs.map((d) => (<div class="vg-card"><h3>{d[0]}</h3><p>{d[1]}</p></div>))}
  </div>
</div></section>

<section class="cta"><div class="wrap" style="padding:56px 0;text-align:center">
  <h2 style="color:#fff">{t.ctaTitle}</h2>
  <p style="color:rgba(255,255,255,.9);max-width:620px;margin:12px auto 0">{t.ctaText}</p>
  <div class="btns" style="justify-content:center;margin-top:20px"><a href={localizePath("/contact/", lang)} class="btn btn-light">{t.ctaBtn}</a></div>
</div></section>

<style>
  .vg-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:20px;margin-top:8px}
  .vg-card{background:#fff;border:1px solid var(--line);border-left:3px solid var(--gold);border-radius:14px;padding:22px 24px}
  .vg-card h3{color:var(--navy);font-size:1.05rem;margin:0 0 8px;letter-spacing:-.01em}
  .vg-card p{color:var(--muted);font-size:14.5px;line-height:1.6;margin:0}
  .vg-edges{list-style:none;margin:0;padding:0;display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:12px 26px}
  .vg-edges li{display:flex;gap:12px;align-items:flex-start;color:var(--navy);font-weight:600;font-size:15px;line-height:1.5}
  .vg-check{flex:none;width:24px;height:24px;border-radius:50%;background:var(--navy);color:#fff;display:flex;align-items:center;justify-content:center;font-size:14px;font-weight:800}
  @media(max-width:820px){.vg-edges{grid-template-columns:1fr}}
  @media(max-width:820px){.vg-grid{grid-template-columns:1fr}}
</style>
