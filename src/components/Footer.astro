---
import { routes } from "../i18n/ui.js";
import { getLangFromUrl, useTranslations, navHref } from "../i18n/utils.js";
import validPaths from "../data/valid-paths.js";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const year = new Date().getFullYear();
const L = (p) => navHref(p, lang, validPaths);
// Sitebrede trust-balk: korte, feitelijke signalen (per taal).
const trustBarByLang = {
  nl: ["Wetenschappelijk gevalideerd", "AVG-proof gegevensverwerking", "36+ online assessments", "Beschikbaar in 14 talen"],
  en: ["Scientifically validated", "GDPR-compliant data handling", "36+ online assessments", "Available in 14 languages"],
  de: ["Wissenschaftlich validiert", "DSGVO-konforme Datenverarbeitung", "36+ Online-Assessments", "In 14 Sprachen verfügbar"],
  fr: ["Validé scientifiquement", "Traitement des données conforme au RGPD", "36+ évaluations en ligne", "Disponible en 14 langues"],
  es: ["Validado científicamente", "Tratamiento de datos conforme al RGPD", "36+ evaluaciones online", "Disponible en 14 idiomas"],
  ro: ["Validat științific", "Prelucrare a datelor conformă GDPR", "36+ evaluări online", "Disponibil în 14 limbi"],
};
const trustBar = trustBarByLang[lang] ?? trustBarByLang.nl;
const _check = `<svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"/></svg>`;
---
<footer>
  <div class="trustbar"><div class="wrap">
    <ul class="tb-list">
      {trustBar.map((item) => (<li><span class="tb-ic" set:html={_check}></span>{item}</li>))}
    </ul>
  </div></div>
  <div class="wrap">
    <div class="fgrid">
      <div>
        <div class="flogo">hrmforce</div>
        <p>{t("footer.tagline")}</p>
      </div>
      <div>
        <h4>{t("footer.quick")}</h4>
        <ul>
          <li><a href={L(routes.assessments)}>{t("footer.assessments")}</a></li>
          <li><a href={L("/voorbereiding/")}>{t("footer.prep")}</a></li>
          <li><a href={L("/kenniscentrum/")}>{t("footer.knowledge")}</a></li>
          <li><a href={L("/advies/")}>{t("footer.training")}</a></li>
          <li><a href={L(routes.shop)}>{t("nav.shop")}</a></li>
        </ul>
      </div>
      <div>
        <h4>{t("footer.more")}</h4>
        <ul>
          <li><a href={L(routes.about)}>{t("footer.about")}</a></li>
          <li><a href={L("/partners/")}>{t("footer.partners")}</a></li>
          <li><a href={L("/tarieven/")}>{t("footer.pricing")}</a></li>
          <li><a href={L("/toepassingen/")}>Toepassingen</a></li>
          <li><a href={L("/klantcases/")}>{t("footer.cases")}</a></li>
          <li><a href={L("/integraties/")}>{t("footer.integrations")}</a></li>
          <li><a href={L("/trust/")}>{t("footer.trust")}</a></li>
          <li><a href={routes.support}>{t("footer.support")}</a></li>
          <li><a href={L("/vacatures/")}>{t("footer.vacancies")}</a></li>
        </ul>
      </div>
      <div>
        <h4>{t("footer.contact")}</h4>
        <p>Solitudolaan 396<br />1096 DS Amsterdam<br />The Netherlands</p>
        <p style="margin-top:10px">T: +31 (0)88 88 321 88<br />E: service@hrmforce.com</p>
      </div>
    </div>
    <div class="fbottom">
      <span>Copyright hrmforce &copy; 2009&ndash;{year}</span>
      <span>
        <button type="button" class="cookie-prefs-btn" onclick="window.openCookiePrefs && window.openCookiePrefs()">{t("footer.cookieprefs")}</button>
        &nbsp;&middot;&nbsp;{t("footer.rights")}
      </span>
    </div>
  </div>
</footer>

<style>
  .trustbar{border-bottom:1px solid rgba(255,255,255,.12);padding:16px 0}
  .tb-list{list-style:none;margin:0;padding:0;display:flex;flex-wrap:wrap;gap:14px 28px;justify-content:center}
  .tb-list li{display:flex;align-items:center;gap:8px;color:rgba(255,255,255,.9);font-size:14px;font-weight:600}
  .tb-ic{display:inline-flex;color:var(--gold)}
  @media(max-width:640px){.tb-list{gap:12px 20px}.tb-list li{font-size:13px}}
  .cookie-prefs-btn {
    background: none;
    border: none;
    padding: 0;
    color: inherit;
    font: inherit;
    cursor: pointer;
    text-decoration: underline;
  }
  .cookie-prefs-btn:hover { opacity: .8; }
</style>
