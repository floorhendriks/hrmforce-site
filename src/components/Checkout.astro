---
import { CHECKOUT_I18N, EU_COUNTRIES } from "../data/checkout-i18n.js";
import { localizePath } from "../i18n/utils.js";
const { lang } = Astro.props;
const c = CHECKOUT_I18N[lang] || CHECKOUT_I18N.nl;
const shopHref = localizePath("/shop/", lang);
// Landen: NL + Nederland eerst, dan overige EU alfabetisch, dan "buiten EU".
const euList = Object.entries(EU_COUNTRIES).sort((a, b) => a[1].localeCompare(b[1]));
---
<section class="wrap co-wrap">
  <a class="co-back" href={shopHref}>{c.back}</a>
  <h1 class="co-h1">{c.h1}</h1>

  <div id="coEmpty" class="co-empty" hidden>
    <p>{c.empty}</p>
    <a class="btn btn-primary" href={shopHref}>{c.toShop} →</a>
  </div>

  <div id="coMain" class="co-grid" hidden>
    <div class="co-order">
      <h2>{c.orderTitle}</h2>
      <div id="coLines"></div>
      <a class="co-edit" href={shopHref}>{c.editCart}</a>
    </div>

    <form class="co-form" id="coForm" novalidate>
      <h2>{c.billTitle}</h2>
      <div class="co-row">
        <label>{c.company}*<input type="text" name="company" required autocomplete="organization" /></label>
      </div>
      <div class="co-row co-2">
        <label>{c.contact}*<input type="text" name="contact" required autocomplete="name" /></label>
        <label>{c.email}*<input type="email" name="email" required autocomplete="email" /></label>
      </div>
      <div class="co-row co-2">
        <label>{c.phone}<input type="tel" name="phone" autocomplete="tel" /></label>
        <label>{c.country}*
          <select name="country" id="coCountry" required>
            <option value="">{c.pick}</option>
            {euList.map(([code, name]) => (<option value={code}>{name}</option>))}
            <option value="XX">, {c.sumVatExport}, </option>
          </select>
        </label>
      </div>
      <div class="co-row">
        <label>{c.vat}<input type="text" name="vat" id="coVat" placeholder="NL000000000B00" /></label>
        <p class="co-hint">{c.vatHint}</p>
      </div>
      <div class="co-row co-2">
        <label>{c.street}*<input type="text" name="street" required autocomplete="street-address" /></label>
        <label>{c.city}*<input type="text" name="city" required autocomplete="address-level2" /></label>
      </div>
      <div class="co-row co-2">
        <label>{c.postal}*<input type="text" name="postal" required autocomplete="postal-code" /></label>
        <label>{c.reference}<input type="text" name="reference" /></label>
      </div>

      <div class="co-sum" id="coSum"></div>
      <p class="co-warn" id="coWarn" hidden></p>
      <button type="submit" class="btn btn-primary co-pay" id="coPay">{c.pay} →</button>
      <p class="co-secure">{c.secure}</p>
      <p class="co-terms">{c.terms}</p>
    </form>
  </div>
</section>

<style is:global>
  .co-wrap { padding: 32px 0 60px; max-width: 1040px; }
  .co-back { display: inline-block; color: var(--navy); font-weight: 600; font-size: 14px; margin-bottom: 10px; text-decoration: none; }
  .co-back:hover { color: var(--accent); }
  .co-h1 { color: var(--navy); font-size: 1.9rem; margin: 0 0 20px; }
  .co-empty { text-align: center; padding: 50px 0; }
  .co-empty p { color: var(--muted); margin-bottom: 16px; }
  .co-grid { display: grid; grid-template-columns: 1fr 1.15fr; gap: 28px; align-items: start; }
  .co-order.co-form { background: #fff; border: 1px solid var(--line); border-radius: var(--radius); padding: 22px 24px; box-shadow: var(--shadow-sm); }
  .co-order h2.co-form h2 { color: var(--navy); font-size: 1.15rem; margin: 0 0 14px; }
  .co-line { display: flex; gap: 12px; padding: 12px 0; border-bottom: 1px solid var(--line); }
  .co-line-img { width: 52px; height: 52px; border-radius: 8px; background: var(--bg-soft) center/cover no-repeat; flex: none; }
  .co-line-b { flex: 1; min-width: 0; }
  .co-line-t { color: var(--navy); font-weight: 700; font-size: 14px; margin: 0; display: flex; justify-content: space-between; gap: 10px; }
  .co-line-meta { color: var(--muted); font-size: 12.5px; margin: 2px 0 0; }
  .co-cands { margin: 6px 0 0; padding: 0; list-style: none; display: grid; gap: 4px; }
  .co-cand { font-size: 12px; color: var(--text); background: var(--bg-soft); border-radius: 6px; padding: 4px 8px; }
  .co-edit { display: inline-block; margin-top: 12px; font-size: 13px; color: var(--navy); text-decoration: underline; }
  .co-edit:hover { color: var(--accent); }
  .co-row { margin-bottom: 12px; }
  .co-2 { display: flex; gap: 12px; }
  .co-2 > label { flex: 1; min-width: 0; }
  .co-form label { display: block; color: var(--navy); font-weight: 600; font-size: 13px; }
  .co-form input.co-form select { width: 100%; margin-top: 4px; padding: 10px 12px; border: 1px solid var(--line-strong); border-radius: 8px; font-family: inherit; font-size: 14px; background: #fff; color: var(--navy); font-weight: 500; }
  .co-form input:focus.co-form select:focus { outline: 2px solid var(--blue); border-color: var(--blue); }
  .co-hint { color: var(--muted); font-size: 12px; margin: 4px 0 0; }
  .co-invalid { border-color: #d64545 !important; box-shadow: 0 0 0 2px rgba(214,69,69.15); }
  .co-sum { border-top: 1px solid var(--line); margin-top: 16px; padding-top: 14px; display: grid; gap: 6px; }
  .co-sum-row { display: flex; justify-content: space-between; font-size: 14px; color: var(--text); }
  .co-sum-total { font-weight: 800; color: var(--navy); font-size: 1.1rem; border-top: 1px solid var(--line); padding-top: 8px; margin-top: 2px; }
  .co-warn { color: #b3261e; background: #fdeceb; border: 1px solid #f6c9c5; border-radius: 8px; padding: 8px 12px; font-size: 13px; font-weight: 600; margin: 12px 0 0; }
  .co-pay { width: 100%; margin-top: 14px; padding: 13px 18px; font-size: 15px; }
  .co-secure.co-terms { text-align: center; color: var(--muted); font-size: 12px; margin: 10px 0 0; }
  .co-terms { text-align: left; margin-top: 8px; }
  @media (max-width: 820px) { .co-grid { grid-template-columns: 1fr; } .co-order { order: 2; } }
  @media (max-width: 520px) { .co-2 { flex-direction: column; gap: 12px; } }
</style>

<script is:inline define:vars={{ C: c, LANG: lang, EU: EU_COUNTRIES, SHOP: shopHref }}>
  (function () {
    var CART_LS = "hrmforce_cart_v2";
    var euCodes = Object.keys(EU);
    var LANGNAME = { nl: "Nederlands", en: "Engels", de: "Duits", fr: "Frans", es: "Spaans", ro: "Roemeens" };
    var LEVELNAME = { operational: "Operational", bachelor: "Bachelor", master: "Master" };
    function money(n) { return "€" + (Math.round(n * 100) / 100).toFixed(2).replace(".", ","); }
    function esc(s) { return (s || "").replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;").replace(/"/g, "&quot;"); }
    function loadCart() { try { var r = localStorage.getItem(CART_LS); if (r) { var o = JSON.parse(r); if (o && o.lines) return o; } } catch (e) {} return { lines: [] }; }

    var cart = loadCart();
    var emptyEl = document.getElementById("coEmpty");
    var mainEl = document.getElementById("coMain");
    if (!cart.lines.length) { emptyEl.hidden = false; return; }
    mainEl.hidden = false;

    function attrVal(l, key) { var a = l.attributes || []; for (var i = 0; i < a.length; i++) { if (a[i].key === key) return a[i].value; } return ""; }
    function candLines(l) {
      var out = [];
      for (var n = 1; n <= l.qty; n++) {
        var nm = attrVal(l, "Kandidaat " + n + " - Naam");
        var ml = attrVal(l, "Kandidaat " + n + " - E-mail");
        var lg = attrVal(l, "Kandidaat " + n + " - Taal");
        var lv = attrVal(l, "Kandidaat " + n + " - Niveau");
        if (nm || ml || lg || lv) {
          out.push(C.candidate + " " + n + ": " + (nm || "-") + (ml ? " <" + ml + ">" : "") +
            (lg ? ", " + (LANGNAME[lg] || lg) : "") + (lv ? ", " + (LEVELNAME[lv] || lv) : ""));
        }
      }
      return out;
    }
    var subtotal = 0;
    var linesHtml = "";
    cart.lines.forEach(function (l) {
      subtotal += l.qty * l.priceNum;
      var im = l.image ? 'style="background-image:url(\'' + l.image + '\')"' : "";
      var cands = candLines(l).map(function (x) { return '<li class="co-cand">' + esc(x) + "</li>"; }).join("");
      linesHtml += '<div class="co-line"><div class="co-line-img" ' + im + '></div><div class="co-line-b">' +
        '<p class="co-line-t"><span>' + esc(l.title) + ' &times; ' + l.qty + '</span><span>' + money(l.qty * l.priceNum) + '</span></p>' +
        '<p class="co-line-meta">' + money(l.priceNum) + ' ' + esc(C.each) + '</p>' +
        (cands ? '<ul class="co-cands">' + cands + '</ul>' : '') + '</div></div>';
    });
    document.getElementById("coLines").innerHTML = linesHtml;

    var countryEl = document.getElementById("coCountry");
    var vatEl = document.getElementById("coVat");
    var sumEl = document.getElementById("coSum");
    function vatValidish(v, country) {
      v = (v || "").replace(/\s/g, "").toUpperCase();
      if (v.length < 8) return false;
      var cc = v.slice(0, 2);
      return euCodes.indexOf(cc) > -1 && /[0-9]/.test(v);
    }
    function computeVat() {
      var country = countryEl.value;
      var vat = vatEl.value;
      var mode, rate, label;
      if (country === "NL") { rate = 0.21; mode = "nl"; label = C.sumVat + " (21%)"; }
      else if (euCodes.indexOf(country) > -1) {
        if (vatValidish(vat, country)) { rate = 0; mode = "reverse"; label = C.sumVatReverse; }
        else { rate = 0.21; mode = "nl_default"; label = C.sumVat + " (21%)"; }
      } else if (country === "XX") { rate = 0; mode = "export"; label = C.sumVatExport; }
      else { rate = 0.21; mode = "nl"; label = C.sumVat + " (21%)"; }
      return { rate: rate, mode: mode, label: label };
    }
    function renderSum() {
      var v = computeVat();
      var vatAmt = subtotal * v.rate;
      var total = subtotal + vatAmt;
      sumEl.innerHTML =
        '<div class="co-sum-row"><span>' + esc(C.sumSubtotal) + '</span><span>' + money(subtotal) + '</span></div>' +
        '<div class="co-sum-row"><span>' + esc(v.label) + '</span><span>' + money(vatAmt) + '</span></div>' +
        '<div class="co-sum-row co-sum-total"><span>' + esc(C.sumTotal) + '</span><span>' + money(total) + '</span></div>';
      return v;
    }
    renderSum();
    countryEl.addEventListener("change", renderSum);
    vatEl.addEventListener("input", renderSum);

    var form = document.getElementById("coForm");
    var warnEl = document.getElementById("coWarn");
    var payBtn = document.getElementById("coPay");
    function validEmail(s) { s = (s || "").trim(); var at = s.indexOf("@"); return at > 0 && s.indexOf(".", at) > at + 1 && s.indexOf(" ") < 0; }

    function buildMailFallback(payload) {
      var lines = [];
      payload.lines.forEach(function (l) {
        lines.push("- " + l.title + " x" + l.qty + " (" + money(l.priceNum) + ")");
        (l.candidates || []).forEach(function (cn) { lines.push("   " + cn.n + ": " + cn.name + " <" + cn.email + ">, " + cn.langName + ", " + cn.levelName); });
      });
      var b = payload.billing;
      var body = "Nieuwe bestelling (betaalomgeving onbereikbaar)%0A%0A" +
        encodeURIComponent(lines.join("\n")) + "%0A%0A" +
        encodeURIComponent("Bedrijf: " + b.company + "\nContact: " + b.contact + " <" + b.email + ">\nBtw: " + (b.vat || "-") + "\nLand: " + b.country + "\nAdres: " + b.street + ", " + b.postal + " " + b.city + "\nReferentie: " + (b.reference || "-"));
      return "mailto:service@hrmforce.com?subject=" + encodeURIComponent("Bestelling hrmforce") + "&body=" + body;
    }

    form.addEventListener("submit", function (ev) {
      ev.preventDefault();
      warnEl.hidden = true;
      var req = ["company", "contact", "email", "country", "street", "city", "postal"];
      var bad = false;
      req.forEach(function (name) {
        var el = form.elements[name];
        var ok = (el.value || "").trim().length > 0;
        el.classList.toggle("co-invalid"!ok);
        if (!ok) bad = true;
      });
      var emailEl = form.elements["email"];
      if (!validEmail(emailEl.value)) { emailEl.classList.add("co-invalid"); warnEl.textContent = C.errEmail; warnEl.hidden = false; return; }
      if (bad) { warnEl.textContent = C.errRequired; warnEl.hidden = false; return; }

      var v = computeVat();
      var payload = {
        locale: LANG, currency: "EUR",
        lines: cart.lines.map(function (l) {
          var cands = [];
          for (var n = 1; n <= l.qty; n++) {
            var nm = attrVal(l, "Kandidaat " + n + " - Naam"); if (!nm) continue;
            cands.push({ n: n, name: nm, email: attrVal(l, "Kandidaat " + n + " - E-mail"),
              lang: attrVal(l, "Kandidaat " + n + " - Taal"), level: attrVal(l, "Kandidaat " + n + " - Niveau"),
              langName: LANGNAME[attrVal(l, "Kandidaat " + n + " - Taal")] || "", levelName: LEVELNAME[attrVal(l, "Kandidaat " + n + " - Niveau")] || "" });
          }
          return { handle: l.lineId, title: l.title, qty: l.qty, price: l.priceNum, candidates: cands };
        }),
        billing: {
          company: form.elements["company"].value.trim(), contact: form.elements["contact"].value.trim(),
          email: emailEl.value.trim(), phone: form.elements["phone"].value.trim(),
          country: form.elements["country"].value, vat: form.elements["vat"].value.trim(),
          street: form.elements["street"].value.trim(), postal: form.elements["postal"].value.trim(),
          city: form.elements["city"].value.trim(), reference: form.elements["reference"].value.trim(),
        },
        vatHint: { mode: v.mode, rate: v.rate },
      };

      payBtn.disabled = true; payBtn.textContent = C.paying;
      fetch("/api/checkout", { method: "POST", headers: { "Content-Type": "application/json" }, body: JSON.stringify(payload) })
        .then(function (r) { return r.json().catch(function () { return {}; }).then(function (j) { return { ok: r.ok, j: j }; }); })
        .then(function (res) {
          if (res.ok && res.j && res.j.checkoutUrl) { window.location.href = res.j.checkoutUrl; return; }
          throw new Error((res.j && res.j.error) || "no_url");
        })
        .catch(function () {
          payBtn.disabled = false; payBtn.textContent = C.pay + " →";
          warnEl.innerHTML = esc(C.errGeneric) + ' <a href="' + buildMailFallback(payload) + '">' + esc(C.mailFallback) + "</a>";
          warnEl.hidden = false;
        });
    });
  })();
</script>
