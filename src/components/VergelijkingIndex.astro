---
import { VERG_UI, COMPETITORS } from "../data/vergelijking-content.js";
import { localizePath } from "../i18n/utils.js";
const { lang = "nl" } = Astro.props;
const t = VERG_UI[lang] || VERG_UI.nl;
const comps = Object.entries(COMPETITORS).map(([slug, c]) => ({ slug, name: c.name, intro: (c.intro[lang] || c.intro.nl) }));
const vp = (slug) => localizePath(`/vergelijking/${slug}/`, lang);
const _faqLd = { "@context":"https://schema.org","@type":"FAQPage", mainEntity:(t.faqs||[]).map((f)=>({ "@type":"Question", name:f.q, acceptedAnswer:{ "@type":"Answer", text:f.a } })) };
const testkiezerHref = localizePath("/testkiezer/", lang);
const gidsHref = localizePath("/whitepapers/assessments-kiezen-gids/", lang);
---
<div class="crumb"><div class="wrap"><a href={localizePath("/", lang)}>Home</a> &rsaquo; <span>{t.crumb}</span></div></div>

<section class="ahero"><div class="wrap" style="display:block">
  <div class="eyebrow">{t.eyebrow}</div>
  <h1>{t.hero}</h1>
  <p style="color:#c4d2e6;font-size:18px;max-width:760px;margin-top:10px">{t.intro}</p>
</div></section>

<section><div class="wrap">
  <div class="eyebrow">{t.diffTitle}</div>
  <h2 class="section-title" style="margin-bottom:26px">{t.diffTitle}</h2>
  <div class="vg-grid">
    {t.diffs.map((d) => (<div class="vg-card"><h3>{d[0]}</h3><p>{d[1]}</p></div>))}
  </div>
</div></section>

<section class="bg-soft"><div class="wrap">
  <div class="eyebrow">{t.compareTitle}</div>
  <h2 class="section-title" style="margin-bottom:26px">{t.compareTitle}</h2>
  <div class="cards">
    {comps.map((c) => (
      <a class="card" href={vp(c.slug)} style="text-decoration:none;color:inherit;display:flex;flex-direction:column">
        <h3>{t.altPrefix} {c.name}</h3>
        <p style="flex:1">{c.intro}</p>
        <span class="readmore">{t.viewCta} &rarr;</span>
      </a>
    ))}
  </div>
</div></section>

<script type="application/ld+json" is:inline set:html={JSON.stringify(_faqLd)}></script>
<section><div class="wrap">
  <div class="eyebrow">{t.guideTitle}</div>
  <h2 class="section-title" style="margin-bottom:8px">{t.guideTitle}</h2>
  <p class="lead" style="max-width:640px;margin:0 0 16px">{t.guideText}</p>
  <div class="btns"><a class="btn btn-primary" href={testkiezerHref}>{t.guideBtn} &rarr;</a><a class="btn btn-ghost" href={gidsHref} style="margin-left:8px">{t.guideBtn2}</a></div>
</div></section>

<section class="bg-soft"><div class="wrap" style="max-width:860px">
  <div class="center"><h2 class="section-title" style="margin-bottom:36px">{t.faqTitle}</h2></div>
  {t.faqs.map((f) => (<div class="faq-item"><div class="faq-q">{f.q}<span class="pl">+</span></div><div class="faq-a"><p>{f.a}</p></div></div>))}
</div></section>

<section class="cta"><div class="wrap" style="padding:56px 0;text-align:center">
  <h2 style="color:#fff">{t.ctaTitle}</h2>
  <p style="color:rgba(255,255,255,.9);max-width:620px;margin:12px auto 0">{t.ctaText}</p>
  <div class="btns" style="justify-content:center;margin-top:20px"><a href={localizePath("/contact/", lang)} class="btn btn-light">{t.ctaBtn}</a></div>
</div></section>

<style>
  .vg-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:20px;margin-top:8px}
  .vg-card{background:#fff;border:1px solid var(--line);border-radius:14px;padding:22px 24px}
  .vg-card h3{color:var(--navy);font-size:1.05rem;margin:0 0 8px;letter-spacing:-.01em}
  .vg-card p{color:var(--muted);font-size:14.5px;line-height:1.6;margin:0}
  @media(max-width:820px){.vg-grid{grid-template-columns:1fr}}
</style>
