---
import { localizePath } from "../i18n/utils.js";
const { t, lang } = Astro.props;
const contactHref = localizePath("/contact/", lang);
const assessHref = localizePath("/online-assessments/", lang);
const _canon = new URL(Astro.url.pathname, "https://hrmforce.com").href;
const _faqLd = { "@context": "https://schema.org", "@type": "FAQPage", mainEntity: t.faq.items.map((f) => ({ "@type": "Question", name: f.q, acceptedAnswer: { "@type": "Answer", text: f.a } })) };
---
<script type="application/ld+json" is:inline set:html={JSON.stringify(_faqLd)}></script>

<div class="crumb"><div class="wrap"><a href={localizePath("/", lang)}>Home</a> › <span>{t.crumb}</span></div></div>

<section class="ahero"><div class="wrap" style="display:block">
  <div class="eyebrow" style="color:var(--gold)">{t.hero.eyebrow}</div>
  <h1>{t.hero.title}</h1>
  <p style="color:#c4d2e6;font-size:18px;max-width:780px;margin-top:10px">{t.hero.intro}</p>
  <div class="btns" style="margin-top:18px"><a href={contactHref} class="btn btn-primary">{t.hero.cta} &rarr;</a></div>
</div></section>

<section><div class="wrap">
  <div class="eyebrow">{t.principles.eyebrow}</div>
  <h2 class="section-title">{t.principles.title}</h2>
  <div class="ws-grid">
    {t.principles.items.map((it) => (<div class="ws-card"><h3>{it.title}</h3><p>{it.text}</p></div>))}
  </div>
</div></section>

<section class="bg-soft"><div class="wrap">
  <div class="eyebrow" style="color:var(--gold)">{t.quality.eyebrow}</div>
  <h2 class="section-title">{t.quality.title}</h2>
  <div class="ws-grid">
    {t.quality.items.map((it) => (<div class="ws-card ws-check"><h3>{it.title}</h3><p>{it.text}</p></div>))}
  </div>
</div></section>

<section><div class="wrap" style="max-width:820px">
  <div class="eyebrow">{t.candidate.title}</div>
  <p class="lead" style="margin-top:8px">{t.candidate.text}</p>
</div></section>

<section class="bg-soft"><div class="wrap" style="max-width:820px">
  <div class="center"><h2 class="section-title" style="margin-bottom:36px">{t.faq.title}</h2></div>
  {t.faq.items.map((f) => (
    <div class="faq-item"><div class="faq-q">{f.q}<span class="pl">+</span></div><div class="faq-a"><p>{f.a}</p></div></div>
  ))}
</div></section>

<section class="cta"><div class="wrap" style="padding:56px 0;text-align:center">
  <h2 style="color:#fff">{t.ctaBand.title}</h2>
  <p style="color:rgba(255,255,255,.9);max-width:640px;margin:12px auto 0">{t.ctaBand.text}</p>
  <div class="btns" style="justify-content:center;margin-top:20px">
    <a href={contactHref} class="btn btn-light">{t.ctaBand.primary}</a>
    <a href={assessHref} class="btn btn-ghost" style="color:#fff;border-color:rgba(255,255,255,.6)">{t.ctaBand.secondary}</a>
  </div>
</div></section>

<style>
  .ws-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:20px;margin-top:26px}
  .ws-card{background:#fff;border:1px solid var(--line);border-radius:16px;padding:24px;border-left:3px solid var(--gold)}
  .ws-card h3{color:var(--navy);font-size:1.1rem;margin:0 0 8px}
  .ws-card p{color:var(--muted);font-size:15px;line-height:1.6;margin:0}
  .ws-check{border-left-color:var(--blue)}
  @media(max-width:760px){.ws-grid{grid-template-columns:1fr}}
</style>
