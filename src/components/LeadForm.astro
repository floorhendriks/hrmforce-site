---
/**
 * Leadgated download van het volledige profiel.
 *
 * Het formulier post naar /api/aanvraag, dezelfde route als de andere
 * formulieren op de site. De aanvraag gaat naar service@hrmforce.com met
 * f.hendriks@hrmforce.com in cc. Bij status 200 start de download. Een ander
 * endpoint kan nog steeds via de eigenschap `endpoint`.
 *
 * AVG: er wordt niets in de browser opgeslagen behalve een vlag dat dit profiel
 * al is gedownload, zodat een terugkerende bezoeker niet opnieuw het formulier
 * hoeft te vullen. Die vlag staat in localStorage en bevat geen persoonsgegevens.
 */
import { localizePath } from '../i18n/utils.js';
import { useT } from '../lib/i18n';
import Mensencheck from './Mensencheck.astro';
import { MENS_UI } from '../data/mensencheck-tekst.js';
interface Props {
  lang: string;
  fileUrl: string;
  fileName: string;
  subject: string;
  subjectId: string;
  endpoint?: string;
  privacyUrl?: string;
  /** Waar bij een echte pdf, onwaar als de link naar de printpagina wijst. */
  isPdf?: boolean;
}
const { lang, fileUrl, fileName, subject, subjectId, endpoint = '/api/aanvraag',
        privacyUrl = null, isPdf = true } = Astro.props;
const privacyHref = privacyUrl || localizePath('/support/privacy-statement/', lang);
const t = useT(lang);
const mensfout = (MENS_UI[lang] || MENS_UI.nl).fout;
---
<div class="hsf-card tint hsf-noprint hsf-leadform" data-endpoint={endpoint} data-file={fileUrl}
     data-filename={fileName} data-subject={subject} data-subject-id={subjectId}
     data-ispdf={isPdf ? '1' : '0'} data-mensfout={mensfout}>
  <h3 style="margin-top:0">{t('lead.title')}</h3>
  <p class="hsf-small">{t('lead.intro')}</p>

  <div class="hsf-alert ok" data-ok hidden>
    {t('lead.success')}{' '}
    <a href={fileUrl} download={isPdf ? fileName : undefined}
       target={isPdf ? undefined : '_blank'} rel="noopener" data-fallback>{t('lead.fallback')}</a>
  </div>
  <div class="hsf-alert err" data-err hidden>{t('lead.error')}</div>

  <form data-form novalidate>
    <div class="hsf-field">
      <label for={`lead-name-${subjectId}`}>{t('lead.name')}</label>
      <input id={`lead-name-${subjectId}`} name="naam" type="text" required autocomplete="name" />
    </div>
    <div class="hsf-field">
      <label for={`lead-email-${subjectId}`}>{t('lead.email')}</label>
      <input id={`lead-email-${subjectId}`} name="email" type="email" required autocomplete="email" />
    </div>
    <div class="hsf-field">
      <label for={`lead-org-${subjectId}`}>{t('lead.org')}</label>
      <input id={`lead-org-${subjectId}`} name="bedrijf" type="text" required autocomplete="organization" />
    </div>
    <div class="hsf-field">
      <label for={`lead-role-${subjectId}`}>{t('lead.role')}</label>
      <input id={`lead-role-${subjectId}`} name="functie" type="text" autocomplete="organization-title" />
    </div>
    <label class="hsf-check">
      <input type="checkbox" name="consent" required />
      <span>{t('lead.consent')}</span>
    </label>
    <label class="hsf-check">
      <input type="checkbox" name="newsletter" />
      <span>{t('lead.consent.newsletter')}</span>
    </label>
    <Mensencheck lang={lang} />
    <button class="hsf-btn block" type="submit" data-submit>{t('lead.submit')}</button>
    <p class="hsf-note" style="margin:.7rem 0 0">
      {t('lead.privacy')} <a href={privacyHref}>{t('ui.privacy-policy')}</a>
    </p>
  </form>
</div>

<script>
  document.querySelectorAll('.hsf-leadform').forEach((box) => {
    const form = box.querySelector('[data-form]');
    if (!form) return;
    const ok = box.querySelector('[data-ok]');
    const err = box.querySelector('[data-err]');
    const btn = box.querySelector('[data-submit]');
    const endpoint = box.dataset.endpoint;
    const file = box.dataset.file;
    const filename = box.dataset.filename;
    const key = 'hsf-lead-' + (box.dataset.subjectId || 'x');
    const labelIdle = btn.textContent;
    const errIdle = err.textContent;
    const isPdf = box.dataset.ispdf === '1';

    const start = () => {
      if (!isPdf) { window.open(file, '_blank', 'noopener'); return; }
      const a = document.createElement('a');
      a.href = file; a.download = filename; a.rel = 'noopener';
      document.body.appendChild(a); a.click(); a.remove();
    };
    const done = () => { form.hidden = true; ok.hidden = false; };

    try { if (localStorage.getItem(key) === '1') done(); } catch (e) {}

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      err.hidden = true;
      err.textContent = errIdle;
      if (!form.reportValidity()) return;
      btn.disabled = true;
      btn.textContent = btn.dataset.sending || labelIdle;
      const fd = new FormData(form);
      fd.append('onderwerp', 'Download functieprofiel: ' + (box.dataset.subject || ''));
      fd.append('profiel', box.dataset.subject || '');
      fd.append('profiel_id', box.dataset.subjectId || '');
      fd.append('bestand', filename || '');
      fd.append('pagina', location.pathname);
      fd.append('bron', 'functieprofiel');
      fd.append('taal', document.documentElement.lang || '');
      try {
        const res = await fetch(endpoint, {
          method: 'POST', body: fd, headers: { Accept: 'application/json' },
        });
        if (!res.ok) {
          const uit = await res.json().catch(() => ({}));
          if (uit && uit.error === 'geen_mens') err.textContent = box.dataset.mensfout || err.textContent;
          throw new Error('endpoint ' + res.status);
        }
        try { localStorage.setItem(key, '1'); } catch (e) {}
        done(); start();
      } catch (e) {
        err.hidden = false;
        btn.disabled = false; btn.textContent = labelIdle;
      }
    });
  });
</script>
