---
import Base from "../layouts/Base.astro";
import LogoSlider from "./LogoSlider.astro";
import { routes } from "../i18n/ui.js";
import { getLangFromUrl, localizePath, demoPath } from "../i18n/utils.js";
import Mensencheck from "./Mensencheck.astro";
import { FORM_UI } from "../data/formulier-tekst.js";
import { MENS_UI } from "../data/mensencheck-tekst.js";
import { SUBPAG_CTA } from "../data/component-teksten.js";

const { page, active = "" } = Astro.props;
const lang = getLangFromUrl(Astro.url);

const CTA = SUBPAG_CTA;
const cta = CTA[lang] || CTA.en;
const homeHref = localizePath("/", lang);
const contactHref = localizePath(routes.contact, lang);
const demoHref = demoPath(lang);
const assessHref = localizePath(routes.assessments, lang);
const f = FORM_UI[lang] || FORM_UI.nl;
const mensfout = (MENS_UI[lang] || MENS_UI.nl).fout;
---
<Base title={page.metaTitle} description={page.metaDescription} active={active}>
  <div class="crumb">
    <div class="wrap"><a href={homeHref}>Home</a> › <span>{page.title}</span></div>
  </div>

  <section class="ahero">
    <div class="wrap" style="display:block">
      <div class="eyebrow">{page.eyebrow}</div>
      <h1>{page.title}</h1>
      <p style="color:#c4d2e6;font-size:19px;max-width:760px;margin-top:8px">{page.lead}</p>
    </div>
  </section>

  {page.isContact ? (
    <section class="formsec">
      <div class="wrap grid-2" style="display:grid;gap:40px;align-items:start">
        <div>
          <h2 class="section-title" style="font-size:24px">hrmforce</h2>
          <p style="color:var(--muted)">Solitudolaan 396<br />1096 DS Amsterdam<br />The Netherlands</p>
          <p style="margin-top:14px;color:var(--muted)">T: +31 (0)88 88 321 88<br />E: service@hrmforce.com</p>
        </div>
        <form class="formcard" action="/api/aanvraag" method="POST" data-mensform
              data-ok={f.ok} data-fout={f.fout} data-mensfout={mensfout} data-bezig={f.bezig}>
          <div class="fg"><label>{page.form.name} *</label><input type="text" name="naam" required /></div>
          <div class="fg"><label>{page.form.company}</label><input type="text" name="bedrijf" /></div>
          <div class="frow">
            <div class="fg"><label>{page.form.email} *</label><input type="email" name="email" required /></div>
            <div class="fg"><label>{page.form.phone}</label><input type="tel" name="telefoon" /></div>
          </div>
          <div class="fg"><label>{page.form.message} *</label><textarea name="bericht" rows="4" required></textarea></div>
          <input type="hidden" name="taal" value={lang} />
          <input type="hidden" name="bron" value="subpagina" />
          <Mensencheck lang={lang} />
          <button type="submit" class="btn btn-primary">{page.form.submit}</button>
        </form>
      </div>
    </section>
  ) : (
    <section>
      <div class="wrap">
        {page.intro?.map((p) => <p style="color:var(--text);font-size:17px;max-width:820px;margin-bottom:14px">{p}</p>)}
        <div class="cards" style="margin-top:34px">
          {page.cards?.map((c) => (<div class="card"><h3>{c.h}</h3><p>{c.p}</p>{c.href && <a class="btn btn-primary" href={c.href} style="align-self:flex-start;margin-top:6px">{c.cta || cta.secondary}</a>}</div>))}
        </div>
      </div>
    </section>
  )}

  {page.slider && <LogoSlider lang={lang} heading={page.slider} />}

  <section class="cta">
    <div class="wrap">
      <h2>{cta.title}</h2>
      <p>{cta.text}</p>
      <div class="btns">
        <a href={demoHref} class="btn btn-primary">{cta.primary}</a>
        <a href={assessHref} class="btn btn-light">{cta.secondary}</a>
      </div>
    </div>
  </section>
</Base>
