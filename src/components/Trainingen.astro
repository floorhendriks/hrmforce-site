---
import LogoSlider from "./LogoSlider.astro";
import Img from "./Img.astro";
import { getLangFromUrl, localizePath } from "../i18n/utils.js";
import { trainingenFor } from "../data/trainingen-content.js";

const lang = getLangFromUrl(Astro.url);
const t = trainingenFor(lang);
const homeHref = localizePath("/", lang);
const adviesHref = localizePath("/advies/", lang);
const contactHref = localizePath("/contact/", lang);
const signupHref = lang === "nl" ? "/inschrijfformulier-trainingen/" : contactHref;
const cardHref = (nlHref) => (lang === "nl" ? nlHref : contactHref);
---
<div class="crumb">
  <div class="wrap"><a href={homeHref}>Home</a> &rsaquo; <a href={adviesHref}>{t.eyebrow}</a> &rsaquo; <span>{t.h1}</span></div>
</div>

<section class="ahero">
  <div class="wrap" style="display:block">
    <div class="eyebrow">{t.eyebrow}</div>
    <h1>{t.h1}</h1>
    <p style="color:#c4d2e6;font-size:19px;max-width:820px;margin-top:8px" set:html={t.lead}></p>
    <div class="btns" style="margin-top:16px">
      <a href={signupHref} class="btn btn-primary">{t.signupBtn}</a>
      <a href="#kalender" class="btn btn-light">{t.calBtn}</a>
    </div>
  </div>
</section>

<LogoSlider heading={t.slider} />

<section>
  <div class="wrap">
    <div class="explain">
      <div>
        <div class="eyebrow">{t.certEyebrow}</div>
        <h2 class="section-title">{t.certTitle}</h2>
        <p>{t.certP}</p>
        <p style="font-weight:700;color:var(--navy);margin-top:14px">{t.forWho}</p>
        <p>{t.forWhoP}</p>
        <p style="font-weight:700;color:var(--navy);margin-top:14px">{t.whatLabel}</p>
        <ul class="traits">{t.leerdoelen.map((d) => <li>{d}</li>)}</ul>
      </div>
      <div class="explain-fig">
        <Img src="/media/wp-content/uploads/2020/12/ass-afb2.png" alt="hrmforce" loading="lazy" />
      </div>
    </div>
  </div>
</section>

<section id="kalender" class="bg-soft">
  <div class="wrap">
    <div class="eyebrow">{t.certEyebrow}</div>
    <h2 class="section-title">{t.kalTitle}</h2>
    <p class="lead" style="margin-bottom:20px">{t.kalLead}</p>
    <div class="kal-wrap">
      <table class="kal">
        <thead><tr><th>{t.kalH.datum}</th><th>{t.kalH.training}</th><th>{t.kalH.deelnemers}</th><th>{t.kalH.locatie}</th><th>{t.kalH.prijs}</th></tr></thead>
        <tbody>
          {t.kalender.map((r) => (
            <tr>
              <td><strong>{r.datum}</strong><br /><span class="kal-sub">{r.tijd}</span></td>
              <td>{r.soort}</td>
              <td>{r.max}</td>
              <td class="kal-sub">{r.locatie}</td>
              <td><strong>{r.prijs}</strong></td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
    <div class="btns" style="margin-top:22px"><a href={signupHref} class="btn btn-primary">{t.kalBtn}</a></div>
  </div>
</section>

<section>
  <div class="wrap">
    <div class="eyebrow">{t.aanbodEyebrow}</div>
    <h2 class="section-title">{t.aanbodTitle}</h2>
    <div class="adv">
      {t.trainingen.map((tr) => (
        <div class="adv-block">
          <h3>{tr.h}</h3>
          <p>{tr.p}</p>
          <a class="btn btn-primary" href={cardHref(tr.nlHref)}>{t.forMoreInfo}</a>
        </div>
      ))}
    </div>
    <p style="color:var(--muted);font-size:15px;margin-top:20px">{t.aanbodNote} <a href={contactHref} style="color:var(--blue);font-weight:600">{t.contactWord}</a>.</p>
  </div>
</section>

<section class="cta">
  <div class="wrap">
    <h2>{t.ctaTitle}</h2>
    <p>{t.ctaText}</p>
    <div class="btns">
      <a href={signupHref} class="btn btn-primary">{t.ctaBtn1}</a>
      <a href={contactHref} class="btn btn-light">{t.ctaBtn2}</a>
    </div>
  </div>
</section>

<style>
  .adv { display: grid; grid-template-columns: repeat(3, 1fr); gap: 24px; margin-top: 28px; }
  .adv-block { background: #fff; border: 1px solid var(--line); border-radius: var(--radius); padding: 26px; box-shadow: var(--shadow-xs); display: flex; flex-direction: column; }
  .adv-block h3 { color: var(--navy); font-size: 19px; font-weight: 800; margin-bottom: 10px; }
  .adv-block p { color: var(--muted); font-size: 15px; margin-bottom: 18px; flex: 1; }
  .adv-block .btn { align-self: flex-start; }
  .kal-wrap { overflow-x: auto; }
  .kal { width: 100%; border-collapse: collapse; background: #fff; border: 1px solid var(--line); border-radius: var(--radius); overflow: hidden; }
  .kal th { text-align: left; background: var(--navy); color: #fff; font-size: 13px; text-transform: uppercase; letter-spacing: .5px; padding: 12px 14px; }
  .kal td { padding: 14px; border-top: 1px solid var(--line); font-size: 15px; color: var(--navy); vertical-align: top; }
  .kal-sub { color: var(--muted); font-size: 13.5px; }
  @media (max-width: 880px) { .adv { grid-template-columns: 1fr; } }
</style>
