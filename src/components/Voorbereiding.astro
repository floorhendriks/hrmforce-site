---
import { localizePath, sanitizeBodyLinks, demoPath } from "../i18n/utils.js";
import validPaths from "../data/valid-paths.js";
import { oefentests } from "../data/oefentests.js";
import { ONDERDELEN } from "../data/oefentest-ui.js";
const { t, lang } = Astro.props;
const contactHref = localizePath("/contact/", lang);
const demoHref = demoPath(lang);
const PREP_UI = {
  nl: { title: "Bereid je voor per test", intro: "Zoek je test en oefen met echte voorbeeldvragen. Zo weet je precies wat je kunt verwachten.", search: "Zoek je test...", none: "Geen test gevonden.", practice: "Oefen deze test" },
  en: { title: "Prepare per test", intro: "Find your test and practise with real example questions, so you know exactly what to expect.", search: "Search your test...", none: "No test found.", practice: "Practise this test" },
  de: { title: "Vorbereitung je Test", intro: "Finden Sie Ihren Test und üben Sie mit echten Beispielfragen, damit Sie genau wissen, was Sie erwartet.", search: "Test suchen...", none: "Kein Test gefunden.", practice: "Diesen Test üben" },
  fr: { title: "Préparez-vous par test", intro: "Trouvez votre test et entraînez-vous avec de vrais exemples de questions, pour savoir exactement à quoi vous attendre.", search: "Recherchez votre test...", none: "Aucun test trouvé.", practice: "S'entraîner à ce test" },
  es: { title: "Prepárate por test", intro: "Encuentra tu test y practica con preguntas de ejemplo reales, para saber exactamente qué esperar.", search: "Busca tu test...", none: "No se encontró el test.", practice: "Practica este test" },
  ro: { title: "Pregătește-te pe test", intro: "Găsește-ți testul și exersează cu întrebări exemplu reale, ca să știi exact la ce să te aștepți.", search: "Caută-ți testul...", none: "Niciun test găsit.", practice: "Exersează acest test" },
};
const prep = PREP_UI[lang] || PREP_UI.nl;
const prepTests = oefentests.map((o) => ({ slug: o.slug, name: (o.i18n[lang] || o.i18n.nl).name })).sort((a, b) => a.name.localeCompare(b.name));
const oefenBase = lang === "nl" ? "/oefenen/" : localizePath("/oefenen/", lang);
const BOOKS_NL = [
  { a: "Wim Bloemers", t: "De nieuwe assessmentgids (het psychologisch onderzoek)" },
  { a: "Wim Bloemers", t: "Het psychologisch onderzoek" },
  { a: "Wim Bloemers", t: "De assessmentgids compact" },
];
const BOOKS_EN = [
  { a: "Mike Bryon", t: "How to Pass Psychometric Tests" },
  { a: "Mark Parkinson", t: "How to Master Psychometric Tests" },
  { a: "Jim Barrett", t: "The Aptitude Test Workbook" },
];
const BOOK_UI = {
  nl: { eyebrow: "Boeken", title: "Boeken ter voorbereiding", intro: "Wil je je nog grondiger voorbereiden? Deze boeken helpen je vertrouwd raken met assessments, capaciteitentests en persoonlijkheidsvragenlijsten.", nlLabel: "Nederlandstalig", enLabel: "Engelstalig" },
  en: { eyebrow: "Books", title: "Books to prepare", intro: "Want to prepare even more thoroughly? These books help you get familiar with assessments, aptitude tests and personality questionnaires.", nlLabel: "In Dutch", enLabel: "In English" },
  de: { eyebrow: "Bücher", title: "Bücher zur Vorbereitung", intro: "Möchten Sie sich noch gründlicher vorbereiten? Diese Bücher helfen Ihnen, sich mit Assessments, Fähigkeitstests und Persönlichkeitsfragebögen vertraut zu machen.", nlLabel: "Niederländisch", enLabel: "Englisch" },
  fr: { eyebrow: "Livres", title: "Livres pour se préparer", intro: "Vous souhaitez vous préparer encore plus en profondeur ? Ces livres vous aident à vous familiariser avec les assessments, les tests d'aptitude et les questionnaires de personnalité.", nlLabel: "En néerlandais", enLabel: "En anglais" },
  es: { eyebrow: "Libros", title: "Libros para prepararte", intro: "¿Quieres prepararte aún más a fondo? Estos libros te ayudan a familiarizarte con los assessments, los tests de capacidad y los cuestionarios de personalidad.", nlLabel: "En neerlandés", enLabel: "En inglés" },
  ro: { eyebrow: "Cărți", title: "Cărți pentru pregătire", intro: "Vrei să te pregătești și mai temeinic? Aceste cărți te ajută să te familiarizezi cu assessment-urile, testele de aptitudini și chestionarele de personalitate.", nlLabel: "În neerlandeză", enLabel: "În engleză" },
};
const books = BOOK_UI[lang] || BOOK_UI.nl;
const OT_BLOK = {
  nl: { eyebrow:"Oefentest", title:"Doe de oefentest", intro:"Wil je een hele ronde achter elkaar maken? In de oefentest krijg je 25 willekeurige vragen, met daarna per vraag het juiste antwoord en de toelichting. Elke ronde is een nieuwe set.", cta:"Start de oefentest" },
  en: { eyebrow:"Practice test", title:"Take the practice test", intro:"Want to do a full round in one go? The practice test gives you 25 random questions, with the correct answer and an explanation per question afterwards. Every round is a new set.", cta:"Start the practice test" },
  de: { eyebrow:"Übungstest", title:"Machen Sie den Übungstest", intro:"Möchten Sie eine ganze Runde am Stück machen? Der Übungstest stellt 25 zufällige Fragen, danach sehen Sie je Frage die richtige Antwort und die Erläuterung. Jede Runde ist ein neuer Satz.", cta:"Übungstest starten" },
  fr: { eyebrow:"Test d'entraînement", title:"Faites le test d'entraînement", intro:"Envie de faire une série complète d'affilée ? Le test propose 25 questions au hasard, puis la bonne réponse et l'explication pour chacune. Chaque série est différente.", cta:"Démarrer le test" },
  es: { eyebrow:"Test de práctica", title:"Haz el test de práctica", intro:"¿Quieres hacer una ronda completa de una vez? El test te da 25 preguntas al azar y después, por pregunta, la respuesta correcta y la explicación. Cada ronda es un conjunto nuevo.", cta:"Empezar el test" },
  ro: { eyebrow:"Test de exersare", title:"Fă testul de exersare", intro:"Vrei o rundă completă dintr-o dată? Testul îți dă 25 de întrebări alese aleatoriu, iar la final vezi pentru fiecare răspunsul corect și explicația. Fiecare rundă este un set nou.", cta:"Începe testul" },
};
const otBlok = OT_BLOK[lang] || OT_BLOK.nl;
const otBase = lang === "nl" ? "/oefentest/" : localizePath("/oefentest/", lang);
const otOnderdelen = Object.values(ONDERDELEN).map((o) => ({
  slug: o.slug[lang] || o.slug.nl,
  naam: o.naam[lang] || o.naam.nl,
  lead: o.lead[lang] || o.lead.nl,
}));
const BODYUI = { nl: {ph:"Zoek in de voorbereiding...", none:"Niets gevonden voor deze zoekterm."}, en:{ph:"Search the preparation...", none:"Nothing found for this term."}, de:{ph:"In der Vorbereitung suchen...", none:"Nichts zu diesem Begriff gefunden."}, fr:{ph:"Rechercher dans la préparation...", none:"Rien trouvé pour ce terme."}, es:{ph:"Buscar en la preparación...", none:"No se encontró nada para este término."}, ro:{ph:"Caută în pregătire...", none:"Nimic găsit pentru acest termen."} }[lang] || {ph:"Zoek...", none:"Niets gevonden."};
---
<div class="crumb"><div class="wrap"><a href={localizePath("/", lang)}>Home</a> › <span>{t.crumb}</span></div></div>
<section class="ahero"><div class="wrap" style="display:block">
  <div class="eyebrow">{t.hero.eyebrow}</div>
  <h1>{t.hero.title}</h1>
</div></section>

<section><div class="wrap" style="display:block">
  <input type="search" id="prepBodySearch" class="prep-search" placeholder={BODYUI.ph} aria-label={BODYUI.ph} />
  <div class="kc-body" id="prepBody" set:html={sanitizeBodyLinks(t.body, lang, validPaths)}></div>
  <p class="prep-none" id="prepBodyNone" hidden>{BODYUI.none}</p>
</div></section>

<section class="bg-soft"><div class="wrap" style="display:block">
  <div class="eyebrow">{otBlok.eyebrow}</div>
  <h2 class="section-title">{otBlok.title}</h2>
  <p style="max-width:820px;color:var(--muted);margin-bottom:18px">{otBlok.intro}</p>
  <div class="ot-grid">
    {otOnderdelen.map((o) => (
      <a class="ot-card" href={`${otBase}${o.slug}/`}>
        <span class="ot-naam">{o.naam}</span>
        <span class="ot-lead">{o.lead}</span>
        <span class="ot-cta">{otBlok.cta} &rarr;</span>
      </a>
    ))}
  </div>
</div></section>

<section><div class="wrap" style="display:block">
  <div class="eyebrow">{prep.title}</div>
  <h2 class="section-title">{prep.title}</h2>
  <p style="max-width:820px;color:var(--muted);margin-bottom:18px">{prep.intro}</p>
  <input type="search" id="prepSearch" class="prep-search" placeholder={prep.search} aria-label={prep.search} />
  <div class="prep-grid" id="prepGrid">
    {prepTests.map((pt) => (
      <a class="prep-card" href={`${oefenBase}${pt.slug}/`} data-name={pt.name.toLowerCase()}>
        <span class="prep-name">{pt.name}</span>
        <span class="prep-link">{prep.practice} &rarr;</span>
      </a>
    ))}
  </div>
  <p class="prep-none" id="prepNone" hidden>{prep.none}</p>
</div></section>

<section><div class="wrap" style="display:block">
  <div class="eyebrow">{books.eyebrow}</div>
  <h2 class="section-title">{books.title}</h2>
  <p style="max-width:820px;color:var(--muted);margin-bottom:18px">{books.intro}</p>
  <div class="prep-books">
    <div class="pb-col">
      <h3 class="pb-h">{books.nlLabel}</h3>
      <ul class="pb-list">{BOOKS_NL.map((b) => (<li><span class="pb-title">{b.t}</span><span class="pb-author">{b.a}</span></li>))}</ul>
    </div>
    <div class="pb-col">
      <h3 class="pb-h">{books.enLabel}</h3>
      <ul class="pb-list">{BOOKS_EN.map((b) => (<li><span class="pb-title">{b.t}</span><span class="pb-author">{b.a}</span></li>))}</ul>
    </div>
  </div>
</div></section>

<section class="bg-soft"><div class="wrap">
  <div class="eyebrow">{t.contact.eyebrow}</div>
  <h2 class="section-title">{t.contact.title}</h2>
  <p style="max-width:820px;color:var(--muted);margin-bottom:20px">{t.contact.intro}</p>
  <ul class="contact-list">
    <li><strong>T:</strong> <a href="tel:+31888832188">+31 (0)88 88 321 88</a></li>
    <li><strong>E:</strong> <a href="mailto:service@hrmforce.com">service@hrmforce.com</a></li>
  </ul>
  <div class="btns" style="margin-top:20px">
    <a href={demoHref} class="btn btn-primary">{t.contact.cta}</a>
  </div>
</div></section>
<style>
  .kc-body{max-width:820px;line-height:1.7;color:#343434}
  .kc-body :global(mark){background:var(--gold,#fcc11b);color:#1a1a1a;padding:0 2px;border-radius:2px}
  .kc-body :global(h2){color:var(--navy,#0E468C);margin:28px 0 10px}
  .kc-body :global(h3){color:var(--navy,#0E468C);margin:22px 0 8px}
  .kc-body :global(p){margin:0 0 14px}
  .kc-body :global(ul),.kc-body :global(ol){margin:0 0 14px 22px}
  .kc-body :global(li){margin:6px 0}
  .kc-body :global(img){max-width:100%;height:auto;border-radius:var(--radius-sm);margin:14px 0}
  .kc-body :global(a){color:var(--blue,#4691CE)}
  .kc-body :global(.btn){color:#fff}
  .contact-list{list-style:none;margin:0;padding:0;font-size:17px;line-height:2}
  .contact-list a{color:var(--blue,#4691CE)}
    .prep-books{display:grid;grid-template-columns:1fr 1fr;gap:24px;max-width:920px}
  .pb-col{background:#fff;border:1px solid var(--line);border-radius:var(--radius);padding:20px 22px;box-shadow:var(--shadow-xs)}
  .pb-h{color:var(--navy);font-size:16px;font-weight:800;margin:0 0 12px}
  .pb-list{list-style:none;margin:0;padding:0}
  .pb-list li{padding:10px 0;border-top:1px solid var(--line)}
  .pb-list li:first-child{border-top:0}
  .pb-title{display:block;color:var(--text);font-weight:600;font-size:15px}
  .pb-author{display:block;color:var(--muted);font-size:13.5px;margin-top:2px}
  @media(max-width:760px){ .prep-books{grid-template-columns:1fr} }
  .prep-search{width:100%;max-width:420px;padding:11px 14px;border:1px solid var(--line);border-radius:var(--radius);font:inherit;font-size:15px;margin-bottom:16px}
  .prep-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:14px}
  .prep-card{display:flex;flex-direction:column;gap:8px;background:#fff;border:1px solid var(--line);border-radius:var(--radius);padding:16px 18px;text-decoration:none}
  .prep-card:hover{box-shadow:var(--shadow-sm)}
  .prep-name{color:var(--navy);font-weight:800;font-size:15px}
  .prep-link{color:var(--blue);font-weight:700;font-size:13.5px}
  .ot-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:14px;max-width:920px}
  .ot-card{display:flex;flex-direction:column;gap:8px;background:#fff;border:1px solid var(--line);border-radius:var(--radius);padding:20px 22px;text-decoration:none}
  .ot-card:hover{box-shadow:var(--shadow-sm)}
  .ot-naam{color:var(--navy);font-weight:800;font-size:17px}
  .ot-lead{color:var(--muted);font-size:14.5px;line-height:1.6}
  .ot-cta{color:var(--blue);font-weight:700;font-size:14px}
  @media(max-width:760px){.ot-grid{grid-template-columns:1fr}}
  .prep-none{color:var(--muted);text-align:center;padding:30px 0}
  @media(max-width:880px){.prep-grid{grid-template-columns:1fr 1fr}}
  @media(max-width:560px){.prep-grid{grid-template-columns:1fr}}
</style>

<script>
  (function () {
    const grid = document.getElementById("prepGrid");
    if (!grid) return;
    const cards = Array.from(grid.querySelectorAll(".prep-card"));
    const search = document.getElementById("prepSearch");
    const none = document.getElementById("prepNone");
    search.addEventListener("input", () => {
      const q = (search.value || "").trim().toLowerCase();
      let n = 0;
      cards.forEach((c) => { const ok = !q || (c.dataset.name || "").includes(q); c.style.display = ok ? "" : "none"; if (ok) n++; });
      none.hidden = n > 0;
    });
  })();
</script>

<script>
  (function () {
    var body = document.getElementById("prepBody");
    var inp = document.getElementById("prepBodySearch");
    var none = document.getElementById("prepBodyNone");
    if (!body || !inp) return;
    var blocks = Array.from(body.querySelectorAll("p, li, h2, h3, h4"));
    blocks.forEach(function (b) { b.dataset.orig = b.innerHTML; });
    var isH = function (b) { return /^H[2-4]$/.test(b.tagName); };
    var esc = function (x) { return x.replace(/[.*+?^${}()|[\]\\]/g, "\\$&"); };
    function restore() { blocks.forEach(function (b) { if (b.dataset.orig != null) b.innerHTML = b.dataset.orig; }); }
    function highlight(el, q) {
      var rx = new RegExp("(" + esc(q) + ")", "gi");
      var walker = document.createTreeWalker(el, NodeFilter.SHOW_TEXT, null);
      var nodes = [], n;
      while ((n = walker.nextNode())) { if (n.nodeValue && rx.test(n.nodeValue)) nodes.push(n); }
      nodes.forEach(function (node) {
        var span = document.createElement("span");
        span.innerHTML = node.nodeValue.replace(rx, "<mark>$1</mark>");
        node.parentNode.replaceChild(span, node);
      });
    }
    var run = function () {
      var q = (inp.value || "").trim();
      var ql = q.toLowerCase();
      restore();
      if (!ql) { blocks.forEach(function (b) { b.style.display = ""; }); none.hidden = true; return; }
      var matched = blocks.map(function (b) { return (b.textContent || "").toLowerCase().indexOf(ql) > -1; });
      var any = 0;
      blocks.forEach(function (b, i) {
        var show = matched[i];
        if (isH(b)) {
          for (var j = i + 1; j < blocks.length && !isH(blocks[j]); j++) { if (matched[j]) { show = true; break; } }
        }
        b.style.display = show ? "" : "none";
        if (show) { any++; if (matched[i]) highlight(b, q); }
      });
      none.hidden = any > 0;
    };
    inp.addEventListener("input", run);
  })();
</script>
