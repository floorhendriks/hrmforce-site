---
// Pagina "Assessment voor werkgevers" (patch 116). Tekst: src/data/werkgevers-content.js
import { localizePath, demoPath } from "../i18n/utils.js";
const { t, lang } = Astro.props;
const demoHref = demoPath(lang);
const overzichtHref = localizePath("/assessment-overzicht/", lang);
const tarievenHref = localizePath("/tarieven/", lang);
const shopHref = localizePath("/shop/", lang);
const faqLd = {
  "@context": "https://schema.org", "@type": "FAQPage",
  mainEntity: t.faq.items.map((f) => ({ "@type": "Question", name: f.q, acceptedAnswer: { "@type": "Answer", text: f.a } })),
};
---
<script type="application/ld+json" set:html={JSON.stringify(faqLd)} />
<div class="crumb"><div class="wrap"><a href={localizePath("/", lang)}>Home</a> › <span>{t.crumb}</span></div></div>

<section class="ahero"><div class="wrap" style="display:block">
  <div class="eyebrow">{t.hero.eyebrow}</div>
  <h1>{t.hero.title}</h1>
  <p style="color:rgba(255,255,255,.85);font-size:17px;max-width:760px;margin-top:12px">{t.hero.intro}</p>
  <div class="btns" style="margin-top:18px">
    <a href={demoHref} class="btn btn-primary">{t.hero.cta}</a>
    <a href={overzichtHref} class="btn btn-ghost" style="color:#fff;border-color:rgba(255,255,255,.6)">{t.hero.cta2}</a>
  </div>
  <p style="color:var(--gold);font-weight:700;font-size:14px;margin-top:14px">{t.hero.trust}</p>
</div></section>

<section class="bg-soft"><div class="wrap">
  <div class="eyebrow">{t.ways.eyebrow}</div>
  <h2 class="section-title">{t.ways.title}</h2>
  <div class="cards">
    {t.ways.items.map((w) => (
      <div class="card">
        <h3>{w.title}</h3>
        <p>{w.text}</p>
        <p style="margin-top:10px"><a href={localizePath(w.href, lang)} style="font-weight:700">{t.ways.more} &rarr;</a></p>
      </div>
    ))}
  </div>
</div></section>

<section><div class="wrap">
  <div class="eyebrow">{t.how.eyebrow}</div>
  <h2 class="section-title">{t.how.title}</h2>
  <ol class="wg-steps">
    {t.how.steps.map((s, i) => (<li><span class="wg-nr">{i + 1}</span><span>{s}</span></li>))}
  </ol>
</div></section>

<section class="bg-soft"><div class="wrap">
  <div class="eyebrow">{t.why.eyebrow}</div>
  <h2 class="section-title">{t.why.title}</h2>
  <ul class="wg-why">
    {t.why.items.map((w) => (<li>{w}</li>))}
  </ul>
</div></section>

<section><div class="wrap">
  <h2 class="section-title">{t.price.title}</h2>
  <p style="max-width:760px;font-size:17px">{t.price.text}</p>
  <div class="btns" style="margin-top:16px">
    <a href={shopHref} class="btn btn-primary">{t.price.shop}</a>
    <a href={tarievenHref} class="btn btn-ghost">{t.price.tarieven}</a>
  </div>
</div></section>

<section class="bg-soft"><div class="wrap">
  <h2 class="section-title">{t.faq.title}</h2>
  <div class="wg-faq">
    {t.faq.items.map((f) => (
      <details><summary>{f.q}</summary><p>{f.a}</p></details>
    ))}
  </div>
</div></section>

<section class="cta"><div class="wrap" style="padding:56px 0">
  <h2 style="color:#fff">{t.ctaBand.title}</h2>
  <p style="color:rgba(255,255,255,.9);max-width:620px;margin:12px auto 0">{t.ctaBand.text}</p>
  <div class="btns" style="justify-content:center;margin-top:20px">
    <a href={demoHref} class="btn btn-light">{t.ctaBand.primary}</a>
    <a href={tarievenHref} class="btn btn-ghost" style="color:#fff;border-color:rgba(255,255,255,.6)">{t.ctaBand.secondary}</a>
  </div>
</div></section>

<style>
  .wg-steps { list-style: none; padding: 0; margin: 22px 0 0; display: grid; gap: 14px; max-width: 820px; }
  .wg-steps li { display: flex; gap: 14px; align-items: flex-start; font-size: 17px; }
  .wg-nr { flex: 0 0 34px; height: 34px; border-radius: 50%; background: var(--navy, #1b3a6b); color: #fff; display: inline-flex; align-items: center; justify-content: center; font-weight: 700; }
  .wg-why { list-style: none; padding: 0; margin: 22px 0 0; display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 12px 28px; }
  .wg-why li { position: relative; padding-left: 28px; font-size: 16px; }
  .wg-why li::before { content: "\2713"; position: absolute; left: 0; top: 0; color: #1e8e3e; font-weight: 700; }
  .wg-faq { max-width: 820px; margin-top: 18px; }
  .wg-faq details { background: #fff; border: 1px solid #e1e6ee; border-radius: 8px; padding: 14px 18px; margin-bottom: 10px; }
  .wg-faq summary { cursor: pointer; font-weight: 700; }
  .wg-faq p { margin: 10px 0 0; }
</style>
