---
/**
 * Smalle band met de twee hulpmiddelen die nu diep in de site zitten:
 * de testkiezer en de ROI-rekentool. Geen kaarten, alleen haarlijnen,
 * zodat hij hoog op de pagina kan staan zonder een blok te worden.
 */
import Ico from "./Ico.astro";
import { localizePath } from "../i18n/utils.js";
import { HULPM_T_ALLE } from "../data/component-teksten.js";
const { lang = "nl" } = Astro.props;

const T_ALLE = HULPM_T_ALLE;
const T = T_ALLE[lang] ?? T_ALLE.nl;

const testHref = localizePath("/testkiezer/", lang);
const roiHref = localizePath("/roi-rekentool/", lang);
---
<section class="hulp">
  <div class="wrap hulp-grid">
    <a class="hulp-item" href={testHref}>
      <span class="hulp-ic"><Ico name="vragenlijst" size={26} /></span>
      <span class="hulp-txt">
        <span class="hulp-lbl">{T.lbl1}</span>
        <strong>{T.k1}</strong>
        <span class="hulp-sub">{T.t1}</span>
        <span class="hulp-cta">{T.c1} &rarr;</span>
      </span>
    </a>
    <a class="hulp-item" href={roiHref}>
      <span class="hulp-ic"><Ico name="groei" size={26} /></span>
      <span class="hulp-txt">
        <span class="hulp-lbl">{T.lbl2}</span>
        <strong>{T.k2}</strong>
        <span class="hulp-sub">{T.t2}</span>
        <span class="hulp-cta">{T.c2} &rarr;</span>
      </span>
    </a>
  </div>
</section>

<style>
  .hulp { border-top: 1px solid var(--line); border-bottom: 1px solid var(--line); padding: 0; }
  .hulp-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 0; }
  .hulp-item { display: flex; gap: 16px; align-items: flex-start; padding: 26px 28px 26px 0; text-decoration: none; color: inherit; }
  .hulp-item + .hulp-item { border-left: 1px solid var(--line); padding-left: 28px; }
  .hulp-ic { flex: none; color: var(--navy); border-left: 2px solid var(--gold); padding-left: 12px; display: flex; }
  .hulp-txt { display: flex; flex-direction: column; gap: 4px; min-width: 0; }
  .hulp-lbl { font-family: var(--font-mono); font-size: 11.5px; letter-spacing: .13em; text-transform: uppercase; color: var(--muted); }
  .hulp-item strong { font-family: var(--font-display); font-size: 1.05rem; font-weight: 700; color: var(--navy); line-height: 1.25; }
  .hulp-sub { color: var(--muted); font-size: 14.5px; line-height: 1.5; }
  .hulp-cta { font-weight: 600; font-size: 14.5px; color: var(--blue); margin-top: 4px; }
  .hulp-item:hover strong { color: var(--accent); }
  .hulp-item:hover .hulp-cta { color: var(--accent); }
  @media (max-width: 760px) {
    .hulp-grid { grid-template-columns: minmax(0, 1fr); }
    .hulp-item { padding: 22px 0; }
    .hulp-item + .hulp-item { border-left: 0; border-top: 1px solid var(--line); padding-left: 0; }
  }
</style>
