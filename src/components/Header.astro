---
import { routes, languages } from "../i18n/ui.js";
import { getLangFromUrl, useTranslations, navHref, switchLocalePath } from "../i18n/utils.js";
import { menuFor } from "../data/menu-content.js";
import validPaths from "../data/valid-paths.json";

const { active = "" } = Astro.props;
const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const logo = "https://hrmforce.com/wp-content/uploads/2022/03/HRM-LOGO.svg";

const assessmentsHref = navHref(routes.assessments, lang);
const shopHref = navHref(routes.shop, lang);
const solutionsHref = navHref(routes.solutions, lang);
const adviceHref = navHref(routes.advice, lang);
const otherLangs = Object.keys(languages).filter((c) => c !== lang);

// Submenu-items met per-taal vertaalde labels (paden blijven gelijk; navHref
// zet de juiste taalprefix erop of valt terug op NL waar nog niet vertaald).
const _menu = menuFor(lang);
const assessmentItems = _menu.assessments;
const solutionItems = _menu.solutions;
const adviceItems = _menu.advice;
const aboutItems = _menu.about;
const contactItems = _menu.contact;
---
<div class="topbar">
  <div class="wrap">
    <a class="login-btn" href="https://assessment.hrmforce.com/Login.aspx?LanguageCode=nl-NL">{t("topbar.login")}</a>
    <details class="langdd">
      <summary>{languages[lang]}<span class="caret">&#9662;</span></summary>
      <div class="langdd-menu">
        {otherLangs.map((code) => (
          <a href={switchLocalePath(Astro.url, code, validPaths)}>{languages[code]}</a>
        ))}
      </div>
    </details>
    <a class="demo-link" href={navHref(routes.contact, lang)}>{t("topbar.demo")} &rarr;</a>
  </div>
</div>
<header>
  <div class="wrap nav">
    <a class="logo" href={lang === "nl" ? "/" : "/" + lang + "/"}><img src={logo} alt="hrmforce" /></a>
    <nav class="menu">
      <div class={`has-dd ${active === "assessments" ? "active" : ""}`}>
        <a href={assessmentsHref}>{t("nav.assessments")}<span class="caret">&#9662;</span></a>
        <div class="dd">
          {assessmentItems.map((it) => (<a href={navHref(it.path, lang)}>{it.label}</a>))}
        </div>
      </div>
      <div class={`has-dd ${active === "solutions" ? "active" : ""}`}>
        <a href={solutionsHref}>{t("nav.solutions")}<span class="caret">&#9662;</span></a>
        <div class="dd">
          {solutionItems.map((it) => (<a href={navHref(it.path, lang)}>{it.label}</a>))}
        </div>
      </div>
      <div class={`has-dd ${active === "advice" ? "active" : ""}`}>
        <a href={adviceHref}>{t("nav.advice")}<span class="caret">&#9662;</span></a>
        <div class="dd">
          {adviceItems.map((it) => (<a href={navHref(it.path, lang)}>{it.label}</a>))}
        </div>
      </div>
      <div class={`has-dd ${active === "about" ? "active" : ""}`}>
        <a href={navHref(routes.about, lang)}>{t("nav.about")}<span class="caret">&#9662;</span></a>
        <div class="dd">
          {aboutItems.map((it) => (<a href={navHref(it.path, lang)}>{it.label}</a>))}
        </div>
      </div>
      <div class={`has-dd ${active === "contact" ? "active" : ""}`}>
        <a href={navHref(routes.contact, lang)}>{t("nav.contact")}<span class="caret">&#9662;</span></a>
        <div class="dd">
          {contactItems.map((it) => (<a href={navHref(it.path, lang)}>{it.label}</a>))}
        </div>
      </div>
    </nav>
    <div class="nav-cta">
      <a href={shopHref} class="btn btn-ghost">{t("cta.shop")}</a>
      <a href={navHref(routes.contact, lang)} class="btn btn-primary">{t("cta.demo")}</a>
    </div>
  </div>
</header>

<style>
  .langdd { position: relative; display: inline-block; margin: 0 14px; }
  .langdd > summary { list-style: none; cursor: pointer; color: #fff; opacity: .9; display: inline-flex; align-items: center; gap: 4px; font-weight: 600; }
  .langdd > summary::-webkit-details-marker { display: none; }
  .langdd .caret { font-size: .7em; }
  .langdd[open] > summary { opacity: 1; }
  .langdd-menu { position: absolute; top: 130%; left: 0; z-index: 60; background: #fff; border: 1px solid #e2e2e2; border-radius: 8px; box-shadow: 0 8px 24px rgba(0,0,0,.12); min-width: 70px; padding: 4px; }
  .langdd-menu a { display: block; padding: 7px 14px; color: #343434; text-decoration: none; font-weight: 600; border-radius: 6px; }
  .langdd-menu a:hover { background: #f1f5fb; color: var(--navy, #0E468C); }

  .has-dd { position: relative; display: inline-flex; align-items: center; }
  .has-dd > a .caret { font-size: .7em; margin-left: 4px; }
  .has-dd .dd { position: absolute; top: 100%; left: 0; z-index: 60; display: none; background: #fff; border: 1px solid #e2e2e2; border-radius: 8px; box-shadow: 0 8px 24px rgba(0,0,0,.12); min-width: 200px; padding: 6px; }
  .has-dd:hover .dd, .has-dd:focus-within .dd { display: block; }
  .has-dd .dd a { display: block; padding: 9px 14px; color: #343434; text-decoration: none; font-weight: 600; border-radius: 6px; white-space: nowrap; }
  .has-dd .dd a:hover { background: #f1f5fb; color: var(--navy, #0E468C); }

  .topbar .demo-link { color: #fff; font-weight: 600; }

  .topbar .login-btn {
    color: #fff;
    font-weight: 700;
    font-size: 15px;
    padding: 6px 16px;
    border: 1px solid rgba(255,255,255,.55);
    border-radius: 8px;
    line-height: 1;
    transition: background .15s, border-color .15s;
  }
  .topbar .login-btn:hover { background: rgba(255,255,255,.15); border-color: #fff; }
</style>
