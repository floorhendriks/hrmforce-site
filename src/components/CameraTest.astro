---
// Zelftest voor camera, microfoon, geluid, browser en netwerk. Alles draait in
// de browser van de kandidaat: er wordt niets opgenomen, verstuurd of bewaard.
import { localizePath } from "../i18n/utils.js";
import { voorbereidingContent } from "../data/voorbereiding-content.js";
const { t, lang } = Astro.props;
const voorbereidingHref = localizePath("/voorbereiding/", lang);
const contactHref = localizePath("/contact/", lang);
const contact = (voorbereidingContent[lang] || voorbereidingContent.nl).contact;
---
<div class="crumb"><div class="wrap">
  <a href={localizePath("/", lang)}>Home</a> › <a href={voorbereidingHref}>{(voorbereidingContent[lang] || voorbereidingContent.nl).crumb}</a> › <span>{t.crumb}</span>
</div></div>

<section class="ahero"><div class="wrap" style="display:block">
  <div class="eyebrow">{t.hero.eyebrow}</div>
  <h1>{t.hero.title}</h1>
  <p class="ct-lead">{t.hero.lead}</p>
</div></section>

<section><div class="wrap" style="display:block">
  <div class="ct-privacy">
    <h2 class="ct-privacy-h">{t.privacy.title}</h2>
    <ul class="ct-privacy-list">{t.privacy.items.map((i) => (<li>{i}</li>))}</ul>
  </div>

  <div class="ct-start">
    <button type="button" id="ctStart" class="btn btn-primary">{t.start.button}</button>
    <button type="button" id="ctStop" class="btn btn-ghost" hidden>{t.start.stop}</button>
    <p class="ct-hint" id="ctStartHint">{t.start.hint}</p>
  </div>

  <div class="ct-grid">
    <div class="ct-card">
      <div class="ct-kop"><h3>{t.camera.title}</h3><span class="ct-st" id="ctCamSt" data-st="wacht">{t.resultaat.nietGetest}</span></div>
      <div class="ct-video"><video id="ctVideo" playsinline autoplay muted></video><span class="ct-video-leeg" id="ctVideoLeeg">{t.camera.wacht}</span></div>
      <p class="ct-msg" id="ctCamMsg">{t.camera.hint}</p>
      <dl class="ct-feiten" id="ctCamFeiten" hidden>
        <dt>{t.camera.apparaat}</dt><dd id="ctCamNaam">-</dd>
        <dt>{t.camera.resolutie}</dt><dd id="ctCamRes">-</dd>
      </dl>
      <label class="ct-kies" id="ctCamKiesWrap" hidden>
        <span>{t.camera.kies}</span>
        <select id="ctCamKies"></select>
      </label>
    </div>

    <div class="ct-card">
      <div class="ct-kop"><h3>{t.mic.title}</h3><span class="ct-st" id="ctMicSt" data-st="wacht">{t.resultaat.nietGetest}</span></div>
      <p class="ct-msg" id="ctMicMsg">{t.mic.hint}</p>
      <div class="ct-meter" aria-hidden="true"><span id="ctMicBalk"></span></div>
      <p class="ct-meter-label">{t.mic.niveau}</p>
      <dl class="ct-feiten" id="ctMicFeiten" hidden>
        <dt>{t.mic.apparaat}</dt><dd id="ctMicNaam">-</dd>
      </dl>
      <label class="ct-kies" id="ctMicKiesWrap" hidden>
        <span>{t.mic.kies}</span>
        <select id="ctMicKies"></select>
      </label>
    </div>

    <div class="ct-card">
      <div class="ct-kop"><h3>{t.speaker.title}</h3><span class="ct-st" id="ctGelSt" data-st="wacht">{t.resultaat.nietGetest}</span></div>
      <p class="ct-msg" id="ctGelMsg">{t.speaker.hint}</p>
      <button type="button" id="ctToon" class="btn btn-ghost btn-sm">{t.speaker.play}</button>
      <div class="ct-vraag" id="ctGelVraag" hidden>
        <p>{t.speaker.vraag}</p>
        <div class="ct-vraag-knoppen">
          <button type="button" class="btn btn-ghost btn-sm" id="ctGelJa">{t.speaker.ja}</button>
          <button type="button" class="btn btn-ghost btn-sm" id="ctGelNee">{t.speaker.nee}</button>
        </div>
      </div>
    </div>

    <div class="ct-card">
      <div class="ct-kop"><h3>{t.systeem.title}</h3><span class="ct-st" id="ctSysSt" data-st="wacht">{t.resultaat.nietGetest}</span></div>
      <dl class="ct-feiten">
        <dt>{t.systeem.browser}</dt><dd id="ctSysBrowser">-</dd>
        <dt>{t.systeem.os}</dt><dd id="ctSysOs">-</dd>
        <dt>{t.systeem.scherm}</dt><dd id="ctSysScherm">-</dd>
        <dt>{t.systeem.verbinding}</dt><dd id="ctSysNet">-</dd>
      </dl>
      <p class="ct-msg" id="ctSysMsg"></p>
    </div>

    <div class="ct-card ct-card-net">
      <div class="ct-kop"><h3>{t.netwerk.title}</h3><span class="ct-st" id="ctNetSt" data-st="wacht">{t.resultaat.nietGetest}</span></div>
      <p class="ct-msg" id="ctNetMsg">{t.netwerk.hint}</p>
    </div>

    <div class="ct-card ct-card-res">
      <div class="ct-kop"><h3>{t.resultaat.title}</h3></div>
      <ul class="ct-res" id="ctRes"></ul>
      <button type="button" id="ctKopieer" class="btn btn-ghost btn-sm">{t.resultaat.kopieer}</button>
      <p class="ct-msg">{t.resultaat.hulp}</p>
    </div>
  </div>
</div></section>

<section class="bg-soft"><div class="wrap" style="display:block">
  <div class="ct-gidsen">
    <div class="ct-gids">
      <h2>{t.meet.title}</h2>
      <p>{t.meet.intro}</p>
      <ol>{t.meet.stappen.map((s) => (<li>{s}</li>))}</ol>
      <a class="ct-ext" href="https://meet.google.com/" target="_blank" rel="noopener noreferrer">{t.meet.linkLabel} &rarr;</a>
    </div>
    <div class="ct-gids">
      <h2>{t.teams.title}</h2>
      <p>{t.teams.intro}</p>
      <ol>{t.teams.stappen.map((s) => (<li>{s}</li>))}</ol>
      <p class="ct-note">{t.teams.note}</p>
      <a class="ct-ext" href="https://teams.microsoft.com/" target="_blank" rel="noopener noreferrer">{t.teams.linkLabel} &rarr;</a>
    </div>
  </div>
</div></section>

<section><div class="wrap" style="display:block">
  <h2 class="section-title">{t.tips.title}</h2>
  <ul class="ct-tips">{t.tips.items.map((i) => (<li>{i}</li>))}</ul>
  <div class="btns" style="margin-top:22px">
    <a href={voorbereidingHref} class="btn btn-ghost">&larr; {t.terug}</a>
  </div>
</div></section>

<section class="bg-soft"><div class="wrap">
  <div class="eyebrow">{contact.eyebrow}</div>
  <h2 class="section-title">{contact.title}</h2>
  <p style="max-width:820px;color:var(--muted);margin-bottom:20px">{contact.intro}</p>
  <ul class="ct-contact">
    <li><strong>T:</strong> <a href="tel:+31888832188">+31 (0)88 88 321 88</a></li>
    <li><strong>E:</strong> <a href="mailto:service@hrmforce.com">service@hrmforce.com</a></li>
  </ul>
  <div class="btns" style="margin-top:20px">
    <a href={contactHref} class="btn btn-primary">{contact.cta}</a>
  </div>
</div></section>

<style>
  [hidden]{display:none !important}
  .ct-lead{max-width:820px;color:#d7e2ef;font-size:17px;line-height:1.7;margin:10px 0 0}
  .ct-privacy{max-width:820px;background:var(--tint,#EEF4FA);border:1px solid var(--line);border-radius:var(--radius);padding:18px 22px}
  .ct-privacy-h{color:var(--navy);font-size:16px;font-weight:800;margin:0 0 10px}
  .ct-privacy-list{margin:0;padding-left:20px;color:#343434;font-size:14.5px;line-height:1.65}
  .ct-privacy-list li{margin:5px 0}
  .ct-start{margin:24px 0 8px;display:flex;flex-wrap:wrap;align-items:center;gap:12px}
  .ct-hint{color:var(--muted);font-size:14px;margin:0;flex:1 1 260px}
  .ct-grid{display:grid;grid-template-columns:repeat(2,1fr);align-items:start;gap:16px;margin-top:20px}
  .ct-card{background:#fff;border:1px solid var(--line);border-radius:var(--radius);padding:18px 20px;box-shadow:var(--shadow-xs)}
  .ct-kop{display:flex;align-items:center;justify-content:space-between;gap:12px;margin-bottom:10px}
  .ct-kop h3{color:var(--navy);font-size:17px;font-weight:800;margin:0}
  .ct-st{font-size:12.5px;font-weight:700;border-radius:999px;padding:3px 10px;white-space:nowrap}
  .ct-st[data-st="wacht"]{background:#EEF1F4;color:#5b6773}
  .ct-st[data-st="ok"]{background:#E6F4EA;color:#1E6B38}
  .ct-st[data-st="fout"]{background:#FBEAE6;color:#A33B2A}
  .ct-st[data-st="bezig"]{background:#FFF4D6;color:#7A5A00}
  .ct-video{position:relative;background:#101820;border-radius:var(--radius-sm,8px);aspect-ratio:16/9;overflow:hidden;display:flex;align-items:center;justify-content:center;margin-bottom:12px}
  .ct-video video{width:100%;height:100%;object-fit:cover;transform:scaleX(-1);display:none}
  .ct-video.aan video{display:block}
  .ct-video.aan .ct-video-leeg{display:none}
  .ct-video-leeg{color:#9fb0c0;font-size:14px;padding:0 16px;text-align:center}
  .ct-msg{color:#343434;font-size:14.5px;line-height:1.6;margin:10px 0 0}
  .ct-meter{height:14px;border-radius:999px;background:#EEF1F4;overflow:hidden;margin-top:12px}
  .ct-meter span{display:block;height:100%;width:0;background:var(--blue,#4691CE);transition:width .08s linear}
  .ct-meter-label{color:var(--muted);font-size:12.5px;margin:6px 0 0}
  .ct-feiten{display:grid;grid-template-columns:auto 1fr;gap:4px 14px;margin:12px 0 0;font-size:14px}
  .ct-feiten dt{color:var(--muted)}
  .ct-feiten dd{margin:0;color:#343434;overflow-wrap:anywhere}
  .ct-kies{display:block;margin-top:12px;font-size:13.5px;color:var(--muted)}
  .ct-kies select{display:block;width:100%;margin-top:5px;padding:9px 11px;border:1px solid var(--line);border-radius:var(--radius-sm,8px);font:inherit;font-size:14px;background:#fff}
  .btn-sm{padding:9px 16px;font-size:14px}
  .ct-vraag{margin-top:14px}
  .ct-vraag p{margin:0 0 8px;font-size:14.5px;color:#343434}
  .ct-vraag-knoppen{display:flex;flex-wrap:wrap;gap:8px}
  .ct-card-res,.ct-card-net{grid-column:1/-1}
  .ct-res{list-style:none;margin:0 0 14px;padding:0;font-size:14.5px}
  .ct-res :global(li){display:flex;flex-wrap:wrap;justify-content:space-between;gap:4px 14px;padding:9px 0;border-top:1px solid var(--line)}
  .ct-res :global(li:first-child){border-top:0}
  .ct-res :global(b){font-weight:600;color:#343434}
  .ct-res :global(span){font-weight:700;text-align:right}
  .ct-res :global(span[data-st="ok"]){color:#1E6B38}
  .ct-res :global(span[data-st="fout"]){color:#A33B2A}
  .ct-res :global(span[data-st="wacht"]),.ct-res :global(span[data-st="bezig"]){color:var(--muted)}
  .ct-gidsen{display:grid;grid-template-columns:1fr 1fr;gap:20px}
  .ct-gids{background:#fff;border:1px solid var(--line);border-radius:var(--radius);padding:22px 24px}
  .ct-gids h2{color:var(--navy);font-size:19px;margin:0 0 10px}
  .ct-gids p{color:#343434;font-size:15px;line-height:1.7;margin:0 0 12px}
  .ct-gids ol{margin:0 0 14px 20px;padding:0;color:#343434;font-size:15px;line-height:1.7}
  .ct-gids ol li{margin:7px 0}
  .ct-note{color:var(--muted);font-size:14px}
  .ct-ext{color:var(--blue);font-weight:700;font-size:14.5px;text-decoration:none}
  .ct-tips{max-width:820px;margin:0;padding-left:20px;color:#343434;font-size:15.5px;line-height:1.75}
  .ct-tips li{margin:8px 0}
  .ct-contact{list-style:none;margin:0;padding:0;font-size:17px;line-height:2}
  .ct-contact a{color:var(--blue,#4691CE)}
  @media(max-width:860px){.ct-grid{grid-template-columns:1fr}.ct-gidsen{grid-template-columns:1fr}}
</style>

<script is:inline define:vars={{ T: t }}>
  (function () {
    var $ = function (id) { return document.getElementById(id); };
    var startKnop = $("ctStart");
    if (!startKnop) return;

    var stroom = null, ctx = null, analyser = null, bron = null, lus = 0;
    var video = $("ctVideo"), videoVak = video.parentNode;
    var stand = { cam: "wacht", mic: "wacht", geluid: "wacht", sys: "wacht", net: "wacht" };
    var feit = { cam: "", mic: "", browser: "", os: "", scherm: "", verbinding: "" };
    var LABEL = { wacht: T.resultaat.nietGetest, ok: T.resultaat.okLabel, fout: T.resultaat.foutLabel, bezig: "..." };
    var CHIP = { cam: "ctCamSt", mic: "ctMicSt", geluid: "ctGelSt", sys: "ctSysSt", net: "ctNetSt" };
    var NAAM = { cam: T.camera.title, mic: T.mic.title, geluid: T.speaker.title, sys: T.systeem.title, net: T.netwerk.title };

    function zet(sleutel, waarde, bericht, berichtId) {
      stand[sleutel] = waarde;
      var chip = $(CHIP[sleutel]);
      if (chip) { chip.setAttribute("data-st", waarde); chip.textContent = LABEL[waarde] || ""; }
      if (bericht != null && berichtId) { var p = $(berichtId); if (p) p.textContent = bericht; }
      tekenResultaat();
    }

    function tekenResultaat() {
      var ul = $("ctRes");
      if (!ul) return;
      ul.innerHTML = "";
      ["cam", "mic", "geluid", "sys", "net"].forEach(function (k) {
        var li = document.createElement("li");
        var b = document.createElement("b");
        b.textContent = NAAM[k];
        var s = document.createElement("span");
        s.setAttribute("data-st", stand[k]);
        var extra = k === "cam" ? feit.cam : k === "mic" ? feit.mic : "";
        s.textContent = (LABEL[stand[k]] || "") + (extra && stand[k] === "ok" ? " (" + extra + ")" : "");
        li.appendChild(b); li.appendChild(s); ul.appendChild(li);
      });
    }

    // ---- browser, apparaat en webview -------------------------------------
    function browserInfo() {
      var ua = navigator.userAgent, m;
      if ((m = /Edg(?:iOS|A)?\/(\d+)/.exec(ua))) return { naam: "Microsoft Edge", versie: +m[1], min: 100 };
      if ((m = /OPR\/(\d+)/.exec(ua)) || (m = /OPiOS\/(\d+)/.exec(ua))) return { naam: "Opera", versie: +m[1], min: 86 };
      if ((m = /SamsungBrowser\/(\d+)/.exec(ua))) return { naam: "Samsung Internet", versie: +m[1], min: 16 };
      if ((m = /(?:Firefox|FxiOS)\/(\d+)/.exec(ua))) return { naam: "Firefox", versie: +m[1], min: 100 };
      if ((m = /CriOS\/(\d+)/.exec(ua))) return { naam: "Chrome", versie: +m[1], min: 100 };
      if ((m = /Chrome\/(\d+)/.exec(ua))) return { naam: "Chrome", versie: +m[1], min: 100 };
      if ((m = /Version\/(\d+)[\d.]*\s+(?:Mobile\/\S+\s+)?Safari/.exec(ua))) return { naam: "Safari", versie: +m[1], min: 15 };
      return { naam: "", versie: 0, min: 0 };
    }
    function osInfo() {
      var ua = navigator.userAgent, m;
      if (/Windows NT 10/.test(ua)) return "Windows 10/11";
      if (/Windows/.test(ua)) return "Windows";
      if (/Android (\d+)/.test(ua)) return "Android " + /Android (\d+)/.exec(ua)[1];
      if (/iPhone|iPod/.test(ua)) return "iOS" + ((m = /OS (\d+)_(\d+)/.exec(ua)) ? " " + m[1] + "." + m[2] : "");
      if (/iPad/.test(ua)) return "iPadOS" + ((m = /OS (\d+)_(\d+)/.exec(ua)) ? " " + m[1] + "." + m[2] : "");
      if (/CrOS/.test(ua)) return "ChromeOS";
      if (/Mac OS X (\d+)[_.](\d+)/.test(ua)) { m = /Mac OS X (\d+)[_.](\d+)/.exec(ua); return "macOS " + m[1] + "." + m[2]; }
      if (/Mac/.test(ua)) return "macOS";
      if (/Linux/.test(ua)) return "Linux";
      return T.systeem.onbekend;
    }
    function isWebview() {
      var ua = navigator.userAgent;
      if (/(FBAN|FBAV|FB_IAB|Instagram|Line\/|LinkedInApp|Twitter|Snapchat|Pinterest|MicroMessenger|WhatsApp|GSA\/|Outlook-)/i.test(ua)) return true;
      if (/;\s*wv\)/.test(ua)) return true;
      if (/iPhone|iPad|iPod/.test(ua) && !/Safari\//.test(ua) && !/CriOS|FxiOS|EdgiOS|OPiOS/.test(ua)) return true;
      return false;
    }
    function systeemCheck() {
      var b = browserInfo();
      feit.browser = b.naam ? b.naam + (b.versie ? " " + b.versie : "") : T.systeem.onbekend;
      feit.os = osInfo();
      feit.scherm = window.innerWidth + " x " + window.innerHeight;
      var c = navigator.connection || navigator.mozConnection || navigator.webkitConnection;
      feit.verbinding = c && c.effectiveType ? c.effectiveType : (navigator.onLine ? "online" : "offline");
      $("ctSysBrowser").textContent = feit.browser;
      $("ctSysOs").textContent = feit.os;
      $("ctSysScherm").textContent = feit.scherm;
      $("ctSysNet").textContent = feit.verbinding;
      if (!window.isSecureContext) { zet("sys", "fout", T.systeem.onveilig, "ctSysMsg"); return; }
      if (isWebview()) { zet("sys", "fout", T.systeem.webview, "ctSysMsg"); return; }
      if (b.min && b.versie && b.versie < b.min) { zet("sys", "fout", T.systeem.oud, "ctSysMsg"); return; }
      zet("sys", "ok", T.systeem.ok, "ctSysMsg");
    }

    // ---- netwerk ----------------------------------------------------------
    function netCheck() {
      zet("net", "bezig", T.netwerk.bezig, "ctNetMsg");
      if (!window.RTCPeerConnection) { zet("net", "fout", T.netwerk.fout, "ctNetMsg"); return; }
      var servers = ["stun:stun.cloudflare.com:3478", "stun:stun.l.google.com:19302"];
      var i = 0;
      (function probeer() {
        if (i >= servers.length) { zet("net", "fout", T.netwerk.fout, "ctNetMsg"); return; }
        var pc, klaar = false, timer;
        var af = function (gelukt) {
          if (klaar) return;
          klaar = true; clearTimeout(timer);
          try { pc.close(); } catch (e) {}
          if (gelukt) zet("net", "ok", T.netwerk.ok, "ctNetMsg");
          else { i++; probeer(); }
        };
        try { pc = new RTCPeerConnection({ iceServers: [{ urls: servers[i] }] }); }
        catch (e) { i++; return probeer(); }
        pc.onicecandidate = function (ev) {
          if (ev.candidate && / typ (srflx|prflx|relay)/.test(ev.candidate.candidate)) af(true);
        };
        try { pc.createDataChannel("hrmforce"); } catch (e) {}
        pc.createOffer().then(function (o) { return pc.setLocalDescription(o); }).catch(function () { af(false); });
        timer = setTimeout(function () { af(false); }, 6000);
      })();
    }

    // ---- camera en microfoon ----------------------------------------------
    function stopStroom() {
      if (lus) { cancelAnimationFrame(lus); lus = 0; }
      if (bron) { try { bron.disconnect(); } catch (e) {} bron = null; }
      if (ctx) { try { ctx.close(); } catch (e) {} ctx = null; analyser = null; }
      if (stroom) { stroom.getTracks().forEach(function (tr) { tr.stop(); }); stroom = null; }
      video.srcObject = null;
      videoVak.classList.remove("aan");
      $("ctMicBalk").style.width = "0";
    }

    function foutTekst(err) {
      var n = (err && err.name) || "";
      if (n === "NotAllowedError" || n === "SecurityError") return { cam: T.camera.geweigerd, mic: T.mic.geweigerd };
      if (n === "NotFoundError" || n === "OverconstrainedError") return { cam: T.camera.geen, mic: T.mic.geen };
      if (n === "NotReadableError" || n === "AbortError") return { cam: T.camera.bezet, mic: T.camera.bezet };
      return { cam: T.camera.fout, mic: T.camera.fout };
    }

    function vulKiezers() {
      if (!navigator.mediaDevices.enumerateDevices) return;
      navigator.mediaDevices.enumerateDevices().then(function (lijst) {
        [["videoinput", "ctCamKies", "ctCamKiesWrap"], ["audioinput", "ctMicKies", "ctMicKiesWrap"]].forEach(function (rij) {
          var apparaten = lijst.filter(function (d) { return d.kind === rij[0] && d.deviceId; });
          var sel = $(rij[1]), wrap = $(rij[2]);
          if (!sel) return;
          var huidig = sel.value;
          sel.innerHTML = "";
          apparaten.forEach(function (d, n) {
            var o = document.createElement("option");
            o.value = d.deviceId;
            o.textContent = d.label || (rij[0] === "videoinput" ? T.camera.title : T.mic.title) + " " + (n + 1);
            sel.appendChild(o);
          });
          var actief = stroom && stroom.getTracks().filter(function (tr) {
            return tr.kind === (rij[0] === "videoinput" ? "video" : "audio");
          })[0];
          var id = actief && actief.getSettings ? actief.getSettings().deviceId : "";
          sel.value = id || huidig || (apparaten[0] && apparaten[0].deviceId) || "";
          wrap.hidden = apparaten.length < 2;
        });
      }).catch(function () {});
    }

    function meetMic() {
      if (!analyser) return;
      var buf = new Uint8Array(analyser.fftSize);
      var piek = 0, stilSinds = Date.now();
      var tik = function () {
        if (!analyser) return;
        analyser.getByteTimeDomainData(buf);
        var som = 0;
        for (var i = 0; i < buf.length; i++) { var v = (buf[i] - 128) / 128; som += v * v; }
        var rms = Math.sqrt(som / buf.length);
        var pct = Math.min(100, Math.round(rms * 320));
        $("ctMicBalk").style.width = pct + "%";
        if (rms > 0.025) {
          piek = Math.max(piek, rms);
          if (stand.mic !== "ok") zet("mic", "ok", T.mic.ok, "ctMicMsg");
        } else if (stand.mic !== "ok" && Date.now() - stilSinds > 4000) {
          var p = $("ctMicMsg");
          if (p && p.textContent !== T.mic.stil) p.textContent = T.mic.stil;
        }
        lus = requestAnimationFrame(tik);
      };
      lus = requestAnimationFrame(tik);
    }

    function start(camId, micId) {
      if (!navigator.mediaDevices || !navigator.mediaDevices.getUserMedia) {
        zet("cam", "fout", T.systeem.webview, "ctCamMsg");
        zet("mic", "fout", T.systeem.webview, "ctMicMsg");
        return;
      }
      stopStroom();
      startKnop.disabled = true;
      startKnop.textContent = T.start.bezig;
      var eisen = {
        video: camId ? { deviceId: { exact: camId } } : { width: { ideal: 1280 }, height: { ideal: 720 } },
        audio: micId ? { deviceId: { exact: micId } } : true,
      };
      navigator.mediaDevices.getUserMedia(eisen).then(function (s) {
        stroom = s;
        startKnop.hidden = true;
        startKnop.disabled = false;
        startKnop.textContent = T.start.opnieuw;
        $("ctStop").hidden = false;
        $("ctStartHint").textContent = "";

        var vt = s.getVideoTracks()[0];
        if (vt) {
          video.srcObject = s;
          video.play().catch(function () {});
          videoVak.classList.add("aan");
          var toonBeeld = function () {
            var inst = vt.getSettings ? vt.getSettings() : {};
            var br = video.videoWidth || inst.width || 0, ho = video.videoHeight || inst.height || 0;
            feit.cam = br && ho ? br + "x" + ho : "";
            $("ctCamNaam").textContent = vt.label || T.systeem.onbekend;
            $("ctCamRes").textContent = feit.cam || T.systeem.onbekend;
            $("ctCamFeiten").hidden = false;
            zet("cam", br ? "ok" : "fout", br ? T.camera.hint : T.camera.fout, "ctCamMsg");
          };
          if (video.readyState >= 1) toonBeeld();
          else video.addEventListener("loadedmetadata", toonBeeld, { once: true });
        } else {
          zet("cam", "fout", T.camera.geen, "ctCamMsg");
        }

        var at = s.getAudioTracks()[0];
        if (at) {
          feit.mic = at.label || "";
          $("ctMicNaam").textContent = at.label || T.systeem.onbekend;
          $("ctMicFeiten").hidden = false;
          try {
            ctx = new (window.AudioContext || window.webkitAudioContext)();
            if (ctx.state === "suspended") ctx.resume();
            analyser = ctx.createAnalyser();
            analyser.fftSize = 1024;
            bron = ctx.createMediaStreamSource(s);
            bron.connect(analyser);
            zet("mic", "bezig", T.mic.hint, "ctMicMsg");
            meetMic();
          } catch (e) {
            zet("mic", "fout", T.camera.fout, "ctMicMsg");
          }
        } else {
          zet("mic", "fout", T.mic.geen, "ctMicMsg");
        }

        vulKiezers();
        if (stand.net === "wacht") netCheck();
      }).catch(function (err) {
        startKnop.disabled = false;
        startKnop.textContent = T.start.opnieuw;
        var tk = foutTekst(err);
        zet("cam", "fout", tk.cam, "ctCamMsg");
        zet("mic", "fout", tk.mic, "ctMicMsg");
        if (stand.net === "wacht") netCheck();
      });
    }

    startKnop.addEventListener("click", function () { start("", ""); });
    $("ctStop").addEventListener("click", function () {
      stopStroom();
      $("ctStop").hidden = true;
      startKnop.hidden = false;
      $("ctCamKiesWrap").hidden = true;
      $("ctMicKiesWrap").hidden = true;
      zet("cam", "wacht", T.camera.hint, "ctCamMsg");
      zet("mic", "wacht", T.mic.hint, "ctMicMsg");
    });
    $("ctCamKies").addEventListener("change", function () { start(this.value, $("ctMicKies").value); });
    $("ctMicKies").addEventListener("change", function () { start($("ctCamKies").value, this.value); });

    // ---- geluid -----------------------------------------------------------
    var toonBezig = false;
    $("ctToon").addEventListener("click", function () {
      if (toonBezig) return;
      var knop = this;
      var tc;
      try { tc = new (window.AudioContext || window.webkitAudioContext)(); }
      catch (e) { zet("geluid", "fout", T.speaker.nok, "ctGelMsg"); return; }
      toonBezig = true;
      knop.disabled = true;
      knop.textContent = T.speaker.bezig;
      zet("geluid", "bezig", T.speaker.hint, "ctGelMsg");
      var nu = tc.currentTime;
      var osc = tc.createOscillator(), gain = tc.createGain();
      osc.type = "sine";
      osc.frequency.setValueAtTime(440, nu);
      gain.gain.setValueAtTime(0.0001, nu);
      gain.gain.exponentialRampToValueAtTime(0.22, nu + 0.12);
      gain.gain.setValueAtTime(0.22, nu + 1.8);
      gain.gain.exponentialRampToValueAtTime(0.0001, nu + 2);
      osc.connect(gain); gain.connect(tc.destination);
      osc.start(nu); osc.stop(nu + 2.05);
      osc.onended = function () {
        try { tc.close(); } catch (e) {}
        toonBezig = false;
        knop.disabled = false;
        knop.textContent = T.speaker.play;
        $("ctGelVraag").hidden = false;
      };
    });
    $("ctGelJa").addEventListener("click", function () { zet("geluid", "ok", T.speaker.ok, "ctGelMsg"); $("ctGelVraag").hidden = true; });
    $("ctGelNee").addEventListener("click", function () { zet("geluid", "fout", T.speaker.nok, "ctGelMsg"); $("ctGelVraag").hidden = true; });

    // ---- resultaat kopiëren ------------------------------------------------
    $("ctKopieer").addEventListener("click", function () {
      var knop = this;
      var regels = ["hrmforce " + T.hero.title, new Date().toLocaleString(), ""];
      ["cam", "mic", "geluid", "net"].forEach(function (k) {
        var extra = k === "cam" ? feit.cam : k === "mic" ? feit.mic : "";
        regels.push(NAAM[k] + ": " + (LABEL[stand[k]] || "") + (extra && stand[k] === "ok" ? " (" + extra + ")" : ""));
      });
      regels.push(T.systeem.browser + ": " + feit.browser);
      regels.push(T.systeem.os + ": " + feit.os);
      regels.push(T.systeem.scherm + ": " + feit.scherm);
      regels.push(T.systeem.verbinding + ": " + feit.verbinding);
      regels.push("URL: " + location.href);
      var tekst = regels.join("\n");
      var klaar = function () {
        knop.textContent = T.resultaat.gekopieerd;
        setTimeout(function () { knop.textContent = T.resultaat.kopieer; }, 2500);
      };
      if (navigator.clipboard && navigator.clipboard.writeText) {
        navigator.clipboard.writeText(tekst).then(klaar).catch(function () { vangnet(tekst, klaar); });
      } else vangnet(tekst, klaar);
    });
    function vangnet(tekst, klaar) {
      var ta = document.createElement("textarea");
      ta.value = tekst;
      ta.setAttribute("readonly", "");
      ta.style.position = "fixed";
      ta.style.left = "-9999px";
      document.body.appendChild(ta);
      ta.select();
      try { document.execCommand("copy"); klaar(); } catch (e) {}
      document.body.removeChild(ta);
    }

    window.addEventListener("pagehide", stopStroom);
    systeemCheck();
    tekenResultaat();
  })();
</script>
