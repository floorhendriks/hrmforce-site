---
/** De te meten competenties van een functie, met het instrument dat ze meet. */
import { useT, path } from '../lib/i18n';
import { navHref } from '../i18n/utils.js';
import { constructById, instrumentInfo } from '../lib/hsf';
import Level from './Level.astro';
import { dlang } from '../lib/hsf-i18n';
import { vt } from '../lib/vocab';
interface Props { rows: any[]; lang: string; anchors?: boolean }
const { rows, lang, anchors = true } = Astro.props;
const t = useT(lang);
const dl = dlang(lang);
---
<div class="hsf-tablewrap">
  <table class="hsf-table">
    <thead>
      <tr>
        <th>{t('fn.competencies')}</th>
        <th class="num">{t('tbl.target')}</th>
        <th>{t('tbl.instrument')}</th>
        <th>{t('tbl.assessment')}</th>
        {anchors && <th>{t('tbl.anchor')}</th>}
      </tr>
    </thead>
    <tbody>
      {rows.map((r) => {
        const c = constructById(r.skill_id);
        return (
          <tr>
            <td>
              <a href={path(lang, 'skills', c.slug[dl])}><strong>{r.name[dl]}</strong></a>
              {r.competency_2014 && <div class="hsf-xs hsf-muted">{t('tbl.competency')}: {vt(r.competency_2014, dl)}</div>}
              {r.critical && <div><span class="hsf-badge stop">{t('tbl.critical')}</span></div>}
            </td>
            <td class="num"><Level value={r.target_level} lang={lang} label={false} /> <span class="hsf-xs">N{r.target_level}</span></td>
            <td class="hsf-xs">
              {r.instruments.length
                ? r.instruments.map((i: string, k: number) => {
                    const info = instrumentInfo(i);
                    const label = vt(i, dl);
                    return <>{k > 0 && ', '}<span class="hsf-nowrap">{info?.url ? <a href={navHref(info.url, lang)}>{label}</a> : label}</span></>;
                  })
                : '-'}
            </td>
            <td class="hsf-xs">{vt(r.assessment, dl)}</td>
            {anchors && <td class="anchor">{r.anchor[dl]}</td>}
          </tr>
        );
      })}
    </tbody>
  </table>
</div>
