---
// Detailpagina van een advies- of trainingsonderwerp, in elke taal dezelfde opbouw.
import Base from "../layouts/Base.astro";
import LogoSlider from "./LogoSlider.astro";
import ReviewSlider from "./ReviewSlider.astro";
import SocialProof from "./SocialProof.astro";
import PlanBlock from "./PlanBlock.astro";
import { adviesPlanFor, adviesRollenVoor } from "../data/advies-plan.js";
import { adviesUiVoor, planblokUiVoor } from "../data/detailpagina-ui.js";
import { localizePath, demoPath } from "../i18n/utils.js";

const { a } = Astro.props;
const lang = Astro.props.lang || "nl";
const t = adviesUiVoor(lang);
const pb = planblokUiVoor(lang);
const adviesHref = localizePath("/advies/", lang);
const plan = adviesPlanFor(a.slug, lang);
const roles = a.roles || adviesRollenVoor(lang);
---
<Base title={a.metaTitle} description={a.metaDescription} active="advice">
  <div class="crumb">
    <div class="wrap"><a href={localizePath("/", lang)}>{t.home}</a> › <a href={adviesHref}>{t.sectie}</a> › <span>{a.title}</span></div>
  </div>

  <section class="ahero">
    <div class="wrap">
      <div>
        <div class="eyebrow">{t.sectie}</div>
        <h1>{a.title}</h1>
        {a.intro.map((p) => <p style="color:rgba(255,255,255,.85);font-size:17px;margin-bottom:14px">{p}</p>)}
        <div class="btns">
          <a href={demoPath(lang)} class="btn btn-primary">{t.kennismaking}</a>
          <a href={localizePath("/tarieven/", lang)} class="btn btn-ghost" style="color:#fff;border-color:rgba(255,255,255,.45)">{t.tarieven}</a>
        </div>
        <p class="cta-note">{a.cta}</p>
      </div>
    </div>
  </section>

  <LogoSlider lang={lang} />

  <SocialProof lang={lang} tone="soft" />

  <section>
    <div class="wrap">
      <div class="eyebrow">{t.toelichting}</div>
      <h2 class="section-title">{a.title}</h2>
      <div class="explain">
        <div>
          {a.body.map((p) => <p>{p}</p>)}
          {a.bullets && a.bullets.length > 0 && (
            <ul class="traits">{a.bullets.map((b) => <li>{b}</li>)}</ul>
          )}
          <a href={demoPath(lang)} class="btn btn-primary" style="margin-top:14px">{t.kennismaking}</a>
        </div>
        <div class="pentagon">
          {a.image
            ? <img src={a.image} alt={a.title} loading="lazy" style="width:100%;border-radius:var(--radius);display:block;box-shadow:var(--shadow);aspect-ratio:4/3;object-fit:cover" />
            : <div class="ring"></div>}
          <p style="color:var(--muted);font-size:14px;margin-top:12px">{t.bijschrift}</p>
        </div>
      </div>
    </div>
  </section>

  <PlanBlock plan={plan} roles={roles} rolesEyebrow={pb.rolverdeling} hrmLabel={pb.hrm} orgLabel={pb.org} />

  <ReviewSlider headingKey="clients" />

  <section class="cta">
    <div class="wrap">
      <h2>{t.ctaTitel}</h2>
      <p>{t.ctaLead}</p>
      <div class="btns">
        <a href={demoPath(lang)} class="btn btn-primary">{t.kennismaking}</a>
        <a href={localizePath("/tarieven/", lang)} class="btn btn-light">{t.tarieven}</a>
      </div>
    </div>
  </section>
</Base>

<style>
  .cta-note { color:#c4d2e6; font-size:13.5px; margin-top:12px; max-width:520px; }
</style>
