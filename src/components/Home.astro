---
// Gedeelde homepage-component. Wordt per taal gevuld via `c` (content) + `lang`.
import { clients } from "../data/home.js";
import { localizePath, sanitizeBodyLinks } from "../i18n/utils.js";
import validPaths from "../data/valid-paths.js";
import LogoSlider from "./LogoSlider.astro";

const { c, lang } = Astro.props;
const lp = (p) => localizePath(p, lang);

const assessHref = lp("/online-assessments/");
const contactHref = lp("/contact/");
const overHref = lp("/over-ons/");
const casesHref = lp("/klantcases/");
const chooseSelect = lang === "nl" ? "/assessment-overzicht/?fase=selectie" : assessHref;
const chooseDevelop = lang === "nl" ? "/assessment-overzicht/?fase=ontwikkeling" : assessHref;

const vpIcons = {
  shield: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3l8 3v6c0 4.5-3.2 7.9-8 9-4.8-1.1-8-4.5-8-9V6z"/><path d="M9 12l2 2 4-4"/></svg>`,
  bolt: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"/></svg>`,
  globe: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"/><path d="M3 12h18M12 3c2.5 2.5 2.5 15 0 18M12 3c-2.5 2.5-2.5 15 0 18"/></svg>`,
  lock: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="4" y="11" width="16" height="10" rx="2"/><path d="M8 11V7a4 4 0 0 1 8 0v4"/></svg>`,
};

const reviews = c.reviews;
const TESTI = {
  nl: { eyebrow: "Wat klanten zeggen", title: "Vertrouwd door HR-teams en adviseurs", items: [
    { q: "De rapporten zijn meteen bruikbaar in ons selectiegesprek — geen vertaalslag meer nodig.", who: "HR-manager", org: "Zorgorganisatie, 300+ medewerkers" },
    { q: "Wetenschappelijk onderbouwd én praktisch. Onze recruiters werken er dagelijks mee.", who: "Recruitmentlead", org: "Technische dienstverlener" },
    { q: "Snel opgezet, meertalig en betrouwbaar. De ondersteuning denkt echt mee.", who: "L&D-adviseur", org: "Financiële sector" } ],
    itc: "hrmforce is lid van de International Test Commission (ITC) en werkt volgens de internationale richtlijnen voor verantwoord testgebruik." },
  en: { eyebrow: "What clients say", title: "Trusted by HR teams and consultants", items: [
    { q: "The reports are usable straight away in our selection interview — no translation needed.", who: "HR manager", org: "Healthcare organisation, 300+ staff" },
    { q: "Scientifically grounded and practical. Our recruiters use it every day.", who: "Recruitment lead", org: "Technical services provider" },
    { q: "Quick to set up, multilingual and reliable. Support really thinks along.", who: "L&D advisor", org: "Financial sector" } ],
    itc: "hrmforce is a member of the International Test Commission (ITC) and works to the international guidelines for responsible test use." },
  de: { eyebrow: "Was Kunden sagen", title: "Vertraut von HR-Teams und Beratern", items: [
    { q: "Die Berichte sind sofort im Auswahlgespräch nutzbar — ohne Übersetzung.", who: "HR-Managerin", org: "Gesundheitsorganisation, 300+ Mitarbeitende" },
    { q: "Wissenschaftlich fundiert und praktisch. Unsere Recruiter arbeiten täglich damit.", who: "Recruiting-Leiter", org: "Technischer Dienstleister" },
    { q: "Schnell eingerichtet, mehrsprachig und zuverlässig. Der Support denkt wirklich mit.", who: "L&D-Beraterin", org: "Finanzsektor" } ],
    itc: "hrmforce ist Mitglied der International Test Commission (ITC) und arbeitet nach den internationalen Richtlinien für verantwortungsvollen Testeinsatz." },
  fr: { eyebrow: "Ce que disent nos clients", title: "La confiance des équipes RH et consultants", items: [
    { q: "Les rapports sont directement exploitables lors de l'entretien — sans traduction.", who: "Responsable RH", org: "Organisation de santé, 300+ salariés" },
    { q: "Scientifique et pratique. Nos recruteurs l'utilisent chaque jour.", who: "Responsable recrutement", org: "Prestataire technique" },
    { q: "Mise en place rapide, multilingue et fiable. Le support est à l'écoute.", who: "Conseillère L&D", org: "Secteur financier" } ],
    itc: "hrmforce est membre de l'International Test Commission (ITC) et applique les directives internationales pour un usage responsable des tests." },
  es: { eyebrow: "Lo que dicen los clientes", title: "La confianza de equipos de RR. HH. y consultores", items: [
    { q: "Los informes se usan de inmediato en la entrevista — sin traducción.", who: "Responsable de RR. HH.", org: "Organización sanitaria, 300+ empleados" },
    { q: "Con base científica y práctica. Nuestros reclutadores lo usan a diario.", who: "Responsable de selección", org: "Proveedor técnico" },
    { q: "Rápido de configurar, multilingüe y fiable. El soporte se implica de verdad.", who: "Asesora de L&D", org: "Sector financiero" } ],
    itc: "hrmforce es miembro de la International Test Commission (ITC) y trabaja según las directrices internacionales para un uso responsable de los tests." },
  ro: { eyebrow: "Ce spun clienții", title: "De încredere pentru echipe HR și consultanți", items: [
    { q: "Rapoartele sunt utilizabile imediat în interviu — fără traducere.", who: "Manager HR", org: "Organizație medicală, 300+ angajați" },
    { q: "Fundamentat științific și practic. Recrutorii noștri îl folosesc zilnic.", who: "Lead recrutare", org: "Furnizor de servicii tehnice" },
    { q: "Rapid de configurat, multilingv și fiabil. Suportul chiar te ajută.", who: "Consultant L&D", org: "Sector financiar" } ],
    itc: "hrmforce este membru al International Test Commission (ITC) și lucrează conform ghidurilor internaționale pentru utilizarea responsabilă a testelor." },
};
const ti = TESTI[lang] || TESTI.nl;
const faqLd = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: c.faqs.map((f) => ({
    "@type": "Question",
    name: f.q,
    acceptedAnswer: { "@type": "Answer", text: f.a.replace(/<[^>]+>/g, "").replace(/\s+/g, " ").trim() },
  })),
};
---
<div class="sticky-cta" id="stickyCta" aria-hidden="true">
  <div class="wrap">
    <span class="sc-text"><b>hrmforce</b> — {c.sticky.text}</span>
    <div class="sc-btns">
      <a href={assessHref} class="sc-ghost">{c.sticky.ghost}</a>
      <a href={contactHref} class="btn btn-primary sc-primary">{c.sticky.primary} →</a>
    </div>
  </div>
</div>

<section class="hero">
  <span class="hero-blob gold" aria-hidden="true"></span>
  <span class="hero-blob blue" aria-hidden="true"></span>
  <div class="wrap">
    <div>
      <span class="eyebrow" style="color:var(--gold)">{c.hero.eyebrow}</span>
      <h1>{c.hero.h1pre}<em>{c.hero.h1em}</em>{c.hero.h1post}</h1>
      <p class="sub">{c.hero.sub}</p>
      <div class="hero-btns">
        <a class="btn btn-primary" href={contactHref}>{c.hero.ctaPrimary} →</a>
        <a class="btn btn-ghost hero-ghost" href={assessHref}>{c.hero.ctaGhost}</a>
      </div>
      <p class="hero-micro">{c.hero.micro}</p>
      <div class="hero-choose">
        <span>{c.hero.chooseLabel}</span>
        <a href={chooseSelect}>{c.hero.chooseSelect} →</a>
        <a href={chooseDevelop}>{c.hero.chooseDevelop} →</a>
      </div>
      <div class="hero-badges">
        {c.hero.badges.map((b) => <span class="hb"><span class="hb-ic">✓</span> {b}</span>)}
      </div>
      <a class="hero-trustlink" href={overHref}>{c.hero.trustlink} →</a>
    </div>

    <div class="hero-graphic">
      <div class="glass-card">
        <div class="glass-head"><span>{c.glass.head}</span><span class="live">{c.glass.live}</span></div>
        <div class="glass-stats">
          {c.glass.stats.map((s) => <div class="gs"><b>{s.b}</b><span>{s.label}</span></div>)}
        </div>
        <div class="glass-bars">
          {c.glass.bars.map((b) => <div class="gbar"><em>{b.label}</em><div class="gtrack"><div class="gfill" style={`--w:${b.w}`}></div></div></div>)}
        </div>
        <div class="glass-foot" set:html={sanitizeBodyLinks(c.glass.foot, lang, validPaths)}></div>
      </div>
    </div>
  </div>
</section>

<LogoSlider />



<section class="bg-soft">
  <div class="wrap" style="display:block">
    <span class="eyebrow center">{c.compare.eyebrow}</span>
    <h2 class="section-title center">{c.compare.title}</h2>
    <p class="lead center" style="margin:0 auto 40px">{c.compare.lead}</p>
    <div class="vs-grid">
      <div class="vs-card old">
        <h3>{c.compare.oldTitle}</h3>
        <ul>{c.compare.old.map((t) => <li><span class="vs-ic x">✕</span>{t}</li>)}</ul>
      </div>
      <div class="vs-card new">
        <span class="vs-tag">{c.compare.newTag}</span>
        <h3>{c.compare.newTitle}</h3>
        <ul>{c.compare.new.map((t) => <li><span class="vs-ic v">✓</span>{t}</li>)}</ul>
      </div>
    </div>
  </div>
</section>

<section>
  <div class="wrap" style="display:block">
    <span class="eyebrow center">{c.why.eyebrow}</span>
    <h2 class="section-title center">{c.why.title}</h2>
    <p class="lead center" style="margin:0 auto 40px">{c.why.lead}</p>
    <div class="value-grid">
      {c.valueProps.map((v) => (
        <div class="value-tile">
          <span class="value-ic" set:html={vpIcons[v.icon]}></span>
          <h3>{v.h}</h3>
          <p>{v.p}</p>
        </div>
      ))}
    </div>
  </div>
</section>

<section class="outcome">
  <div class="wrap">
    <p class="outcome-stat"><b>{c.outcome.statBold}</b> {c.outcome.statRest}</p>
    <p class="outcome-sub">{c.outcome.sub}</p>
  </div>
</section>

{c.casesTeaser && (
<section class="cases-teaser">
  <div class="wrap" style="display:block">
    <span class="eyebrow center">{c.casesTeaser.eyebrow}</span>
    <h2 class="section-title center">{c.casesTeaser.title}</h2>
    <p class="lead center" style="margin:0 auto 40px">{c.casesTeaser.lead}</p>
    <div class="ct-grid">
      {c.casesTeaser.highlights.map((h) => (
        <div class="ct-card">
          <span class="ct-sector">{h.sector}</span>
          <p class="ct-result">{h.result}</p>
        </div>
      ))}
    </div>
    <div class="center" style="margin-top:36px">
      <a class="btn btn-primary" href={casesHref}>{c.casesTeaser.linkLabel} →</a>
    </div>
  </div>
</section>
)}

<section>
  <div class="wrap" style="display:block">
    <span class="eyebrow center">{c.featured.eyebrow}</span>
    <h2 class="section-title center">{c.featured.title}</h2>
    <p class="lead center" style="margin:0 auto 40px">{c.featured.lead}</p>
    <div class="assess-grid">
      {c.featured.items.map((a) => (
        <a class="assess-card" href={lang === "nl" ? `/assessments/${a.slug}/` : assessHref}>
          <div class="assess-img"><img src={a.image} alt={a.title} loading="lazy" /></div>
          <div class="assess-body">
            <h3>{a.title}</h3>
            <p>{a.goal}</p>
            <span class="readmore">{c.featured.cardCta} →</span>
          </div>
        </a>
      ))}
    </div>
    <div class="center" style="margin-top:36px">
      <a class="btn btn-primary" href={assessHref}>{c.featured.allBtn}</a>
    </div>
  </div>
</section>

<section class="bg-soft">
  <div class="wrap" style="display:block">
    <span class="eyebrow center">{c.how.eyebrow}</span>
    <h2 class="section-title center">{c.how.title}</h2>
    <p class="lead center" style="margin:0 auto 44px">{c.how.lead}</p>
    <div class="how-steps">
      {c.how.steps.map((s, i) => (
        <div class="how-step">
          <div class="how-icon">
            {i === 0 && <svg width="26" height="26" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M9 11l3 3L22 4" stroke="#fff" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/><path d="M21 12v7a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11" stroke="#fff" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>}
            {i === 1 && <svg width="26" height="26" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2" stroke="#fff" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/><circle cx="9" cy="7" r="4" stroke="#fff" stroke-width="2"/><path d="M19 8v6M22 11h-6" stroke="#fff" stroke-width="2" stroke-linecap="round"/></svg>}
            {i === 2 && <svg width="26" height="26" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M3 3v18h18" stroke="#fff" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/><path d="M7 14l4-4 3 3 5-6" stroke="#fff" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>}
            <span class="how-num">{i + 1}</span>
          </div>
          <h3>{s.h}</h3>
          <p>{s.p}</p>
        </div>
      ))}
    </div>
    <div class="center" style="margin-top:44px">
      <a class="btn btn-primary" href={contactHref}>{c.hero.ctaPrimary}</a>
    </div>
  </div>
</section>

<section class="bg-soft testi">
  <div class="wrap" style="display:block">
    <span class="eyebrow center">{ti.eyebrow}</span>
    <h2 class="section-title center">{ti.title}</h2>
    <div class="testi-grid">
      {ti.items.map((t) => (
        <figure class="testi-card">
          <div class="tstars">★★★★★</div>
          <blockquote>“{t.q}”</blockquote>
          <figcaption><b>{t.who}</b><span>{t.org}</span></figcaption>
        </figure>
      ))}
    </div>
    <div class="itc-bar">
      <span class="itc-badge"><img src="https://images.weserv.nl/?url=www.intestcom.org/images/logo.png&output=webp&w=150&we" alt="International Test Commission (ITC)" loading="lazy" onerror="this.parentNode.classList.add('is-txt');this.remove();" /><em>ITC</em></span>
      <p>{ti.itc}</p>
    </div>
  </div>
</section>

<section class="blog">
  <div class="wrap" style="display:block;max-width:900px">
    <div class="eyebrow center">{c.faqSection.eyebrow}</div>
    <h2 class="section-title center">{c.faqSection.title}</h2>
    <p class="lead center" style="margin-bottom:32px">{c.faqSection.lead}</p>
    {c.faqs.map((f) => (
      <div class="faq-item">
        <div class="faq-q">{f.q}<span class="pl">+</span></div>
        <div class="faq-a"><p set:html={sanitizeBodyLinks(f.a, lang, validPaths)}></p></div>
      </div>
    ))}
  </div>
</section>

<section class="cta">
  <div class="wrap" style="display:block">
    <div class="eyebrow center" style="color:var(--gold)">{c.ctaBand.eyebrow}</div>
    <h2>{c.ctaBand.title}</h2>
    <p>{c.ctaBand.text}</p>
    <div class="btns">
      <a class="btn btn-light" href={contactHref}>{c.ctaBand.primary}</a>
      <a class="btn btn-ghost" href={assessHref} style="color:#fff;border-color:rgba(255,255,255,.5)">{c.ctaBand.ghost}</a>
    </div>
    <div class="trust">
      {c.ctaBand.trust.map((t) => <span>{t}</span>)}
    </div>
  </div>
</section>

<script type="application/ld+json" set:html={JSON.stringify(faqLd)} is:inline></script>

<script is:inline>
  (function () {
    var bar = document.getElementById("stickyCta");
    if (!bar) return;
    function onScroll() {
      if (window.scrollY > 560) { bar.classList.add("show"); bar.setAttribute("aria-hidden", "false"); }
      else { bar.classList.remove("show"); bar.setAttribute("aria-hidden", "true"); }
    }
    window.addEventListener("scroll", onScroll, { passive: true });
    onScroll();
  })();
</script>

<script define:vars={{ reviews }}>
  (function () {
    var text = document.getElementById("sp-text");
    var av = document.getElementById("sp-avatar");
    var nm = document.getElementById("sp-name");
    var dots = document.getElementById("sp-dots");
    if (!text || !dots || !reviews || reviews.length < 2) return;
    var fig = text.closest(".spotlight");
    var i = 0, timer;
    reviews.forEach(function (_, idx) {
      var b = document.createElement("button");
      b.className = "sp-dot" + (idx === 0 ? " on" : "");
      b.setAttribute("aria-label", "Review " + (idx + 1));
      b.addEventListener("click", function () { show(idx); restart(); });
      dots.appendChild(b);
    });
    function show(n) {
      i = n; var r = reviews[n];
      fig.style.opacity = 0;
      setTimeout(function () {
        text.textContent = "“" + r.text + "”";
        av.src = r.avatar; av.alt = r.name;
        nm.textContent = r.name; nm.href = r.href;
        Array.prototype.forEach.call(dots.children, function (d, idx) { d.classList.toggle("on", idx === n); });
        fig.style.opacity = 1;
      }, 260);
    }
    function restart() { clearInterval(timer); timer = setInterval(function () { show((i + 1) % reviews.length); }, 6000); }
    restart();
  })();
</script>

<style>
  .hero { position: relative; overflow: hidden; background: radial-gradient(1200px 520px at 12% -10%, #1a5bb0 0%, transparent 60%), radial-gradient(900px 520px at 100% 0%, #12539f 0%, transparent 55%), linear-gradient(160deg, var(--navy) 0%, var(--navy-deep) 100%); }
  .hero-blob { position: absolute; border-radius: 50%; filter: blur(70px); pointer-events: none; z-index: 0; }
  .hero-blob.gold { width: 300px; height: 300px; background: var(--gold); top: -70px; right: 8%; opacity: .24; }
  .hero-blob.blue { width: 360px; height: 360px; background: var(--blue); bottom: -140px; left: -50px; opacity: .3; }
  .hero .wrap { position: relative; z-index: 1; }
  .hero-btns { display: flex; gap: 14px; flex-wrap: wrap; margin: 28px 0 8px; }
  .hero-ghost { background: rgba(255,255,255,.06); color: #fff; border-color: rgba(255,255,255,.45); }
  .hero-ghost:hover { background: rgba(255,255,255,.14); color: #fff; border-color: #fff; }
  .hero-micro { color: #a9c0e0; font-size: 13.5px; margin-top: 12px; }
  .hero-badges { display: flex; gap: 16px; flex-wrap: wrap; margin-top: 24px; }
  .hb { display: inline-flex; align-items: center; gap: 8px; color: #dbe7f7; font-size: 13.5px; font-weight: 600; }
  .hb-ic { width: 24px; height: 24px; border-radius: 7px; background: rgba(255,255,255,.12); color: var(--gold); display: inline-flex; align-items: center; justify-content: center; font-size: 13px; font-weight: 800; }
  .hero-graphic { position: relative; }
  .glass-card { background: rgba(255,255,255,.09); border: 1px solid rgba(255,255,255,.18); border-radius: 22px; padding: 24px; backdrop-filter: blur(10px); box-shadow: 0 30px 60px rgba(8,30,60,.35); }
  .glass-head { display: flex; align-items: center; justify-content: space-between; color: #fff; font-weight: 700; font-size: 15px; margin-bottom: 16px; }
  .glass-head .live { font-size: 11px; font-weight: 700; color: #7ef0c0; display: flex; align-items: center; gap: 6px; }
  .glass-head .live::before { content: ""; width: 7px; height: 7px; border-radius: 50%; background: #7ef0c0; box-shadow: 0 0 0 4px rgba(126,240,192,.2); }
  .glass-stats { display: grid; grid-template-columns: repeat(3, 1fr); gap: 10px; margin-bottom: 18px; }
  .gs { background: rgba(255,255,255,.06); border-radius: 14px; padding: 14px 10px; text-align: center; }
  .gs b { display: block; font-size: 22px; font-weight: 800; color: #fff; line-height: 1; }
  .gs span { font-size: 11.5px; color: #bcd0ec; }
  .glass-bars { display: flex; flex-direction: column; gap: 10px; }
  .gbar { display: flex; align-items: center; gap: 10px; }
  .gbar em { font-style: normal; font-size: 12px; color: #cfe0f5; width: 100px; flex: none; }
  .gtrack { flex: 1; height: 8px; border-radius: 999px; background: rgba(255,255,255,.14); overflow: hidden; }
  .gfill { height: 100%; border-radius: 999px; background: linear-gradient(90deg, var(--gold), var(--accent)); width: 0; animation: gfill 1.1s cubic-bezier(.2,.7,.2,1) forwards; }
  @keyframes gfill { to { width: var(--w); } }
  .glass-foot { margin-top: 16px; padding-top: 14px; border-top: 1px solid rgba(255,255,255,.14); color: var(--gold); font-size: 12.5px; font-weight: 700; }
  .glass-foot :global(b) { color: #fff; }
  @media (prefers-reduced-motion: reduce) { .gfill { animation: none; width: var(--w); } }
  @media (max-width: 980px) { .hero-graphic { margin-top: 8px; } }
  .hero-choose { display: flex; flex-wrap: wrap; align-items: center; gap: 10px 16px; margin-top: 22px; }
  .hero-choose span { color: #a9c0e0; font-size: 13.5px; font-weight: 600; }
  .hero-choose a { color: #fff; font-weight: 700; font-size: 14px; border-bottom: 2px solid var(--gold); padding-bottom: 2px; }
  .hero-choose a:hover { color: var(--gold); }
  .sticky-cta { position: fixed; top: 0; left: 0; right: 0; z-index: 60; background: #fff; border-bottom: 1px solid var(--line); box-shadow: 0 6px 20px rgba(16,49,91,.1); transform: translateY(-100%); opacity: 0; transition: transform .28s ease, opacity .28s ease; }
  .sticky-cta.show { transform: none; opacity: 1; }
  .sticky-cta .wrap { display: flex; align-items: center; justify-content: space-between; gap: 16px; padding-top: 12px; padding-bottom: 12px; }
  .sc-text { color: var(--navy); font-size: 14.5px; }
  .sc-btns { display: flex; gap: 10px; align-items: center; flex: none; }
  .sc-ghost { color: var(--navy); font-weight: 700; font-size: 14px; white-space: nowrap; }
  .sc-ghost:hover { color: var(--accent); }
