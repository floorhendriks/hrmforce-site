---
// De pagina Advies, in elke taal dezelfde opbouw. De teksten komen uit
// src/data/advies-hub.js, de links worden per taal gezet.
import Base from "../layouts/Base.astro";
import LogoSlider from "./LogoSlider.astro";
import SocialProof from "./SocialProof.astro";
import PlanBlock from "./PlanBlock.astro";
import ReviewSlider from "./ReviewSlider.astro";
import { adviesHubVoor } from "../data/advies-hub.js";
import { adviesPlanFor, adviesRollenVoor } from "../data/advies-plan.js";
import { planblokUiVoor } from "../data/detailpagina-ui.js";
import { localizePath, demoPath } from "../i18n/utils.js";

const lang = Astro.props.lang || "nl";
const t = adviesHubVoor(lang);
const pb = planblokUiVoor(lang);

// Vaste indeling, gelijk aan de software-/oplossingenpagina's: hero, bewijs,
// gegroepeerde kaarten met icoon, stappenplan, rolverdeling, reviews, CTA.
const icons = {
  cap: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 10 12 5 2 10l10 5 10-5z"/><path d="M6 12v5c0 1 2.7 2.5 6 2.5s6-1.5 6-2.5v-5"/></svg>`,
  chat: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg>`,
  clip: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="7" y="3" width="10" height="4" rx="1"/><path d="M17 5h2a2 2 0 0 1 2 2v12a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V7a2 2 0 0 1 2-2h2"/><path d="M8 12l2 2 4-4"/></svg>`,
  star: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polygon points="12 2 15.1 8.6 22 9.6 17 14.4 18.2 21.3 12 18 5.8 21.3 7 14.4 2 9.6 8.9 8.6 12 2"/></svg>`,
  grid: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="7" height="7" rx="1"/><rect x="14" y="3" width="7" height="7" rx="1"/><rect x="3" y="14" width="7" height="7" rx="1"/><rect x="14" y="14" width="7" height="7" rx="1"/></svg>`,
  compass: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"/><polygon points="15.5 8.5 10.5 10.5 8.5 15.5 13.5 13.5 15.5 8.5"/></svg>`,
  users: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M22 21v-2a4 4 0 0 0-3-3.9"/></svg>`,
  route: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="6" cy="19" r="3"/><circle cx="18" cy="5" r="3"/><path d="M9 19h6a3 3 0 0 0 0-6H9a3 3 0 0 1 0-6h3"/></svg>`,
};
---
<Base title={t.meta.title} description={t.meta.description} active="advice">
  <div class="crumb">
    <div class="wrap"><a href={localizePath("/", lang)}>{t.crumb.home}</a> › <span>{t.crumb.hier}</span></div>
  </div>

  <section class="ahero">
    <div class="wrap" style="display:block">
      <div class="eyebrow">{t.hero.eyebrow}</div>
      <h1>{t.hero.title}</h1>
      <p style="color:#c4d2e6;font-size:19px;max-width:820px;margin-top:8px" set:html={t.hero.lead}></p>
      <div class="btns" style="margin-top:18px">
        <a href={demoPath(lang)} class="btn btn-primary">{t.hero.knop}</a>
        <a href={localizePath("/advies/trainingen/", lang)} class="btn btn-ghost" style="color:#fff;border-color:rgba(255,255,255,.45)">{t.hero.knop2}</a>
      </div>
      <p class="cta-note">{t.hero.note}</p>
    </div>
  </section>

  <LogoSlider lang={lang} heading={t.logoKop} />

  <SocialProof lang={lang} tone="soft" />

  {t.groups.map((g, gi) => (
    <section class={gi % 2 === 1 ? "bg-soft" : ""}>
      <div class="wrap" style="display:block">
        <div class="eyebrow">{g.eyebrow}</div>
        <h2 class="section-title">{g.title}</h2>
        <p class="lead" style="max-width:720px;margin:0 0 28px" set:html={g.lead}></p>
        <div class="advgrid">
          {g.items.map((it) => (
            <a class="advcard" href={localizePath(it.href, lang)}>
              <span class="advic" set:html={icons[it.icon]}></span>
              <h3>{it.h}</h3>
              <p>{it.p}</p>
              <span class="readmore">{it.cta} &rarr;</span>
            </a>
          ))}
        </div>
      </div>
    </section>
  ))}

  <PlanBlock plan={adviesPlanFor("", lang)} roles={adviesRollenVoor(lang)} rolesEyebrow={pb.rolverdeling} hrmLabel={pb.hrm} orgLabel={pb.org} />

  <ReviewSlider headingKey="clients" />

  <section class="cta">
    <div class="wrap">
      <h2>{t.cta.title}</h2>
      <p>{t.cta.lead}</p>
      <div class="btns">
        <a href={demoPath(lang)} class="btn btn-primary">{t.cta.knop}</a>
        <a href={localizePath("/tarieven/", lang)} class="btn btn-light">{t.cta.tarieven}</a>
      </div>
    </div>
  </section>
</Base>

<style>
  .cta-note { color:#c4d2e6; font-size:13.5px; margin-top:12px; max-width:560px; }
  .advgrid { display:grid; grid-template-columns:repeat(3,1fr); gap:22px; }
  .advcard { display:flex; flex-direction:column; background:#fff; border:1px solid var(--line); border-radius:var(--radius); padding:26px 24px; box-shadow:var(--shadow-xs); text-decoration:none; color:inherit; transition:transform .2s ease, box-shadow .2s ease, border-color .2s ease; }
  .advcard:hover { border-color:var(--navy); box-shadow:var(--shadow-md); border-color:var(--line-strong); }
  .advic { width:50px; height:50px; border-radius:0; background:transparent; color:var(--navy); display:inline-flex; align-items:center; justify-content:center; margin-bottom:14px; border-left:2px solid var(--gold);padding-left:12px;width:auto;justify-content:flex-start;}
  .advic :global(svg) { width:25px; height:25px; }
  .advcard h3 { color:var(--navy); font-size:1.12rem; margin:0 0 8px; line-height:1.3; }
  .advcard p { color:var(--muted); font-size:14.5px; line-height:1.6; margin:0 0 16px; flex:1; }
  .advcard .readmore { color:var(--accent); font-weight:700; font-size:14px; }
  section p a { color:var(--blue); font-weight:600; }
  .ahero p a { color:#fff; font-weight:700; border-bottom:1px solid var(--gold); }
  @media (max-width:980px) { .advgrid { grid-template-columns:1fr 1fr; } }
  @media (max-width:640px) { .advgrid { grid-template-columns:1fr; } }
  @media (prefers-reduced-motion: reduce) { .advcard:hover { transform:none; } }
</style>
