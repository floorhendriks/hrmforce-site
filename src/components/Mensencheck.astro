---
/* Spamcontrole voor alle formulieren. Drie lagen:
   1. een verborgen veld dat alleen een bot invult
   2. de tijd tussen openen en verzenden; onder de drie seconden is het geen mens
   3. het vakje van Cloudflare Turnstile, zodra de sleutels zijn ingesteld
   Zonder sleutels blijven laag 1 en 2 gewoon werken en ziet de bezoeker niets
   extra's. De server controleert alle drie; hier staat alleen wat de bezoeker
   nodig heeft. */
import { MENS_UI } from "../data/mensencheck-tekst.js";
import { TURNSTILE_SITE_KEY } from "../data/turnstile.js";
import { MENSCHK_TAAL } from "../data/component-teksten.js";
const { lang = "nl" } = Astro.props;
const u = MENS_UI[lang] || MENS_UI.nl;
const siteKey = TURNSTILE_SITE_KEY;
const TAAL = MENSCHK_TAAL;
---
<div class="mc-val" aria-hidden="true">
  <label for={`mc-web-${lang}`}>{u.val}</label>
  <input id={`mc-web-${lang}`} type="text" name="website" tabindex="-1" autocomplete="off" />
</div>
<input type="hidden" name="gestart" value="" />
{siteKey && (
  <div class="mc-vak cf-turnstile" data-sitekey={siteKey} data-language={TAAL[lang] || "nl"} data-theme="light" data-size="flexible" data-traag={u.traag}></div>
)}
{siteKey && (
  <script is:inline>
    if (!window.__mcTurnstile) {
      window.__mcTurnstile = true;
      var mcS = document.createElement("script");
      mcS.src = "https://challenges.cloudflare.com/turnstile/v0/api.js";
      mcS.async = true;
      mcS.defer = true;
      document.head.appendChild(mcS);
    }
  </script>
)}

<style is:global>
  .mc-val { position: absolute !important; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); clip-path: inset(50%); white-space: nowrap; }
  .mc-vak { margin: 0 0 14px; max-width: 320px; }
  .vv-form .mc-vak { flex-basis: 100%; margin: 4px 0 0; }
  .dm-form .mc-vak { margin: 0 0 16px; }
  .mc-melding { margin: 12px 0 0; font-size: 14px; font-weight: 600; line-height: 1.45; }
  .mc-melding.ok { color: #1a7f4b; }
  .mc-melding.fout { color: #b3261e; }
  .pm-req .mc-melding, .gvz-form .mc-melding { color: #fff; }
  .pm-req .mc-melding.fout, .gvz-form .mc-melding.fout { color: #ffd4cf; }
</style>

<script>
  (function () {
    /* Zet het starttijdstip zodra de pagina er staat. Een bot die het formulier
       rechtstreeks post heeft dit veld niet ingevuld. */
    function stempel() {
      document.querySelectorAll('input[name="gestart"]').forEach(function (i) {
        if (!i.value) i.value = String(Date.now());
      });
    }
    if (document.readyState === "loading") document.addEventListener("DOMContentLoaded", stempel);
    else stempel();

    /* Turnstile heeft na het laden van de pagina een paar tellen nodig. Wie
       sneller klaar is met invullen dan het vakje met verifieren, zou anders
       een afwijzing krijgen. Deze afhandeling loopt voor die van de pagina
       zelf, houdt het verzenden even vast en probeert het daarna opnieuw. */
    var WACHT_MS = 8000;
    document.addEventListener("submit", function (ev) {
      var form = ev.target;
      if (!form || !form.querySelector) return;
      var vak = form.querySelector(".cf-turnstile");
      if (!vak) return;
      if (form.dataset.mcGewacht === "1") return;
      var veld = function () { return form.querySelector('input[name="cf-turnstile-response"]'); };
      var nu = veld();
      if (nu && nu.value) return;
      ev.preventDefault();
      ev.stopPropagation();
      var knop = form.querySelector("button[type=submit], input[type=submit]");
      if (knop) knop.disabled = true;
      var regel = form.querySelector(".mc-wacht");
      if (!regel) {
        regel = document.createElement("p");
        regel.className = "mc-melding mc-wacht";
        vak.parentNode.insertBefore(regel, vak.nextSibling);
      }
      regel.textContent = vak.dataset.traag || "";
      var tot = Date.now() + WACHT_MS;
      var tik = setInterval(function () {
        var v = veld();
        if ((v && v.value) || Date.now() > tot) {
          clearInterval(tik);
          regel.textContent = "";
          if (knop) knop.disabled = false;
          form.dataset.mcGewacht = "1";
          if (form.requestSubmit) form.requestSubmit(knop || undefined);
          else form.dispatchEvent(new Event("submit", { bubbles: true, cancelable: true }));
          setTimeout(function () { delete form.dataset.mcGewacht; }, 0);
        }
      }, 200);
    }, true);

    /* Een token is eenmalig. Elk formulier dat na een geslaagde verzending
       reset() aanroept krijgt hier een vers vakje en een nieuw starttijdstip. */
    document.addEventListener("reset", function (ev) {
      var form = ev.target;
      if (!form || !form.querySelectorAll) return;
      setTimeout(function () {
        stempel();
        if (!window.turnstile) return;
        form.querySelectorAll(".cf-turnstile").forEach(function (vak) {
          try { window.turnstile.reset(vak); } catch (e) {}
        });
      }, 0);
    });

    /* Afhandeling voor de formulieren die hiervoor rechtstreeks naar Formspree
       gingen. Formulieren met een eigen script doen niet mee. */
    document.addEventListener("submit", function (ev) {
      var form = ev.target;
      if (!form || !form.matches || !form.matches("form[data-mensform]")) return;
      if (ev.defaultPrevented) return;
      ev.preventDefault();
      var knop = form.querySelector("button[type=submit], input[type=submit]");
      var melding = form.querySelector(".mc-melding");
      if (!melding) {
        melding = document.createElement("p");
        melding.className = "mc-melding";
        form.appendChild(melding);
      }
      var oud = knop ? knop.textContent : "";
      if (knop) { knop.disabled = true; knop.textContent = form.dataset.bezig || "..."; }
      melding.className = "mc-melding";
      melding.textContent = "";
      fetch(form.getAttribute("action"), {
        method: "POST", body: new FormData(form), headers: { Accept: "application/json" },
      })
        .then(function (r) { return r.json().catch(function () { return {}; }); })
        .then(function (uit) {
          if (knop) { knop.disabled = false; knop.textContent = oud; }
          if (uit && uit.ok) {
            /* Pas nu is het een aanvraag. De meting in Base.astro luistert
               hierop, zodat een verzending die de controle of de server afkeurt
               geen conversie oplevert. form.reset() wist de velden, dus de
               gegevens gaan eerst mee. */
            if (window.hrmAanvraagGelukt) window.hrmAanvraagGelukt(form);
            form.reset();
            stempel();
            melding.className = "mc-melding ok";
            melding.textContent = form.dataset.ok || "";
          } else {
            melding.className = "mc-melding fout";
            melding.textContent = (uit && uit.error === "geen_mens") ? (form.dataset.mensfout || "") : (form.dataset.fout || "");
          }
        })
        .catch(function () {
          if (knop) { knop.disabled = false; knop.textContent = oud; }
          melding.className = "mc-melding fout";
          melding.textContent = form.dataset.fout || "";
        });
    });
  })();
</script>
