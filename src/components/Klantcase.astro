---
// Losse casepagina onder /klantcases/<slug>/.
import { localizePath, localizeExisting, demoPath } from "../i18n/utils.js";
import validPaths from "../data/valid-paths.js";
import { assessments } from "../data/assessments.js";
import { ovContent } from "../data/overzicht-content.js";
const { c, lang } = Astro.props;
const casesHref = localizeExisting("/klantcases/", lang, validPaths);
const sectorHref = localizeExisting(`/sectoren/${c.sectorKey}/`, lang, validPaths);
const demoHref = demoPath(lang);
// De titel in de taal van de pagina. ovContent heeft per taal een eigen lijst;
// assessments.js is Nederlands en is alleen de terugval.
const TITELS = Object.fromEntries(
  ((ovContent[lang] || ovContent.nl).items || []).map((i) => [i.slug, i.title])
);
const titelVan = (pad) => {
  const slug = pad.split("/").filter(Boolean).pop();
  if (TITELS[slug]) return TITELS[slug];
  const a = assessments.find((x) => x.slug === slug);
  return a ? a.title : slug.replace(/-/g, " ");
};
const instrumenten = c.instrumenten.map((p) => ({
  href: localizeExisting(p, lang, validPaths),
  titel: titelVan(p),
}));
---
<div class="crumb"><div class="wrap">
  <a href={localizePath("/", lang)}>Home</a> › <a href={casesHref}>{c.ui.terug.replace(/^.*?\s/, "")}</a> › <span>{c.thema}</span>
</div></div>

<section class="ahero"><div class="wrap" style="display:block">
  <div class="eyebrow">{c.thema} · {c.omvang}</div>
  <h1>{c.titel}</h1>
  <p class="kc-lead">{c.ui.intro}</p>
</div></section>

<section><div class="wrap" style="display:block">
  <div class="kc-body">
    <h2 class="section-title">{c.labels.challenge}</h2>
    <p>{c.challenge}</p>
    <h2 class="section-title">{c.labels.approach}</h2>
    <p>{c.approach}</p>
    <h2 class="section-title">{c.labels.results}</h2>
    <ul class="kc-res">{c.results.map((r) => (<li>{r}</li>))}</ul>
  </div>
</div></section>

<section class="bg-soft"><div class="wrap" style="display:block">
  <h2 class="section-title">{c.ui.instrumenten}</h2>
  <div class="kc-rij">
    {instrumenten.map((i) => (<a class="kc-knop" href={i.href}>{i.titel} &rarr;</a>))}
  </div>
  <div class="btns" style="margin-top:24px">
    <a href={sectorHref} class="btn btn-ghost">{c.ui.meer} &rarr;</a>
    <a href={casesHref} class="btn btn-ghost">&larr; {c.ui.terug}</a>
  </div>
</div></section>

<section class="cta"><div class="wrap" style="display:block">
  <h2 class="section-title">{c.ui.verder}</h2>
  <div class="btns">
    <a href={demoHref} class="btn btn-primary">{c.thema}</a>
  </div>
</div></section>

<style>
  .kc-lead{max-width:820px;color:#d7e2ef;font-size:17px;line-height:1.7;margin:10px 0 0}
  .kc-body{max-width:820px;color:#343434;font-size:16.5px;line-height:1.75}
  .kc-body p{margin:0 0 18px}
  .kc-body .section-title{margin-top:26px}
  .kc-res{margin:0;padding-left:20px}
  .kc-res li{margin:8px 0}
  .kc-rij{display:flex;flex-wrap:wrap;gap:10px;max-width:920px}
  .kc-knop{display:inline-block;background:#fff;border:1px solid var(--line);border-radius:var(--radius-pill);padding:10px 18px;color:var(--navy);font-weight:700;font-size:14.5px;text-decoration:none}
  .kc-knop:hover{border-color:var(--navy)}
</style>
