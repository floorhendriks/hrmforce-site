---
<div class="crumb">
  <div class="wrap"><a href={localizePath("/", lang)}>Home</a> › <span>{c.crumb}</span></div>
</div>

<section class="ahero">
  <div class="wrap" style="display:block">
    <div class="eyebrow" style="color:var(--gold)">{c.hero.eyebrow}</div>
    <h1>{c.hero.title}</h1>
    <p style="color:#c4d2e6;font-size:19px;max-width:840px;margin-top:8px">{c.hero.intro}</p>
    <div class="btns"><a class="btn btn-primary" href={overzichtHref}>{c.hero.cta}</a></div>
  </div>
</section>

<section>
  <div class="wrap">
    <div class="explain">
      <div>
        <div class="eyebrow">{c.why.eyebrow}</div>
        <h2 class="section-title">{c.why.title}</h2>
        <p>{c.why.body}</p>
      </div>
      <div>
        <img src="https://hrmforce.com/wp-content/uploads/2020/12/ass-afb3.png" alt="gesprekscyclus hrmforce" loading="lazy" />
        <img src="https://hrmforce.com/wp-content/uploads/2020/12/ass-afb2.png" alt="online assessment portal hrmforce" loading="lazy" style="margin-top:16px" />
      </div>
    </div>
  </div>
</section>

<section style="background:var(--bg)">
  <div class="wrap">
    <div class="eyebrow">{c.how.eyebrow}</div>
    <h2 class="section-title">{c.how.title}</h2>
    <p style="max-width:900px;color:var(--text);font-size:17px" set:html={c.how.body}></p>
  </div>
</section>

<section>
  <div class="wrap">
    <div class="eyebrow">{c.clients.eyebrow}</div>
    <h2 class="section-title">{c.clients.title}</h2>
    <div class="logos">
      {logos.map((l) => <img src={l.src} alt={l.alt} title={l.alt} loading="lazy" />)}
    </div>
  </div>
</section>

<section style="background:var(--bg)">
  <div class="wrap">
    <div class="eyebrow">{c.featuredSection.eyebrow}</div>
    <h2 class="section-title">{c.featuredSection.title}</h2>
    <div class="cards">
      {c.featured.map((a) => (
        <a class="card" href={cardHref(a.slug)} style="text-decoration:none;color:inherit;display:block">
          <span class="tag-row">{a.cats.map((cat) => <span class="tag">{cat}</span>)}</span>
          <h3>{a.title}</h3>
          <p><strong>{c.ui.goalLabel}</strong> {a.goal}</p>
          <span style="color:var(--blue);font-weight:600;font-size:15px">{c.ui.readmore} &rarr;</span>
        </a>
      ))}
    </div>
    <div style="margin-top:28px"><a class="btn btn-primary" href={overzichtHref}>{c.featuredSection.cta}</a></div>
  </div>
</section>

<section>
  <div class="wrap">
    <a href="https://www.youtube.com/watch?v=50gYB0KjtMw&ab_channel=hrmforce" target="_blank" rel="noopener">
      <img src="https://hrmforce.com/wp-content/uploads/2022/03/youtube-afbeelding2.png" alt={c.video.alt} loading="lazy" style="max-width:100%;height:auto;border-radius:var(--radius)" />
    </a>
    <div class="eyebrow" style="margin-top:28px">{c.video.eyebrow}</div>
    <h2 class="section-title">{c.video.title}</h2>
    <p style="max-width:900px;color:var(--text);font-size:17px" set:html={c.video.body}></p>
    <div class="btns" style="margin-top:8px"><a class="btn btn-primary" href={contactHref}>{c.video.cta}</a></div>
  </div>
</section>

<section style="background:var(--bg)">
  <div class="wrap">
    <div class="eyebrow">{c.reviews.eyebrow}</div>
    <h2 class="section-title">{c.reviews.title}</h2>
    <p style="max-width:900px;color:var(--text);font-size:17px">{c.reviews.body}</p>
    <div class="cards" style="margin-top:28px">
      {c.reviewItems.map((r) => (
        <div class="card">
          <p style="color:var(--text)">{r.text}</p>
          <strong style="color:var(--navy)">{r.name}</strong>
        </div>
      ))}
    </div>
  </div>
</section>

<section class="cta">
  <div class="wrap">
    <h2>{c.ctaBand.title}</h2>
    <p>{c.ctaBand.text}</p>
    <div class="btns">
      <a href={contactHref} class="btn btn-primary">{c.ctaBand.primary}</a>
      <a href={overzichtHref} class="btn btn-light">{c.ctaBand.secondary}</a>
    </div>
  </div>
</section>

<style>
  section img { max-width: 100%; height: auto; }
  .logos { display: grid; grid-template-columns: repeat(6, 1fr); gap: 18px; align-items: center; margin-top: 24px; }
  .logos img { width: 100%; height: 70px; object-fit: contain; filter: grayscale(1); opacity: .8; transition: .2s; }
  .logos img:hover { filter: none; opacity: 1; }
  .tag-row { display: flex; flex-wrap: wrap; gap: 6px; margin-bottom: 12px; }
  .tag { background: #e8f0fe; color: var(--navy); font-size: 12px; font-weight: 700; padding: 3px 10px; border-radius: 999px; }
  @media (max-width: 880px) { .logos { grid-template-columns: repeat(3, 1fr); } }
</style>
