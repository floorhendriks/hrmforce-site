---
// Contactpagina, in alle talen dezelfde opbouw. De Nederlandse opmaak is de
// norm: kantoorblok met kaart links, formulier rechts, daaronder de
// vestigingen en een afsluitend blok.
//
// Alle teksten komen uit src/data/contact-content.js. De veldnamen in het
// formulier zijn in elke taal gelijk (voornaam, bedrijf, email, telefoon,
// bericht), alleen de labels verschillen. Dat is wat functions/api/aanvraag.js
// verwacht.
import Sterren from "./Sterren.astro";
import AanvraagSoort from "./AanvraagSoort.astro";
import Mensencheck from "./Mensencheck.astro";
import { KANTOREN, HOOFDKANTOOR } from "../data/contact-content.js";

const { t, lang } = Astro.props;
const js = t.melding;
---
<div class="crumb">
  <div class="wrap"><a href={lang === "nl" ? "/" : `/${lang}/`}>Home</a> › <span>{t.crumb}</span></div>
</div>

<section class="ahero">
  <div class="wrap" style="display:block">
    <div class="eyebrow">{t.hero.eyebrow}</div>
    <h1>{t.hero.title}</h1>
    <p style="color:#c4d2e6;font-size:19px;max-width:820px;margin-top:8px">{t.hero.lead}</p>
  </div>
</section>

<section class="formsec">
  <div class="wrap contact-grid">
    <div class="contact-info">
      <div class="office-box">
        <div class="eyebrow">{t.kantoor.eyebrow}</div>
        <h2 class="section-title" style="font-size:26px;margin-top:4px">{HOOFDKANTOOR.stad}</h2>
        <p class="addr">{HOOFDKANTOOR.regels.map((r, i) => (<>{r}{i < HOOFDKANTOOR.regels.length - 1 && <br />}</>))}</p>
        <div class="ci-row"><span class="ci-lbl">{t.kantoor.telLabel}</span><a href={HOOFDKANTOOR.telHref}>{HOOFDKANTOOR.tel}</a></div>
        <div class="ci-row"><span class="ci-lbl">{t.kantoor.mailLabel}</span><a href={`mailto:${HOOFDKANTOOR.mail}`}>{HOOFDKANTOOR.mail}</a></div>
        <p class="hours"><strong>{t.kantoor.bereikbaarTitel}</strong><br />{t.kantoor.bereikbaarTekst}</p>
        <p class="ci-legal">{HOOFDKANTOOR.legal}</p>
      </div>

      <div class="map">
        <iframe
          title={t.kantoor.kaartTitel}
          src="https://maps.google.com/maps?q=Solitudolaan%20396%2C%201096%20DS%20Amsterdam&t=&z=15&ie=UTF8&iwloc=&output=embed"
          loading="lazy"
          referrerpolicy="no-referrer-when-downgrade"
        ></iframe>
      </div>
    </div>

    <div>
      <div class="eyebrow">{t.formulier.eyebrow}</div>
      <h2 class="section-title" style="font-size:26px">{t.formulier.titel}</h2>
      <form id="contactForm" class="formcard" action="/api/aanvraag" method="POST" novalidate>
        <div class="fg">
          <label for="voornaam">{t.formulier.voornaam} *</label>
          <input type="text" id="voornaam" name="voornaam" required />
        </div>
        <div class="fg">
          <label for="bedrijf">{t.formulier.bedrijf} *</label>
          <input type="text" id="bedrijf" name="bedrijf" required />
        </div>
        <div class="frow">
          <div class="fg">
            <label for="email">{t.formulier.email} *</label>
            <input type="email" id="email" name="email" required />
          </div>
          <div class="fg">
            <label for="telefoon">{t.formulier.telefoon} *</label>
            <input type="tel" id="telefoon" name="telefoon" required />
          </div>
        </div>
        <div class="fg">
          <label for="bericht">{t.formulier.bericht} *</label>
          <textarea id="bericht" name="bericht" rows="5" required></textarea>
        </div>
        <div class="next-steps"><strong>{t.stappen.titel}</strong><ol>{t.stappen.items.map((s) => (<li>{s}</li>))}</ol><div class="ns-proof"><span class="ns-stars"><Sterren /></span> {t.stappen.proof}</div></div>
        <AanvraagSoort lang={lang} bron="contact" />
        <Mensencheck lang={lang} />
        <p id="formMsg" class="form-msg" role="status" aria-live="polite"></p>
        <button type="submit" class="btn btn-primary">{t.formulier.verstuur}</button>
        <p class="privacy-note">
          {t.privacy.tekst}
          <a href={t.privacy.href}>{t.privacy.link}</a>.
        </p>
      </form>
      <div class="person-card"><img src="/media/team/floor-hendriks.webp" alt={t.persoon.alt} width="72" height="72" loading="lazy" /><div><strong>{t.persoon.titel}</strong><span>{t.persoon.tekst}</span><span class="person-name">{t.persoon.naam}</span></div></div>
    </div>
  </div>
</section>

<section>
  <div class="wrap">
    <div class="eyebrow">{t.vestigingen.eyebrow}</div>
    <h2 class="section-title">{t.vestigingen.titel}</h2>
    <p class="lead">{t.vestigingen.lead}</p>
    <div class="office-grid">
      {KANTOREN.map((o) => (
        <div class="office-card">
          <h3>{o.naam}</h3>
          <p class="addr">{o.regels.map((r, i) => (<>{r}{i < o.regels.length - 1 && <br />}</>))}</p>
          <p class="office-contact">
            <a href={o.telHref}>{o.tel}</a><br />
            <a href={`mailto:${o.mail}`}>{o.mail}</a>
          </p>
        </div>
      ))}
    </div>
  </div>
</section>

<section class="cta">
  <div class="wrap">
    <h2>{t.cta.titel}</h2>
    <p>{t.cta.tekst}</p>
    <div class="btns">
      <a href={t.cta.knop1.href} class="btn btn-primary">{t.cta.knop1.label}</a>
      <a href={t.cta.knop2.href} class="btn btn-light">{t.cta.knop2.label}</a>
    </div>
  </div>
</section>

<style>
  .contact-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 48px; align-items: start; }
  .contact-info .addr { color: var(--muted); font-size: 16px; margin-bottom: 18px; }
  .hours { background: var(--bg); padding: 14px 16px; border-radius: var(--radius-sm); color: var(--muted); font-size: 15px; margin-bottom: 18px; }
  .hours strong { color: var(--navy); }
  .office-box{background:#fff;border:1px solid var(--line);border-radius:var(--radius);padding:26px 28px;box-shadow:var(--shadow-xs);margin-bottom:18px}
  .office-box .addr{margin-bottom:16px}
  .ci-row{display:flex;gap:12px;align-items:baseline;padding:7px 0;font-size:15px;border-bottom:1px solid var(--line)}
  .ci-lbl{min-width:90px;color:var(--navy);font-weight:700;font-size:12.5px;text-transform:uppercase;letter-spacing:.4px}
  .ci-row a{color:var(--blue);font-weight:600}
  .ci-legal{color:var(--muted);font-size:12.5px;margin:14px 0 0;padding-top:14px;border-top:1px solid var(--line);line-height:1.7}
  .map { margin-top: 8px; border-radius: var(--radius); overflow: hidden; border: 1px solid var(--line); box-shadow:none; }
  .map iframe { width: 100%; height: 260px; border: 0; display: block; }
  .form-msg { display: none; margin-bottom: 16px; padding: 12px 14px; border-radius: var(--radius); font-size: 14px; font-weight: 600; }
  .form-msg.error { display: block; background: #fff3f0; border: 1px solid var(--accent); color: #8a4a25; }
  .form-msg.success { display: block; background: #eef7ee; border: 1px solid #57a05a; color: #2f6b32; }
  .privacy-note { margin-top: 14px; font-size: 13px; color: var(--muted); }
  .privacy-note a { color: var(--blue); }
  .office-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 24px; margin-top: 34px; }
  .office-card { background: #fff; border: 1px solid var(--line); border-radius: var(--radius); padding: 26px; box-shadow:none; }
  .office-card h3 { font-size: 18px; margin-bottom: 10px; }
  .office-card .addr { color: var(--muted); font-size: 15px; margin-bottom: 12px; }
  .office-contact a { color: var(--blue); font-weight: 600; font-size: 15px; }
  .office-contact a:hover { text-decoration: underline; }
  @media (max-width: 880px) { .contact-grid { grid-template-columns: 1fr; } .office-grid { grid-template-columns: 1fr; } }

  .next-steps{background:var(--bg-soft);border:1px solid var(--line);border-radius:var(--radius);padding:16px 18px;margin:4px 0 18px}
  .next-steps strong{color:var(--navy);font-size:14.5px;display:block;margin-bottom:8px}
  .next-steps ol{margin:0 0 10px 18px;padding:0;color:var(--text);font-size:14px;line-height:1.5}
  .next-steps li{margin:3px 0}
  .ns-proof{color:var(--muted);font-size:13px;padding-top:8px;border-top:1px solid var(--line)}
  .ns-stars{color:var(--gold);letter-spacing:1px}

  .person-card{display:flex;gap:16px;align-items:center;background:var(--bg-soft);border:1px solid var(--line);border-radius:var(--radius);padding:16px 18px;margin:22px 0 0}
  .person-card img{width:72px;height:72px;border-radius:var(--radius-sm);object-fit:cover;flex:none;border:2px solid #fff;box-shadow:var(--shadow-xs)}
  .person-card strong{display:block;color:var(--navy);font-size:15.5px;margin-bottom:2px}
  .person-card span{display:block;color:var(--muted);font-size:14px;line-height:1.45}
  .person-card .person-name{color:var(--navy);font-weight:700;font-size:13px;margin-top:6px}
</style>

<script is:inline define:vars={{ js }}>
  (function () {
    var form = document.getElementById("contactForm");
    if (!form) return;
    var msg = document.getElementById("formMsg");
    form.addEventListener("submit", function (e) {
      var required = form.querySelectorAll("[required]");
      var missing = [];
      required.forEach(function (el) { if (!el.value.trim()) missing.push(el); });
      var email = form.querySelector("#email");
      var emailOk = email && /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email.value.trim());
      if (missing.length > 0 || !emailOk) {
        e.preventDefault();
        msg.className = "form-msg error";
        msg.textContent = missing.length > 0 ? js.verplicht : js.ongeldigEmail;
        (missing[0] || email).focus();
        return;
      }
      e.preventDefault();
      var knop = form.querySelector("button[type=submit]");
      var oud = knop ? knop.textContent : "";
      if (knop) { knop.disabled = true; knop.textContent = js.verzenden; }
      msg.className = "form-msg"; msg.textContent = "";
      fetch("/api/aanvraag", { method: "POST", body: new FormData(form), headers: { Accept: "application/json" } })
        .then(function (r) { return r.json().catch(function () { return {}; }); })
        .then(function (uit) {
          if (knop) { knop.disabled = false; knop.textContent = oud; }
          if (uit && uit.ok) {
            if (window.hrmAanvraagGelukt) window.hrmAanvraagGelukt(form);
            form.reset();
            msg.className = "form-msg success";
            msg.textContent = uit.doorverwezen ? js.dankParticulier : js.dank;
          } else {
            msg.className = "form-msg error";
            msg.textContent = (uit && uit.error === "geen_mens") ? js.geenMens : js.misgegaan;
          }
        })
        .catch(function () {
          if (knop) { knop.disabled = false; knop.textContent = oud; }
          msg.className = "form-msg error";
          msg.textContent = js.misgegaan;
        });
    });
  })();
</script>
