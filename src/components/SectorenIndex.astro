---
import LogoSlider from "./LogoSlider.astro";
import { getLangFromUrl, localizePath } from "../i18n/utils.js";
import { sectorsFor } from "../data/sectoren-content.js";

const lang = getLangFromUrl(Astro.url);
const { ui, sectors } = sectorsFor(lang);
const _exLabel = { nl: "Voorbeeld", en: "Example", de: "Beispiel", fr: "Exemple", es: "Ejemplo", ro: "Exemplu" }[lang] || "Voorbeeld";
const contactHref = localizePath("/contact/", lang);
const assessHref = localizePath("/assessment-overzicht/", lang);
const landHref = (slug) => localizePath(`/toepassingen/${slug}/`, lang);
---
<div class="crumb"><div class="wrap"><a href={localizePath("/", lang)}>Home</a> › <span>{ui.eyebrow}</span></div></div>

<section class="ahero"><div class="wrap" style="display:block">
  <div class="eyebrow" style="color:var(--gold)">{ui.eyebrow}</div>
  <h1>{ui.title}</h1>
  <p style="color:rgba(255,255,255,.85);font-size:17px;max-width:780px;margin-top:12px">{ui.intro}</p>
</div></section>

<section><div class="wrap" style="display:block">
  <div class="sec-bar">
    <input type="search" id="secSearch" class="sec-search" placeholder={ui.search} aria-label={ui.search} />
    <div class="sec-chips" id="secChips">
      <button type="button" class="sec-chip is-active" data-key="">{ui.all}</button>
      {sectors.map((s) => <button type="button" class="sec-chip" data-key={s.key}>{s.label}</button>)}
    </div>
  </div>

  <div class="sec-grid" id="secGrid">
    {sectors.map((s) => (
      <article class="sec-card" data-key={s.key} data-search={(s.label + " " + s.blurb).toLowerCase()}>
        <h2 class="sec-name">{s.label}</h2>
        <p class="sec-blurb">{s.blurb}</p>
        {s.casus && <p class="sec-casus"><span>{_exLabel}</span> {s.casus}</p>}
        {s.landing
          ? <a class="sec-link" href={landHref(s.landing)}>{ui.view} &rarr;</a>
          : <a class="sec-link" href={contactHref}>{ui.ask} &rarr;</a>}
      </article>
    ))}
  </div>
  <p class="sec-none" id="secNone" hidden>{ui.none}</p>
</div></section>

<LogoSlider heading="Organisaties die u voorgingen" />

<section class="cta"><div class="wrap" style="padding:56px 0;text-align:center">
  <h2 style="color:#fff">{ui.cta.title}</h2>
  <p style="color:rgba(255,255,255,.9);max-width:640px;margin:12px auto 0">{ui.cta.text}</p>
  <div class="btns" style="justify-content:center;margin-top:20px">
    <a href={contactHref} class="btn btn-light">{ui.cta.primary}</a>
    <a href={assessHref} class="btn btn-ghost" style="color:#fff;border-color:rgba(255,255,255,.6)">{ui.cta.secondary}</a>
  </div>
</div></section>

<style>
  .sec-bar{margin-bottom:26px}
  .sec-search{width:100%;max-width:420px;padding:11px 14px;border:1px solid var(--line);border-radius:10px;font:inherit;font-size:15px;margin-bottom:14px}
  .sec-chips{display:flex;flex-wrap:wrap;gap:8px}
  .sec-chip{border:1px solid var(--line);background:#fff;color:var(--navy);font:inherit;font-size:13.5px;font-weight:700;padding:7px 14px;border-radius:999px;cursor:pointer;transition:.15s}
  .sec-chip:hover{border-color:var(--navy)}
  .sec-chip.is-active{background:var(--navy);color:#fff;border-color:var(--navy)}
  .sec-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:20px}
  @media(max-width:980px){.sec-grid{grid-template-columns:1fr 1fr}}
  @media(max-width:640px){.sec-grid{grid-template-columns:1fr}}
  .sec-card{background:#fff;border:1px solid var(--line);border-radius:14px;padding:22px 24px;box-shadow:var(--shadow-xs);display:flex;flex-direction:column}
  .sec-name{color:var(--navy);font-size:1.15rem;margin:0 0 8px}
  .sec-blurb{color:var(--muted);font-size:14.5px;line-height:1.55;margin:0 0 14px;flex:1}
  .sec-casus{background:var(--bg-soft,#f6f9fc);border-radius:10px;padding:10px 12px;color:var(--navy);font-size:13px;line-height:1.5;margin:0 0 14px}
  .sec-casus span{display:inline-block;font-size:10.5px;font-weight:800;letter-spacing:.5px;text-transform:uppercase;color:var(--blue);margin-right:6px}
  .sec-link{color:var(--navy);font-weight:700;font-size:14px;text-decoration:none}
  .sec-link:hover{color:var(--blue)}
  .sec-none{color:var(--muted);font-size:16px;text-align:center;padding:40px 0}
</style>

<script>
  (function () {
    const grid = document.getElementById("secGrid");
    if (!grid) return;
    const cards = Array.from(grid.querySelectorAll(".sec-card"));
    const chips = Array.from(document.querySelectorAll(".sec-chip"));
    const search = document.getElementById("secSearch");
    const none = document.getElementById("secNone");
    let active = "";
    function apply() {
      const q = (search.value || "").trim().toLowerCase();
      let n = 0;
      cards.forEach((c) => {
        const ok = (!active || c.dataset.key === active) && (!q || (c.dataset.search || "").includes(q));
        c.style.display = ok ? "" : "none";
        if (ok) n++;
      });
      none.hidden = n > 0;
    }
    chips.forEach((ch) => ch.addEventListener("click", () => {
      active = ch.dataset.key;
      chips.forEach((x) => x.classList.toggle("is-active", x === ch));
      apply();
    }));
    search.addEventListener("input", apply);
  })();
</script>
