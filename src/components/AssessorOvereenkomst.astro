---
/* De ondertekenpagina voor nieuwe assessoren. De tekst van de overeenkomst
   komt uit dezelfde bron als de PDF, dus wat de assessor leest is letterlijk
   wat hij tekent. De pagina staat niet in het menu en niet in de sitemap. */
import { TEKST, BIJLAGE_B, VERSIE } from "../data/assessor-overeenkomst.js";
import Mensencheck from "./Mensencheck.astro";

const velden = [
  { id: "naam", label: "Volledige naam", type: "text", verplicht: true, hint: "Voornaam en achternaam", auto: "name" },
  { id: "handelsnaam", label: "Handelsnaam en rechtsvorm", type: "text", verplicht: false, hint: "Laat leeg als je als particulier tekent", auto: "organization" },
  { id: "straat", label: "Straat en huisnummer", type: "text", verplicht: true, auto: "street-address" },
  { id: "postcodePlaats", label: "Postcode en plaats", type: "text", verplicht: true, auto: "postal-code" },
  { id: "kvk", label: "KvK-nummer", type: "text", verplicht: false, hint: "Acht cijfers, als je die hebt" },
  { id: "email", label: "E-mailadres", type: "email", verplicht: true, hint: "Hierheen sturen we de getekende overeenkomst", auto: "email" },
  { id: "telefoon", label: "Telefoonnummer", type: "tel", verplicht: true, auto: "tel" },
  { id: "registratie", label: "Beroepsregistratie(s)", type: "text", verplicht: false, hint: "Bijvoorbeeld NIP, NVO of registerpsycholoog, met registratienummer" },
];
---

<section class="ao">
  <div class="wrap ao-wrap">
    <p class="ao-vertrouwelijk">Vertrouwelijk</p>

    <div class="ao-tekst" id="aoTekst">
      {TEKST.map((b) => (
        b.t === "titel" ? <h1 class="ao-h1">{b.tekst}</h1> :
        b.t === "ondertitel" ? <p class="ao-h2">{b.tekst}</p> :
        b.t === "lead" ? <p class="ao-lead">{b.tekst}</p> :
        b.t === "kop" ? <h2 class="ao-kop">{b.tekst}</h2> :
        b.t === "artikel" ? <h3 class="ao-artikel">{b.nr}. {b.titel}</h3> :
        b.t === "lid" ? <p class="ao-lid"><span class="ao-nr">{b.nr}</span>{b.tekst}</p> :
        b.t === "lijst" ? <ol class="ao-lijst">{b.items.map((i) => <li>{i}</li>)}</ol> :
        b.t === "cursief" ? <p class="ao-cursief">{b.tekst}</p> :
        b.t === "deftabel" ? (
          <dl class="ao-def">
            {b.rijen.map((r) => (
              <div class="ao-defrij">
                <dt>{r[0]}</dt>
                <dd>{String(r[1] || "").split("\n").map((p) => <p>{p}</p>)}</dd>
              </div>
            ))}
          </dl>
        ) : <p class="ao-alinea">{b.tekst}</p>
      ))}
    </div>

    <form id="aoForm" novalidate>
      <h2 class="ao-kop">Bijlage A. Gegevens van de Assessor</h2>
      <p class="ao-alinea">In te vullen door jou. hrmforce gebruikt deze gegevens voor de uitvoering van de overeenkomst, de toegang tot de hrmforce-omgeving en de verantwoording richting opdrachtgevers.</p>

      <div class="ao-velden">
        {velden.map((v) => (
          <div class={"ao-veld" + (v.id === "registratie" || v.id === "straat" ? " ao-breed" : "")}>
            <label for={"ao-" + v.id}>
              {v.label}{v.verplicht && <span class="ao-ster">*</span>}
            </label>
            <input
              id={"ao-" + v.id}
              name={v.id}
              type={v.type}
              required={v.verplicht}
              autocomplete={v.auto || "off"}
              inputmode={v.id === "kvk" ? "numeric" : undefined}
            />
            {v.hint && <p class="ao-hint">{v.hint}</p>}
          </div>
        ))}
      </div>

      <h2 class="ao-kop">Ondertekening</h2>
      <p class="ao-alinea">Door te ondertekenen verklaar je deze overeenkomst, inclusief de bijlagen A en B, te hebben gelezen en te aanvaarden, en de gegevens in Bijlage A naar waarheid te hebben ingevuld.</p>

      <div class="ao-tekenblok">
        <div class="ao-kolom">
          <p class="ao-kolomkop">hrmforce B.V.</p>
          <p class="ao-regel"><span>Naam</span>Floor Hendriks</p>
          <p class="ao-regel"><span>Functie</span>Managing Partner</p>
          <p class="ao-regel"><span>Plaats en datum</span>Amsterdam, <span id="aoDatum">vandaag</span></p>
          <p class="ao-regel"><span>Handtekening</span></p>
          <img class="ao-htfloor" src="/media/assessor/handtekening-floor.jpg" alt="Handtekening Floor Hendriks" width="278" height="139" />
        </div>

        <div class="ao-kolom">
          <p class="ao-kolomkop">De Assessor</p>
          <div class="ao-veld">
            <label for="ao-tekennaam">Naam<span class="ao-ster">*</span></label>
            <input id="ao-tekennaam" name="tekennaam" type="text" required autocomplete="name" />
          </div>
          <div class="ao-veld">
            <label for="ao-plaats">Plaats<span class="ao-ster">*</span></label>
            <input id="ao-plaats" name="plaats" type="text" required autocomplete="address-level2" />
            <p class="ao-hint">De datum vullen we zelf in op het moment van ondertekenen.</p>
          </div>

          <p class="ao-label">Handtekening<span class="ao-ster">*</span></p>
          <div class="ao-krabbel" id="aoKrabbel" aria-live="polite">
            <span id="aoKrabbelTekst"></span>
            <canvas id="aoCanvas" width="640" height="220" hidden aria-label="Tekenvlak voor je handtekening"></canvas>
          </div>
          <div class="ao-tekenknoppen">
            <button type="button" class="ao-knopje" id="aoTekenen">Liever zelf tekenen</button>
            <button type="button" class="ao-knopje" id="aoWissen" hidden>Opnieuw</button>
          </div>
          <p class="ao-hint">Je getypte naam verschijnt hierboven als handtekening. Wil je met de muis of je vinger tekenen, kies dan voor zelf tekenen.</p>
        </div>
      </div>

      <label class="ao-vink">
        <input type="checkbox" id="aoAkkoord1" />
        <span>Ik heb de overeenkomst inclusief bijlagen A en B gelezen en ga ermee akkoord</span>
      </label>
      <label class="ao-vink">
        <input type="checkbox" id="aoAkkoord2" />
        <span>Ik verklaar dat de ingevulde gegevens juist en volledig zijn</span>
      </label>

      <Mensencheck lang="nl" />

      <p class="ao-bewijs">Door op Ondertekenen en verzenden te klikken plaats je een elektronische handtekening. Wij registreren daarbij datum, tijd en IP-adres als bewijs van ondertekening.</p>

      <button type="submit" class="btn btn-primary ao-verzend" id="aoVerzend" disabled>Ondertekenen en verzenden</button>
      <p class="ao-melding" id="aoMelding" hidden></p>
    </form>

    <div class="ao-tekst">
      {BIJLAGE_B.map((b) => (
        b.t === "kop" ? <h2 class="ao-kop">{b.tekst}</h2> :
        b.t === "kader" ? (
          <div class="ao-kader"><p class="ao-kaderkop">{b.titel}</p><p>{b.tekst}</p></div>
        ) :
        b.t === "deftabel" ? (
          <dl class="ao-def">
            {b.rijen.map((r) => (
              <div class="ao-defrij"><dt>{r[0]}</dt><dd>{String(r[1] || "").split("\n").map((p) => <p>{p}</p>)}</dd></div>
            ))}
          </dl>
        ) : <p class="ao-alinea">{b.tekst}</p>
      ))}
    </div>

    <p class="ao-privacy">hrmforce verwerkt de gegevens in dit formulier uitsluitend voor het vastleggen van deze overeenkomst. Zie ons <a href="/support/privacy-statement/">privacy statement</a>. Tekstversie: {VERSIE}.</p>
  </div>

  <div class="ao-klaar" id="aoKlaar" hidden>
    <div class="ao-klaarkaart">
      <div class="ao-vink-rond" aria-hidden="true">
        <svg width="30" height="30" viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"/></svg>
      </div>
      <h2>Getekend en verstuurd</h2>
      <p id="aoKlaarTekst">Je ontvangt de getekende overeenkomst per e-mail.</p>
      <p class="ao-nummer">Documentnummer: <strong id="aoNummer"></strong></p>
      <a class="btn btn-primary" id="aoDownload" href="#" download>Download de getekende PDF</a>
      <p class="ao-hint">De downloadknop werkt zolang deze pagina openstaat. Daarna heb je de e-mail.</p>
    </div>
  </div>
</section>

<style is:global>
  @font-face {
    font-family: "Caveat hrmforce";
    src: url("/media/fonts/caveat-latin.woff2") format("woff2");
    font-weight: 600;
    font-display: swap;
  }
  .ao { padding: 36px 0 80px; }
  .ao-wrap { max-width: 820px; }
  .ao-vertrouwelijk { color: #A33B2A; font-weight: 800; font-size: 12px; letter-spacing: .14em; text-transform: uppercase; margin: 0 0 18px; }
  .ao-h1 { font-size: 1.9rem; color: #0E468C; margin: 0 0 6px; }
  .ao-h2 { color: #0A70B7; font-weight: 700; font-size: 1.05rem; margin: 0 0 10px; }
  .ao-lead { color: var(--muted); font-size: 15px; margin: 0 0 26px; }
  .ao-kop { color: #0E468C; font-size: 1.25rem; margin: 30px 0 10px; }
  .ao-artikel { color: #0E468C; font-size: 1rem; margin: 24px 0 8px; }
  .ao-alinea, .ao-lid { font-size: 15px; line-height: 1.62; margin: 0 0 10px; color: var(--text); }
  .ao-lid { padding-left: 42px; position: relative; }
  .ao-nr { position: absolute; left: 0; color: #0A70B7; font-weight: 700; }
  .ao-cursief { font-style: italic; color: var(--muted); font-size: 14.5px; margin: 0 0 10px; }
  .ao-lijst { margin: 0 0 12px; padding-left: 22px; }
  .ao-lijst li { font-size: 15px; line-height: 1.62; margin-bottom: 8px; }
  .ao-def { margin: 0 0 16px; }
  .ao-defrij { display: grid; grid-template-columns: 180px 1fr; gap: 14px; padding: 10px 12px; background: #EEF4FA; border-bottom: 1px solid #fff; }
  .ao-defrij dt { font-weight: 700; color: #0E468C; font-size: 14.5px; }
  .ao-defrij dd { margin: 0; font-size: 14.5px; line-height: 1.55; }
  .ao-defrij dd p { margin: 0 0 6px; }
  .ao-defrij dd p:last-child { margin: 0; }
  .ao-kader { background: #EEF4FA; border-left: 3px solid #0A70B7; padding: 14px 16px; margin: 6px 0 16px; }
  .ao-kaderkop { font-weight: 800; color: #0E468C; margin: 0 0 6px; }
  .ao-kader p { font-size: 14.5px; line-height: 1.55; margin: 0; }

  #aoForm { margin: 10px 0 0; }
  .ao-velden { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; margin-bottom: 8px; }
  .ao-veld.ao-breed { grid-column: 1 / -1; }
  .ao-veld label, .ao-label { display: block; font-size: 13px; font-weight: 700; color: #0E468C; margin-bottom: 5px; }
  .ao-ster { color: #A33B2A; margin-left: 3px; }
  .ao-veld input { width: 100%; padding: 10px 12px; border: 1px solid #CBD9E8; border-radius: var(--radius-sm); font-family: inherit; font-size: 15px; background: #fff; }
  .ao-veld input:focus { outline: 2px solid #0A70B7; border-color: #0A70B7; }
  .ao-veld input.ao-fout { border-color: #A33B2A; background: #fdf4f2; }
  .ao-hint { color: var(--muted); font-size: 12.5px; margin: 5px 0 0; line-height: 1.45; }

  .ao-tekenblok { display: grid; grid-template-columns: 1fr 1fr; gap: 26px; margin: 14px 0 20px; }
  .ao-kolom { border-top: 2px solid #CBD9E8; padding-top: 12px; }
  .ao-kolomkop { font-weight: 800; color: #0E468C; margin: 0 0 12px; font-size: 1.02rem; }
  .ao-regel { margin: 0 0 10px; font-size: 15px; }
  .ao-regel > span:first-child { display: block; font-size: 12px; font-weight: 700; color: var(--muted); }
  .ao-htfloor { height: 54px; width: auto; display: block; margin-top: 2px; }
  .ao-krabbel { border: 1px dashed #CBD9E8; border-radius: var(--radius-sm); background: #fff; min-height: 86px; display: flex; align-items: center; justify-content: center; padding: 8px; overflow: hidden; }
  .ao-krabbel span { font-family: "Caveat hrmforce", "Segoe Script", cursive; font-size: 40px; line-height: 1.1; color: #111; }
  .ao-krabbel canvas { width: 100%; height: 110px; touch-action: none; cursor: crosshair; }
  .ao-tekenknoppen { display: flex; gap: 10px; margin: 8px 0 0; }
  .ao-knopje { background: none; border: 0; padding: 0; color: #0A70B7; font-family: inherit; font-size: 13px; font-weight: 600; cursor: pointer; text-decoration: underline; }

  .ao-vink { display: flex; gap: 10px; align-items: flex-start; margin: 10px 0; font-size: 14.5px; line-height: 1.5; }
  .ao-vink input { margin-top: 3px; flex: 0 0 auto; width: 17px; height: 17px; }
  .ao-bewijs { color: var(--muted); font-size: 12.5px; line-height: 1.5; margin: 14px 0 16px; }
  .ao-verzend { width: 100%; }
  .ao-verzend:disabled { opacity: .5; cursor: not-allowed; }
  .ao-melding { margin: 12px 0 0; font-size: 14.5px; font-weight: 600; }
  .ao-melding.fout { color: #A33B2A; }
  .ao-privacy { color: var(--muted); font-size: 12.5px; margin: 26px 0 0; }

  .ao-klaar { padding: 60px 0 90px; }
  .ao-klaarkaart { max-width: 560px; margin: 0 auto; text-align: center; background: #fff; border: 1px solid #CBD9E8; border-radius: var(--radius); padding: 38px 32px; }
  .ao-vink-rond { width: 58px; height: 58px; border-radius: var(--radius-sm); background: #1a8a55; display: flex; align-items: center; justify-content: center; margin: 0 auto 16px; }
  .ao-klaarkaart h2 { color: #0E468C; margin: 0 0 10px; }
  .ao-nummer { color: #0E468C; font-size: 14.5px; margin: 14px 0 18px; }
  @media (max-width: 760px) {
    .ao-velden, .ao-tekenblok { grid-template-columns: 1fr; }
  }
</style>

<script>
  (function () {
    var form = document.getElementById("aoForm");
    if (!form) return;
    var krabbelTekst = document.getElementById("aoKrabbelTekst");
    var canvas = document.getElementById("aoCanvas");
    var knopTekenen = document.getElementById("aoTekenen");
    var knopWissen = document.getElementById("aoWissen");
    var verzend = document.getElementById("aoVerzend");
    var melding = document.getElementById("aoMelding");
    var naamVeld = document.getElementById("ao-naam");
    var tekenNaam = document.getElementById("ao-tekennaam");
    var akkoord1 = document.getElementById("aoAkkoord1");
    var akkoord2 = document.getElementById("aoAkkoord2");
    var tekenModus = false, getekend = false;

    var datum = document.getElementById("aoDatum");
    if (datum) {
      datum.textContent = new Intl.DateTimeFormat("nl-NL", {
        timeZone: "Europe/Amsterdam", day: "numeric", month: "long", year: "numeric",
      }).format(new Date());
    }

    // De naam uit Bijlage A vult het handtekeningveld voor, zolang de assessor
    // dat veld zelf nog niet heeft aangepast.
    var naamAangeraakt = false;
    tekenNaam.addEventListener("input", function () { naamAangeraakt = true; toonKrabbel(); kijkNa(); });
    naamVeld.addEventListener("input", function () {
      if (!naamAangeraakt) { tekenNaam.value = naamVeld.value; toonKrabbel(); }
      kijkNa();
    });

    function toonKrabbel() {
      krabbelTekst.textContent = tekenModus ? "" : tekenNaam.value.trim();
    }

    // ---------- tekenvlak ----------
    var ctx = canvas.getContext("2d");
    function wisCanvas() {
      ctx.fillStyle = "#fff";
      ctx.fillRect(0, 0, canvas.width, canvas.height);
      ctx.lineWidth = 3.2; ctx.lineCap = "round"; ctx.lineJoin = "round"; ctx.strokeStyle = "#111";
      getekend = false;
    }
    wisCanvas();
    var tekent = false;
    function punt(e) {
      var r = canvas.getBoundingClientRect();
      var t = e.touches ? e.touches[0] : e;
      return { x: (t.clientX - r.left) * (canvas.width / r.width), y: (t.clientY - r.top) * (canvas.height / r.height) };
    }
    function start(e) { e.preventDefault(); tekent = true; var p = punt(e); ctx.beginPath(); ctx.moveTo(p.x, p.y); }
    function beweeg(e) { if (!tekent) return; e.preventDefault(); var p = punt(e); ctx.lineTo(p.x, p.y); ctx.stroke(); getekend = true; kijkNa(); }
    function stop() { tekent = false; }
    ["mousedown", "touchstart"].forEach(function (n) { canvas.addEventListener(n, start, { passive: false }); });
    ["mousemove", "touchmove"].forEach(function (n) { canvas.addEventListener(n, beweeg, { passive: false }); });
    ["mouseup", "mouseleave", "touchend", "touchcancel"].forEach(function (n) { canvas.addEventListener(n, stop); });

    knopTekenen.addEventListener("click", function () {
      tekenModus = !tekenModus;
      canvas.hidden = !tekenModus;
      knopWissen.hidden = !tekenModus;
      knopTekenen.textContent = tekenModus ? "Toch mijn getypte naam gebruiken" : "Liever zelf tekenen";
      if (tekenModus) wisCanvas();
      toonKrabbel();
      kijkNa();
    });
    knopWissen.addEventListener("click", function () { wisCanvas(); kijkNa(); });

    // ---------- knop pas aan als alles er staat ----------
    function compleet() {
      var nodig = ["naam", "straat", "postcodePlaats", "email", "telefoon"];
      for (var i = 0; i < nodig.length; i++) {
        var el = form.elements[nodig[i]];
        if (!el || !el.value.trim()) return false;
      }
      if (!/^[^\s@]+@[^\s@]+\.[^\s@]{2,}$/.test(form.elements.email.value.trim())) return false;
      if (form.elements.naam.value.trim().split(/\s+/).length < 2) return false;
      var kvk = form.elements.kvk.value.trim();
      if (kvk && !/^\d{8}$/.test(kvk)) return false;
      if (!form.elements.plaats.value.trim()) return false;
      if (!tekenNaam.value.trim()) return false;
      if (tekenModus && !getekend) return false;
      return akkoord1.checked && akkoord2.checked;
    }
    function kijkNa() { verzend.disabled = !compleet(); }
    form.addEventListener("input", kijkNa);
    form.addEventListener("change", kijkNa);
    kijkNa();

    // ---------- handtekening als beeld ----------
    function naarJpeg(c) { return c.toDataURL("image/jpeg", 0.92); }

    async function tekstAlsBeeld(tekst, hoogte) {
      var c = document.createElement("canvas");
      var g = c.getContext("2d");
      var font = "600 " + hoogte + "px 'Caveat hrmforce', cursive";
      try { if (document.fonts && document.fonts.load) await document.fonts.load(font); } catch (e) {}
      g.font = font;
      var breedte = Math.ceil(g.measureText(tekst).width) + 40;
      c.width = Math.max(breedte, 120); c.height = Math.round(hoogte * 1.9);
      g.fillStyle = "#fff"; g.fillRect(0, 0, c.width, c.height);
      g.font = font; g.fillStyle = "#111"; g.textBaseline = "middle";
      g.fillText(tekst, 20, c.height / 2);
      return naarJpeg(c);
    }

    function initialenVan(naam) {
      return naam.trim().split(/\s+/).map(function (w) { return w.charAt(0).toUpperCase(); }).join("").slice(0, 3);
    }

    // ---------- verzenden ----------
    form.addEventListener("submit", async function (e) {
      e.preventDefault();
      if (!compleet()) return;
      verzend.disabled = true;
      var oud = verzend.textContent;
      verzend.textContent = "Bezig met ondertekenen…";
      melding.hidden = true; melding.className = "ao-melding";

      try {
        var naam = tekenNaam.value.trim();
        var handtekening = tekenModus ? naarJpeg(canvas) : await tekstAlsBeeld(naam, 64);
        var initialen = await tekstAlsBeeld(initialenVan(naam), 44);
        var lading = {
          naam: form.elements.naam.value.trim(),
          handelsnaam: form.elements.handelsnaam.value.trim(),
          straat: form.elements.straat.value.trim(),
          postcodePlaats: form.elements.postcodePlaats.value.trim(),
          kvk: form.elements.kvk.value.trim(),
          email: form.elements.email.value.trim(),
          telefoon: form.elements.telefoon.value.trim(),
          registratie: form.elements.registratie.value.trim(),
          plaats: form.elements.plaats.value.trim(),
          tekennaam: naam,
          getekend: tekenModus && getekend,
          handtekening: handtekening,
          initialen: initialen,
          akkoordOvereenkomst: akkoord1.checked,
          akkoordGegevens: akkoord2.checked,
          website: (form.querySelector('input[name="website"]') || {}).value || "",
          gestart: (form.querySelector('input[name="gestart"]') || {}).value || "",
          "cf-turnstile-response": (form.querySelector('[name="cf-turnstile-response"]') || {}).value || "",
        };

        var r = await fetch("/api/assessor-ondertekenen", {
          method: "POST", headers: { "Content-Type": "application/json" }, body: JSON.stringify(lading),
        });
        var uit = await r.json().catch(function () { return {}; });

        if (!uit || !uit.ok) {
          var tekst = "Er ging iets mis bij het ondertekenen. Probeer het nog eens of mail naar service@hrmforce.com.";
          if (uit && uit.error === "geen_mens") tekst = "We konden niet vaststellen dat je een mens bent. Vink het vakje aan en probeer het opnieuw.";
          if (uit && uit.error === "onvolledig") tekst = "Niet alle gegevens zijn ingevuld. Controleer de velden met een sterretje.";
          melding.textContent = tekst; melding.className = "ao-melding fout"; melding.hidden = false;
          verzend.disabled = false; verzend.textContent = oud;
          return;
        }

        document.getElementById("aoNummer").textContent = uit.nummer;
        var link = document.getElementById("aoDownload");
        var bin = atob(uit.pdf);
        var bytes = new Uint8Array(bin.length);
        for (var i = 0; i < bin.length; i++) bytes[i] = bin.charCodeAt(i);
        link.href = URL.createObjectURL(new Blob([bytes], { type: "application/pdf" }));
        link.setAttribute("download", uit.bestandsnaam || "assessorovereenkomst.pdf");
        if (!uit.mail) {
          document.getElementById("aoKlaarTekst").textContent =
            "De overeenkomst is vastgelegd. Het versturen van de e-mail lukte nog niet; download hieronder je exemplaar en meld dit even bij service@hrmforce.com.";
        }
        document.querySelector(".ao-wrap").hidden = true;
        document.getElementById("aoKlaar").hidden = false;
        window.scrollTo({ top: 0, behavior: "smooth" });
      } catch (fout) {
        melding.textContent = "Er ging iets mis bij het ondertekenen. Probeer het nog eens of mail naar service@hrmforce.com.";
        melding.className = "ao-melding fout"; melding.hidden = false;
        verzend.disabled = false; verzend.textContent = oud;
      }
    });
  })();
</script>
