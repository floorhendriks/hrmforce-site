---
/* Aanvraagformulier voor de oefenvragen. Post naar /api/oefenmateriaal, dat het
   document als bijlage naar de kandidaat stuurt met oefenen@hrmforce.com in cc.
   Zonder javascript valt het terug op een gewone formulierpost naar hetzelfde
   adres; de bezoeker ziet dan de bevestiging van de server. */
const { lang = "nl", onderdeel, titel, bron = "", knop, placeholder, klasse = "" } = Astro.props;
const NAAM_LABEL = {
  nl: "Je naam", en: "Your name", de: "Ihr Name", fr: "Votre nom", es: "Tu nombre", ro: "Numele t\u0103u",
};
const naamLabel = NAAM_LABEL[lang] || NAAM_LABEL.nl;
const MENSFOUT = OEFAANVR_MENSFOUT;
const BEVESTIGING = OEFAANVR_BEVESTIGING;
const b = BEVESTIGING[lang] || BEVESTIGING.nl;
const mensfout = MENSFOUT[lang] || MENSFOUT.nl;
import Mensencheck from "./Mensencheck.astro";
import { OEFAANVR_BEVESTIGING, OEFAANVR_MENSFOUT } from "../data/component-teksten.js";
---
<form class={`oa-form ${klasse}`} method="POST" action="/api/oefenmateriaal"
      data-oefenaanvraag data-ok={b.ok} data-fout={b.fout} data-bezig={b.bezig} data-mensfout={mensfout}>
  <input type="hidden" name="onderdeel" value={onderdeel} />
  <input type="hidden" name="taal" value={lang} />
  <input type="hidden" name="titel" value={titel} />
  <input type="hidden" name="bron" value={bron} />
  <input type="text" name="naam" autocomplete="name" placeholder={naamLabel} aria-label={naamLabel} />
  <input type="email" name="email" required placeholder={placeholder} aria-label={placeholder} />
  <Mensencheck lang={lang} />
  <button type="submit" class="btn btn-primary">{knop}</button>
</form>
<p class="oa-melding" hidden></p>

<style is:global>
  .oa-melding { margin: 10px 0 0; font-size: 14px; font-weight: 600; line-height: 1.45; }
  .oa-melding.ok { color: #1a7f4b; }
  .oa-melding.fout { color: #b3261e; }
  /* in de blauwe balk op de assessmentpagina: hele breedte, onder het formulier */
  .vv-cta { flex-wrap: wrap; }
  .vv-cta .oa-melding { flex-basis: 100%; width: 100%; color: #fff; text-align: right; margin: 4px 0 0; }
  .vv-cta .oa-melding.fout { color: #ffd4cf; }
  /* De blauwe balk op de assessmentpagina. Deze opmaak stond eerder in de
     pagina zelf; omdat het formulier nu een component is, hoort ze hier. */
  .vv-form { display: flex; gap: 10px; flex-wrap: wrap; align-items: center; }
  .vv-form input[type="text"], .vv-form input[type="email"] {
    border: 1px solid rgba(255,255,255,.25); background: rgba(255,255,255,.08); color: #fff;
    border-radius: var(--radius); padding: 11px 14px; font-size: 15px; font-family: inherit;
  }
  .vv-form input[type="email"] { min-width: 210px; }
  .vv-form input[type="text"] { min-width: 170px; }
  .vv-form input::placeholder { color: #9fb2c9; }
  .vv-form input:focus { outline: none; border-color: #fff; background: rgba(255,255,255,.16); }
  @media (max-width: 620px) { .vv-form { flex-direction: column; align-items: stretch; } .vv-form .btn { width: 100%; } }

  /* De kaart op de oefenpagina: de velden onder elkaar met ruimte ertussen. */
  .formcard.oa-form input[type="text"], .formcard.oa-form input[type="email"] { display: block; width: 100%; margin-bottom: 14px; }
  @media (max-width: 760px) { .vv-cta .oa-melding { text-align: left; } }
</style>

<script>
  /* Eén afhandelaar voor alle aanvraagformulieren op de pagina. */
  document.addEventListener("submit", function (ev) {
    var form = ev.target;
    if (!form || !form.matches || !form.matches("form[data-oefenaanvraag]")) return;
    ev.preventDefault();
    var knop = form.querySelector("button[type=submit]");
    var melding = form.parentNode.querySelector(".oa-melding");
    var oudeTekst = knop ? knop.textContent : "";
    if (knop) { knop.disabled = true; knop.textContent = form.dataset.bezig; }
    if (melding) { melding.hidden = true; melding.className = "oa-melding"; }
    var data = {};
    new FormData(form).forEach(function (v, k) { data[k] = v; });
    fetch("/api/oefenmateriaal", {
      method: "POST", headers: { "Content-Type": "application/json" }, body: JSON.stringify(data),
    }).then(function (r) { return r.json().catch(function () { return {}; }); })
      .then(function (uit) {
        if (knop) { knop.disabled = false; knop.textContent = oudeTekst; }
        if (!melding) return;
        var gelukt = uit && uit.ok;
        melding.textContent = gelukt ? form.dataset.ok : (uit && uit.error === "geen_mens" ? form.dataset.mensfout : form.dataset.fout);
        melding.className = "oa-melding " + (gelukt ? "ok" : "fout");
        melding.hidden = false;
        if (gelukt) {
          /* Het opvragen van voorbeeldvragen is een zachte lead: wel een eigen
             gebeurtenis in Analytics, geen conversie in Google Ads. */
          if (window.hrmAanvraagGelukt) window.hrmAanvraagGelukt(form, "voorbeeldvragen");
          form.reset();
        }
      })
      .catch(function () {
        if (knop) { knop.disabled = false; knop.textContent = oudeTekst; }
        if (melding) { melding.textContent = form.dataset.fout; melding.className = "oa-melding fout"; melding.hidden = false; }
      });
  });
</script>
