---
// Themapagina: een vaste opbouw voor pagina's die om een algemene term draaien
// (persoonlijkheidstest, capaciteitentest, AI in assessments). De tekst komt uit
// een datamodule, de kaarten verwijzen naar bestaande pagina's.
import { localizePath, localizeExisting, demoPath } from "../i18n/utils.js";
import validPaths from "../data/valid-paths.js";
const { t, lang, kaarten = [] } = Astro.props;
const demoHref = demoPath(lang);
const tarievenHref = localizeExisting("/tarieven/", lang, validPaths);
const links = kaarten.map((p) => localizeExisting(p, lang, validPaths));
const onderbouwingHref = t.onderbouwing && t.onderbouwing.link
  ? localizeExisting(t.onderbouwing.link.href, lang, validPaths)
  : null;
const faqLd = t.faq && t.faq.items && t.faq.items.length
  ? {
      "@context": "https://schema.org",
      "@type": "FAQPage",
      mainEntity: t.faq.items.map((i) => ({
        "@type": "Question",
        name: i.q,
        acceptedAnswer: { "@type": "Answer", text: i.a },
      })),
    }
  : null;
---
{faqLd && <script type="application/ld+json" is:inline set:html={JSON.stringify(faqLd)}></script>}

<div class="crumb"><div class="wrap">
  <a href={localizePath("/", lang)}>Home</a> › <span>{t.crumb}</span>
</div></div>

<section class="ahero"><div class="wrap" style="display:block">
  <div class="eyebrow">{t.hero.eyebrow}</div>
  <h1>{t.hero.title}</h1>
  <p class="tp-lead">{t.hero.lead}</p>
</div></section>

<section><div class="wrap" style="display:block">
  <div class="tp-intro">{t.intro.map((p) => (<p>{p}</p>))}</div>

  <h2 class="section-title tp-h2">{t.meet.title}</h2>
  <div class="tp-grid">
    {t.meet.items.map((i) => (
      <div class="tp-vak">
        <h3>{i.t}</h3>
        <p>{i.d}</p>
      </div>
    ))}
  </div>
</div></section>

<section class="bg-soft"><div class="wrap" style="display:block">
  <h2 class="section-title">{t.tests.title}</h2>
  <p class="tp-sub">{t.tests.intro}</p>
  <div class="tp-kaarten">
    {t.tests.kaarten.map((k, i) => (
      <a class="tp-kaart" href={links[i] || "#"}>
        <span class="tp-kaart-t">{k.t}</span>
        <span class="tp-kaart-d">{k.d}</span>
        <span class="tp-kaart-c">{t.tests.cta} &rarr;</span>
      </a>
    ))}
  </div>
</div></section>

<section><div class="wrap" style="display:block">
  <h2 class="section-title">{t.stappen.title}</h2>
  <ol class="tp-stappen">
    {t.stappen.items.map((s) => (
      <li><strong>{s.t}</strong><span>{s.d}</span></li>
    ))}
  </ol>
</div></section>

<section class="bg-soft"><div class="wrap" style="display:block">
  <div class="tp-onder">
    <h2 class="section-title">{t.onderbouwing.title}</h2>
    {t.onderbouwing.tekst.map((p) => (<p>{p}</p>))}
    {onderbouwingHref && (
      <a class="tp-link" href={onderbouwingHref}>{t.onderbouwing.link.label} &rarr;</a>
    )}
  </div>
</div></section>

<section><div class="wrap" style="display:block">
  <h2 class="section-title">{t.faq.title}</h2>
  <div class="tp-faq">
    {t.faq.items.map((i) => (
      <details>
        <summary>{i.q}</summary>
        <p>{i.a}</p>
      </details>
    ))}
  </div>
</div></section>

<section class="cta"><div class="wrap" style="display:block">
  <h2 class="section-title">{t.cta.title}</h2>
  <p class="tp-sub">{t.cta.text}</p>
  <div class="btns">
    <a href={demoHref} class="btn btn-primary">{t.cta.primary}</a>
    <a href={tarievenHref} class="btn btn-ghost">{t.cta.secondary}</a>
  </div>
</div></section>

<style>
  .tp-lead{max-width:820px;color:#d7e2ef;font-size:17px;line-height:1.7;margin:10px 0 0}
  .tp-intro{max-width:820px;color:#343434;font-size:16.5px;line-height:1.75}
  .tp-intro p{margin:0 0 16px}
  .tp-h2{margin-top:34px}
  .tp-sub{max-width:820px;color:var(--muted);margin:0 0 20px;font-size:15.5px;line-height:1.7}
  .tp-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:16px;max-width:920px}
  .tp-vak{background:#fff;border:1px solid var(--line);border-radius:var(--radius);padding:18px 20px}
  .tp-vak h3{color:var(--navy);font-size:16px;font-weight:800;margin:0 0 6px}
  .tp-vak p{margin:0;color:#343434;font-size:14.5px;line-height:1.65}
  .tp-kaarten{display:grid;grid-template-columns:repeat(3,1fr);gap:16px}
  .tp-kaart{display:flex;flex-direction:column;gap:8px;background:#fff;border:1px solid var(--line);border-radius:var(--radius);padding:20px 22px;text-decoration:none}
  .tp-kaart:hover{box-shadow:var(--shadow-sm)}
  .tp-kaart-t{color:var(--navy);font-weight:800;font-size:16px}
  .tp-kaart-d{color:#343434;font-size:14.5px;line-height:1.6;flex:1}
  .tp-kaart-c{color:var(--blue);font-weight:700;font-size:14px}
  .tp-stappen{counter-reset:s;list-style:none;margin:0;padding:0;max-width:820px}
  .tp-stappen li{counter-increment:s;position:relative;padding:14px 0 14px 46px;border-top:1px solid var(--line)}
  .tp-stappen li:first-child{border-top:0}
  .tp-stappen li:before{content:counter(s);position:absolute;left:0;top:14px;width:30px;height:30px;border-radius:999px;background:var(--navy);color:#fff;display:flex;align-items:center;justify-content:center;font-weight:800;font-size:14px}
  .tp-stappen strong{display:block;color:var(--navy);font-size:16px;margin-bottom:3px}
  .tp-stappen span{color:#343434;font-size:14.5px;line-height:1.65}
  .tp-onder{max-width:820px}
  .tp-onder p{color:#343434;font-size:16px;line-height:1.75;margin:0 0 14px}
  .tp-link{color:var(--blue);font-weight:700;text-decoration:none;font-size:15px}
  .tp-faq{max-width:820px}
  .tp-faq details{border-top:1px solid var(--line);padding:4px 0}
  .tp-faq details:first-child{border-top:0}
  .tp-faq summary{cursor:pointer;padding:14px 0;color:var(--navy);font-weight:700;font-size:16px;list-style:none}
  .tp-faq summary::-webkit-details-marker{display:none}
  .tp-faq summary:before{content:"+";display:inline-block;width:20px;color:var(--blue);font-weight:800}
  .tp-faq details[open] summary:before{content:"\2212"}
  .tp-faq details p{margin:0 0 16px 20px;color:#343434;font-size:15.5px;line-height:1.75}
  @media(max-width:860px){.tp-grid{grid-template-columns:1fr}.tp-kaarten{grid-template-columns:1fr}}
</style>
