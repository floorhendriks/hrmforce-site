---
// Over ons, in alle talen dezelfde opbouw. De Nederlandse opmaak is de norm.
// Secties waarvoor een taal nog geen tekst heeft, worden overgeslagen; zodra
// de vertaling in over-ons-content.js staat, verschijnt de sectie vanzelf.
import Img from "./Img.astro";
import { localizePath, PREFIXED } from "../i18n/utils.js";

const { t } = Astro.props;
// De taal komt van de pagina. Zonder taal valt alles terug op Nederlands.
const lang = Astro.props.lang || "nl";
// De brontalen hebben hun eigen links in de data staan, die hebben het
// taalvoorvoegsel al. Alleen een pad zonder voorvoegsel krijgt het erbij.
const link = (h) => (PREFIXED.includes(String(h).split("/")[1]) ? h : localizePath(h, lang));

// Foto van de oprichter, taalonafhankelijk.
const FOTO = "/media/team/floor-hendriks.webp";
---
<div class="crumb">
  <div class="wrap"><a href={localizePath("/", lang)}>Home</a> › <span>{t.crumb}</span></div>
</div>

<section class="ahero">
  <div class="wrap" style="display:block">
    <div class="eyebrow">{t.hero.eyebrow}</div>
    <h1>{t.hero.title}</h1>
  </div>
</section>

<section>
  <div class="wrap ov">
    <h2 class="section-title">{t.intro.titel}</h2>
    {t.intro.alineas.map((p) => (<p set:html={p} />))}
    <p><Img src={t.intro.beeld.src} alt={t.intro.beeld.alt} loading="lazy" /></p>

    <h2 class="section-title">{t.waarom.titel}</h2>
    <div class="usps">
      {t.waarom.items.map((u) => (
        <div class="usp"><h3 set:html={u.h} /><p>{u.p}</p></div>
      ))}
    </div>
  </div>
</section>

{t.oprichter && (
  <section class="founder"><div class="wrap">
    <div class="founder-grid">
      <div class="founder-photo">
        <Img src={FOTO} alt={t.oprichter.alt} loading="lazy" />
      </div>
      <div>
        <div class="eyebrow">{t.oprichter.eyebrow}</div>
        <h2>{t.oprichter.naam}</h2>
        {t.oprichter.alineas.map((p) => (<p set:html={p} />))}
        <p class="founder-meta">{t.oprichter.meta}</p>
      </div>
    </div>
  </div></section>
)}

<section>
  <div class="wrap ov">
    <h2 class="section-title">{t.software.titel}</h2>
    {t.software.alineas.map((p) => (<p set:html={p} />))}

    <div class="cards" style="margin:28px 0">
      {t.software.domeinen.map((d) => (
        d.href
          ? <a class="card" href={link(d.href)} style="text-decoration:none;color:inherit;display:block"><h3>{d.h}</h3></a>
          : <div class="card"><h3>{d.h}</h3></div>
      ))}
    </div>

    <h2 class="section-title">{t.oplossingen.titel}</h2>
    {t.oplossingen.alineas.map((p) => (<p set:html={p} />))}

    <h2 class="section-title">{t.werkwijze.titel}</h2>
    {t.werkwijze.alineas.map((p) => (<p set:html={p} />))}

    {t.werkwijze.stappen && (
      <div class="steps">
        {t.werkwijze.stappen.map((s, i) => (
          <div class="step">
            <span class="num">{i + 1}</span>
            <div>
              <h3>{s.h}</h3>
              <p>{s.p}</p>
            </div>
          </div>
        ))}
      </div>
    )}

    {t.visie && (
      <>
        <h2 class="section-title">{t.visie.titel}</h2>
        {t.visie.alineas.map((p) => (<p set:html={p} />))}
      </>
    )}

    {t.werkenBij && (
      <>
        <h2 class="section-title">{t.werkenBij.titel}</h2>
        <p set:html={t.werkenBij.tekst} />
      </>
    )}
  </div>
</section>

<style>
  .ov { max-width: 900px; }
  .ov h2.section-title { color: var(--navy); margin-top: 40px; }
  .ov h2.section-title:first-child { margin-top: 0; }
  .ov p { color: var(--text); font-size: 17px; margin-bottom: 16px; }
  .ov img { max-width: 100%; height: auto; border-radius: var(--radius); }
  .ov a { color: var(--blue); font-weight: 600; }
  .steps { display: grid; gap: 18px; margin: 24px 0 8px; }
  .step { display: grid; grid-template-columns: auto 1fr; gap: 18px; align-items: start; background: var(--bg); border: 1px solid var(--line); border-radius: var(--radius); padding: 22px 24px; }
  .step .num { width: 40px; height: 40px; border-radius:var(--radius-sm); background: var(--navy); color: #fff; font-weight: 800; display: flex; align-items: center; justify-content: center; }
  .step h3 { color: var(--navy); font-size: 20px; margin-bottom: 6px; }
  .step p { margin-bottom: 0; font-size: 16px; color: var(--muted); }
  .founder{ padding:48px 0; border-top:1px solid var(--line); border-bottom:1px solid var(--line); }
  .founder-grid{ display:grid; grid-template-columns:220px 1fr; gap:36px; align-items:center; }
  .founder-photo :global(img){ width:220px; height:264px; object-fit:cover; border-radius:var(--radius); display:block; box-shadow:var(--shadow-sm); }
  .founder h2{ margin:6px 0 10px; }
  .founder p{ color: var(--text); font-size: 17px; margin-bottom: 16px; }
  .founder-meta{ color:var(--muted); font-weight:600; margin-top:10px; }
  @media(max-width:720px){ .founder-grid{ grid-template-columns:1fr; text-align:center; } .founder-photo :global(img){ margin:0 auto; } }
</style>
