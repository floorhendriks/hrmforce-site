  .pm-vendor { display: inline-block; background: var(--navy); color: #fff; font-size: 11.5px; font-weight: 700; padding: 3px 10px; border-radius: 999px; margin-bottom: 8px; }
  .pm-body h2 { color: var(--navy); font-size: 1.5rem; margin: 0 0 10px; }
  .pm-tags { display: flex; flex-wrap: wrap; gap: 6px; margin-bottom: 12px; }
  .pm-price { color: var(--navy); font-weight: 800; font-size: 1.3rem; margin-bottom: 14px; }
  .pm-desc { color: var(--text); font-size: 14.5px; line-height: 1.6; margin-bottom: 20px; }
