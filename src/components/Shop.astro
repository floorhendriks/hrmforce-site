  .pm-faq-item summary::-webkit-details-marker { display: none; }
  .pm-faq-item summary::before { content: "+"; color: var(--accent); font-weight: 800; margin-right: 8px; }
  .pm-faq-item[open] summary::before { content: "–"; }
  .pm-faq-item p { color: var(--muted); font-size: 13.5px; line-height: 1.55; margin: 8px 0 0; }
  .pm-add { width: 100%; padding: 13px 18px; font-size: 15px; box-shadow: 0 6px 16px rgba(217,93,21,.30); transition: box-shadow .15s, transform .1s; }
  .pm-add:hover { box-shadow: 0 9px 22px rgba(217,93,21,.40); transform: translateY(-1px); }
  @media (max-width: 680px) { .pm-panel { grid-template-columns: 1fr; overflow-y: auto; } .pm-media { min-height: 160px; } .pm-body { max-height: none; } }
</style>

<script is:inline define:vars={{ L, ENRICH, LANG, IMGMAP: shopImages, SC: SHOP_CONTENT, FORM: FORMSPREE_ENDPOINT, VENDOR_LOGO, RQ: rq, FAQ_SEG, FAQ_DEFAULT }}>
  (function () {
    var app = document.getElementById("shopApp");
    if (!app) return;
    var DOMAIN = app.dataset.domain, TOKEN = app.dataset.token, VER = app.dataset.version, PUBLIC = app.dataset.publicurl;
    var grid = document.getElementById("shopGrid");
    var countEl = document.getElementById("shopCount");
    var statusEl = document.getElementById("shopStatus");
    var q = document.getElementById("shopq");
    var fCyclus = document.getElementById("fCyclus"), fSegment = document.getElementById("fSegment"), fUitgever = document.getElementById("fUitgever");
    var products = [];
    var CART_KEY = "hrmforce_cart_id";
    var cart = null; // { id, checkoutUrl, subtotal, lines:[{lineId,variantId,title,image,qty,price}] }

    function gql(query, variables) {
      return fetch("https://" + DOMAIN + "/api/" + VER + "/graphql.json", {
        method: "POST",
        headers: { "Content-Type": "application/json", "X-Shopify-Storefront-Access-Token": TOKEN },
        body: JSON.stringify({ query: query, variables: variables || {} }),
      }).then(function (r) { return r.json(); });
    }

    var CART_FIELDS = "{ id checkoutUrl totalQuantity cost { subtotalAmount { amount currencyCode } } lines(first:100){ edges { node { id quantity merchandise { ... on ProductVariant { id price { amount currencyCode } product { title featuredImage { url } } } } } } } }";

    var CYCLUS_TAGS = ["Voorselectie", "Selectie", "Ontwikkeling", "Doorstroom", "Mobiliteit", "Employability", "Functioneren", "Beoordelen"];
    function parseTaxo(node) {
      var cyclus = (node.tags || []).filter(function (t) { return CYCLUS_TAGS.indexOf(t) > -1; });
      var uit = node.vendor && node.vendor !== "My Store" ? node.vendor : null;
      return { cyclus: cyclus, segment: node.productType ? [node.productType] : [], uitgever: uit };
    }
    function money(a, c) { var n = parseFloat(a); return (c === "EUR" ? "€" : (c + " ")) + n.toFixed(2).replace(".", ","); }
    function fillSelect(sel, values) { values.sort().forEach(function (v) { var o = document.createElement("option"); o.value = v; o.textContent = v; sel.appendChild(o); }); }
    function esc(s) { return (s || "").replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;").replace(/"/g, "&quot;"); }
    function enrichImg(p) { return (IMGMAP && IMGMAP[p.handle]) || (p.taxo.segment[0] && ENRICH.imgBySeg[p.taxo.segment[0]]) || ENRICH.defImg; }
    function enrichD(p) { return ENRICH.desc[LANG] || ENRICH.desc.nl; }
    function enrichText(p) { return enrichD(p).intro.replace("{name}", p.title); }
    function enrichHtml(p) { var d = enrichD(p); return "<p>" + esc(d.intro.replace("{name}", p.title)) + "</p><p>" + esc(d.body) + "</p><ul>" + d.bullets.map(function (b) { return "<li>" + esc(b) + "</li>"; }).join("") + "</ul>"; }
    function enrichBullets() { var d = enrichD(); return "<ul>" + d.bullets.map(function (b) { return "<li>" + esc(b) + "</li>"; }).join("") + "</ul>"; }

    /* ---------- Echte productinhoud (van hrmforce.com) + logo per product ---------- */
    function scFor(p) { return (SC && SC[p.title]) || null; }
    // Echte beschrijving (NL) uit SHOP_CONTENT; val terug op de generieke tekst.
    function descOf(p) { var c = scFor(p); if (!c || !c.desc) return null; return (typeof c.desc === "string") ? c.desc : (c.desc[LANG] || c.desc.nl); }
    function descText(p) { return descOf(p) || enrichText(p); }
    function descHtml(p) { var d = descOf(p); return d ? ("<p>" + esc(d) + "</p>" + enrichBullets()) : enrichHtml(p); }
    // FAQ per product: segment-specifiek + algemeen (≥10) uit shop-faq.js.
    function faqOf(p) { var seg = (p.taxo && p.taxo.segment && p.taxo.segment[0]); return (seg && FAQ_SEG[seg]) || FAQ_DEFAULT; }
    // Logo-URL: eigen merk-/testlogo van het product, anders het uitgeverslogo.
    function brandUrl(p) {
      var c = scFor(p);
      var vend = (c && c.vendor) || (p.taxo && p.taxo.uitgever) || "";
      if (c && c.img && c.img.indexOf("Generaltesticon") === -1) return c.img;
      return VENDOR_LOGO[vend] || null;
    }
    function vendorName(p) { var c = scFor(p); return (c && c.vendor) || (p.taxo && p.taxo.uitgever) || ""; }
    // Badge-HTML: toont het logo; valt bij een laadfout terug op de naam.
    function brandBadge(p) {
      var url = brandUrl(p), vn = vendorName(p);
      if (url) return '<span class="sp-brand"><img src="' + url + '" alt="' + esc(vn) + '" loading="lazy" onerror="this.parentNode.classList.add(\'is-txt\');this.remove();"><em>' + esc(vn) + "</em></span>";
      return vn ? '<span class="sp-brand is-txt"><em>' + esc(vn) + "</em></span>" : "";
    }

    var PRODUCTS_Q =
      "{ products(first: 250, sortKey: TITLE) { edges { node { title handle description descriptionHtml tags vendor productType availableForSale " +
      "featuredImage { url altText } priceRange { minVariantPrice { amount currencyCode } } " +
      "variants(first: 1) { edges { node { id availableForSale } } } } } } }";

    /* ---------- Winkelmand ---------- */
    function mapCart(c) {
      if (!c) return null;
      return {
        id: c.id, checkoutUrl: c.checkoutUrl, qty: c.totalQuantity,
        subtotal: c.cost ? money(c.cost.subtotalAmount.amount, c.cost.subtotalAmount.currencyCode) : "",
        lines: (c.lines.edges || []).map(function (e) {
          var n = e.node, m = n.merchandise || {};
          return { lineId: n.id, variantId: m.id, qty: n.quantity,
            title: m.product ? m.product.title : "", image: m.product && m.product.featuredImage ? m.product.featuredImage.url : null,
            price: m.price ? money(m.price.amount, m.price.currencyCode) : "" };
        }),
      };
    }
    function saveCartId(id) { try { id ? localStorage.setItem(CART_KEY, id) : localStorage.removeItem(CART_KEY); } catch (e) {} }

    function ensureCart() {
      if (cart && cart.id) return Promise.resolve(cart.id);
      var M = "mutation { cartCreate { cart " + CART_FIELDS + " } }";
      return gql(M).then(function (r) {
        var c = r.data.cartCreate.cart; cart = mapCart(c); saveCartId(cart.id); return cart.id;
      });
    }
    function addToCart(variantId, btn) {
      var old = btn ? btn.textContent : "";
      if (btn) { btn.disabled = true; btn.textContent = L.busy; }
      ensureCart().then(function (id) {
        var M = "mutation($id:ID!,$lines:[CartLineInput!]!){ cartLinesAdd(cartId:$id, lines:$lines){ cart " + CART_FIELDS + " } }";
        return gql(M, { id: id, lines: [{ merchandiseId: variantId, quantity: 1 }] });
      }).then(function (r) {
        cart = mapCart(r.data.cartLinesAdd.cart); renderCart(); updateFab();
        if (btn) { btn.textContent = L.added; btn.classList.add("is-added"); setTimeout(function () { btn.disabled = false; btn.textContent = old || L.add; btn.classList.remove("is-added"); }, 1400); }
        openCart();
      }).catch(function () { if (btn) { btn.disabled = false; btn.textContent = old || L.add; } });
    }
    function changeQty(lineId, qty) {
      if (qty < 1) return removeLine(lineId);
      var M = "mutation($id:ID!,$lines:[CartLineUpdateInput!]!){ cartLinesUpdate(cartId:$id, lines:$lines){ cart " + CART_FIELDS + " } }";
      gql(M, { id: cart.id, lines: [{ id: lineId, quantity: qty }] }).then(function (r) { cart = mapCart(r.data.cartLinesUpdate.cart); renderCart(); updateFab(); });
    }
    function removeLine(lineId) {
      var M = "mutation($id:ID!,$ids:[ID!]!){ cartLinesRemove(cartId:$id, lineIds:$ids){ cart " + CART_FIELDS + " } }";
      gql(M, { id: cart.id, ids: [lineId] }).then(function (r) { cart = mapCart(r.data.cartLinesRemove.cart); renderCart(); updateFab(); });
    }

    var fab = document.getElementById("cartFab");
    var cartCount = document.getElementById("cartCount");
    var drawer = document.getElementById("cartDrawer");
    var overlay = document.getElementById("cartOverlay");
    var linesEl = document.getElementById("cartLines");
    var footEl = document.getElementById("cartFoot");
    function updateFab() {
      var n = cart ? cart.qty : 0;
      if (n > 0) { fab.hidden = false; cartCount.textContent = n; } else { fab.hidden = true; }
    }
    function renderCart() {
      if (!cart || !cart.lines.length) { linesEl.innerHTML = '<p class="cart-empty">' + esc(L.empty) + "</p>"; footEl.hidden = true; return; }
      var html = "";
      cart.lines.forEach(function (l) {
        var im = l.image ? 'style="background-image:url(\'' + l.image + "')\"" : "";
        html += '<div class="cl"><div class="cl-img" ' + im + "></div>" +
          '<div class="cl-info"><p class="cl-title">' + esc(l.title) + '</p><span class="cl-price">' + l.price + " " + esc(L.each) + "</span>" +
          '<div class="cl-ctrls"><span class="cl-qty"><button type="button" data-dec="' + l.lineId + '">−</button><span>' + l.qty + '</span><button type="button" data-inc="' + l.lineId + '">+</button></span>' +
          '<button class="cl-rm" data-rm="' + l.lineId + '">' + esc(L.remove) + "</button></div></div></div>";
      });
      linesEl.innerHTML = html;
      footEl.hidden = false;
      document.getElementById("cartSubtotal").textContent = cart.subtotal;
      document.getElementById("cartCheckout").href = cart.checkoutUrl || "#";
    }
    function openCart() { renderCart(); overlay.hidden = false; drawer.hidden = false; }
    function closeCart() { overlay.hidden = true; drawer.hidden = true; }
    fab.addEventListener("click", openCart);
    document.getElementById("cartClose").addEventListener("click", closeCart);
    overlay.addEventListener("click", closeCart);
    linesEl.addEventListener("click", function (e) {
      var t = e.target;
      var q = cart.lines.filter(function (x) { return x.lineId === (t.dataset.inc || t.dataset.dec || t.dataset.rm); })[0];
      if (t.dataset.inc && q) changeQty(t.dataset.inc, q.qty + 1);
      else if (t.dataset.dec && q) changeQty(t.dataset.dec, q.qty - 1);
      else if (t.dataset.rm) removeLine(t.dataset.rm);
    });

    /* ---------- Product-detail-paneel ---------- */
    var pmOverlay = document.getElementById("pmOverlay");
    function openProduct(p) {
      document.getElementById("pmTitle").textContent = p.title;
      document.getElementById("pmPrice").textContent = p.price;
      document.getElementById("pmImg").style.backgroundImage = "url('" + enrichImg(p) + "')";
      var vd = document.getElementById("pmVendor");
      var _burl = brandUrl(p), _vn = vendorName(p);
      if (_burl) { vd.className = "pm-brand"; vd.innerHTML = '<img src="' + _burl + '" alt="' + esc(_vn) + '" onerror="this.remove()">'; vd.hidden = false; }
      else if (_vn) { vd.className = "pm-vendor"; vd.textContent = _vn; vd.hidden = false; }
      else vd.hidden = true;
      document.getElementById("pmTags").innerHTML = p.taxo.cyclus.concat(p.taxo.segment).map(function (x) { return '<span class="sp-tag">' + esc(x) + "</span>"; }).join("");
      document.getElementById("pmDesc").innerHTML = descHtml(p);
      var faqs = faqOf(p);
      document.getElementById("pmFaq").innerHTML = faqs.map(function (f) { return '<details class="pm-faq-item"><summary>' + esc(f.q) + '</summary><p>' + esc(f.a) + "</p></details>"; }).join("");
      var add = document.getElementById("pmAdd");
      add.disabled = !(p.variantId && p.available);
      add.textContent = L.add;
      add.onclick = function () { if (p.variantId) { addToCart(p.variantId, add); } };
      // Voorbeeldrapport-formulier resetten voor dit product
      var _rq = document.getElementById("pmReq");
      if (_rq) {
        document.getElementById("pmReqProduct").value = p.title;
        _rq.querySelector(".pm-req-row").style.display = "";
        document.getElementById("pmReqPhone").style.display = "";
        var _rb = document.getElementById("pmReqBtn"); _rb.style.display = ""; _rb.disabled = false; _rb.textContent = RQ.submit;
        document.getElementById("pmReqDone").hidden = true;
        document.getElementById("pmReqName").value = ""; document.getElementById("pmReqEmail").value = ""; document.getElementById("pmReqPhone").value = "";
      }
      pmOverlay.hidden = false;
    }
    document.getElementById("pmClose").addEventListener("click", function () { pmOverlay.hidden = true; });
    var _reqForm = document.getElementById("pmReq");
    if (_reqForm) _reqForm.addEventListener("submit", function (e) {
      e.preventDefault();
      var btn = document.getElementById("pmReqBtn"); btn.disabled = true; btn.textContent = RQ.sending;
      fetch(FORM, { method: "POST", headers: { Accept: "application/json" }, body: new FormData(_reqForm) })
        .then(function (r) {
          if (r.ok) { _reqForm.querySelector(".pm-req-row").style.display = "none"; document.getElementById("pmReqPhone").style.display = "none"; btn.style.display = "none"; document.getElementById("pmReqDone").hidden = false; }
          else { btn.disabled = false; btn.textContent = RQ.submit; }
        })
        .catch(function () { btn.disabled = false; btn.textContent = RQ.submit; });
    });
    pmOverlay.addEventListener("click", function (e) { if (e.target === pmOverlay) pmOverlay.hidden = true; });

    /* ---------- Grid ---------- */
    function render() {
      var term = (q.value || "").trim().toLowerCase();
      var c = fCyclus.value, s = fSegment.value, u = fUitgever.value;
      var html = "", shown = 0;
      products.forEach(function (p, idx) {
        var okC = !c || p.taxo.cyclus.indexOf(c) > -1;
        var okS = !s || p.taxo.segment.indexOf(s) > -1;
        var okU = !u || p.taxo.uitgever === u;
        var okT = !term || p.title.toLowerCase().indexOf(term) > -1;
        if (!(okC && okS && okU && okT)) return;
        shown++;
        var chips = p.taxo.cyclus.concat(p.taxo.segment).slice(0, 3).map(function (x) { return '<span class="sp-tag">' + esc(x) + "</span>"; }).join("");
        var img = 'style="background-image:url(\'' + enrichImg(p) + "')\"" ;
        var vendor = brandBadge(p);
        var et = descText(p); var desc = '<p class="sp-desc">' + esc(et).slice(0, 130) + (et.length > 130 ? "…" : "") + "</p>";
        var buy = p.variantId && p.available
          ? '<button class="sp-buy" data-add="' + idx + '">' + esc(L.add) + "</button>"
          : '<button class="sp-buy" data-open="' + idx + '">' + esc(L.view) + "</button>";
        html +=
          '<div class="sp-card">' +
          '<button class="sp-img" ' + img + ' data-open="' + idx + '" aria-label="' + esc(p.title) + '">' + vendor + "</button>" +
          '<div class="sp-body"><div class="sp-tags">' + chips + "</div>" +
          '<button class="sp-title" data-open="' + idx + '">' + esc(p.title) + "</button>" +
          desc +
          '<div class="sp-foot"><span class="sp-price">' + p.price + "</span>" + buy + "</div>" +
          '<button class="sp-more" data-open="' + idx + '">' + esc(L.more) + "</button>" +
          "</div></div>";
      });
      grid.innerHTML = html;
      countEl.textContent = shown + " " + L.countMid + " " + products.length + " " + L.countUnit;
      grid.querySelectorAll("[data-add]").forEach(function (b) { b.addEventListener("click", function () { addToCart(products[+b.dataset.add].variantId, b); }); });
      grid.querySelectorAll("[data-open]").forEach(function (b) { b.addEventListener("click", function () { openProduct(products[+b.dataset.open]); }); });
    }

    countEl.textContent = L.loading;
    gql(PRODUCTS_Q).then(function (res) {
      var edges = res && res.data && res.data.products && res.data.products.edges;
      if (!edges) throw new Error("no products");
      var cycSet = {}, segSet = {}, uitSet = {};
      products = edges.filter(function (e) { return (e.node.vendor || "") !== "Pera"; }).map(function (e) {
        var n = e.node, taxo = parseTaxo(n);
        taxo.cyclus.forEach(function (x) { cycSet[x] = 1; });
        taxo.segment.forEach(function (x) { segSet[x] = 1; });
        if (taxo.uitgever) uitSet[taxo.uitgever] = 1;
        var v = n.variants && n.variants.edges && n.variants.edges[0] && n.variants.edges[0].node;
        return {
          title: n.title, handle: n.handle, taxo: taxo, desc: n.description || "", descHtml: n.descriptionHtml || "",
          image: n.featuredImage ? n.featuredImage.url : null,
          price: n.priceRange ? money(n.priceRange.minVariantPrice.amount, n.priceRange.minVariantPrice.currencyCode) : "",
          variantId: v ? v.id : null, available: v ? v.availableForSale : false,
        };
      });
      fillSelect(fCyclus, Object.keys(cycSet));
      fillSelect(fSegment, Object.keys(segSet));
      fillSelect(fUitgever, Object.keys(uitSet));
      render();
    }).catch(function () {
      countEl.textContent = "";
      statusEl.hidden = false;
      statusEl.innerHTML = L.loadErrorPre + '<a href="' + PUBLIC + '">' + L.toShop + "</a>";
    });

    // Bestaande winkelmand herstellen (indien nog geldig).
    var savedId = null; try { savedId = localStorage.getItem(CART_KEY); } catch (e) {}
    if (savedId) {
      gql("query($id:ID!){ cart(id:$id) " + CART_FIELDS + " }", { id: savedId }).then(function (r) {
        if (r.data && r.data.cart) { cart = mapCart(r.data.cart); updateFab(); } else saveCartId(null);
      }).catch(function () {});
    }

    [q, fCyclus, fSegment, fUitgever].forEach(function (el) { el.addEventListener(el === q ? "input" : "change", render); });
    document.getElementById("shopReset").addEventListener("click", function () { q.value = ""; fCyclus.value = ""; fSegment.value = ""; fUitgever.value = ""; render(); });
    document.addEventListener("keydown", function (e) { if (e.key === "Escape") { closeCart(); pmOverlay.hidden = true; } });
  })();
</script>
