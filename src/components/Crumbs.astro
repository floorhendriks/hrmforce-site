---
interface Props { items: { label: string; href?: string }[] }
const { items } = Astro.props;
---
<nav class="hsf-crumbs" aria-label="Breadcrumb">
  {items.map((it, i) => (
    <>
      {i > 0 && <span aria-hidden="true"> / </span>}
      {it.href ? <a href={it.href}>{it.label}</a> : <span>{it.label}</span>}
    </>
  ))}
</nav>
