---
/* Alle gratis tests bij elkaar: de vijf capaciteitenonderdelen, de zes
   vragenlijsten en de kleurentest. Staat onderaan elke oefentestpagina en op
   de overzichtspagina, zodat bezoekers die er één doen de rest ook zien. */
import { ONDERDELEN } from "../data/oefentest-ui.js";
import { VRAGENLIJSTEN } from "../data/oefenvragenlijst.js";
import { localizePath } from "../i18n/utils.js";
import { GRATIS_TEKST } from "../data/component-teksten.js";

const { lang = "nl", huidig = "" } = Astro.props;

const TEKST = GRATIS_TEKST;

const tk = TEKST[lang] || TEKST.nl;
const basis = localizePath("/oefentest/", lang);

const kaarten = [
  ...Object.entries(VRAGENLIJSTEN).map(([sleutel, o]) => ({
    sleutel,
    naam: o.naam[lang] || o.naam.nl,
    lead: o.lead[lang] || o.lead.nl,
    href: `${basis}${o.slug[lang] || o.slug.nl}/`,
  })),
  ...Object.entries(ONDERDELEN).map(([sleutel, o]) => ({
    sleutel,
    naam: o.naam[lang] || o.naam.nl,
    lead: o.lead[lang] || o.lead.nl,
    href: `${basis}${o.slug[lang] || o.slug.nl}/`,
  })),
  {
    sleutel: "kleuren",
    naam: tk.kleurNaam,
    lead: tk.kleurLead,
    href: localizePath("/gratis-kleurentest/", lang),
  },
].filter((k) => k.sleutel !== huidig);
---

<section class="bg-soft gt-sectie"><div class="wrap" style="display:block">
  <div class="eyebrow">{tk.kop}</div>
  <h2 class="section-title">{tk.kop}</h2>
  <p class="gt-lead">{tk.lead}</p>
  <div class="gt-grid">
    {kaarten.map((k) => (
      <a class="gt-kaart" href={k.href}>
        <span class="gt-naam">{k.naam}</span>
        <span class="gt-lead-k">{k.lead}</span>
        <span class="gt-cta">{tk.start} &rarr;</span>
      </a>
    ))}
  </div>
</div></section>

<style>
  .gt-sectie { padding-top:46px; padding-bottom:46px; }
  .gt-lead { max-width:820px; color:var(--muted); margin:0 0 18px; }
  .gt-grid { display:grid; grid-template-columns:repeat(3,1fr); gap:16px; }
  .gt-kaart { display:flex; flex-direction:column; gap:8px; background:#fff; border:1px solid var(--line); border-radius:var(--radius); padding:20px 22px; text-decoration:none; }
  .gt-kaart:hover { box-shadow:var(--shadow-sm); }
  .gt-naam { color:var(--navy); font-weight:800; font-size:17px; }
  .gt-lead-k { color:var(--muted); font-size:14px; line-height:1.55; }
  .gt-cta { color:var(--blue); font-weight:700; font-size:13.5px; margin-top:auto; padding-top:4px; }
  @media (max-width:980px) { .gt-grid { grid-template-columns:repeat(2,1fr); } }
  @media (max-width:640px) { .gt-grid { grid-template-columns:1fr; } }
</style>
