---
// De pagina HRM oplossingen, in elke taal dezelfde opbouw. De teksten komen uit
// src/data/oplossingen-hub.js, de links worden per taal gezet.
import Base from "../layouts/Base.astro";
import { oplossingenHubVoor } from "../data/oplossingen-hub.js";
import { localizePath, demoPath } from "../i18n/utils.js";

const lang = Astro.props.lang || "nl";
const t = oplossingenHubVoor(lang);

const cycIcons = {
  search: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/></svg>`,
  grow: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 20h18"/><path d="M7 20V12M12 20V7M17 20v-5"/></svg>`,
  talk: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg>`,
  check: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 11l3 3 8-8"/><path d="M21 12v7a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11"/></svg>`,
};

// Inline SVG-iconen per oplossing (strak, navy via currentColor).
const icons = {
  target: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"/><circle cx="12" cy="12" r="5"/><circle cx="12" cy="12" r="1"/></svg>`,
  cycle: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12a9 9 0 1 1-3-6.7"/><polyline points="21 3 21 8 16 8"/></svg>`,
  compass: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"/><polygon points="15.5 8.5 10.5 10.5 8.5 15.5 13.5 13.5 15.5 8.5"/></svg>`,
  chart: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="4" y1="20" x2="4" y2="12"/><line x1="10" y1="20" x2="10" y2="4"/><line x1="16" y1="20" x2="16" y2="9"/><line x1="21" y1="20" x2="3" y2="20"/></svg>`,
};
---
<Base title={t.meta.title} description={t.meta.description} active="solutions">
  <div class="crumb">
    <div class="wrap"><a href={localizePath("/", lang)}>{t.crumb.home}</a> › <span>{t.crumb.hier}</span></div>
  </div>

  <section class="ahero">
    <div class="wrap" style="display:block">
      <div class="eyebrow">{t.hero.eyebrow}</div>
      <h1>{t.hero.title}</h1>
      <p style="color:#c4d2e6;font-size:19px;max-width:780px;margin-top:8px">{t.hero.lead}</p>
    </div>
  </section>

  <section>
    <div class="wrap">
      <div class="center">
        <div class="eyebrow" style="justify-content:center">{t.cyclusKop.eyebrow}</div>
        <h2 class="section-title">{t.cyclusKop.title}</h2>
        <p class="lead" style="max-width:760px;margin:0 auto 8px">{t.cyclusKop.lead}</p>
      </div>
      <ol class="cyclus">
        {t.cyclus.map((c, i) => (
          <li class="cyc-step">
            <span class="cyc-n">{i + 1}</span>
            <span class="cyc-ic" set:html={cycIcons[c.icon]}></span>
            <h3>{c.t}</h3>
            <p>{c.d}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section style="background:var(--bg)">
    <div class="wrap">
      <div class="eyebrow">{t.blokkenKop.eyebrow}</div>
      <h2 class="section-title" style="margin-bottom:28px">{t.blokkenKop.title}</h2>
      <div class="sol">
        {t.blocks.map((b) => (
          <a class="sol-block card" href={localizePath(b.href, lang)}>
            <span class="sol-ic" set:html={icons[b.icon]}></span>
            <h3>{b.h}</h3>
            <p>{b.p}</p>
            <span class="readmore">{t.readmore} &rarr;</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="cta">
    <div class="wrap">
      <h2>{t.cta.title}</h2>
      <p>{t.cta.lead}</p>
      <div class="btns">
        <a href={demoPath(lang)} class="btn btn-primary">{t.cta.demo}</a>
        <a href={localizePath("/tarieven/", lang)} class="btn btn-light">{t.cta.tarieven}</a>
      </div>
    </div>
  </section>
  <section class="roi-band"><div class="wrap">
    <div class="roi-band-inner">
      <div>
        <div class="eyebrow">{t.roi.eyebrow}</div>
        <h2>{t.roi.title}</h2>
        <p>{t.roi.lead}</p>
      </div>
      <a href={localizePath("/roi-rekentool/", lang)} class="btn btn-primary">{t.roi.knop}</a>
    </div>
  </div></section>
  <style>
    .roi-band{padding:8px 0 48px}
    .roi-band-inner{display:flex;flex-wrap:wrap;gap:22px;align-items:center;justify-content:space-between;background:var(--navy);border-radius:var(--radius);padding:34px 32px}
    .roi-band-inner h2{color:#fff;margin:6px 0 8px;font-size:1.5rem}
    .roi-band-inner p{color:#c4d2e6;max-width:560px;font-size:15px;line-height:1.6;margin:0}
    .roi-band-inner .btn{flex:none}
    @media(max-width:760px){.roi-band-inner{flex-direction:column;align-items:flex-start}.roi-band-inner .btn{width:100%;text-align:center}}
  </style>
</Base>

<style>
  .cyclus { list-style: none; margin: 34px 0 0; padding: 0; display: grid; grid-template-columns: repeat(4, 1fr); gap: 0; }
  .cyc-step { position: relative; background: #fff; border: 1px solid var(--line); padding: 26px 22px; text-align: left; }
  .cyc-step:first-child { border-radius: var(--radius) 0 0 var(--radius); }
  .cyc-step:last-child { border-radius: 0 var(--radius) var(--radius) 0; }
  .cyc-step:not(:last-child) { border-right: none; }
  .cyc-step:not(:last-child)::after {
    content: ""; position: absolute; right: -11px; top: 50%; transform: translateY(-50%) rotate(45deg);
    width: 20px; height: 20px; background: #fff; border-top: 1px solid var(--line); border-right: 1px solid var(--line); z-index: 2;
  }
  .cyc-ic { display: block; width: 26px; height: 26px; color: var(--gold); margin: 0 0 8px; }
  .cyc-ic :global(svg) { width: 26px; height: 26px; }
  .cyc-n { display: inline-flex; align-items: center; justify-content: center; width: 34px; height: 34px; border-radius:var(--radius-sm); background: var(--navy); color: #fff; font-weight: 800; margin-bottom: 12px; }
  .cyc-step h3 { color: var(--navy); font-size: 1.1rem; margin-bottom: 6px; }
  .cyc-step p { color: var(--muted); font-size: 14px; line-height: 1.55; }
  @media (max-width: 880px) { .cyclus { grid-template-columns: 1fr 1fr; } .cyc-step, .cyc-step:first-child, .cyc-step:last-child { border-radius: var(--radius); border: 1px solid var(--line); margin: 6px; } .cyc-step::after { display: none; } }
  @media (max-width: 520px) { .cyclus { grid-template-columns: 1fr; } }

  .sol { display: grid; grid-template-columns: repeat(2, 1fr); gap: 24px; }
  .sol-block { display: flex; flex-direction: column; text-decoration: none; color: inherit; }
  .sol-ic { width: 56px; height: 56px; border-radius:0; background:transparent; display: inline-flex; align-items: center; justify-content: center; margin-bottom: 16px; color: var(--navy); border-left:2px solid var(--gold);padding-left:12px;width:auto;justify-content:flex-start;}
  .sol-ic :global(svg) { width: 28px; height: 28px; }
  .sol-block h3 { color: var(--navy); font-size: 22px; font-weight: 800; margin-bottom: 10px; }
  .sol-block p { color: var(--muted); font-size: 16px; margin-bottom: 16px; flex: 1; }
  .readmore { color: var(--accent); font-weight: 700; font-size: 15px; }
  @media (max-width: 880px) { .sol { grid-template-columns: 1fr; } }
</style>
