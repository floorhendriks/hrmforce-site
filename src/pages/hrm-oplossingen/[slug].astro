---
// De Nederlandse detailpagina's; de andere talen lopen via
// src/pages/[lang]/hrm-oplossingen/[slug].astro.
import OplossingDetail from "../../components/OplossingDetail.astro";
import { oplossingenVoor } from "../../data/oplossingen.js";

export async function getStaticPaths() {
  return oplossingenVoor("nl").map((o) => ({ params: { slug: o.slug }, props: { o } }));
}

const { o } = Astro.props;
---
<OplossingDetail o={o} lang="nl" />
