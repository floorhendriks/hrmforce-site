---
import Base from "../layouts/Base.astro";
import { FORMSPREE_ENDPOINT, CONTACT_EMAIL } from "../data/site-config.js";

const formAction = FORMSPREE_ENDPOINT || `mailto:${CONTACT_EMAIL}`;
const useFormspree = Boolean(FORMSPREE_ENDPOINT);

const offices = [
  {
    naam: "hrmforce Germany",
    regels: ["Theodorstrasse 105", "40472 Düsseldorf", "Germany"],
    tel: "+31 (0)88 88 321 88",
    telHref: "tel:+31888832188",
    mail: "service@hrmforce.com",
  },
  {
    naam: "hrmforce Belgium",
    regels: ["Bridge Building", "Keizer Karellaan 584", "1082 Sint-Agatha-Berchem", "Belgium"],
    tel: "+32 495 66 58 97",
    telHref: "tel:+32495665897",
    mail: "belgium@hrmforce.com",
  },
  {
    naam: "hrmforce France",
    regels: ["5 Place de la Pyramide Tour Ariane", "92800 Paris, Hauts-de-Seine", "France"],
    tel: "+31 (0)88 88 321 88",
    telHref: "tel:+31888832188",
    mail: "france@hrmforce.com",
  },
  {
    naam: "hrmforce India",
    regels: ["Plot #27, 1-4-190/27/1/A, Phase-I", "Bhaskara Rao Nagar Sainikpuri P.O.", "Secunderabad – 500 094", "Telangana, India"],
    tel: "+91 89787 86121",
    telHref: "tel:+918978786121",
    mail: "india@hrmforce.com",
  },
  {
    naam: "hrmforce Romania",
    regels: ["Ploiesti Street, No 9", "400157 Cluj-Napoca", "Romania"],
    tel: "+31 (0)88 88 321 88",
    telHref: "tel:+31888832188",
    mail: "office@hrmforce.com",
  },
  {
    naam: "hrmforce Spain",
    regels: ["Carrer de les Barques 2 – 2nd floor", "46002 València", "Valencia, Spain"],
    tel: "+31 (0)88 88 321 88",
    telHref: "tel:+31888832188",
    mail: "atencioncliente@hrmforce.com",
  },
];
---
<Base
  title="Contact opnemen | Hrmforce.com"
  description="Neem contact op met hrmforce. Bel +31 (0)88 88 321 88, mail service@hrmforce.com of vul het contactformulier in. Onze adviseurs helpen je graag verder."
  active="contact"
>
  <div class="crumb">
    <div class="wrap"><a href="/">Home</a> › <span>Contact</span></div>
  </div>

  <section class="ahero">
    <div class="wrap" style="display:block">
      <div class="eyebrow" style="color:var(--gold)">Contact</div>
      <h1>Interesse of heb je een vraag? Neem contact met ons op.</h1>
      <p style="color:#c4d2e6;font-size:19px;max-width:820px;margin-top:8px">
        Wij helpen je graag en denken mee om samen tot een passende oplossing te komen.
        Aarzel dus niet, maar leg je vraag of idee meteen voor aan onze adviseurs.
        Vul het contactformulier in of bel ons en ga direct in gesprek.
      </p>
    </div>
  </section>

  <section class="formsec">
    <div class="wrap contact-grid">
      <div class="contact-info">
        <div class="office-box">
          <div class="eyebrow">hrmforce head office</div>
          <h2 class="section-title" style="font-size:26px;margin-top:4px">Amsterdam</h2>
          <p class="addr">Solitudolaan 396<br />1096 DS Amsterdam<br />The Netherlands</p>
          <div class="ci-row"><span class="ci-lbl">Telefoon</span><a href="tel:+31888832188">+31 (0)88 88 321 88</a></div>
          <div class="ci-row"><span class="ci-lbl">E-mail</span><a href="mailto:service@hrmforce.com">service@hrmforce.com</a></div>
          <p class="hours"><strong>Bereikbaarheid</strong><br />Onze adviseurs zijn bereikbaar op maandag t/m vrijdag van 08:00 tot 18:00 uur.</p>
          <p class="ci-legal">KvK Amsterdam 34369982 &middot; BTW NL821671480B01 &middot; IBAN NL31 RABO 0155 7584 11</p>
        </div>

        <div class="map">
          <iframe
            title="Locatie hrmforce Amsterdam"
            src="https://maps.google.com/maps?q=Solitudolaan%20396%2C%201096%20DS%20Amsterdam&t=&z=15&ie=UTF8&iwloc=&output=embed"
            loading="lazy"
            referrerpolicy="no-referrer-when-downgrade"
          ></iframe>
        </div>
      </div>

      <div>
        <div class="eyebrow">Contactformulier</div>
        <h2 class="section-title" style="font-size:26px">Stuur ons een bericht</h2>
        <div class="person-card"><img src="/media/team/floor-hendriks.webp" alt="Floor Hendriks, hrmforce" width="72" height="72" loading="lazy" /><div><strong>Liever persoonlijk contact?</strong><span>We helpen je graag verder. Bel of mail gerust, we reageren snel.</span><span class="person-name">Floor Hendriks &middot; hrmforce</span></div></div>
        <form
          id="contactForm"
          class="formcard"
          action={formAction}
          method="POST"
          enctype={useFormspree ? "application/x-www-form-urlencoded" : "text/plain"}
          data-formspree={useFormspree ? "1" : "0"}
          novalidate
        >
          <div class="fg">
            <label for="voornaam">Voornaam *</label>
            <input type="text" id="voornaam" name="voornaam" required />
          </div>
          <div class="fg">
            <label for="bedrijf">Bedrijfsnaam *</label>
            <input type="text" id="bedrijf" name="bedrijf" required />
          </div>
          <div class="frow">
            <div class="fg">
              <label for="email">Werk e-mailadres *</label>
              <input type="email" id="email" name="email" required />
            </div>
            <div class="fg">
              <label for="telefoon">Telefoonnummer *</label>
              <input type="tel" id="telefoon" name="telefoon" required />
            </div>
          </div>
          <div class="fg">
            <label for="bericht">Waar kunnen we je mee helpen? *</label>
            <textarea id="bericht" name="bericht" rows="5" required></textarea>
          </div>
          <div class="next-steps"><strong>Wat gebeurt er daarna?</strong><ol><li>We reageren binnen 1 werkdag.</li><li>Een korte kennismaking, afgestemd op jouw vraag.</li><li>Een demo op maat, vrijblijvend.</li></ol><div class="ns-proof"><span class="ns-stars">★★★★★</span> 10.000+ deelnemers · 1.200+ organisaties · 4,9/5</div></div>
          <p id="formMsg" class="form-msg" role="status" aria-live="polite"></p>
          <button type="submit" class="btn btn-primary">Verstuur</button>
          <p class="privacy-note">
            Door dit formulier te verzenden ga je akkoord met onze
            <a href="/support/privacy-statement/">privacyverklaring</a>.
          </p>
        </form>
      </div>
    </div>
  </section>

  <section>
    <div class="wrap">
      <div class="eyebrow">Onze vestigingen</div>
      <h2 class="section-title">hrmforce wereldwijd</h2>
      <p class="lead">Naast ons hoofdkantoor in Amsterdam zijn we ook internationaal vertegenwoordigd.</p>
      <div class="office-grid">
        {offices.map((o) => (
          <div class="office-card">
            <h3>{o.naam}</h3>
            <p class="addr">{o.regels.map((r, i) => (<>{r}{i < o.regels.length - 1 && <br />}</>))}</p>
            <p class="office-contact">
              <a href={o.telHref}>{o.tel}</a><br />
              <a href={`mailto:${o.mail}`}>{o.mail}</a>
            </p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="cta">
    <div class="wrap">
      <h2>Klaar om hrmforce in actie te zien?</h2>
      <p>Plan een vrijblijvende demo en ontdek in 30 minuten hoe onze assessments en talentmanagement-software jouw HR-proces versterken.</p>
      <div class="btns">
        <a href="/contact/" class="btn btn-primary">Claim gratis demo</a>
        <a href="/online-assessments/" class="btn btn-light">Bekijk de assessments</a>
      </div>
    </div>
  </section>

  <style>
    .contact-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 48px;
      align-items: start;
    }
    .contact-info .addr {
      color: var(--muted);
      font-size: 16px;
      margin-bottom: 18px;
    }
    .contact-list,
    .legal {
      list-style: none;
      margin: 0 0 18px;
    }
    .contact-list li,
    .legal li {
      padding: 8px 0;
      border-bottom: 1px dashed var(--line);
      color: var(--text);
      font-size: 15px;
    }
    .contact-list a { color: var(--blue); font-weight: 600; }
    .contact-list a:hover { text-decoration: underline; }
    .lbl {
      display: inline-block;
      min-width: 130px;
      color: var(--navy);
      font-weight: 700;
      font-size: 13px;
      text-transform: uppercase;
      letter-spacing: .4px;
    }
    .hours {
      background: var(--bg);
      border-left: 3px solid var(--gold);
      padding: 14px 16px;
      border-radius: 8px;
      color: var(--muted);
      font-size: 15px;
      margin-bottom: 18px;
    }
    .hours strong { color: var(--navy); }
    .office-box{background:#fff;border:1px solid var(--line);border-radius:16px;padding:26px 28px;box-shadow:var(--shadow-xs);margin-bottom:18px}
    .office-box .addr{margin-bottom:16px}
    .ci-row{display:flex;gap:12px;align-items:baseline;padding:7px 0;font-size:15px;border-bottom:1px solid var(--line)}
    .ci-lbl{min-width:90px;color:var(--navy);font-weight:700;font-size:12.5px;text-transform:uppercase;letter-spacing:.4px}
    .ci-row a{color:var(--blue);font-weight:600}
    .ci-legal{color:var(--muted);font-size:12.5px;margin:14px 0 0;padding-top:14px;border-top:1px solid var(--line);line-height:1.7}
    .map {
      margin-top: 8px;
      border-radius: var(--radius);
      overflow: hidden;
      border: 1px solid var(--line);
      box-shadow: var(--shadow);
    }
    .map iframe {
      width: 100%;
      height: 260px;
      border: 0;
      display: block;
    }
    .form-msg {
      display: none;
      margin-bottom: 16px;
      padding: 12px 14px;
      border-radius: 10px;
      font-size: 14px;
      font-weight: 600;
    }
    .form-msg.error {
      display: block;
      background: #fff3f0;
      border: 1px solid var(--accent);
      color: #8a4a25;
    }
    .form-msg.success {
      display: block;
      background: #eef7ee;
      border: 1px solid #57a05a;
      color: #2f6b32;
    }
    .privacy-note {
      margin-top: 14px;
      font-size: 13px;
      color: var(--muted);
    }
    .privacy-note a { color: var(--blue); }
    .office-grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 24px;
      margin-top: 34px;
    }
    .office-card {
      background: #fff;
      border: 1px solid var(--line);
      border-radius: var(--radius);
      padding: 26px;
      box-shadow: var(--shadow);
    }
    .office-card h3 { font-size: 18px; margin-bottom: 10px; }
    .office-card .addr { color: var(--muted); font-size: 15px; margin-bottom: 12px; }
    .office-contact a { color: var(--blue); font-weight: 600; font-size: 15px; }
    .office-contact a:hover { text-decoration: underline; }
    @media (max-width: 880px) {
      .contact-grid { grid-template-columns: 1fr; }
      .office-grid { grid-template-columns: 1fr; }
    }
  
  .next-steps{background:var(--bg-soft);border:1px solid var(--line);border-radius:12px;padding:16px 18px;margin:4px 0 18px}
  .next-steps strong{color:var(--navy);font-size:14.5px;display:block;margin-bottom:8px}
  .next-steps ol{margin:0 0 10px 18px;padding:0;color:var(--text);font-size:14px;line-height:1.5}
  .next-steps li{margin:3px 0}
  .ns-proof{color:var(--muted);font-size:13px;padding-top:8px;border-top:1px solid var(--line)}
  .ns-stars{color:var(--gold);letter-spacing:1px}

  .person-card{display:flex;gap:16px;align-items:center;background:var(--bg-soft);border:1px solid var(--line);border-radius:14px;padding:16px 18px;margin:0 0 20px}
  .person-card img{width:72px;height:72px;border-radius:50%;object-fit:cover;flex:none;border:2px solid #fff;box-shadow:var(--shadow-xs)}
  .person-card strong{display:block;color:var(--navy);font-size:15.5px;margin-bottom:2px}
  .person-card span{display:block;color:var(--muted);font-size:14px;line-height:1.45}
  .person-card .person-name{color:var(--navy);font-weight:700;font-size:13px;margin-top:6px}
</style>

  <script is:inline>
    (function () {
      var form = document.getElementById("contactForm");
      if (!form) return;
      var msg = document.getElementById("formMsg");
      var useFormspree = form.getAttribute("data-formspree") === "1";
      form.addEventListener("submit", function (e) {
        var required = form.querySelectorAll("[required]");
        var missing = [];
        required.forEach(function (el) {
          if (!el.value.trim()) missing.push(el);
        });
        var email = form.querySelector("#email");
        var emailOk = email && /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email.value.trim());
        if (missing.length > 0 || !emailOk) {
          e.preventDefault();
          msg.className = "form-msg error";
          msg.textContent = missing.length > 0
            ? "Vul alle verplichte velden in voordat je verzendt."
            : "Vul een geldig e-mailadres in.";
          (missing[0] || email).focus();
          return;
        }
        if (!useFormspree) {
          // Geen Formspree geconfigureerd: val terug op mailto (standaardgedrag).
          msg.className = "form-msg success";
          msg.textContent = "Bedankt! Je bericht wordt geopend in je e-mailprogramma. Wij nemen zo snel mogelijk contact met je op.";
          return;
        }
        // Formspree: async verzenden zonder de pagina te verlaten.
        e.preventDefault();
        var btn = form.querySelector("button[type=submit]");
        if (btn) { btn.disabled = true; btn.textContent = "Verzenden…"; }
        msg.className = "form-msg";
        msg.textContent = "";
        fetch(form.action, {
          method: "POST",
          body: new FormData(form),
          headers: { Accept: "application/json" },
        })
          .then(function (r) {
            if (r.ok) {
              form.reset();
              msg.className = "form-msg success";
              msg.textContent = "Bedankt voor je bericht! We nemen zo snel mogelijk contact met je op.";
            } else {
              throw new Error("Formspree error");
            }
          })
          .catch(function () {
            msg.className = "form-msg error";
            msg.textContent = "Er ging iets mis bij het verzenden. Mail ons gerust direct op service@hrmforce.com.";
          })
          .finally(function () {
            if (btn) { btn.disabled = false; btn.textContent = "Verstuur"; }
          });
      });
    })();
  </script>
</Base>
