---
import Base from "../../layouts/Base.astro";
import Tarieven from "../../components/Tarieven.astro";
import { tarievenContent } from "../../data/tarieven-content.js";
import { perTaal } from "../../i18n/paden.js";
export function getStaticPaths() { return perTaal(); }
const { lang } = Astro.params;
const t = tarievenContent[lang];
---
<Base title={t.meta.title} description={t.meta.description} active="">
  <Tarieven t={t} lang={lang} />
</Base>
