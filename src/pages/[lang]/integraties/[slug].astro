---
import Base from "../../../layouts/Base.astro";
import IntegratieDetail from "../../../components/IntegratieDetail.astro";
import { INT_SYSTEMS, INT_UI } from "../../../data/integraties-detail.js";
import { perTaal } from "../../../i18n/paden.js";
export function getStaticPaths(){ return perTaal(INT_SYSTEMS.map((sys)=>({ params:{ slug: sys.slug }, props:{ sys } }))); }
const { lang } = Astro.params;
const { sys } = Astro.props; const ui = INT_UI[lang];
---
<Base title={`${ui.mtA}${sys.name}${ui.mtB}`} description={sys.blurb[lang]} active="solutions">
  <IntegratieDetail sys={sys} ui={ui} lang={lang} />
</Base>
