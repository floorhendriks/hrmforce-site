---
import FamilyPage from '../../../../views/FamilyPage.astro';
import { families } from '../../../../lib/hsf';
import { altItem } from '../../../../lib/alt';
import { PREFIXED } from '../../../../i18n/utils.js';
export async function getStaticPaths() {
  return PREFIXED.flatMap((lang) =>
    families
      .filter((f: any) => f.slug?.[lang])
      .map((f: any) => ({ params: { lang, slug: f.slug[lang] }, props: { fam: f } }))
  );
}
const { lang } = Astro.params;
const { fam } = Astro.props;
---
<FamilyPage lang={lang} fam={fam} alternates={altItem('families', fam.slug)} />
