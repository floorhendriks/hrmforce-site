---
import MatchPage from '../../../../views/MatchPage.astro';
import { functions, getFunction } from '../../../../lib/hsf';
import { altItem } from '../../../../lib/alt';
import { PREFIXED } from '../../../../i18n/utils.js';
export async function getStaticPaths() {
  return PREFIXED.flatMap((lang) =>
    functions
      .filter((f: any) => f.slug?.[lang])
      .map((f: any) => ({ params: { lang, slug: f.slug[lang] }, props: { id: f.id, slugs: f.slug } }))
  );
}
const { lang } = Astro.params;
const { id, slugs } = Astro.props;
const fn = await getFunction(id);
---
<MatchPage lang={lang} fn={fn} alternates={altItem('match', slugs)} />
