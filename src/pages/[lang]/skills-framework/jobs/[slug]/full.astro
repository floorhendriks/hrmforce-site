---
import FunctionFull from '../../../../../views/FunctionFull.astro';
import { functions, getFunction } from '../../../../../lib/hsf';
import { HSF_PREFIXED } from '../../../../../i18n/paden.js';
import { REKENHULP_TALEN } from '../../../../../lib/hsf-i18n';
export async function getStaticPaths() {
  // Alleen de talen met een eigen vertaling van de dataset, zie hsf-i18n.ts.
  return HSF_PREFIXED.filter((l) => REKENHULP_TALEN.includes(l)).flatMap((lang) =>
    functions
      .filter((f: any) => f.slug?.[lang])
      .map((f: any) => ({ params: { lang, slug: f.slug[lang] }, props: { id: f.id } }))
  );
}
const { lang } = Astro.params;
const fn = await getFunction(Astro.props.id);
---
<FunctionFull lang={lang} fn={fn} />
