---
import FunctionPage from '../../../../views/FunctionPage.astro';
import { functions, getFunction } from '../../../../lib/hsf';
import { altItem } from '../../../../lib/alt';
import { HSF_PREFIXED } from '../../../../i18n/paden.js';
export async function getStaticPaths() {
  return HSF_PREFIXED.flatMap((lang) =>
    functions
      .filter((f: any) => f.slug?.[lang])
      .map((f: any) => ({ params: { lang, slug: f.slug[lang] }, props: { id: f.id, slugs: f.slug } }))
  );
}
const { lang } = Astro.params;
const { id, slugs } = Astro.props;
const fn = await getFunction(id);
---
<FunctionPage lang={lang} fn={fn} alternates={altItem('functions', slugs)} />
