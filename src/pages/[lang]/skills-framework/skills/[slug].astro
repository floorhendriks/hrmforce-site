---
import SkillPage from '../../../../views/SkillPage.astro';
import { skills } from '../../../../lib/hsf';
import { altItem } from '../../../../lib/alt';
import { HSF_PREFIXED } from '../../../../i18n/paden.js';
export async function getStaticPaths() {
  return HSF_PREFIXED.flatMap((lang) =>
    skills
      .filter((s: any) => s.slug?.[lang])
      .map((s: any) => ({ params: { lang, slug: s.slug[lang] }, props: { sk: s } }))
  );
}
const { lang } = Astro.params;
const { sk } = Astro.props;
---
<SkillPage lang={lang} sk={sk} alternates={altItem('skills', sk.slug)} />
