---
import Base from "../../layouts/Base.astro";
import Wetenschap from "../../components/Wetenschap.astro";
import { wetenschapContent } from "../../data/wetenschap-content.js";
import { perTaal } from "../../i18n/paden.js";
export function getStaticPaths() { return perTaal(); }
const { lang } = Astro.params;
const t = wetenschapContent[lang];
---
<Base title={t.meta.title} description={t.meta.description} active="about">
  <Wetenschap t={t} lang={lang} />
</Base>
