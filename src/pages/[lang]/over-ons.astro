---
import Base from "../../layouts/Base.astro";
import OverOns from "../../components/OverOns.astro";
import { overOnsContent } from "../../data/over-ons-content.js";
import { perTaal } from "../../i18n/paden.js";
export function getStaticPaths() { return perTaal(); }
const { lang } = Astro.params;
const t = overOnsContent[lang];
---
<Base title={t.meta.title} description={t.meta.description} active="about">
  <OverOns t={t} lang={lang} />
</Base>
