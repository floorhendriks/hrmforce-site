---
import Img from "../../../components/Img.astro";
import Base from "../../../layouts/Base.astro";
import { assessments } from "../../../data/assessments.js";
import { assessmentsI18n } from "../../../data/assessments-i18n.js";
import { detailUi } from "../../../data/assessment-detail-ui.js";
import { shopInfo, prijs } from "../../../data/assessment-shop.js";
import { FORMSPREE_ENDPOINT, CONTACT_EMAIL } from "../../../data/site-config.js";
import { localizePath } from "../../../i18n/utils.js";
import { examplesFor } from "../../../data/assessment-examples.js";
import { extraFor } from "../../../data/assessment-detail-extra.js";
import { theoryFor } from "../../../data/assessment-theory.js";
import { generalFaq } from "../../../data/general-faq.js";
import QPreview from "../../../components/QPreview.astro";
import ReviewSlider from "../../../components/ReviewSlider.astro";
import SocialProof from "../../../components/SocialProof.astro";
import LogoSlider from "../../../components/LogoSlider.astro";
import { oefentests } from "../../../data/oefentests.js";
import { createClient } from "@sanity/client";
import { kenniscentrumContent } from "../../../data/kenniscentrum-content.js";

const formAction = FORMSPREE_ENDPOINT || `mailto:${CONTACT_EMAIL}`;

// (lang ∈ en,de,fr,es,ro) × (36 slugs). Data = merge van assessments.js
// (beeld/slug/quote.author/quote.initials) + assessmentsI18n[lang][slug] (teksten).
export async function getStaticPaths() {
  const langs = ["en", "de", "fr", "es", "ro"];
  const stripHtml = (h) => (h || "").replace(/<[^>]+>/g, " ").replace(/\s+/g, " ").trim();
  const excerpt = (h) => { const t = stripHtml(h); return t.length > 140 ? t.slice(0, 140).trim() + "\u2026" : t; };
  const kw = (t) => (t || "").toLowerCase().split(/[^a-z0-9\u00e0-\u00ff]+/).filter((w) => w.length > 4);
  const _kcClient = createClient({ projectId: "hqo56w28", dataset: "production", apiVersion: "2024-01-01", useCdn: false });
  const paths = [];
  for (const lang of langs) {
    const match = kenniscentrumContent[lang]?.sanityMatch;
    let arts = [];
    if (match) {
      try {
        arts = await _kcClient.fetch(`*[_type == "article" && defined(path) && defined(body) && (${match})] | order(date desc)[0...60]{title, path, body}`);
      } catch (e) { arts = []; }
    }
    const pool = (arts || []).filter((p) => p.path && p.title).map((p) => ({ title: p.title, path: p.path, excerpt: excerpt(p.body), words: new Set(kw(p.title)) }));
    for (const base of assessments) {
      const tr = assessmentsI18n[lang]?.[base.slug];
      if (!tr) continue;
      const merged = {
        ...base,
        ...tr,
        image: base.image,
        slug: base.slug,
        quote: {
          ...tr.quote,
          author: base.quote?.author || "",
          initials: base.quote?.initials || "",
        },
      };
      const hay = `${tr.title || ""} ${tr.phase || ""} ${tr.goal || ""} ${(tr.traits || []).join(" ")}`.toLowerCase();
      const kc = pool
        .map((p) => { let s = 0; p.words.forEach((w) => { if (hay.includes(w)) s += 1; }); return { p, s }; })
        .filter((x) => x.s > 0)
        .sort((x, y) => y.s - x.s)
        .slice(0, 3)
        .map((x) => ({ title: x.p.title, path: x.p.path, excerpt: x.p.excerpt }));
      paths.push({ params: { lang, slug: base.slug }, props: { a: merged, lang, kc } });
    }
  }
  return paths;
}

const { a, lang, kc } = Astro.props;
const _oefen = (oefentests || []).find((o) => o.assessmentSlug === a.slug);
const t = detailUi[lang] || detailUi.en;
const assessHref = localizePath("/online-assessments/", lang);
const shop = shopInfo(a.slug);

// Gerelateerde assessments: a.related bevat NL-titels (uit assessments.js).
// Koppel die aan de echte pagina's en toon de vertaalde titel/goal.
const byTitle = new Map(assessments.map((x) => [x.title, x]));
const related = (a.related || [])
  .map((title) => byTitle.get(title))
  .filter(Boolean)
  .slice(0, 3)
  .map((x) => {
    const tr = assessmentsI18n[lang]?.[x.slug] || {};
    return { title: tr.title || x.title, slug: x.slug, image: x.image, goal: tr.goal || x.goal };
  });

const ex = examplesFor(a.slug, lang);
const extra = extraFor(a.slug, lang);
const theory = theoryFor(a.slug, lang);
const _specQ = new Set((a.faq || []).map((f) => (f.q || "").trim().toLowerCase()));
const allFaq = [...(a.faq || []), ...generalFaq(lang).filter((g) => !_specQ.has((g.q || "").trim().toLowerCase()))];
const faqTitle = t.faqTitle.replace("{t}", a.title);
const howTitle = t.howTitle.replace("{t}", a.title);
const requestTitle = t.requestTitle.replace("{t}", a.title);
const _canon = new URL(Astro.url.pathname, "https://hrmforce.com").href;
const _crumbLd = { "@context": "https://schema.org", "@type": "BreadcrumbList", itemListElement: [
  { "@type": "ListItem", position: 1, name: "Home", item: "https://hrmforce.com/" },
  { "@type": "ListItem", position: 2, name: "Online assessments", item: new URL(assessHref, "https://hrmforce.com").href },
  { "@type": "ListItem", position: 3, name: a.title, item: _canon },
] };
const _faqLd = { "@context": "https://schema.org", "@type": "FAQPage", mainEntity: (allFaq || []).map((f) => ({ "@type": "Question", name: f.q, acceptedAnswer: { "@type": "Answer", text: f.a } })) };
const _offerLd = (shop && shop.price)
  ? { "@context": "https://schema.org", "@type": "Product", name: a.title, description: a.goal, brand: { "@type": "Brand", name: "hrmforce" }, ...(a.image ? { image: a.image } : {}), offers: { "@type": "Offer", price: String(shop.price), priceCurrency: "EUR", availability: "https://schema.org/InStock", url: _canon } }
  : { "@context": "https://schema.org", "@type": "Service", name: a.title, description: a.goal, provider: { "@type": "Organization", name: "hrmforce" }, areaServed: "EU" };
---
<Base title={a.metaTitle} description={a.metaDescription} active="assessments">
  <script type="application/ld+json" is:inline set:html={JSON.stringify(_offerLd)}></script>
  <script type="application/ld+json" is:inline set:html={JSON.stringify(_faqLd)}></script>
  <script type="application/ld+json" is:inline set:html={JSON.stringify(_crumbLd)}></script>

  <div class="crumb">
    <div class="wrap"><a href={localizePath("/", lang)}>{t.home}</a> › <a href={assessHref}>{t.crumbAssessments}</a> › <span>{a.title}</span></div>
  </div>

  <section class="ahero">
    <div class="wrap">
      <div>
        <div class="eyebrow">{t.eyebrowAssessments}</div>
        <h1>{a.title}</h1>
        <div class="meta-row"><span class="lbl">{t.phase}</span><span class="val">{a.phase}</span></div>
        <div class="meta-row"><span class="lbl">{t.goal}</span><span class="val">{a.goal}</span></div>
        {a.time && <div class="meta-row"><span class="lbl">{t.time}</span><span class="val">{a.time}</span></div>}
        {shop.price && (
          <p class="priceline">
            <span class="priceline-amt">&euro;&nbsp;{prijs(shop.price)}</span>
            <span class="priceline-txt">{t.priceNote}</span>
          </p>
        )}
        <div class="btns">
          <a href={localizePath("/contact/", lang)} class="btn btn-primary">{t.demo} &rarr;</a>
          <a href={localizePath(shop.url, lang)} class="btn btn-light">
            {shop.price ? t.orderLoose : t.inShop}
          </a>
        </div>
        <div class="guarantee">
          <strong style="color:#fff">{t.guaranteeTitle}</strong>
          <span><span class="stars">★★★★★</span> {t.guaranteeMeta}<b style="color:#fff">{t.guaranteeStars}</b></span>
        </div>
      </div>
      <div class="device">
        <div class="screen">
          <span class="chip">{t.sampleReport}</span>
          {a.image ? (
            <Img class="report-img" src={a.image} alt={a.title} loading="lazy" />
          ) : (
            a.traits.map((tr, i) => (
              <div class="traitbar"><span>{tr}</span><div class="track"><div class="fill" style={`width:${40 + ((i * 13) % 50)}%`}></div></div></div>
            ))
          )}
        </div>
      </div>
    </div>
  </section>

<SocialProof lang={lang} />

<LogoSlider heading={null} note={null} />

<section class="qshots"><div class="wrap">
  <h2 class="qshots-h">{ex.title}</h2>
  <p class="qshots-lead">{ex.intro}</p>

  <QPreview lang={lang} testName={a.title} ex={ex} />

  <p class="qex-scale"><strong>{ex.scaleLabel}:</strong> {ex.scale}</p>
  {_oefen && (<p style="margin:0 0 20px"><a href={localizePath(`/oefenen/${_oefen.slug}/`, lang)} class="btn btn-ghost">{t.practiceLink} &rarr;</a></p>)}

  <div class="vv-cta">
    <div class="vv-copy">
      <strong>{t.vvTitle}</strong>
      <span>{t.vvText.replace("{t}", a.title)}</span>
    </div>
    <form class="vv-form" action={formAction} method="POST" enctype={FORMSPREE_ENDPOINT ? "application/x-www-form-urlencoded" : "text/plain"}>
      <input type="hidden" name="onderwerp" value={`Voorbeeldvragen ${a.title}`} />
      <input type="hidden" name="assessment" value={a.title} />
      <input type="email" name="email" required placeholder={t.vvPlaceholder} aria-label={t.workEmail} />
      <button type="submit" class="btn btn-primary">{t.vvButton}</button>
    </form>
  </div>
</div></section>


  <section>
    <div class="wrap">
      <div class="eyebrow">{t.explain}</div>
      <h2 class="section-title">{a.title}</h2>
      <div class="explain">
        <div>
          {a.intro.map((p) => <p>{p}</p>)}
          {extra && extra.aliasNote && (<p class="alias-note" set:html={extra.aliasNote}></p>)}
          {a.traits.length > 0 && <ul class="traits">{a.traits.map((tr) => <li>{tr}</li>)}</ul>}
          {a.body.map((p) => <p>{p}</p>)}
          {(() => {
            const T = {
              en:{meet:"This test measures ", phase:"You use it in the HR cycle: ", time:"Completion takes ", tail:" and you receive the results in your inbox, with no PDF to download."},
              de:{meet:"Dieser Test misst ", phase:"Sie setzen ihn im HR-Zyklus ein: ", time:"Das Ausfüllen dauert ", tail:" und Sie erhalten die Ergebnisse in Ihrem Postfach, ohne PDF zum Herunterladen."},
              fr:{meet:"Ce test mesure ", phase:"Vous l utilisez dans le cycle RH : ", time:"Le remplissage prend ", tail:" et vous recevez les résultats dans votre boîte mail, sans PDF à télécharger."},
              es:{meet:"Esta prueba mide ", phase:"La usas en el ciclo de RR. HH.: ", time:"Completarla dura ", tail:" y recibes los resultados en tu bandeja de entrada, sin PDF para descargar."},
              ro:{meet:"Acest test măsoară ", phase:"Îl folosești în ciclul HR: ", time:"Completarea durează ", tail:" și primești rezultatele în inbox, fără PDF de descărcat."}
            };
            const t = T[lang] || T.en;
            const parts = [
              a.traits && a.traits.length ? t.meet + a.traits.join(", ") + ". " : "",
              a.phase ? t.phase + a.phase + ". " : "",
              a.feedback ? a.feedback + " " : "",
              a.time ? t.time + a.time + (a.form ? " (" + a.form + ")" : "") + t.tail : ""
            ].join("");
            return <p class="assess-usage">{parts}</p>;
          })()}
          <a href="#request" class="btn btn-primary" style="margin-top:8px">{t.startNow}</a>
        </div>
        <div class="pentagon">
          <div class="ring"></div>
          <p style="color:var(--muted);font-size:14px">{t.pentagon}</p>
        </div>
      </div>
    </div>
  </section>

  <section style="background:var(--bg)">
    <div class="wrap">
      <div>
        <div class="eyebrow">{t.howEyebrow}</div>
        <h2 class="section-title">{howTitle}</h2>
      </div>
      <div class="order-steps">
        <div class="ostep"><span class="on">1</span><h4>{t.step1t}</h4><p>{t.step1b}</p></div>
        <div class="ostep"><span class="on">2</span><h4>{t.step2t}</h4><p>{t.step2b}</p></div>
        <div class="ostep"><span class="on">3</span><h4>{t.step3t}</h4><p>{t.step3b}</p></div>
      </div>
      <div style="margin-top:26px">
        <a href={localizePath("/contact/", lang)} class="btn btn-primary">{t.demoPlain}</a>
        <a href={localizePath("/tarieven/", lang)} class="btn btn-ghost" style="margin-left:8px">{t.licenseOptions}</a>
      </div>
    </div>
  </section>

  {theory && (
    <section><div class="wrap" style="max-width:880px">
      <div class="eyebrow" style="color:var(--gold)">{theory.modelLabel}</div>
      <h2 class="section-title">{theory.title}</h2>
      <div class="theory-card">
        <h3 class="theory-name">{theory.name}</h3>
        <p class="theory-desc">{theory.desc}</p>
        <div class="theory-reflbl">{theory.refLabel}</div>
        <ul class="theory-refs">{theory.refs.map((r) => <li>{r}</li>)}</ul>
        <p class="theory-note">{theory.note}</p>
      </div>
    </div></section>
  )}

  {a.quote.text && (
    <section class="quote">
      <div class="wrap">
        <img class="quote-photo" src="/media/team/floor-hendriks.webp" alt={`${a.quote.author}, ${a.quote.role} - hrmforce`} width="112" height="112" loading="lazy" />
        <div>
          <h3>{a.quote.heading}</h3>
          <blockquote>"{a.quote.text}"</blockquote>
          <div class="who"><b>{a.quote.author}</b>, {a.quote.role}</div>
          <a class="quote-cta" href={localizePath("/over-ons/", lang)}>{t.teamCta} &rarr;</a>
        </div>
      </div>
    </section>
  )}

  <ReviewSlider />

  <section>
    <div class="wrap">
      <div>
        <div class="eyebrow">{t.faqEyebrow}</div>
        <h2 class="section-title" style="margin-bottom:42px">{faqTitle}</h2>
      </div>
      <div style="max-width:820px;margin:0 auto">
        {allFaq.map((f) => (
          <div class="faq-item">
            <div class="faq-q">{f.q}<span class="pl">+</span></div>
            <div class="faq-a"><p>{f.a}</p></div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="formsec" id="request">
    <div class="wrap">
      <div>
        <div class="eyebrow">{t.requestEyebrow}</div>
        <h2 class="section-title">{requestTitle}</h2>
        <p class="lead" style="margin-bottom:36px">{t.requestLead}</p>
      </div>
      <form class="formcard" action={formAction} method="POST" enctype={FORMSPREE_ENDPOINT ? "application/x-www-form-urlencoded" : "text/plain"}>
        <div class="frow">
          <div class="fg"><label>{t.firstName}</label><input type="text" name="voornaam" required /></div>
          <div class="fg"><label>{t.workEmail}</label><input type="email" name="email" required /></div>
        </div>
        <div class="fg"><label>{t.company}</label><input type="text" name="bedrijf" /></div>
        <button type="submit" class="btn btn-primary">{t.submit}</button>
      </form>
    </div>
  </section>

  {related.length > 0 && (
    <section style="background:var(--bg)">
      <div class="wrap">
        <div>
          <div class="eyebrow">{t.relatedEyebrow}</div>
          <h2 class="section-title" style="margin-bottom:36px">{t.relatedTitle}</h2>
        </div>
        <div class="cards">
          {related.map((r) => (
            <a class="card" href={localizePath(`/assessments/${r.slug}/`, lang)} style="text-decoration:none;color:inherit;display:flex;flex-direction:column">
              {r.image && <Img class="rel-img" src={r.image} alt={r.title} loading="lazy" />}
              <h3>{r.title}</h3>
              <p style="flex:1">{r.goal}</p>
              <span class="readmore">{t.relatedRead} &rarr;</span>
            </a>
          ))}
        </div>
      </div>
    </section>
  )}

  {extra && extra.blocks && extra.blocks.length > 0 && (
    <section class="bg-soft"><div class="wrap" style="max-width:880px">
      <details class="xdetails">
        <summary>{t.detailsSummary}</summary>
      {extra.blocks.map((b) => (
        <div class="xblock">
          <h3 class="xblock-h">{b.title}</h3>
          {b.lead && <p class="xblock-lead">{b.lead}</p>}
          {b.type === "list" && b.items.length > 0 && (
            <ul class="xblock-list">{b.items.map((it) => <li>{it}</li>)}</ul>
          )}
          {b.type === "text" && b.text && <p class="xblock-text">{b.text}</p>}
        </div>
      ))}
      </details>
    </div></section>
  )}
</Base>

<style>
  .device .screen .report-img{
    display:block;
    width:100%;
    height:auto;
    max-height:300px;
    object-fit:cover;
    object-position:top center;
    border-radius:8px;
    margin-top:10px;
  }
  .pricebox{
    display:inline-flex;flex-direction:column;gap:2px;
    background:rgba(255,255,255,.07);border:1px solid rgba(255,255,255,.16);
    
    padding:10px 16px;border-radius:10px;margin:16px 0 6px;max-width:420px;
  }
  .pricebox-label{color:#c4d2e6;font-size:12px;text-transform:uppercase;letter-spacing:.5px;font-weight:700}
  .pricebox-amt{color:#fff;font-size:1.45rem;font-weight:800;line-height:1.15;letter-spacing:-.01em}
  .pricebox-note{color:#aebfd4;font-size:12.5px;line-height:1.45}
  .rel-img{display:block;width:100%;height:150px;object-fit:contain;background:#fff;border-radius:8px;margin-bottom:14px;padding:10px}
  .readmore{color:var(--blue);font-weight:600;font-size:15px;margin-top:12px}
  .portal-nudge{color:#c4d2e6;font-size:13.5px;margin-top:14px;max-width:460px}
  .portal-nudge a{color:#fff;font-weight:700;border-bottom:1px solid var(--gold)}
  .order-steps{display:grid;grid-template-columns:repeat(3,1fr);gap:20px;margin-top:32px}
  .ostep{background:#fff;border:1px solid var(--line);border-radius:14px;padding:24px 22px;text-align:center}
  .ostep .on{display:inline-flex;align-items:center;justify-content:center;width:36px;height:36px;border-radius:50%;background:var(--navy);color:#fff;font-weight:800;margin-bottom:12px}
  .ostep h4{color:var(--navy);font-size:1.05rem;margin-bottom:6px}
  .ostep p{color:var(--muted);font-size:14px}
  @media(max-width:760px){.order-steps{grid-template-columns:1fr}}
  .xdetails{border:1px solid var(--line);border-radius:14px;background:#fff}
  .xdetails>summary{cursor:pointer;list-style:none;padding:16px 20px;color:var(--navy);font-weight:700;font-size:1.02rem;display:flex;align-items:center;justify-content:space-between;gap:12px}
  .xdetails>summary::-webkit-details-marker{display:none}
  .xdetails>summary::after{content:"+";color:var(--muted);font-weight:700;font-size:1.2rem;line-height:1}
  .xdetails[open]>summary::after{content:"\2013"}
  .xdetails[open]>summary{border-bottom:1px solid var(--line)}
  .xdetails>.xblock{padding:0 20px}
  .xdetails>.xblock:first-of-type{padding-top:18px}
  .xdetails>.xblock:last-of-type{padding-bottom:6px}
  .priceline{display:flex;flex-wrap:wrap;align-items:baseline;gap:6px 12px;margin:18px 0 4px;max-width:520px}
  .priceline-amt{color:#fff;font-size:1.5rem;font-weight:800;letter-spacing:-.01em}
  .priceline-txt{color:#c4d2e6;font-size:14px;line-height:1.5}
  .qshots{padding:34px 0}
  .infobar .info-grid{grid-template-columns:repeat(4,minmax(0,1fr));gap:12px;padding:22px 0}
  .infobar .info-grid>div{background:var(--bg-soft);border:1px solid var(--line);border-radius:12px;padding:14px 16px}
  .infobar .info-grid .lbl{font-size:11.5px;margin-bottom:2px}
  .infobar .info-grid .v{color:var(--navy);font-size:14.5px;font-weight:600;line-height:1.4}
  @media(max-width:880px){.infobar .info-grid{grid-template-columns:1fr 1fr}}
  .quote-photo{width:112px;height:112px;border-radius:50%;object-fit:cover;object-position:50% 18%;flex:none;border:3px solid rgba(255,255,255,.35)}
  .quote-cta{display:inline-block;margin-top:14px;color:#fff;font-weight:700;font-size:14.5px;border-bottom:2px solid var(--gold);padding-bottom:2px}
  .qex{margin-top:34px;padding-top:30px;border-top:1px solid var(--line)}
  .qex-h{color:var(--navy);font-size:1.35rem;margin:0 0 6px}
  .qex-lead{color:var(--muted);max-width:640px;margin:0 0 20px}
  .qex-list{display:flex;flex-direction:column;gap:10px}
  .qex-item{display:flex;gap:14px;align-items:flex-start;background:#fff;border:1px solid var(--line);border-radius:12px;padding:14px 18px;box-shadow:var(--shadow-xs)}
  .qex-n{flex:none;width:26px;height:26px;border-radius:50%;background:var(--navy);color:#fff;font-weight:800;font-size:13.5px;display:flex;align-items:center;justify-content:center}
  .qex-q{color:var(--navy);font-weight:600;font-size:15px;line-height:1.5}
  .qex-scale{color:var(--muted);font-size:14px;margin:16px 0 18px}
  .qex-scale strong{color:var(--navy)}
  .qshots-h{margin:6px 0 6px}
  .qshots-lead{color:var(--muted);max-width:620px;margin:0 0 22px}
  .qshots-track{display:flex;gap:20px;overflow-x:auto;scroll-snap-type:x mandatory;padding-bottom:12px;-webkit-overflow-scrolling:touch}
  .qshot{flex:0 0 92%;max-width:940px;scroll-snap-align:center;margin:0}
  .qshot img,.qshot svg{width:100%;height:auto;border-radius:14px;border:1px solid var(--line);box-shadow:var(--shadow-sm);display:block}
  .qshot figcaption{margin-top:10px;color:var(--muted);font-size:14px;text-align:center}
  @media(min-width:900px){ .qshot{flex-basis:62%} }
  .assess-usage{ margin-top:16px; padding-top:16px; border-top:1px solid var(--line); color:var(--text); }
