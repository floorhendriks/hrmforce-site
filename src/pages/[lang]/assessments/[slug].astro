---
import Base from "../../../layouts/Base.astro";
import { assessments } from "../../../data/assessments.js";
import { assessmentsI18n } from "../../../data/assessments-i18n.js";
import { detailUi } from "../../../data/assessment-detail-ui.js";
import { shopInfo } from "../../../data/assessment-shop.js";
import { FORMSPREE_ENDPOINT, CONTACT_EMAIL } from "../../../data/site-config.js";
import { localizePath } from "../../../i18n/utils.js";
import { examplesFor } from "../../../data/assessment-examples.js";

const formAction = FORMSPREE_ENDPOINT || `mailto:${CONTACT_EMAIL}`;

// (lang ∈ en,de,fr,es,ro) × (36 slugs). Data = merge van assessments.js
// (beeld/slug/quote.author/quote.initials) + assessmentsI18n[lang][slug] (teksten).
export async function getStaticPaths() {
  const langs = ["en", "de", "fr", "es", "ro"];
  const paths = [];
  for (const lang of langs) {
    for (const base of assessments) {
      const tr = assessmentsI18n[lang]?.[base.slug];
      if (!tr) continue;
      const merged = {
        ...base,
        ...tr,
        image: base.image,
        slug: base.slug,
        quote: {
          ...tr.quote,
          author: base.quote?.author || "",
          initials: base.quote?.initials || "",
        },
      };
      paths.push({ params: { lang, slug: base.slug }, props: { a: merged, lang } });
    }
  }
  return paths;
}

const { a, lang } = Astro.props;
const t = detailUi[lang] || detailUi.en;
const assessHref = localizePath("/online-assessments/", lang);
const shop = shopInfo(a.slug);

// Gerelateerde assessments: a.related bevat NL-titels (uit assessments.js).
// Koppel die aan de echte pagina's en toon de vertaalde titel/goal.
const byTitle = new Map(assessments.map((x) => [x.title, x]));
const related = (a.related || [])
  .map((title) => byTitle.get(title))
  .filter(Boolean)
  .slice(0, 3)
  .map((x) => {
    const tr = assessmentsI18n[lang]?.[x.slug] || {};
    return { title: tr.title || x.title, slug: x.slug, image: x.image, goal: tr.goal || x.goal };
  });

const ex = examplesFor(a.slug, lang);
const faqTitle = t.faqTitle.replace("{t}", a.title);
const howTitle = t.howTitle.replace("{t}", a.title);
const requestTitle = t.requestTitle.replace("{t}", a.title);
---
<Base title={a.metaTitle} description={a.metaDescription} active="assessments">
  <div class="crumb">
    <div class="wrap"><a href={localizePath("/", lang)}>{t.home}</a> › <a href={assessHref}>{t.crumbAssessments}</a> › <span>{a.title}</span></div>
  </div>

  <section class="ahero">
    <div class="wrap">
      <div>
        <div class="eyebrow">{t.eyebrowAssessments}</div>
        <h1>{a.title}</h1>
        <div class="meta-row"><span class="lbl">{t.phase}</span><span class="val">{a.phase}</span></div>
        <div class="meta-row"><span class="lbl">{t.goal}</span><span class="val">{a.goal}</span></div>
        {shop.price && (
          <div class="pricebox">
            <span class="pricebox-label">{t.priceLabel}</span>
            <span class="pricebox-amt">&euro;{shop.price}</span>
            <span class="pricebox-note">{t.priceNote}</span>
          </div>
        )}
        <div class="btns">
          <a href={localizePath("/contact/", lang)} class="btn btn-primary">{t.demo} &rarr;</a>
          <a href={shop.url} class="btn btn-light" rel="noopener">
            {shop.price ? t.orderLoose : t.inShop}
          </a>
        </div>
        <p class="portal-nudge">{t.portalPre}<a href={localizePath("/tarieven/", lang)}>{t.portalLink}</a>{t.portalPost}</p>
        <div class="guarantee">
          <strong style="color:#fff">{t.guaranteeTitle}</strong>
          <span><span class="stars">★★★★★</span> {t.guaranteeMeta}<b style="color:#fff">{t.guaranteeStars}</b></span>
        </div>
      </div>
      <div class="device">
        <div class="screen">
          <span class="chip">{t.sampleReport}</span>
          {a.image ? (
            <img class="report-img" src={a.image} alt={a.title} loading="lazy" />
          ) : (
            a.traits.map((tr, i) => (
              <div class="traitbar"><span>{tr}</span><div class="track"><div class="fill" style={`width:${40 + ((i * 13) % 50)}%`}></div></div></div>
            ))
          )}
        </div>
      </div>
    </div>
  </section>

  <div class="infobar">
    <div class="wrap">
      <div class="info-grid">
        <div><div class="lbl">{t.time}</div><div class="v">{a.time}</div></div>
        <div><div class="lbl">{t.form}</div><div class="v">{a.form}</div></div>
        <div><div class="lbl">{t.feedback}</div><div class="v">{a.feedback}</div></div>
        <div><div class="lbl">{t.extra}</div><div class="v">{a.extra}</div></div>
      </div>
    </div>
  </div>

  <section>
    <div class="wrap">
      <div class="eyebrow">{t.explain}</div>
      <h2 class="section-title">{a.title}</h2>
      <div class="explain">
        <div>
          {a.intro.map((p) => <p>{p}</p>)}
          {a.traits.length > 0 && <ul class="traits">{a.traits.map((tr) => <li>{tr}</li>)}</ul>}
          {a.body.map((p) => <p>{p}</p>)}
          <a href="#request" class="btn btn-primary" style="margin-top:8px">{t.startNow}</a>
        </div>
        <div class="pentagon">
          <div class="ring"></div>
          <p style="color:var(--muted);font-size:14px">{t.pentagon}</p>
        </div>
      </div>
    </div>
  </section>

  {a.quote.text && (
    <section class="quote">
      <div class="wrap">
        <div class="avatar">{a.quote.initials}</div>
        <div>
          <h3>{a.quote.heading}</h3>
          <blockquote>"{a.quote.text}"</blockquote>
          <div class="who"><b>{a.quote.author}</b> — {a.quote.role}</div>
        </div>
      </div>
    </section>
  )}

  <section class="bg-soft"><div class="wrap" style="max-width:860px">
    <div class="eyebrow" style="color:var(--gold)">{ex.tag}</div>
    <h2 class="section-title">{ex.title}</h2>
    <p class="lead" style="margin-bottom:22px">{ex.intro}</p>
    <div style="display:flex;flex-direction:column;gap:12px">
      {ex.items.map((qq, i) => (
        <div style="display:flex;gap:14px;align-items:flex-start;background:#fff;border:1px solid var(--line);border-left:3px solid var(--gold);border-radius:12px;padding:16px 18px;box-shadow:var(--shadow-xs)">
          <span style="flex:none;width:28px;height:28px;border-radius:50%;background:var(--navy);color:#fff;font-weight:800;font-size:14px;display:flex;align-items:center;justify-content:center">{i + 1}</span>
          <span style="color:var(--navy);font-weight:600;font-size:15px;line-height:1.5">{qq}</span>
        </div>
      ))}
    </div>
    <p style="color:var(--muted);font-size:14px;margin-top:16px"><strong style="color:var(--navy)">{ex.scaleLabel}:</strong> {ex.scale}</p>
  </div></section>

  <section>
    <div class="wrap">
      <div class="center">
        <div class="eyebrow">{t.faqEyebrow}</div>
        <h2 class="section-title" style="margin-bottom:42px">{faqTitle}</h2>
      </div>
      <div style="max-width:820px;margin:0 auto">
        {a.faq.map((f) => (
          <div class="faq-item">
            <div class="faq-q">{f.q}<span class="pl">+</span></div>
            <div class="faq-a"><p>{f.a}</p></div>
          </div>
        ))}
      </div>
    </div>
  </section>

  {related.length > 0 && (
    <section style="background:var(--bg)">
      <div class="wrap">
        <div class="center">
          <div class="eyebrow">{t.relatedEyebrow}</div>
          <h2 class="section-title" style="margin-bottom:36px">{t.relatedTitle}</h2>
        </div>
        <div class="cards">
          {related.map((r) => (
            <a class="card" href={localizePath(`/assessments/${r.slug}/`, lang)} style="text-decoration:none;color:inherit;display:flex;flex-direction:column">
              {r.image && <img class="rel-img" src={r.image} alt={r.title} loading="lazy" />}
              <h3>{r.title}</h3>
              <p style="flex:1">{r.goal}</p>
              <span class="readmore">{t.relatedRead} &rarr;</span>
            </a>
          ))}
        </div>
      </div>
    </section>
  )}

  <section style="background:var(--bg)">
    <div class="wrap">
      <div class="center">
        <div class="eyebrow" style="justify-content:center">{t.howEyebrow}</div>
        <h2 class="section-title">{howTitle}</h2>
      </div>
      <div class="order-steps">
        <div class="ostep"><span class="on">1</span><h4>{t.step1t}</h4><p>{t.step1b}</p></div>
        <div class="ostep"><span class="on">2</span><h4>{t.step2t}</h4><p>{t.step2b}</p></div>
        <div class="ostep"><span class="on">3</span><h4>{t.step3t}</h4><p>{t.step3b}</p></div>
      </div>
      <div class="center" style="margin-top:26px">
        <a href={localizePath("/contact/", lang)} class="btn btn-primary">{t.demoPlain}</a>
        <a href={localizePath("/tarieven/", lang)} class="btn btn-ghost" style="margin-left:8px">{t.licenseOptions}</a>
      </div>
    </div>
  </section>

  <section class="formsec" id="request">
    <div class="wrap">
      <div class="center">
        <div class="eyebrow">{t.requestEyebrow}</div>
        <h2 class="section-title">{requestTitle}</h2>
        <p class="lead" style="margin-bottom:36px">{t.requestLead}</p>
      </div>
      <form class="formcard" action={formAction} method="POST" enctype={FORMSPREE_ENDPOINT ? "application/x-www-form-urlencoded" : "text/plain"}>
        <div class="frow">
          <div class="fg"><label>{t.firstName}</label><input type="text" name="voornaam" required /></div>
          <div class="fg"><label>{t.workEmail}</label><input type="email" name="email" required /></div>
        </div>
        <div class="fg"><label>{t.company}</label><input type="text" name="bedrijf" /></div>
        <button type="submit" class="btn btn-primary">{t.submit}</button>
      </form>
    </div>
  </section>
</Base>

<style>
  .device .screen .report-img{
    display:block;
    width:100%;
    height:auto;
    border-radius:8px;
    margin-top:10px;
  }
  .pricebox{
    display:inline-flex;flex-direction:column;gap:2px;
    background:rgba(255,255,255,.08);border:1px solid rgba(255,255,255,.18);
    border-left:3px solid var(--gold);
    padding:12px 18px;border-radius:10px;margin:18px 0 6px;
  }
  .pricebox-label{color:#c4d2e6;font-size:12.5px;text-transform:uppercase;letter-spacing:.6px;font-weight:700}
  .pricebox-amt{color:#fff;font-size:1.9rem;font-weight:800;line-height:1.1}
  .pricebox-note{color:#aebfd4;font-size:13px}
  .rel-img{display:block;width:100%;height:150px;object-fit:contain;background:#fff;border-radius:8px;margin-bottom:14px;padding:10px}
  .readmore{color:var(--blue);font-weight:600;font-size:15px;margin-top:12px}
  .portal-nudge{color:#c4d2e6;font-size:13.5px;margin-top:14px;max-width:460px}
  .portal-nudge a{color:#fff;font-weight:700;border-bottom:1px solid var(--gold)}
  .order-steps{display:grid;grid-template-columns:repeat(3,1fr);gap:20px;margin-top:32px}
  .ostep{background:#fff;border:1px solid var(--line);border-radius:14px;padding:24px 22px;text-align:center}
  .ostep .on{display:inline-flex;align-items:center;justify-content:center;width:36px;height:36px;border-radius:50%;background:var(--navy);color:#fff;font-weight:800;margin-bottom:12px}
  .ostep h4{color:var(--navy);font-size:1.05rem;margin-bottom:6px}
  .ostep p{color:var(--muted);font-size:14px}
  @media(max-width:760px){.order-steps{grid-template-columns:1fr}}
</style>
