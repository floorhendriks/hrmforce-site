---
import Base from "../../../layouts/Base.astro";
import Klantcase from "../../../components/Klantcase.astro";
import { alleCaseSlugs, caseFor, caseOmschrijving } from "../../../data/cases-content.js";
import { titel as maakTitel } from "../../../lib/meta.js";
import { perTaal } from "../../../i18n/paden.js";
export function getStaticPaths() {
  return perTaal(alleCaseSlugs().map((slug) => ({ params: { case: slug } })));
}
const { lang } = Astro.params;
const c = caseFor(Astro.params.case, lang);
// De titel kan te lang worden in de vertalingen; maakTitel laat dan eerst de
// merknaam vallen. De omschrijving was vaak maar een halve regel, te kort voor
// het zoekresultaat, dus de resultaten komen erachteraan.
const titel = maakTitel(c.titel);
const omschrijving = caseOmschrijving(c);
---
<Base title={titel} description={omschrijving} active="">
  <Klantcase c={c} lang={lang} />
</Base>
