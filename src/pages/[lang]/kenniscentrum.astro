---
import Base from "../../layouts/Base.astro";
import Kenniscentrum from "../../components/Kenniscentrum.astro";
import { kenniscentrumContent } from "../../data/kenniscentrum-content.js";
import { perTaal } from "../../i18n/paden.js";
export function getStaticPaths() { return perTaal(); }
const { lang } = Astro.params;
const t = kenniscentrumContent[lang];
---
<Base title={t.meta.title} description={t.meta.description} active="">
  <Kenniscentrum t={t} lang={lang} />
</Base>
