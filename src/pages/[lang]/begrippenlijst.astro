---
import Base from "../../layouts/Base.astro";
import Glossary from "../../components/Glossary.astro";
import { glossaryContent } from "../../data/glossary-content.js";
import { perTaal } from "../../i18n/paden.js";
export function getStaticPaths() { return perTaal(); }
const { lang } = Astro.params;
const t = glossaryContent[lang];
---
<Base title={t.meta.title} description={t.meta.description} active="">
  <Glossary t={t} lang={lang} />
</Base>
