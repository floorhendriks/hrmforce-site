---
import Base from "../../layouts/Base.astro";
import Voorbereiding from "../../components/Voorbereiding.astro";
import { voorbereidingContent } from "../../data/voorbereiding-content.js";
import { perTaal } from "../../i18n/paden.js";
export function getStaticPaths() { return perTaal(); }
const { lang } = Astro.params;
const t = voorbereidingContent[lang];
---
<Base title={t.meta.title} description={t.meta.description} active="">
  <Voorbereiding t={t} lang={lang} />
</Base>
