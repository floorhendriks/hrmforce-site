---
import Base from "../../layouts/Base.astro";
import Oefentest from "../../components/Oefentest.astro";
import { ONDERDELEN, OT_UI } from "../../data/oefentest-ui.js";
import numeriek from "../../data/oefenbank/numeriek.nl.json";
import verbaal from "../../data/oefenbank/verbaal.nl.json";
import calculation from "../../data/oefenbank/calculation.nl.json";
import ruimtelijk from "../../data/oefenbank/ruimtelijk.nl.json";
import abstract from "../../data/oefenbank/abstract.nl.json";
const BANKEN = { numeriek, verbaal, calculation, ruimtelijk, abstract };
export function getStaticPaths() {
  return Object.entries(ONDERDELEN).map(([sleutel, o]) => ({
    params: { onderdeel: o.slug["nl"] }, props: { sleutel, o },
  }));
}
const { sleutel, o } = Astro.props;
const t = OT_UI["nl"];
const naam = o.naam["nl"];
---
<Base lang="nl" title={`${naam} | ${t.eyebrow} | hrmforce`} description={o.lead["nl"]} active="">
  <Oefentest onderdeel={sleutel} lang="nl" bank={BANKEN[sleutel]} />
</Base>
