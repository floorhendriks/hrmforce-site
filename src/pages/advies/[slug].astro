---
// De Nederlandse detailpagina's; de andere talen lopen via
// src/pages/[lang]/advies/[slug].astro.
import AdviesDetail from "../../components/AdviesDetail.astro";
import { adviesDetailVoor } from "../../data/advies-detail.js";

export async function getStaticPaths() {
  return adviesDetailVoor("nl").map((a) => ({ params: { slug: a.slug }, props: { a } }));
}

const { a } = Astro.props;
---
<AdviesDetail a={a} lang="nl" />
