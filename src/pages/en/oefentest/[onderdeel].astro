---
import Base from "../../../layouts/Base.astro";
import Oefentest from "../../../components/Oefentest.astro";
import { ONDERDELEN, OT_UI } from "../../../data/oefentest-ui.js";
import numeriek from "../../../data/oefenbank/numeriek.en.json";
import verbaal from "../../../data/oefenbank/verbaal.en.json";
import calculation from "../../../data/oefenbank/calculation.en.json";
import ruimtelijk from "../../../data/oefenbank/ruimtelijk.en.json";
import abstract from "../../../data/oefenbank/abstract.en.json";
const BANKEN = { numeriek, verbaal, calculation, ruimtelijk, abstract };
export function getStaticPaths() {
  return Object.entries(ONDERDELEN).map(([sleutel, o]) => ({
    params: { onderdeel: o.slug["en"] }, props: { sleutel, o },
  }));
}
const { sleutel, o } = Astro.props;
const t = OT_UI["en"];
const naam = o.naam["en"];
---
<Base lang="en" title={`${naam} | ${t.eyebrow} | hrmforce`} description={o.lead["en"]} active="">
  <Oefentest onderdeel={sleutel} lang="en" bank={BANKEN[sleutel]} />
</Base>
