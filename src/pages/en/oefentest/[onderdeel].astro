---
import Base from "../../../layouts/Base.astro";
import Oefentest from "../../../components/Oefentest.astro";
import { ONDERDELEN, OT_UI } from "../../../data/oefentest-ui.js";
import bank from "../../../data/oefenbank/numeriek.en.json";
export function getStaticPaths() {
  return Object.entries(ONDERDELEN).map(([sleutel, o]) => ({
    params: { onderdeel: o.slug["en"] }, props: { sleutel, o },
  }));
}
const { sleutel, o } = Astro.props;
const t = OT_UI["en"];
const naam = o.naam["en"];
---
<Base lang="en" title={`${naam} | ${t.eyebrow} | hrmforce`} description={o.lead["en"]} active="">
  <Oefentest onderdeel={sleutel} lang="en" bank={bank} />
</Base>
