---
import Base from "../layouts/Base.astro";

const blocks = [
  { h: "Matching & selectie", icon: "target", p: "Vind de best passende kandidaat door het in-en extern selecteren van medewerkers op basis van het gewenste matchprofiel. Dit doen we aan de hand van selectieassessments.", href: "/hrm-oplossingen/matching/" },
  { h: "HR Gesprekscyclus", icon: "cycle", p: "Het maken van een persoonlijk ontwikkelplan voor de kandidaat. Met stap voor stap begeleiding in het proces om ontwikkel- en resultaat afspraken te maken.", href: "/hrm-oplossingen/development/" },
  { h: "Employability", icon: "compass", p: "De kandidaten laten zoeken naar mogelijke beroepen en actueel beschikbare vacatures op basis van hun persoonlijkheid, motivatie en gedrag.", href: "/hrm-oplossingen/employability/" },
  { h: "HR Analytics", icon: "chart", p: "Voor het genereren van geautomatiseerde team-, afdeling- en organisatie overzichten. Deze zijn voor elke vragenlijst beschikbaar.", href: "/hrm-oplossingen/hr-analytics/" },
];

// De vier fases van de HR-cyclus (processchema).
const cyclus = [
  { n: "1", t: "(Pre)selectie", d: "Objectief de juiste kandidaat kiezen met selectie-assessments.", icon: "search" },
  { n: "2", t: "Ontwikkeling", d: "Groei sturen met persoonlijke ontwikkelplannen.", icon: "grow" },
  { n: "3", t: "Functioneren", d: "Voortgang volgen via feedback en gesprekscyclus.", icon: "talk" },
  { n: "4", t: "Beoordelen", d: "Prestaties objectief evalueren en vastleggen.", icon: "check" },
];

const cycIcons = {
  search: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/></svg>`,
  grow: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 20h18"/><path d="M7 20V12M12 20V7M17 20v-5"/></svg>`,
  talk: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg>`,
  check: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 11l3 3 8-8"/><path d="M21 12v7a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11"/></svg>`,
};

// Inline SVG-iconen per oplossing (strak, navy via currentColor).
const icons = {
  target: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"/><circle cx="12" cy="12" r="5"/><circle cx="12" cy="12" r="1"/></svg>`,
  cycle: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12a9 9 0 1 1-3-6.7"/><polyline points="21 3 21 8 16 8"/></svg>`,
  compass: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"/><polygon points="15.5 8.5 10.5 10.5 8.5 15.5 13.5 13.5 15.5 8.5"/></svg>`,
  chart: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="4" y1="20" x2="4" y2="12"/><line x1="10" y1="20" x2="10" y2="4"/><line x1="16" y1="20" x2="16" y2="9"/><line x1="21" y1="20" x2="3" y2="20"/></svg>`,
};
---
<Base
  title="HR oplossingen nodig? O.a. matching | Selectie | Gesprekscycli"
  description="Onze vragenlijsten zijn verwerkt in workflows voor (pre)selectie, ontwikkeling en beoordeling van sollicitanten en medewerkers."
  active="solutions"
>
  <div class="crumb">
    <div class="wrap"><a href="/">Home</a> › <span>HRM oplossingen</span></div>
  </div>

  <section class="ahero">
    <div class="wrap" style="display:block">
      <div class="eyebrow" style="color:var(--gold)">HRM oplossingen</div>
      <h1>HRM oplossingen</h1>
      <p style="color:#c4d2e6;font-size:19px;max-width:780px;margin-top:8px">Hrmforce biedt naast het afnemen van online assessments nog veel meer functionaliteiten. De vragenlijsten zijn verwerkt in workflows voor (pre)selectie, ontwikkeling en beoordeling van sollicitanten en medewerkers.</p>
    </div>
  </section>

  <section>
    <div class="wrap">
      <div class="center">
        <div class="eyebrow" style="justify-content:center">De HR-cyclus</div>
        <h2 class="section-title">Eén platform voor de complete HR-cyclus</h2>
        <p class="lead" style="max-width:760px;margin:0 auto 8px">Onze oplossingen ondersteunen elke fase, van selectie tot beoordeling, met dezelfde gevalideerde vragenlijsten en data.</p>
      </div>
      <ol class="cyclus">
        {cyclus.map((c) => (
          <li class="cyc-step">
            <span class="cyc-n">{c.n}</span>
            <span class="cyc-ic" set:html={cycIcons[c.icon]}></span>
            <h3>{c.t}</h3>
            <p>{c.d}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section style="background:var(--bg)">
    <div class="wrap">
      <div class="eyebrow">Oplossingen</div>
      <h2 class="section-title" style="margin-bottom:28px">Kies de oplossing die bij je vraag past</h2>
      <div class="sol">
        {blocks.map((b) => (
          <a class="sol-block card" href={b.href}>
            <span class="sol-ic" set:html={icons[b.icon]}></span>
            <h3>{b.h}</h3>
            <p>{b.p}</p>
            <span class="readmore">Meer informatie &rarr;</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="cta">
    <div class="wrap">
      <h2>Benieuwd wat hrmforce voor jouw HR-proces kan doen?</h2>
      <p>Plan een vrijblijvende demo en ontdek hoe onze oplossingen selectie, ontwikkeling en beoordeling versterken.</p>
      <div class="btns">
        <a href="/demo/" class="btn btn-primary">Plan een gratis demo</a>
        <a href="/tarieven/" class="btn btn-light">Bekijk tarieven</a>
      </div>
    </div>
  </section>
  <section class="roi-band"><div class="wrap">
    <div class="roi-band-inner">
      <div>
        <div class="eyebrow" style="color:var(--gold)">Rekenhulp</div>
        <h2>Bereken wat objectief selecteren jou oplevert</h2>
        <p>Een verkeerde aanname kost al snel een veelvoud van een assessment. Reken in twee minuten uit wat gerichter selecteren en ontwikkelen voor jouw organisatie kan besparen.</p>
      </div>
      <a href="/roi-rekentool/" class="btn btn-primary">Open de ROI-rekentool</a>
    </div>
  </div></section>
  <style>
    .roi-band{padding:8px 0 48px}
    .roi-band-inner{display:flex;flex-wrap:wrap;gap:22px;align-items:center;justify-content:space-between;background:linear-gradient(160deg,var(--navy),var(--navy-deep));border-radius:20px;padding:34px 32px}
    .roi-band-inner h2{color:#fff;margin:6px 0 8px;font-size:1.5rem}
    .roi-band-inner p{color:#c4d2e6;max-width:560px;font-size:15px;line-height:1.6;margin:0}
    .roi-band-inner .btn{flex:none}
    @media(max-width:760px){.roi-band-inner{flex-direction:column;align-items:flex-start}.roi-band-inner .btn{width:100%;text-align:center}}
  </style>
</Base>

<style>
  .cyclus { list-style: none; margin: 34px 0 0; padding: 0; display: grid; grid-template-columns: repeat(4, 1fr); gap: 0; }
  .cyc-step { position: relative; background: #fff; border: 1px solid var(--line); padding: 26px 22px; text-align: left; }
  .cyc-step:first-child { border-radius: var(--radius) 0 0 var(--radius); }
  .cyc-step:last-child { border-radius: 0 var(--radius) var(--radius) 0; }
  .cyc-step:not(:last-child) { border-right: none; }
  .cyc-step:not(:last-child)::after {
    content: ""; position: absolute; right: -11px; top: 50%; transform: translateY(-50%) rotate(45deg);
    width: 20px; height: 20px; background: #fff; border-top: 1px solid var(--line); border-right: 1px solid var(--line); z-index: 2;
  }
  .cyc-ic { display: block; width: 26px; height: 26px; color: var(--gold); margin: 0 0 8px; }
  .cyc-ic :global(svg) { width: 26px; height: 26px; }
  .cyc-n { display: inline-flex; align-items: center; justify-content: center; width: 34px; height: 34px; border-radius: 50%; background: var(--navy); color: #fff; font-weight: 800; margin-bottom: 12px; }
  .cyc-step h3 { color: var(--navy); font-size: 1.1rem; margin-bottom: 6px; }
  .cyc-step p { color: var(--muted); font-size: 14px; line-height: 1.55; }
  @media (max-width: 880px) { .cyclus { grid-template-columns: 1fr 1fr; } .cyc-step, .cyc-step:first-child, .cyc-step:last-child { border-radius: var(--radius); border: 1px solid var(--line); margin: 6px; } .cyc-step::after { display: none; } }
  @media (max-width: 520px) { .cyclus { grid-template-columns: 1fr; } }

  .sol { display: grid; grid-template-columns: repeat(2, 1fr); gap: 24px; }
  .sol-block { display: flex; flex-direction: column; text-decoration: none; color: inherit; }
  .sol-ic { width: 56px; height: 56px; border-radius: 14px; background: linear-gradient(135deg, #e8f0fe, #dbe9fb); display: inline-flex; align-items: center; justify-content: center; margin-bottom: 16px; color: var(--navy); }
  .sol-ic :global(svg) { width: 28px; height: 28px; }
  .sol-block h3 { color: var(--navy); font-size: 22px; font-weight: 800; margin-bottom: 10px; }
  .sol-block p { color: var(--muted); font-size: 16px; margin-bottom: 16px; flex: 1; }
  .readmore { color: var(--accent); font-weight: 700; font-size: 15px; }
  @media (max-width: 880px) { .sol { grid-template-columns: 1fr; } }
</style>
