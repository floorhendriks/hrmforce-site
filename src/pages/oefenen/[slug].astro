---
import Base from "../../layouts/Base.astro";
import { oefentests } from "../../data/oefentests.js";
import { examplesFor } from "../../data/assessment-examples.js";
import { FORMSPREE_ENDPOINT, CONTACT_EMAIL } from "../../data/site-config.js";

export function getStaticPaths() {
  return oefentests.map((o) => ({ params: { slug: o.slug }, props: { o } }));
}

const { o } = Astro.props;
const formAction = FORMSPREE_ENDPOINT || `mailto:${CONTACT_EMAIL}`;
const ex = examplesFor(o.assessmentSlug, "nl");
const _canon = new URL(Astro.url.pathname, "https://hrmforce.com").href;
const _crumbLd = { "@context": "https://schema.org", "@type": "BreadcrumbList", itemListElement: [
  { "@type": "ListItem", position: 1, name: "Home", item: "https://hrmforce.com/" },
  { "@type": "ListItem", position: 2, name: o.name, item: _canon },
] };
---
<Base title={o.metaTitle} description={o.metaDescription} active="">
  <script type="application/ld+json" is:inline set:html={JSON.stringify(_crumbLd)}></script>

  <div class="crumb"><div class="wrap"><a href="/">Home</a> › <a href="/online-assessments/">Online assessments</a> › <span>Oefenen: {o.name}</span></div></div>

  <section class="ahero"><div class="wrap" style="display:block">
    <div class="eyebrow" style="color:var(--gold)">Voorbereiding</div>
    <h1>{o.hero}</h1>
    <p style="color:#c4d2e6;font-size:18px;max-width:760px;margin-top:10px">{o.intro}</p>
    <div class="btns" style="margin-top:18px">
      <a href="#voorbeeldvragen" class="btn btn-primary">Bekijk voorbeeldvragen</a>
      <a href={`/assessments/${o.assessmentSlug}/`} class="btn btn-ghost" style="color:#fff;border-color:rgba(255,255,255,.6)">Meer over deze test</a>
    </div>
  </div></section>

  <section id="voorbeeldvragen"><div class="wrap" style="max-width:860px">
    <div class="eyebrow" style="color:var(--gold)">{ex.tag}</div>
    <h2 class="section-title">Voorbeeldvragen</h2>
    <p class="lead" style="margin-bottom:22px">{ex.intro}</p>
    <div style="display:flex;flex-direction:column;gap:12px">
      {ex.items.map((qq, i) => (
        <div style="display:flex;gap:14px;align-items:flex-start;background:#fff;border:1px solid var(--line);border-left:3px solid var(--gold);border-radius:12px;padding:16px 18px;box-shadow:var(--shadow-xs)">
          <span style="flex:none;width:28px;height:28px;border-radius:50%;background:var(--navy);color:#fff;font-weight:800;font-size:14px;display:flex;align-items:center;justify-content:center">{i + 1}</span>
          <span style="color:var(--navy);font-weight:600;font-size:15px;line-height:1.5">{qq}</span>
        </div>
      ))}
    </div>
    <p style="color:var(--muted);font-size:14px;margin-top:16px"><strong style="color:var(--navy)">{ex.scaleLabel}:</strong> {ex.scale}</p>
  </div></section>

  <section class="bg-soft"><div class="wrap">
    <div class="eyebrow">Zo bereid je je voor</div>
    <h2 class="section-title">Tips om te oefenen</h2>
    <div class="ot-tips">
      {o.tips.map((tp) => (<div class="ot-tip"><span aria-hidden="true">✓</span><p>{tp}</p></div>))}
    </div>
  </div></section>

  <section class="formsec" id="request"><div class="wrap">
    <div class="center"><div class="eyebrow">Meer oefenen?</div>
      <h2 class="section-title">Ontvang extra voorbeeldvragen per e-mail</h2>
      <p class="lead" style="margin-bottom:36px">Laat je e-mail achter, dan sturen we je meer voorbeeldvragen en oefentips voor de {o.name}.</p></div>
    <form class="formcard" action={formAction} method="POST" enctype={FORMSPREE_ENDPOINT ? "application/x-www-form-urlencoded" : "text/plain"}>
      <input type="hidden" name="onderwerp" value={`Oefenmateriaal ${o.name}`} />
      <div class="fg"><label>Werk e-mail *</label><input type="email" name="email" required /></div>
      <button type="submit" class="btn btn-primary">Stuur mij oefenmateriaal</button>
    </form>
    <p style="text-align:center;margin-top:20px"><a href="/oefen-assessment-maken/" style="color:var(--blue);font-weight:600">Liever een compleet oefen-assessment maken? →</a></p>
  </div></section>
</Base>

<style>
  .ot-tips{display:grid;grid-template-columns:repeat(3,1fr);gap:18px;margin-top:26px}
  .ot-tip{display:flex;gap:12px;background:#fff;border:1px solid var(--line);border-radius:12px;padding:18px 20px;box-shadow:var(--shadow-xs)}
  .ot-tip span{color:var(--gold);font-weight:800;font-size:18px}
  .ot-tip p{margin:0;color:var(--navy);font-weight:600;font-size:15px;line-height:1.5}
  @media(max-width:820px){.ot-tips{grid-template-columns:1fr}}
</style>
