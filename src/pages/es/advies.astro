---
import Base from "../../layouts/Base.astro";
import LogoSlider from "../../components/LogoSlider.astro";

const items = [
  { h: "Formación", p: "Con una formación de certificación de hrmforce aprendes a trabajar con nuestros cuestionarios e interpretar los resultados correctamente. Consulta el calendario e inscríbete directamente.", href: "/es/advies/trainingen/", cta: "Ver formación y calendario" },
  { h: "Live Assessments", p: "Más allá de las pruebas online de autoservicio, nuestros asesores guían evaluaciones en directo: selección, desarrollo, carrera, executive y análisis de equipo.", href: "/es/advies/assessments/", cta: "Ver todas las evaluaciones" },
  { h: "Gestión del Talento", p: "Aplicando el principio 80-20 al reclutamiento, el 20% de los candidatos aporta el 80% de los resultados. Es esencial reconocer y aprovechar el talento dentro de la organización.", href: "/es/hrm-oplossingen/", cta: "Más información" },
  { h: "Gestión de Competencias", p: "Al implementar la gestión por competencias, la visión y la estrategia de tu organización se traducen en objetivos, aportando claridad y estructura a todas las funciones.", href: "/es/contact/", cta: "Contáctanos" },
  { h: "Consultoría", p: "Tu organización crece, innova o se adapta. Eliges una estrategia ambiciosa y, como siempre, su realización es el mayor reto. Nuestros consultores te ayudan a lograrlo.", href: "/es/contact/", cta: "Contáctanos" },
];
---
<Base title="Asesoría de hrmforce - hrmforce" description="Además de nuestras evaluaciones online y soluciones de RR. HH., puedes contar con formación y evaluaciones en directo guiadas por asesores." active="advice">
  <div class="crumb">
    <div class="wrap"><a href="/es/">Home</a> › <span>Asesoría</span></div>
  </div>

  <section class="ahero">
    <div class="wrap" style="display:block">
      <div class="eyebrow" style="color:var(--gold)">Asesoría</div>
      <h1>Asesoría de hrmforce</h1>
      <p style="color:#c4d2e6;font-size:19px;max-width:820px;margin-top:8px">Además de nuestras evaluaciones online y soluciones de RR. HH., puedes contar con <strong>formación</strong> y <strong>evaluaciones en directo</strong> guiadas por asesores. Nuestros consultores piensan contigo sobre tus retos de RR. HH.</p>
    </div>
  </section>

  <section>
    <div class="wrap">
      <p style="color:var(--text);font-size:17px;max-width:820px;margin-bottom:14px">Además de nuestras <a href="/es/online-assessments/">evaluaciones online</a> y <a href="/es/hrm-oplossingen/">soluciones de RR. HH.</a>, puedes contar con proyectos de asesoría a medida y diversos cursos.</p>
      <div class="adv">
        {items.map((it) => (
          <div class="adv-block">
            <h2>{it.h}</h2>
            <p>{it.p}</p>
            {it.href && <a class="btn btn-primary" href={it.href}>{it.cta}</a>}
          </div>
        ))}
      </div>
    </div>
  </section>

  <LogoSlider heading="Organizaciones que te precedieron" />
</Base>

<style>
  .adv { display: grid; grid-template-columns: repeat(2, 1fr); gap: 24px; margin-top: 28px; }
  .adv-block { background: #fff; border: 1px solid var(--line); border-radius: var(--radius); padding: 30px; box-shadow: var(--shadow); display: flex; flex-direction: column; }
  .adv-block h2 { color: var(--navy); font-size: 22px; font-weight: 800; margin-bottom: 12px; }
  .adv-block p { color: var(--muted); font-size: 16px; margin-bottom: 20px; flex: 1; }
  .adv-block .btn { align-self: flex-start; }
  section p a { color: var(--blue); font-weight: 600; }
  @media (max-width: 880px) { .adv { grid-template-columns: 1fr; } }
</style>
