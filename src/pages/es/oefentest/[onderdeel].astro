---
import Base from "../../../layouts/Base.astro";
import Oefentest from "../../../components/Oefentest.astro";
import { ONDERDELEN, OT_UI } from "../../../data/oefentest-ui.js";
import numeriek from "../../../data/oefenbank/numeriek.es.json";
import verbaal from "../../../data/oefenbank/verbaal.es.json";
import calculation from "../../../data/oefenbank/calculation.es.json";
import ruimtelijk from "../../../data/oefenbank/ruimtelijk.es.json";
import abstract from "../../../data/oefenbank/abstract.es.json";
const BANKEN = { numeriek, verbaal, calculation, ruimtelijk, abstract };
export function getStaticPaths() {
  return Object.entries(ONDERDELEN).map(([sleutel, o]) => ({
    params: { onderdeel: o.slug["es"] }, props: { sleutel, o },
  }));
}
const { sleutel, o } = Astro.props;
const t = OT_UI["es"];
const naam = o.naam["es"];
---
<Base lang="es" title={`${naam} | ${t.eyebrow} | hrmforce`} description={o.lead["es"]} active="">
  <Oefentest onderdeel={sleutel} lang="es" bank={BANKEN[sleutel]} />
</Base>
