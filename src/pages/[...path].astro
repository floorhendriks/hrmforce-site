---
import { BASE_DATUM_LOCALE } from "../data/component-teksten.js";
import { webpHtml, altAanvullen } from "../lib/beeld.js";
import { titel, omschrijving, kortZin } from "../lib/meta.js";
import { herstelLinks } from "../data/link-onderhoud.js";
import { merknaam, merknaamInHtml } from "../lib/merknaam.js";
import Base from "../layouts/Base.astro";
import { createClient } from "@sanity/client";
import { shopInfo } from "../data/assessment-shop.js";
import { localizePath, sanitizeBodyLinks, PREFIXED } from "../i18n/utils.js";
import LogoSlider from "../components/LogoSlider.astro";
import GratisTests from "../components/GratisTests.astro";
import validPaths from "../data/valid-paths.js";
import { DUBBELE_PADEN } from "../data/kenniscentrum-duplicaten.js";
import { ADVIES_SLUGS } from "../data/advies-detail.js";
import { OPLOSSING_SLUGS } from "../data/oplossingen.js";
import { SANITY_INTEG, SANITY_KC, SANITY_RECI18N, SANITY_T, SANITY__descFallback, SANITY__sliderH } from "../data/component-teksten.js";

// Gemigreerde kenniscentrum-artikelen uit WordPress. Elk artikel-document in
// Sanity heeft een volledig 'path'; deze catch-all route rendert ze op dat pad.
export async function getStaticPaths() {
  const client = createClient({ projectId: "hqo56w28", dataset: "production", apiVersion: "2024-01-01", useCdn: false });
  const arts = await client.fetch(
    `*[_type == "article" && defined(path) && defined(body)]{path, title, body, date}`
  );
  // Statische routes hebben voorrang; sluit paden uit die we nu als eigen
  // pagina bouwen (bijv. de sectoren-index) om dubbele routes te voorkomen.
  const OWN = new Set(["sectoren", "en/sectoren", "de/sectoren", "fr/sectoren", "es/sectoren", "ro/sectoren", "sectoren/onderwijs"]);
  // De advies- en oplossingendetailpagina's bouwen we zelf, in elke taal, uit
  // src/data/advies-detail.js en src/data/oplossingen.js. De oude
  // Sanity-versies daarvan slaan we over, anders staat hetzelfde adres twee keer
  // in de route-tabel.
  for (const taal of ["", ...PREFIXED]) {
    const voor = taal ? taal + "/" : "";
    for (const slug of ADVIES_SLUGS) OWN.add(`${voor}advies/${slug}`);
    for (const slug of OPLOSSING_SLUGS) OWN.add(`${voor}hrm-oplossingen/${slug}`);
  }
  // Artikelen die twee adressen hebben. Het lege "Verplaatst"-adres bouwen we
  // niet meer; een terugvalpagina stuurt de bezoeker naar het echte artikel.
  // Migratieresten uit WordPress: paden als /?page_id=8355/. Het zijn dubbelen
  // van echte pagina's (templates, testpagina's, tweede versies van Support en
  // de algemene voorwaarden) met een URL zonder betekenis. Ze niet bouwen haalt
  // ze ook uit de sitemap.
  // Artikelen uit een serie beginnen vaak met dezelfde zin, waardoor de
  // automatische metadescription op meerdere pagina's gelijk wordt. Markeer die,
  // zodat de titel er straks voor komt te staan.
  const kop = (b) => String(b || "").replace(/<[^>]+>/g, " ").replace(/\s+/g, " ").trim().slice(0, 160);
  const telling = {};
  for (const a of arts) { const k = kop(a.body); if (k) telling[k] = (telling[k] || 0) + 1; }

  return arts
    .filter((a) => a.path && a.path.includes("/"))
    .filter((a) => !/page_id=/i.test(a.path))
    .map((a) => ({ ...a, gedeeldeIntro: telling[kop(a.body)] > 1 }))
    .map((a) => ({ p: a.path.replace(/^\/+|\/+$/g, ""), a }))
    .filter((x) => !OWN.has(x.p))
    .filter((x) => !DUBBELE_PADEN.has(x.p))
    .map((x) => ({ params: { path: x.p }, props: { article: x.a } }));
}

const { article: _artikel } = Astro.props;
// Merknaam kleinschrijven in alles wat uit Sanity komt.
const article = { ..._artikel, title: merknaam(_artikel.title || ""), excerpt: merknaam(_artikel.excerpt || "") };
const fmt = (d) => (d ? new Date(d).toLocaleDateString("nl-NL") : "");

// Taal afleiden uit het pad (bv. /en/kenniscentrum/...).
const seg = (article.path || "").split("/").filter(Boolean)[0];
const lang = PREFIXED.includes(seg) ? seg : "nl";

// De kleurentest is de drukstbezochte gratis test. Wie hem doet, krijgt
// daaronder de elf andere gratis tests te zien in plaats van een doodlopend eind.
const toonGratisTests = /(^|\/)gratis-kleurentest\/?$/.test("/" + (article.path || "").replace(/^\/+/, ""));

// Meest relevante assessment kiezen op basis van de titel (themabuckets).
const RECI18N = SANITY_RECI18N;
const REC = RECI18N[lang] || RECI18N.nl;

// Zoekwoorden per assessment, in de zes talen van de site. Een treffer in de
// titel weegt zwaarder dan een treffer in de tekst: de titel zegt waar het
// artikel over gaat, de tekst noemt een onderwerp soms terloops.
const TREFWOORDEN = {
  "disc-test": ["disc", "gedragsstijl", "behavioural style", "verhaltensstil"],
  "big-five": ["big five", "big 5", "big fifty", "persoonlijkheid", "persoonlijk", "personality", "persönlichkeit", "personnalité", "personalidad", "personalitate", "karakter", "trek", "introvert", "extravert"],
  "cognitieve-test": ["capacite", "capacit", "cognit", "intelligent", "iq", "abstract", "matrigma", "ability", "aptitude", "leervermogen", "denkniveau", "werk- en denkniveau", "redeneer", "numeriek", "verbaal"],
  "drijfverentest": ["drijfver", "motivat", "drives", "antrieb", "bevlogen", "energie", "zingeving", "waarden"],
  "leiderschapstest": ["leider", "leadership", "management", "manager", "führung", "leidinggev", "directie", "coachend"],
  "360-graden-feedback": ["360", "feedback", "team", "samenwerk", "collega", "teamrol", "groepsrol", "retrospective"],
  "studiekeuzetest": ["studiekeuze", "beroepskeuze", "loopbaan", "career", "study", "orientat", "schoolverlat", "starter", "stage", "jong talent"],
  "competentie-check": ["competentie", "competency", "kompetenz", "compétence", "competencia", "vaardighe", "skill", "gedragsindicator", "functieprofiel"],
  "duurzame-inzetbaarheid-scan": ["inzetbaarheid", "employability", "vitalit", "werkplezier", "verzuim", "burn-out", "burnout", "werkdruk", "stress", "veerkracht", "welzijn", "retentie", "verloop"],
};
const TITELGEWICHT = 10;
function pickAssessment(title, tekst) {
  const t = (title || "").toLowerCase();
  const b = (tekst || "").slice(0, 2500).toLowerCase();
  let beste = null;
  let hoogste = 0;
  for (const [slug, woorden] of Object.entries(TREFWOORDEN)) {
    let score = 0;
    for (const w of woorden) {
      if (t.includes(w)) score += TITELGEWICHT;
      else if (b.includes(w)) score += 1;
    }
    if (score > hoogste) { hoogste = score; beste = slug; }
  }
  return hoogste >= 2 ? beste : null;
}
const contactHref = localizePath("/contact/", lang);
const allHref = localizePath("/online-assessments/", lang);

// Gerelateerde assessments voor de eindband (max 3, exclusief de aanbevolen).

// UI-teksten (nl volledig; de/fr/es/ro vallen terug op en).
const T = SANITY_T;
const L = T[lang] || T.en;

// Article + auteur/uitgever-schema (E-E-A-T). Auteur = redactie hrmforce,
// met Floor Hendriks als verantwoordelijke; uitgever = hrmforce met logo.
const _artCanon = new URL(Astro.url.pathname, "https://hrmforce.com").href;
const _articleLd = {
  "@context": "https://schema.org",
  "@type": "Article",
  headline: article.title,
  inLanguage: lang,
  ...(article.date ? { datePublished: article.date, dateModified: article.date } : {}),
  author: { "@type": "Organization", name: "hrmforce", url: "https://hrmforce.com/" },
  publisher: { "@type": "Organization", name: "hrmforce", logo: { "@type": "ImageObject", url: "https://hrmforce.com/logo.svg" } },
  mainEntityOfPage: { "@type": "WebPage", "@id": _artCanon },
  url: _artCanon,
};

// Body splitsen: contextuele kaart na de eerste </h2> (anders vóór de eindband).
let body = altAanvullen(merknaamInHtml(sanitizeBodyLinks(article.body || "", lang, validPaths)), article.title);
// Afbeeldingen stonden nog op de oude WordPress-site. Ze staan nu in /media/,
// zodat de pagina niet afhankelijk is van een domein dat vervangen wordt.
body = body.replace(/https:\/\/(?:www\.)?hrmforce\.com\/wp-content\//g, "/media/wp-content/");
// De beelden staan als webp in public/media; zie src/lib/beeld.js.
body = webpHtml(body);
// Verhuisde bronnen bijwerken, dode bronlinks ontkoppelen en verdwenen
// beelden weglaten; zie src/data/link-onderhoud.js.
body = herstelLinks(body, lang);
// Verwijder de lege, doelloze kop "Organisaties die u voorgingen" die uit de oude
// WordPress-logoslider-plugin in de gemigreerde artikelinhoud is achtergebleven.
body = body
  .replace(/<p>\s*<\/p>\s*<h2>\s*Organisaties die u voorgingen\s*<\/h2>/gi, "")
  .replace(/<h2>\s*Organisaties die u voorgingen\s*<\/h2>\s*(<p>\s*<\/p>)?/gi, "");
// Partners-pagina: extra doorlink naar de integraties (alleen echte koppelingen).
const _pathClean = (article.path || "").replace(/^\/+|\/+$/g, "");
const isPartners = _pathClean === "partners" || _pathClean.endsWith("/partners");
const _sliderH = SANITY__sliderH;
const showAdviesSlider = /^(en\/|de\/|fr\/|es\/|ro\/)?advies\//.test(_pathClean + "/") || _pathClean.indexOf("advies/") > -1;
const integHref = localizePath("/integraties/", lang);
const INTEG = SANITY_INTEG;
const INT = INTEG[lang] || INTEG.nl;
// Sommige gemigreerde artikelen brengen hun eigen paginaopmaak mee: een
// <article> eromheen en een <section> met max-width en margin:0 auto. Die
// wrapper loopt dwars door de opmaak van de pagina heen, waardoor blokken
// eronder (zoals het auteursblok) breder uitvallen dan de tekst. De inhoud
// hoort geen eigen kader te bepalen, dus die wrappers halen we eruit.
body = body
  .replace(/<\/?article\b[^>]*>/gi, "")
  .replace(/<section\b([^>]*)>/gi, (m, attrs) =>
    /max-width|margin\s*:\s*0\s+auto/i.test(attrs)
      ? `<section${attrs.replace(/\sstyle\s*=\s*("[^"]*"|'[^']*')/i, "")}>`
      : m
  );

// De gemigreerde WordPress-body bevat vaak zijn eigen <h1>. De pagina heeft al een
// <h1> in de header, dus degraderen we die naar <h2> (max één H1 per pagina).
body = body.replace(/<h1(\s[^>]*)?>([\s\S]*?)<\/h1>/gi, (m, attrs, inner) => `<h2${attrs || ""}>${inner}</h2>`);

// Afbeeldingen zonder alt-tekst krijgen een beschrijvende fallback.
const _altFallback = (article.title || "hrmforce").replace(/"/g, "");
body = body.replace(/<img\b([^>]*)>/gi, (m, attrs) =>
  /\salt\s*=/i.test(attrs) ? m : `<img${attrs} alt="${_altFallback}">`
);

// K3: eerste afbeelding uit het artikel als header-beeld, zodat de kop niet kaal is.
const _img = body.match(/<img\b[^>]*\bsrc="([^"]+)"[^>]*>/i);
const headerImg = _img ? _img[1] : "";

// Meta description uit de eerste alinea's van de body (in plaats van de titel).
const _plain = body
  .replace(/<(script|style)[\s\S]*?<\/\1>/gi, " ")
  // WordPress-shortcodes zoals [caption ...] en [/caption] stonden anders
  // letterlijk in de meta-omschrijving.
  .replace(/\[\/?[a-z][^\]]*\]/gi, " ")
  .replace(/<[^>]+>/g, " ")
  .replace(/&nbsp;/g, " ")
  .replace(/&(amp|#38);/g, "&")
  .replace(/&(quot|#34);/g, '"')
  .replace(/&(#39|apos);/g, "'")
  .replace(/\s+/g, " ")
  .trim();
// De eerste hele zinnen van het artikel, zonder beletselteken: een
// omschrijving die midden in een zin ophoudt kost kliks in de zoekresultaten.
const recSlug = pickAssessment(article.title, _plain);
const rec = recSlug ? REC[recSlug] : null;
const recShop = recSlug ? shopInfo(recSlug) : null;
const recHref = recSlug ? localizePath(`/assessments/${recSlug}/`, lang) : allHref;
const relatedPool = ["big-five", "drijfverentest", "360-graden-feedback", "disc-test", "cognitieve-test"];
const related = relatedPool.filter((x) => x !== recSlug).slice(0, 3).map((x) => ({ slug: x, label: REC[x].label }));

let metaDesc = kortZin(_plain, 160);
const _descFallback = SANITY__descFallback;
[lang] || "Lees meer over assessments, selectie en talentontwikkeling bij hrmforce.";
if (metaDesc.length < 60) metaDesc = `${article.title}. ${_descFallback}`;
// Deelt dit artikel zijn openingszin met andere delen uit dezelfde serie, dan
// zet de titel ervoor. Anders krijgen meerdere pagina's dezelfde beschrijving.
if (article.gedeeldeIntro) metaDesc = kortZin(`${article.title}. ${metaDesc}`, 170);

// Video in de body: markeren als VideoObject, zodat Google er een
// videoresultaat van kan maken met een voorbeeldafbeelding.
const _vid = (body.match(/youtube(?:-nocookie)?\.com\/embed\/([A-Za-z0-9_-]{6,})/) || [])[1] || "";
const videoLd = _vid
  ? {
      "@context": "https://schema.org",
      "@type": "VideoObject",
      name: article.title,
      description: metaDesc,
      thumbnailUrl: [`https://i.ytimg.com/vi/${_vid}/maxresdefault.jpg`],
      embedUrl: `https://www.youtube.com/embed/${_vid}`,
      uploadDate: article.date ? new Date(article.date).toISOString() : undefined,
      publisher: { "@type": "Organization", name: "hrmforce" },
    }
  : null;

// H2-koppen een id geven en daaruit een klikbare inhoudsopgave opbouwen.
const _slug = (txt) =>
  txt
    .replace(/<[^>]+>/g, " ")
    .replace(/&[a-z]+;/gi, " ")
    .toLowerCase()
    .normalize("NFD")
    .replace(/[\u0300-\u036f]/g, "")
    .replace(/[^a-z0-9]+/g, "-")
    .replace(/^-+|-+$/g, "")
    .slice(0, 60);
const toc = [];
const _seen = new Set();
body = body.replace(/<h2([^>]*)>([\s\S]*?)<\/h2>/gi, (m, attrs, inner) => {
  const label = inner.replace(/<[^>]+>/g, "").replace(/\s+/g, " ").trim();
  if (!label) return m;
  if (/\bid=/.test(attrs)) {
    const ex = attrs.match(/id="([^"]+)"/);
    if (ex) toc.push({ id: ex[1], label });
    return m;
  }
  let id = _slug(label) || "kop";
  let i = 2;
  while (_seen.has(id)) id = _slug(label) + "-" + i++;
  _seen.add(id);
  toc.push({ id, label });
  return `<h2 id="${id}"${attrs}>${inner}</h2>`;
});

// Leestijd op basis van het aantal woorden in de body.
const _words = body.replace(/<[^>]+>/g, " ").split(/\s+/).filter(Boolean).length;
const readMin = Math.max(2, Math.round(_words / 200));

const KC = SANITY_KC;
const K = KC[lang] || KC.nl;
const kcHref = localizePath("/kenniscentrum/", lang);
const overHref = localizePath("/over-ons/", lang);
const LOC = BASE_DATUM_LOCALE[lang] || BASE_DATUM_LOCALE.nl;
const dateLabel = article.date ? new Date(article.date).toLocaleDateString(LOC, { day: "numeric", month: "long", year: "numeric" }) : "";

const cut = body.indexOf("</h2>");
const bodyTop = cut !== -1 ? body.slice(0, cut + 5) : body;
const bodyBottom = cut !== -1 ? body.slice(cut + 5) : "";
---
<Base title={titel(article.title)} description={omschrijving(metaDesc)}>
  {videoLd && <script type="application/ld+json" is:inline set:html={JSON.stringify(videoLd)} />}
  <script type="application/ld+json" is:inline set:html={JSON.stringify(_articleLd)}></script>
  <div class="crumb">
    <div class="wrap"><a href={localizePath("/", lang)}>{K.crumbHome}</a> › <a href={kcHref}>{K.crumb}</a> › <span>{article.title}</span></div>
  </div>

  <div class={"kc-head" + (headerImg ? " met-beeld" : "")}>
    {headerImg && <img class="kc-hero-img" src={headerImg} alt="" aria-hidden="true" loading="eager" />}
    <div class="wrap">
      <div class="eyebrow">{K.eyebrow}</div>
      <h1>{article.title}</h1>
      <div class="kc-meta">
        {dateLabel && <span class="kc-mi"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="5" width="18" height="16" rx="2"/><path d="M8 3v4M16 3v4M3 11h18"/></svg>{K.published} {dateLabel}</span>}
        <span class="kc-mi"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/></svg>{readMin} {K.read}</span>
        <span class="kc-mi"><img src="/media/team/floor-hendriks.webp" alt="Floor Hendriks" width="26" height="26" loading="lazy" />Floor Hendriks</span>
      </div>
    </div>
  </div>

  <article class="kc-article">
    <div class="wrap">
      {toc.length > 1 && (
        <nav class="kc-toc" aria-label={K.toc}>
          <p class="kc-toc-h">{K.toc}</p>
          <ol>
            {toc.map((h) => <li><a href={`#${h.id}`}>{h.label}</a></li>)}
          </ol>
        </nav>
      )}
      <div class="kc-body" set:html={bodyTop}></div>

      {isPartners && (
        <div class="kc-integ">
          <div>
            <div class="ctx-tag">Integraties</div>
            <h3>{INT.title}</h3>
            <p>{INT.text}</p>
          </div>
          <a class="btn btn-primary" href={integHref}>{INT.btn} &rarr;</a>
        </div>
      )}

      {rec && (
        <div class="kc-ctx">
          <span class="ic">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"/><circle cx="12" cy="12" r="4"/></svg>
          </span>
          <div class="ctx-body">
            <div class="ctx-tag">{L.tag}</div>
            <h3>{rec.label}{recShop && recShop.price && <span class="ctx-price"> · {L.from} &euro;{recShop.price}</span>}</h3>
            <p>{rec.blurb}</p>
          </div>
          <a class="ctx-btn" href={recHref}>{L.card} {rec.label} →</a>
        </div>
      )}

      {bodyBottom && <div class="kc-body" set:html={bodyBottom}></div>}

      <aside class="kc-author">
        <img src="/media/team/floor-hendriks.webp" alt="Floor Hendriks, hrmforce" width="76" height="76" loading="lazy" />
        <div>
          <b>Floor Hendriks</b>
          <span class="ka-role">{K.authorRole}</span>
          <p>{K.authorBio}</p>
          <a href={overHref}>{K.authorCta} &rarr;</a>
        </div>
      </aside>

      <div class="kc-endcta">
        <h3>{L.endTitle}</h3>
        <p>{L.endText}</p>
        <div class="kc-btns">
          <a class="btn btn-primary" href={recHref}>{recSlug ? `${L.card} ${rec.label}` : L.primary} →</a>
          <a class="btn btn-ghost" href={contactHref}>{L.demo}</a>
        </div>
        <p class="kc-rel">{L.also} {related.map((r, i) => (<>{i > 0 && " · "}<a href={localizePath(`/assessments/${r.slug}/`, lang)}>{r.label}</a></>))}</p>
      </div>
    </div>
  </article>
  {toonGratisTests && <GratisTests lang={lang} huidig="kleuren" />}
  {showAdviesSlider && <LogoSlider heading={null} />}
</Base>

<style>
  .kc-head { position: relative; overflow: hidden; background: var(--navy); color: #fff; }
  .kc-hero-img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; opacity: .22; }
  .kc-head.met-beeld::after { content: ""; position: absolute; inset: 0; background: linear-gradient(rgba(13,50,100,.88),rgba(13,50,100,.88)); }
  .kc-head .wrap { position: relative; z-index: 2; }
  .kc-head .wrap { max-width: 860px; margin: 0 auto; padding: 40px 20px 34px; }
  .kc-head h1 { color: #fff; font-size: clamp(1.7rem, 1.4rem + 1.4vw, 2.3rem); line-height: 1.2; margin: 6px 0 0; }
  .kc-meta { display: flex; flex-wrap: wrap; gap: 10px 22px; margin-top: 18px; }
  .kc-mi { display: inline-flex; align-items: center; gap: 8px; color: #c4d2e6; font-size: 13.5px; font-weight: 600; }
  .kc-mi svg { width: 16px; height: 16px; color: var(--gold); }
  .kc-mi img { width: 26px; height: 26px; border-radius:var(--radius-sm); object-fit: cover; }
  .kc-toc { border-top: 1px solid var(--line); border-bottom: 1px solid var(--line); padding: 18px 0; margin: 0 0 30px; }
  .kc-toc-h { font-family: var(--font-mono); color: var(--muted); font-weight: 500; font-size: 12px; text-transform: uppercase; letter-spacing: .13em; margin: 0 0 12px; }
  .kc-toc ol { margin: 0; padding: 0; list-style: none; counter-reset: kc; display: flex; flex-direction: column; gap: 8px; }
  .kc-toc li { margin: 0; counter-increment: kc; display: flex; gap: 10px; align-items: baseline; }
  .kc-toc li::before { content: counter(kc, decimal-leading-zero); font-family: var(--font-mono); color: var(--muted); font-weight: 700; font-size: 13px; min-width: 14px; font-variant-numeric: tabular-nums; }
  .kc-toc a { color: var(--blue); font-weight: 600; font-size: 15px; text-decoration: none; }
  .kc-toc a:hover { color: var(--accent); text-decoration: underline; }
  .kc-author { display: flex; gap: 18px; align-items: flex-start; background: #fff; border: 1px solid var(--line); border-radius: var(--radius); padding: 22px 24px; margin: 34px 0 0; box-shadow:none; }
  .kc-author img { width: 76px; height: 76px; border-radius:var(--radius-sm); object-fit: cover; flex: none; }
  .kc-author b { color: var(--navy); font-size: 1.02rem; display: block; }
  .kc-author .ka-role { color: var(--muted); font-size: 13.5px; display: block; margin-top: 2px; }
  .kc-author p { color: var(--muted); font-size: 14.5px; line-height: 1.6; margin: 10px 0 8px; }
  .kc-author a { color: var(--accent); font-weight: 700; font-size: 14px; }
