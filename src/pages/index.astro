  <script define:vars={{ reviews }}>
    (function () {
      var text = document.getElementById("sp-text");
      var av = document.getElementById("sp-avatar");
      var nm = document.getElementById("sp-name");
      var dots = document.getElementById("sp-dots");
      if (!text || !dots || !reviews || reviews.length < 2) return;
      var fig = text.closest(".spotlight");
      var i = 0, timer;
      reviews.forEach(function (_, idx) {
        var b = document.createElement("button");
        b.className = "sp-dot" + (idx === 0 ? " on" : "");
        b.setAttribute("aria-label", "Review " + (idx + 1));
        b.addEventListener("click", function () { show(idx); restart(); });
        dots.appendChild(b);
      });
      function show(n) {
        i = n; var r = reviews[n];
        fig.style.opacity = 0;
        setTimeout(function () {
          text.textContent = "“" + r.text + "”";
          av.src = r.avatar; av.alt = r.name;
          nm.textContent = r.name; nm.href = r.href;
          Array.prototype.forEach.call(dots.children, function (d, idx) { d.classList.toggle("on", idx === n); });
          fig.style.opacity = 1;
        }, 260);
      }
      function restart() { clearInterval(timer); timer = setInterval(function () { show((i + 1) % reviews.length); }, 6000); }
      restart();
    })();
  </script>
