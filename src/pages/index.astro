---
import Base from "../layouts/Base.astro";
import { clients } from "../data/home.js";
import { assessments } from "../data/assessments.js";

// Social-proof metrics
const metrics = [
  { big: "240.000+", label: "tests per jaar" },
  { big: "1.200+", label: "organisaties" },
  { big: "4,9/5", label: "klantbeoordeling" },
  { big: "15+ jaar", label: "ervaring" },
];

// 6 uitgelichte assessments (op slug uit assessments.js)
const featuredSlugs = ["big-five", "cognitieve-test", "disc-test", "drijfverentest", "360-graden-feedback", "studiekeuzetest"];
const fallbackImg = "https://hrmforce.com/wp-content/uploads/2025/03/placeholder-assessment2.png";
const featured = featuredSlugs
  .map((s) => assessments.find((a) => a.slug === s))
  .filter(Boolean)
  .map((a) => ({ slug: a.slug, title: a.title, goal: a.goal, image: a.image || fallbackImg }));

// Waarom hrmforce (waardeproposities)
const valueProps = [
  { icon: "shield", h: "Wetenschappelijk gevalideerd", p: "Gebouwd op bewezen modellen (Big Five, klassieke testtheorie) en gereviewd door NIP-geregistreerde psychologen." },
  { icon: "bolt", h: "Binnen een uur live", p: "Portal in jouw huisstijl klaar, kandidaten in één klik uitgenodigd, rapport automatisch in je inbox." },
  { icon: "globe", h: "14 talen, één platform", p: "Kandidaten testen in hun eigen taal. Eén omgeving voor de complete HR-cyclus." },
  { icon: "lock", h: "AVG-proof & veilig", p: "Verwerking binnen de EU, versleutelde verbindingen en instelbare bewaartermijnen per assessment." },
];

const vpIcons = {
  shield: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3l8 3v6c0 4.5-3.2 7.9-8 9-4.8-1.1-8-4.5-8-9V6z"/><path d="M9 12l2 2 4-4"/></svg>`,
  bolt: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"/></svg>`,
  globe: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"/><path d="M3 12h18M12 3c2.5 2.5 2.5 15 0 18M12 3c-2.5 2.5-2.5 15 0 18"/></svg>`,
  lock: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="4" y="11" width="16" height="10" rx="2"/><path d="M8 11V7a4 4 0 0 1 8 0v4"/></svg>`,
};

// Vergelijking: oude manier vs. hrmforce
const compareOld = [
  "Beslissen op cv en onderbuikgevoel",
  "Dure mismatch bij een verkeerde hire",
  "Ontwikkeling zonder richting",
  "Losse tools, geen overzicht",
];
const compareNew = [
  "Objectieve, gevalideerde inzichten",
  "Hogere kans op de juiste match",
  "Gerichte groei met concrete rapporten",
  "Eén platform voor de hele HR-cyclus",
];

// Hoe het werkt (3 stappen)
const howSteps = [
  { h: "Kies wat past", p: "Selecteer een wetenschappelijk gevalideerde vragenlijst voor selectie, ontwikkeling of teams. Twijfel je? Onze specialisten adviseren vrijblijvend." },
  { h: "Nodig kandidaten uit", p: "Verstuur in één klik een persoonlijke uitnodigingslink. Kandidaten vullen de vragenlijst online in, in hun eigen taal en tempo." },
  { h: "Krijg direct inzicht", p: "Het rapport komt automatisch in je inbox. Bewezen modellen, heldere uitleg en direct bruikbaar in je gesprek of besluit." },
];

// Kenniscentrum-artikelen (behouden uit bestaande content)
const posts = [
  {
    img: "https://hrmforce.com/wp-content/uploads/2023/05/NLP-recruitment-development.webp",
    title: "Burn-out herkennen bij topperformers: wat assessmentdata laat zien",
    href: "https://hrmforce.com/kenniscentrum/hrm-software/burn-out-herkennen-bij-topperformers-wat-assessmentdata-laat-zien/",
    date: "24/04/2026",
    tags: "HRM software, Nieuws",
    excerpt: "Burn-out herkennen bij medewerkers is lastig als je alleen afgaat…",
  },
  {
    img: "https://hrmforce.com/wp-content/uploads/2020/07/no-image.jpg",
    title: "Matrigma: wat meet deze capaciteitentest precies?",
    href: "https://hrmforce.com/kenniscentrum/ontwikkeling/matrigma/",
    date: "06/01/2026",
    tags: "Capaciteiten, Ontwikkeling",
    excerpt: "Veel organisaties selecteren op cv en ervaring, terwijl het echte…",
  },
  {
    img: "https://hrmforce.com/wp-content/uploads/2020/07/no-image.jpg",
    title: "Talent management system software. Alles over strategisch talentbeleid",
    href: "https://hrmforce.com/kenniscentrum/hrm-software/talent-management-system-software-alles-over-strategisch-talentbeleid/",
    date: "19/12/2025",
    tags: "HRM software",
    excerpt: "Talent bepaalt of organisaties groeien of vastlopen, terwijl veel…",
  },
  {
    img: "https://hrmforce.com/wp-content/uploads/2020/07/no-image.jpg",
    title: "Leiderschapsontwikkeling: hoe data leiders laat groeien",
    href: "https://hrmforce.com/kenniscentrum/ontwikkeling/leiderschapsontwikkeling/",
    date: "08/12/2025",
    tags: "Leiding geven, Ontwikkeling",
    excerpt: "Veel organisaties willen leidinggevenden die teams meenemen in ve…",
  },
  {
    img: "https://hrmforce.com/wp-content/uploads/2025/09/people-4328648_1280.png",
    title: "Waarom een ontwikkelassessment voor iedereen belangrijk is",
    href: "https://hrmforce.com/kenniscentrum/ontwikkeling/ontwikkelassessment-belangrijk/",
    date: "22/09/2025",
    tags: "Ontwikkeling",
    excerpt: "Een ontwikkelassessment is een systematische methode om…",
  },
  {
    img: "https://hrmforce.com/wp-content/uploads/2025/09/assessment-8777361_1280.png",
    title: "Intelligentietest voor volwassenen: doe de gratis oefentest",
    href: "https://hrmforce.com/kenniscentrum/capaciteiten/intelligentietest-volwassenen/",
    date: "22/09/2025",
    tags: "Capaciteiten",
    excerpt: "Een intelligentietest voor volwassenen brengt in kaart hoe je red…",
  },
];

// Reviews (echte reviewteksten uit bestaande content)
const reviews = [
  {
    name: "Esther M.",
    href: "https://www.google.com/maps/contrib/115910511765005052442/reviews",
    avatar: "https://lh3.googleusercontent.com/a/ACg8ocIhKQ63iBmiXYhMAhfrrkFkQaxjlYW2KO2B8gdpuQjOtNvXFQ=s128-c0x00000000-cc-rp-mo",
    text: "Enorm klantvriendelijk en meedenkend. HRMforce heeft mij geholpen talenten en ontwikkelpunten van mijn medewerkers in kaart te brengen, wat heeft gezorgd voor een enorm boost voor het bedrijf.",
  },
  {
    name: "Eric H.",
    href: "https://www.google.com/maps/contrib/103157241363380674799/reviews",
    avatar: "https://lh3.googleusercontent.com/a-/ALV-UjWrAxJ0maIGi5Z1EyHdGPMCO-qcqcM2t-pCd8Hj_hpyD6boNqDM=s128-c0x00000000-cc-rp-mo-ba2",
    text: "Goede dienstverlener met uitstekende tools voor talentontwikkeling. Zo help je organisaties vooruit.",
  },
  {
    name: "Juliëtte K.",
    href: "https://www.google.com/maps/contrib/103151884185464760911/reviews",
    avatar: "https://lh3.googleusercontent.com/a-/ALV-UjWzNKARK4Sotv0Pu1cRYYw1lEBsdx1-ocrtfJ08Vu1qLn15rQ_w=s128-c0x00000000-cc-rp-mo",
    text: "Leuke gratis kleurentest gedaan! Prettige en professionele dienstverlening.",
  },
];

const faqs = [
  {
    q: "Welke assessments passen bij selectie en welke bij ontwikkeling?",
    a: `Het doel waarvoor je het instrument inzet, bepaalt de keuze. Bij <strong>selectie</strong> zoek je signalen die voorspellen hoe iemand zich straks gedraagt in de functie. Gestructureerde capaciteitentesten en persoonlijkheidsvragenlijsten zoals de <a href="/assessments/big-fifty/">Big Fifty</a> horen daarbij.<br /><br />Bij <strong>ontwikkeling</strong> draait het om zelfinzicht, gesprek en groei. Daar passen instrumenten als <a href="/assessments/preselectie/disc-test/">DISC</a> en <a href="/assessments/360-graden-feedback/">360 graden feedback</a> beter, omdat de waarde zit in de nabespreking en de opvolging.<br /><br />In het <a href="/assessment-overzicht/">assessment-overzicht</a> zie je per instrument voor welk doel het is ontwikkeld.`,
  },
  {
    q: "Hoe wetenschappelijk onderbouwd zijn de vragenlijsten van hrmforce?",
    a: `De vragenlijsten zijn gebouwd op bewezen modellen. Voor persoonlijkheid werken we vanuit de Big Five, voor drijfveren vanuit werkgerelateerde drijfverenmodellen en voor cognitief vermogen vanuit klassieke testtheorie. Per instrument staat op de assessment-pagina wat het meet, voor welke doelgroep het werkt en welke onderbouwing eronder ligt.<br /><br />Bij instrumenten waarvoor een COTAN-beoordeling beschikbaar is, vermelden we de status zichtbaar op de pagina. We werken samen met NIP-geregistreerde psychologen die de inhoud van de rapporten reviewen.<br /><br />Wil je de technische onderbouwing van een specifieke vragenlijst inzien, vraag deze dan op via een <a href="/contact/">demo-gesprek</a>.`,
  },
  {
    q: "Hoe snel kunnen we live met de assessments?",
    a: `Voor losse afnames via de <a href="https://hrmforce.com/shop/">webshop</a> ben je direct online. Je rekent af, ontvangt de uitnodigingslink en stuurt die door naar de kandidaat. Het rapport komt per mail zodra de vragenlijst is ingevuld.<br /><br />Voor een licentie of een implementatie binnen onze <a href="/hrm-oplossingen/">HR-tooling</a> rekenen we doorgaans twee tot drie weken voor inrichting, uitrol en gebruikersinstructie. Bij grotere trajecten met integraties of meerdere modules plannen we de doorlooptijd in overleg.`,
  },
  {
    q: "Wat is het verschil tussen een licentie en de webshop?",
    a: `De <a href="https://hrmforce.com/shop/">webshop</a> is bedoeld voor incidentele afnames. Je rekent af per assessment en krijgt direct toegang. Handig voor freelance consultants, kleinere organisaties of teams die af en toe een vragenlijst inzetten. In de webshop vind je ook instrumenten van partners zoals Talogy, PiCompany en Cubiks.<br /><br />Een <a href="/assessment-overzicht/">licentie</a> past bij organisaties die structureel of op grotere schaal assessments inzetten. Je hebt toegang binnen afgesproken kaders, eigen branding op rapporten en gebruikersbeheer in het platform.<br /><br />Twijfel je welke vorm past, plan dan een kort gesprek waarin we kijken naar je afnamevolume en je doelen.`,
  },
  {
    q: "Kunnen we de assessments koppelen aan onze HR-software?",
    a: `Ja. Onze <a href="/hrm-oplossingen/matching/">Matching-module</a> en het bredere <a href="/hrm-oplossingen/">hrmforce platform</a> werken samen met de meest gebruikte ATS-, HR- en payroll-systemen via API of SSO. Veel klanten koppelen aan AFAS, Visma, Nmbrs, SuccessFactors of een eigen recruitmentsysteem.<br /><br />Tijdens de intake brengen we in kaart welke koppelingen voor jullie processen waarde toevoegen. Vraag het overzicht op via een <a href="/contact/">gesprek met een specialist</a>.`,
  },
  {
    q: "Hoe gaan jullie om met persoonsgegevens en de AVG?",
    a: `Persoonsgegevens worden verwerkt binnen de Europese Unie. We werken met versleutelde verbindingen, rolgebaseerd gebruikersbeheer en bewaartermijnen die je per assessment zelf instelt. Voor elk traject leggen we een verwerkersovereenkomst vast.<br /><br />Kandidaten zien voorafgaand aan het invullen wat er met hun gegevens gebeurt, wie het rapport te zien krijgt en hoe lang het wordt bewaard. Dat past bij de eisen van de AVG en de zorgvuldigheid die het NIP voor assessment-onderzoek voorschrijft.`,
  },
  {
    q: "In welke talen zijn de assessments beschikbaar?",
    a: `Kandidaten vullen de meeste vragenlijsten in in het Nederlands, Engels, Duits, Frans, Spaans of Roemeens. Per assessment verschilt welke talen actief zijn. Op de pagina van het instrument zie je het actuele overzicht.<br /><br />Heb je kandidaten in een andere taal of werk je internationaal, bespreek dat dan vooraf zodat we de juiste taalversie klaarzetten.`,
  },
  {
    q: "Wat krijgt de kandidaat na het invullen van een assessment?",
    a: `De kandidaat ontvangt direct een bevestiging en, afhankelijk van de afspraak die je vooraf maakt, een persoonlijk rapport. Bij ontwikkelassessments krijgt de kandidaat doorgaans hetzelfde rapport als de opdrachtgever, soms met een aparte gespreksleidraad. Bij selectie-assessments bepaalt de opdrachtgever wat de kandidaat terugkrijgt.<br /><br />Een terugkoppelingsgesprek vergroot de waarde van het rapport, voor de kandidaat én voor de organisatie. Dat past bij de zorgvuldigheid die wij voorstaan rond assessment-onderzoek.`,
  },
];
---
<Base
  title="Talentmanagement software | Assessment bureau | Hrmforce"
  description="De talentmanagement software van hrmforce helpt HR managers van over de hele wereld meer rendement halen uit medewerkers."
  active=""
>
  <!-- 1. HERO -->
  <section class="hero">
    <span class="hero-blob gold" aria-hidden="true"></span>
    <span class="hero-blob blue" aria-hidden="true"></span>
    <div class="wrap">
      <div>
        <span class="eyebrow" style="color:var(--gold)">Talentmanagement software</span>
        <h1>Neem betere beslissingen over <em>mensen</em></h1>
        <p class="sub">Onderbouwd, snel en objectief. Wetenschappelijk gevalideerde assessments voor selectie, ontwikkeling en teams.</p>
        <div class="hero-btns">
          <a class="btn btn-primary" href="/contact/">Plan een gratis demo →</a>
          <a class="btn btn-ghost hero-ghost" href="/online-assessments/">Bekijk alle assessments</a>
        </div>
        <p class="hero-micro">Binnen 24 uur reactie · geen verkoopdruk · vrijblijvend advies</p>
        <div class="hero-badges">
          <span class="hb"><span class="hb-ic">✓</span> COTAN-beoordeeld</span>
          <span class="hb"><span class="hb-ic">✓</span> NIP-psychologen</span>
          <span class="hb"><span class="hb-ic">✓</span> AVG-proof (EU)</span>
        </div>
      </div>

      <!-- Glazen statspaneel: kerncijfers + competentiebalken + trend -->
      <div class="hero-graphic">
        <div class="glass-card">
          <div class="glass-head"><span>Competentieprofiel</span><span class="live">live data</span></div>
          <div class="glass-stats">
            <div class="gs"><b>240.000+</b><span>tests / jaar</span></div>
            <div class="gs"><b>1.200+</b><span>organisaties</span></div>
            <div class="gs"><b>4,9★</b><span>beoordeling</span></div>
          </div>
          <div class="glass-bars">
            <div class="gbar"><em>Persoonlijkheid</em><div class="gtrack"><div class="gfill" style="--w:86%"></div></div></div>
            <div class="gbar"><em>Drijfveren</em><div class="gtrack"><div class="gfill" style="--w:72%"></div></div></div>
            <div class="gbar"><em>Cognitief</em><div class="gtrack"><div class="gfill" style="--w:64%"></div></div></div>
            <div class="gbar"><em>Potentieel</em><div class="gtrack"><div class="gfill" style="--w:91%"></div></div></div>
          </div>
          <div class="glass-foot">↑ Ontwikkeltrend · match met functie <b>88%</b></div>
        </div>
      </div>
    </div>
  </section>

  <!-- 2. SOCIAL PROOF -->
  <section class="proof">
    <div class="wrap" style="display:block">
      <div class="metric-cards">
        {metrics.map((m) => (
          <div class="metric-card">
            <div class="mc-big">{m.big}</div>
            <div class="mc-lab">{m.label}</div>
          </div>
        ))}
      </div>

      <p class="lead center" style="margin:44px auto 0">Vertrouwd door 1.200+ organisaties</p>
      <div class="logo-marquee" aria-label="Klanten van hrmforce">
        <div class="lm-track">
          {[...clients, ...clients].map((c) => (
            <div class="lm-cell"><img src={c.logo} alt={c.name} loading="lazy" /></div>
          ))}
        </div>
      </div>

      <figure class="spotlight">
        <div class="stars">★★★★★</div>
        <blockquote id="sp-text">“{reviews[0].text}”</blockquote>
        <figcaption id="sp-cap">
          <img id="sp-avatar" src={reviews[0].avatar} alt={reviews[0].name} loading="lazy" />
          <span><a id="sp-name" href={reviews[0].href} class="sp-name">{reviews[0].name}</a><small>Tevreden klant · Google-review</small></span>
        </figcaption>
        <div class="sp-dots" id="sp-dots" role="tablist" aria-label="Reviews"></div>
      </figure>
    </div>
  </section>

  <!-- 2b. WAAROM HRMFORCE -->
  <section>
    <div class="wrap" style="display:block">
      <span class="eyebrow center">Waarom hrmforce</span>
      <h2 class="section-title center">Onderbouwde beslissingen, zonder gedoe</h2>
      <p class="lead center" style="margin:0 auto 40px">Alles wat je nodig hebt om talent objectief te beoordelen en te ontwikkelen — op één plek.</p>
      <div class="value-grid">
        {valueProps.map((v) => (
          <div class="value-tile">
            <span class="value-ic" set:html={vpIcons[v.icon]}></span>
            <h3>{v.h}</h3>
            <p>{v.p}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- 2c. VERGELIJKING -->
  <section class="bg-soft">
    <div class="wrap" style="display:block">
      <span class="eyebrow center">Het verschil</span>
      <h2 class="section-title center">Van onderbuik naar onderbouwd</h2>
      <p class="lead center" style="margin:0 auto 40px">Stop met gokken op cv en gevoel. Beslis op basis van gevalideerde data.</p>
      <div class="vs-grid">
        <div class="vs-card old">
          <h3>De oude manier</h3>
          <ul>
            {compareOld.map((t) => <li><span class="vs-ic x">✕</span>{t}</li>)}
          </ul>
        </div>
        <div class="vs-card new">
          <span class="vs-tag">Met hrmforce</span>
          <h3>De onderbouwde manier</h3>
          <ul>
            {compareNew.map((t) => <li><span class="vs-ic v">✓</span>{t}</li>)}
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- 3. UITGELICHTE ASSESSMENTS -->
  <section>
    <div class="wrap" style="display:block">
      <span class="eyebrow center">Populaire assessments</span>
      <h2 class="section-title center">Kies uit wetenschappelijk gevalideerde vragenlijsten</h2>
      <p class="lead center" style="margin:0 auto 40px">Voor selectie, ontwikkeling en teams. Elk instrument met een helder doel en een direct bruikbaar rapport.</p>
      <div class="assess-grid">
        {featured.map((a) => (
          <a class="assess-card" href={`/assessments/${a.slug}/`}>
            <div class="assess-img"><img src={a.image} alt={a.title} loading="lazy" /></div>
            <div class="assess-body">
              <h3>{a.title}</h3>
              <p>{a.goal}</p>
              <span class="readmore">Bekijk assessment →</span>
            </div>
          </a>
        ))}
      </div>
      <div class="center" style="margin-top:36px">
        <a class="btn btn-primary" href="/online-assessments/">Bekijk alle 36 assessments</a>
      </div>
    </div>
  </section>

  <!-- 4. HOE HET WERKT -->
  <section class="bg-soft">
    <div class="wrap" style="display:block">
      <span class="eyebrow center">Zo werkt het</span>
      <h2 class="section-title center">In 3 stappen naar inzicht</h2>
      <p class="lead center" style="margin:0 auto 44px">Eenvoudig, bewezen en direct bruikbaar in je gesprek of besluit.</p>
      <div class="how-steps">
        {howSteps.map((s, i) => (
          <div class="how-step">
            <div class="how-icon">
              {i === 0 && (
                <svg width="26" height="26" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M9 11l3 3L22 4" stroke="#fff" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/><path d="M21 12v7a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11" stroke="#fff" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
              )}
              {i === 1 && (
                <svg width="26" height="26" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2" stroke="#fff" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/><circle cx="9" cy="7" r="4" stroke="#fff" stroke-width="2"/><path d="M19 8v6M22 11h-6" stroke="#fff" stroke-width="2" stroke-linecap="round"/></svg>
              )}
              {i === 2 && (
                <svg width="26" height="26" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M3 3v18h18" stroke="#fff" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/><path d="M7 14l4-4 3 3 5-6" stroke="#fff" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
              )}
              <span class="how-num">{i + 1}</span>
            </div>
            <h3>{s.h}</h3>
            <p>{s.p}</p>
          </div>
        ))}
      </div>
      <div class="center" style="margin-top:44px">
        <a class="btn btn-primary" href="/contact/">Plan een gratis demo</a>
      </div>
    </div>
  </section>

  <!-- 5c. FAQ (behouden) -->
  <section class="blog">
    <div class="wrap" style="display:block;max-width:900px">
      <div class="eyebrow center">Veelgestelde vragen</div>
      <h2 class="section-title center">Direct antwoord op de vragen voor je kiest</h2>
      <p class="lead center" style="margin-bottom:32px">Wat HR-managers, directies en consultants willen weten voordat ze met onze assessments en HR-tooling starten.</p>
      {faqs.map((f) => (
        <div class="faq-item">
          <div class="faq-q">{f.q}<span class="pl">+</span></div>
          <div class="faq-a"><p set:html={f.a}></p></div>
        </div>
      ))}
    </div>
  </section>

  <!-- 5d. Afsluitende CTA (behouden) -->
  <section class="cta">
    <div class="wrap" style="display:block">
      <div class="eyebrow center" style="color:var(--gold)">Plan een demo</div>
      <h2>Ontdek welke aanpak past bij jouw HR-vraagstuk</h2>
