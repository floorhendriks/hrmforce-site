---
import Base from "../../../layouts/Base.astro";
import Oefentest from "../../../components/Oefentest.astro";
import Oefenvragenlijst from "../../../components/Oefenvragenlijst.astro";
import { ONDERDELEN, OT_UI } from "../../../data/oefentest-ui.js";
import { VRAGENLIJSTEN, VL_UI } from "../../../data/oefenvragenlijst.js";
import numeriek from "../../../data/oefenbank/numeriek.ro.json";
import verbaal from "../../../data/oefenbank/verbaal.ro.json";
import calculation from "../../../data/oefenbank/calculation.ro.json";
import ruimtelijk from "../../../data/oefenbank/ruimtelijk.ro.json";
import abstract from "../../../data/oefenbank/abstract.ro.json";
import vlbigfive from "../../../data/oefenbank/vl-bigfive.ro.json";
import vldisc from "../../../data/oefenbank/vl-disc.ro.json";
import vldrijfveren from "../../../data/oefenbank/vl-drijfveren.ro.json";
import vlleiderschap from "../../../data/oefenbank/vl-leiderschap.ro.json";
import vlcompetenties from "../../../data/oefenbank/vl-competenties.ro.json";
import vlstudiekeuze from "../../../data/oefenbank/vl-studiekeuze.ro.json";
const BANKEN = { numeriek, verbaal, calculation, ruimtelijk, abstract };
const BANKEN_VL = { bigfive: vlbigfive, disc: vldisc, drijfveren: vldrijfveren, leiderschap: vlleiderschap, competenties: vlcompetenties, studiekeuze: vlstudiekeuze };
export function getStaticPaths() {
  const tests = Object.entries(ONDERDELEN).map(([sleutel, o]) => ({
    params: { onderdeel: o.slug["ro"] }, props: { sleutel, o, vragenlijst: false },
  }));
  const lijsten = Object.entries(VRAGENLIJSTEN).map(([sleutel, o]) => ({
    params: { onderdeel: o.slug["ro"] }, props: { sleutel, o, vragenlijst: true },
  }));
  return [...tests, ...lijsten];
}
const { sleutel, o, vragenlijst } = Astro.props;
const t = vragenlijst ? VL_UI["ro"] : OT_UI["ro"];
const naam = o.naam["ro"];
---
<Base lang="ro" title={`${naam} | ${t.eyebrow} | hrmforce`} description={o.lead["ro"]} active="">
  {vragenlijst
    ? <Oefenvragenlijst onderdeel={sleutel} lang="ro" bank={BANKEN_VL[sleutel]} />
    : <Oefentest onderdeel={sleutel} lang="ro" bank={BANKEN[sleutel]} />}
</Base>
