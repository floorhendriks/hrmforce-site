---
import Base from "../../../layouts/Base.astro";
import Oefentest from "../../../components/Oefentest.astro";
import { ONDERDELEN, OT_UI } from "../../../data/oefentest-ui.js";
import bank from "../../../data/oefenbank/numeriek.ro.json";
export function getStaticPaths() {
  return Object.entries(ONDERDELEN).map(([sleutel, o]) => ({
    params: { onderdeel: o.slug["ro"] }, props: { sleutel, o },
  }));
}
const { sleutel, o } = Astro.props;
const t = OT_UI["ro"];
const naam = o.naam["ro"];
---
<Base lang="ro" title={`${naam} | ${t.eyebrow} | hrmforce`} description={o.lead["ro"]} active="">
  <Oefentest onderdeel={sleutel} lang="ro" bank={bank} />
</Base>
