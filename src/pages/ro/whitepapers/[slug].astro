---
import Base from "../../../layouts/Base.astro";
import WhitepaperDetail from "../../../components/WhitepaperDetail.astro";
import { WHITEPAPERS, WP_UI } from "../../../data/whitepapers-content.js";
export function getStaticPaths(){ return WHITEPAPERS.map((wp)=>({ params:{slug:wp.slug}, props:{wp} })); }
const { wp } = Astro.props; const ui = WP_UI.ro; const d = wp.i18n.ro;
---
<Base title={`${d.title} | hrmforce`} description={d.summary} active=""><WhitepaperDetail wp={wp} ui={ui} lang="ro" /></Base>
