---
import Base from "../../../layouts/Base.astro";
import Vergelijking from "../../../components/Vergelijking.astro";
import { VERG_UI, COMPETITORS } from "../../../data/vergelijking-content.js";
export function getStaticPaths(){ return Object.keys(COMPETITORS).map((slug)=>({ params:{slug}, props:{slug} })); }
const { slug } = Astro.props; const t = VERG_UI.ro; const c = COMPETITORS[slug];
---
<Base title={`${t.altPrefix} ${c.name} | hrmforce`} description={`hrmforce față de ${c.name}: ce măsoară instrumentele, în ce limbi sunt disponibile și cât costă o licență. Fără discurs comercial.`} active=""><Vergelijking slug={slug} lang="ro" /></Base>
