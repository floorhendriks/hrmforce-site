---
import Base from "../layouts/Base.astro";
import LogoSlider from "../components/LogoSlider.astro";

const items = [
  { h: "Training", p: "Word met de certificatietraining van hrmforce een gecertificeerd gebruiker: je leert onze vragenlijsten inzetten, resultaten correct interpreteren en zorgvuldig terugkoppelen. Daarnaast bieden we trainingen op maat, zoals 'Het goede gesprek'. Bekijk de trainingskalender en schrijf je direct in.", href: "/advies/trainingen/", cta: "Bekijk trainingen & kalender" },
  { h: "Live Assessments", p: "Naast de zelfservice online tests begeleiden onze assessoren live assessments: van selectie- en ontwikkelassessments tot loopbaan- en teamtrajecten. Je bekijkt alle beschikbare assessments en zet ze gericht in voor jouw vraagstuk.", href: "/advies/assessments/", cta: "Bekijk alle assessments" },
  { h: "Talent Management", p: "Als men de 80-20-regel toepast op recruitment, blijkt dat 20% van de aangeworven kandidaten voor 80% van de resultaten zorgt. Meer dan ooit ligt de focus op het werven van deze talenten. Door de huidige economische omstandigheden is het ook noodzakelijk om talent in de organisatie te herkennen en te benutten.", href: "/advies/talent-management/", cta: "Meer informatie" },
  { h: "Competentie Management", p: "Bij het invoeren van competentiemanagement worden de visie & strategie van je organisatie vertaald in doelstellingen. Goed geimplementeerd competentiemanagement verdient zich dubbel en dwars terug. Het zorgt voor helderheid en structuur in alle functies van de organisatie.", href: "/advies/competentie-management/", cta: "Meer informatie" },
  { h: "Loopbaan", p: "Een loopbaantraject van hrmforce is gericht op de toekomst en het verlangen: 'Wat wil ik?'. De deelnemer wil iets met zijn of haar loopbaan maar heeft moeite met het richting geven. Op de achtergrond spelen de vragen 'Wie ben ik?' en 'Wat kan ik?' vaak mee.", href: "/advies/loopbaan-assessment/", cta: "Meer informatie" },
  { h: "Consultancy", p: "Je organisatie verandert. Zij groeit, vernieuwt of past zich aan. In tijden waarin de technologische innovatie zo snel gaat, betekent stilstaan zelfs achteruitgaan. Je kiest voor een ambitieuze strategie en zoals altijd is de realisatie daarvan de grootste uitdaging.", href: "/contact/", cta: "Neem contact op" },
  { h: "Coaching", p: "Zet coaching in om medewerkers te laten groeien op basis van hun persoonlijkheid, motivatie en gedrag, en om mogelijke beroepen en loopbaanstappen te verkennen die bij hen passen.", href: "/contact/", cta: "Neem contact op" },
  { h: "Selectie Begeleiding", p: "Een nieuw persoon binnen de organisatie halen voor impactvolle functies is geen dagelijkse bezigheid. Als assessoren beoordelen wij met onze expertise in gedragsonderzoek objectief de geschiktheid tijdens alle fases van het werving- en selectieproces.", href: "/contact/", cta: "Neem contact op" },
];
---
<Base
  title="Hrmforce advies | Waarmee wij jouw bedrijf helpen"
  description="Naast onze online assessments en HRM oplossingen kun je bij ons terecht voor adviestrajecten op maat en verschillende trainingen."
  active="advice"
>
  <div class="crumb">
    <div class="wrap"><a href="/">Home</a> › <span>Advies</span></div>
  </div>

  <section class="ahero">
    <div class="wrap" style="display:block">
      <div class="eyebrow" style="color:var(--gold)">Advies</div>
      <h1>Hrmforce advies</h1>
      <p style="color:#c4d2e6;font-size:19px;max-width:820px;margin-top:8px">Naast onze online assessments en HRM oplossingen kun je bij ons terecht voor <strong>adviestrajecten op maat</strong> en verschillende trainingen. We helpen met het implementeren en optimaliseren van de HR-processen binnen je organisatie.</p>
    </div>
  </section>

  <section>
    <div class="wrap">
      <p style="color:var(--text);font-size:17px;max-width:820px;margin-bottom:14px">Naast onze <a href="/online-assessments/">online assessments</a> en <a href="/hrm-oplossingen/">HRM oplossingen</a> kun je bij ons terecht voor <strong>adviestrajecten op maat</strong> en verschillende trainingen. We helpen met het implementeren en optimaliseren van de HR-processen binnen je organisatie.</p>

      <div class="adv">
        {items.map((it) => (
          <div class="adv-block">
            <h2>{it.h}</h2>
            <p>{it.p}</p>
            {it.href && <a class="btn btn-primary" href={it.href}>{it.cta || "Meer informatie"}</a>}
          </div>
        ))}
      </div>
    </div>
  </section>

<LogoSlider heading="Organisaties die u voorgingen" />

  <section class="cta">
    <div class="wrap">
      <h2>Benieuwd wat het juiste adviestraject jou oplevert?</h2>
      <p>Plan een vrijblijvende demo en we stemmen samen de best passende aanpak af, of bekijk direct de mogelijkheden en tarieven.</p>
      <div class="btns">
        <a href="/contact/" class="btn btn-primary">Plan een demo</a>
        <a href="/tarieven/" class="btn btn-light">Bekijk de tarieven</a>
      </div>
    </div>
  </section>
</Base>

<style>
  .adv { display: grid; grid-template-columns: repeat(2, 1fr); gap: 24px; margin-top: 28px; }
  .adv-block { background: #fff; border: 1px solid var(--line); border-radius: var(--radius); padding: 30px; box-shadow: var(--shadow); display: flex; flex-direction: column; }
  .adv-block h2 { color: var(--navy); font-size: 22px; font-weight: 800; margin-bottom: 12px; }
  .adv-block p { color: var(--muted); font-size: 16px; margin-bottom: 20px; flex: 1; }
  .adv-block .btn { align-self: flex-start; }
  section p a { color: var(--blue); font-weight: 600; }
  @media (max-width: 880px) { .adv { grid-template-columns: 1fr; } }
</style>
