---
import Img from "../../components/Img.astro";
import Base from "../../layouts/Base.astro";
import { assessments } from "../../data/assessments.js";
import { shopInfo } from "../../data/assessment-shop.js";
import { FORMSPREE_ENDPOINT, CONTACT_EMAIL } from "../../data/site-config.js";
import { getLangFromUrl, localizePath } from "../../i18n/utils.js";
import { examplesFor } from "../../data/assessment-examples.js";
import { extraFor } from "../../data/assessment-detail-extra.js";
import { theoryFor } from "../../data/assessment-theory.js";
import { generalFaq } from "../../data/general-faq.js";
import { posts as kcPosts } from "../../data/blog.js";
import validPaths from "../../data/valid-paths.js";
import { navHref } from "../../i18n/utils.js";
import { oefentests } from "../../data/oefentests.js";
import QMock from "../../components/QMock.astro";
import ReviewSlider from "../../components/ReviewSlider.astro";
import SocialProof from "../../components/SocialProof.astro";

const formAction = FORMSPREE_ENDPOINT || `mailto:${CONTACT_EMAIL}`;

// Alle assessments komen uit het lokale databestand (36 stuks), zodat álle
// detailpagina's gegenereerd worden ongeacht de Sanity-inhoud.
export async function getStaticPaths() {
  return assessments.map((a) => ({ params: { slug: a.slug }, props: { a } }));
}

const lang = getLangFromUrl(Astro.url);
let a = Astro.props.a;
if (!a) {
  const { sanity, pick } = await import("../../lib/sanity.js");
  const { assessmentBySlug } = await import("../../lib/queries.js");
  const r = await sanity.fetch(assessmentBySlug, { slug: Astro.params.slug });
  const initials = (r?.quote?.author || "").split(" ").map((w) => w[0]).join("").slice(0, 2);
  a = {
    title: pick(r.title, lang), phase: pick(r.phase, lang), goal: pick(r.goal, lang),
    time: pick(r.time, lang), form: pick(r.form, lang), feedback: pick(r.feedback, lang), extra: pick(r.extra, lang),
    traits: (r.traits || []).map((t) => pick(t, lang)),
    intro: (r.intro || []).map((p) => pick(p, lang)),
    body: (r.body || []).map((p) => pick(p, lang)),
    quote: { heading: pick(r.quote?.heading, lang), text: pick(r.quote?.text, lang), author: r.quote?.author || "", role: pick(r.quote?.role, lang), initials },
    faq: (r.faq || []).map((f) => ({ q: pick(f.q, lang), a: pick(f.a, lang) })),
    metaTitle: pick(r.title, lang), metaDescription: pick(r.goal, lang), related: [],
  };
}
const assessHref = localizePath("/online-assessments/", lang);
const ex = examplesFor(Astro.params.slug, lang);
const extra = extraFor(Astro.params.slug, lang);
const theory = theoryFor(Astro.params.slug, lang);
// Datagedreven "kerndimensies"-ring: segmenten uit de traits van de test, naam in het midden.
// Zo krijgt elke test een uniek, passend beeld en toont "Big Five" alleen bij Big Five.
const RING_COLORS = ["var(--navy)", "var(--blue)", "var(--gold)", "var(--accent)", "#7aa7d6", "#2f6db0"];
const _ringTraits = (a.traits && a.traits.length ? a.traits : ["Dimensie 1", "Dimensie 2", "Dimensie 3", "Dimensie 4"]).slice(0, 6);
const _rn = _ringTraits.length;
const ringBg = "conic-gradient(" + _ringTraits.map((_t, i) => {
  const c = RING_COLORS[i % RING_COLORS.length];
  return c + " " + Math.round((i * 100) / _rn) + "% " + Math.round(((i + 1) * 100) / _rn) + "%";
}).join(", ") + ")";
let _ringBase = (a.title || "").split("|")[0].trim();
if (_ringBase.indexOf(":") > -1) _ringBase = _ringBase.split(":").pop().trim();
const ringLabel = _ringBase;
const _specQ = new Set((a.faq || []).map((f) => (f.q || "").trim().toLowerCase()));
const allFaq = [...(a.faq || []), ...generalFaq(lang).filter((g) => !_specQ.has((g.q || "").trim().toLowerCase()))];

// Shop-info (prijs + bestellink) op basis van de huidige slug.
const shop = shopInfo(Astro.params.slug);

// Gerelateerde assessments: koppel de titels uit a.related aan echte pagina's.
const byTitle = new Map(assessments.map((x) => [x.title, x]));
const related = (a.related || [])
  .map((t) => byTitle.get(t))
  .filter(Boolean)
  .slice(0, 3)
  .map((x) => ({ title: x.title, slug: x.slug, image: x.image, goal: x.goal }));
const _oefen = (oefentests || []).find((o) => o.assessmentSlug === Astro.params.slug);
const _canon = new URL(Astro.url.pathname, "https://hrmforce.com").href;
const _crumbLd = { "@context": "https://schema.org", "@type": "BreadcrumbList", itemListElement: [
  { "@type": "ListItem", position: 1, name: "Home", item: "https://hrmforce.com/" },
  { "@type": "ListItem", position: 2, name: "Online assessments", item: new URL(assessHref, "https://hrmforce.com").href },
  { "@type": "ListItem", position: 3, name: a.title, item: _canon },
] };
const _faqLd = { "@context": "https://schema.org", "@type": "FAQPage", mainEntity: (allFaq || []).map((f) => ({ "@type": "Question", name: f.q, acceptedAnswer: { "@type": "Answer", text: f.a } })) };
// Relevante kenniscentrum-artikelen bij dit assessment (interne links voor SEO).
const _hay = `${a.title||""} ${a.phase||""} ${a.goal||""} ${(a.traits||[]).join(" ")}`.toLowerCase();
const _kw = (t) => (t||"").toLowerCase().split(/[^a-z0-9\u00e0-\u00ff]+/).filter((w) => w.length > 4);
const kcRelated = (kcPosts || [])
  .map((p) => {
    const words = new Set([..._kw(p.title), ..._kw(p.category), ..._kw(p.excerpt)]);
    let score = 0;
    words.forEach((w) => { if (_hay.includes(w)) score += 1; });
    return { p, score };
  })
  .sort((x, y) => y.score - x.score || new Date(y.p.date) - new Date(x.p.date))
  .slice(0, 3)
  .map((x) => x.p);
const _offerLd = (shop && shop.price)
  ? { "@context": "https://schema.org", "@type": "Product", name: a.title, description: a.goal, brand: { "@type": "Brand", name: "hrmforce" }, ...(a.image ? { image: a.image } : {}), offers: { "@type": "Offer", price: String(shop.price), priceCurrency: "EUR", availability: "https://schema.org/InStock", url: _canon } }
  : { "@context": "https://schema.org", "@type": "Service", name: a.title, description: a.goal, provider: { "@type": "Organization", name: "hrmforce" }, areaServed: "EU" };
---
<Base title={a.metaTitle} description={a.metaDescription} active="assessments">
  <script type="application/ld+json" is:inline set:html={JSON.stringify(_offerLd)}></script>
  <script type="application/ld+json" is:inline set:html={JSON.stringify(_faqLd)}></script>
  <script type="application/ld+json" is:inline set:html={JSON.stringify(_crumbLd)}></script>

  <div class="crumb">
    <div class="wrap"><a href={localizePath("/", lang)}>Home</a> › <a href={assessHref}>Online assessments</a> › <span>{a.title}</span></div>
  </div>

  <section class="ahero">
    <div class="wrap">
      <div>
        <div class="eyebrow">Online assessments</div>
        <h1>{a.title}</h1>
        <div class="meta-row"><span class="lbl">Wanneer inzetten?</span><span class="val">{a.phase}</span></div>
        <div class="meta-row"><span class="lbl">Doel</span><span class="val">{a.goal}</span></div>
        {shop.price && (
          <div class="pricebox">
            <span class="pricebox-label">Prijs per los assessment</span>
            <span class="pricebox-amt">&euro;{shop.price}</span>
            <span class="pricebox-note">Bij bulkafname of een eigen portal betaal je aanzienlijk minder per afname.</span>
          </div>
        )}
        <div class="btns">
          <a href={localizePath("/contact/", lang)} class="btn btn-primary">Plan een gratis demo &rarr;</a>
          <a href={localizePath(shop.url, lang)} class="btn btn-light">
            {shop.price ? "Los bestellen" : "Bekijk in de shop"}
          </a>
        </div>
        <p class="portal-nudge">Structureel inzetten? Start met een <a href={localizePath("/tarieven/", lang)}>eigen portal op licentiebasis</a>, onbeperkt afnemen tegen een vaste jaarprijs.</p>
        <div class="guarantee">
          <strong style="color:#fff">Wetenschappelijk gevalideerd</strong>
          <span><span class="stars">★★★★★</span> 10.000+ deelnemers · <b style="color:#fff">4,9/5 sterren</b></span>
        </div>
      </div>
      <div class="device">
        <div class="screen">
          <span class="chip">Voorbeeldrapport</span>
          {a.image ? (
            <Img class="report-img" src={a.image} alt={a.title} loading="lazy" />
          ) : (
            a.traits.map((t, i) => (
              <div class="traitbar"><span>{t}</span><div class="track"><div class="fill" style={`width:${40 + ((i * 13) % 50)}%`}></div></div></div>
            ))
          )}
        </div>
      </div>
    </div>
  </section>

<SocialProof lang="nl" />

<section class="qshots"><div class="wrap">
  <div class="eyebrow" style="color:var(--gold)">Zo werkt het</div>
  <h2 class="qshots-h">Een kijkje in de vragenlijst</h2>
  <p class="qshots-lead">Zo ziet de vragenlijst er voor je kandidaten uit, van uitnodiging tot afronding.</p>
  <div class="qshots-track">
    <figure class="qshot"><QMock screen="intro" lang="nl" testName={a.title} /><figcaption>Starten in eigen taal en tempo</figcaption></figure>
    <figure class="qshot"><QMock screen="vraag" lang="nl" testName={a.title} question={ex.mockQuestion} scaleNote={ex.scale} answer={ex.answer} options={ex.mockOptions || []} /><figcaption>Een voorbeeldvraag uit deze vragenlijst</figcaption></figure>
    <figure class="qshot"><Img src="/mockups/vragenlijst-afgerond.svg" alt={`Afrondscherm van de vragenlijst ${a.title}`} loading="eager" /><figcaption>Uitkomsten bespreek je persoonlijk</figcaption></figure>
  </div>

  <div class="qex">
    <h3 class="qex-h">{ex.title}</h3>
    <p class="qex-lead">{ex.intro}</p>
    <div class="qex-list">
      {ex.items.map((qq, i) => (
        <div class="qex-item">
          <span class="qex-n">{i + 1}</span>
          <span class="qex-q">{qq}</span>
        </div>
      ))}
    </div>
    <p class="qex-scale"><strong>{ex.scaleLabel}:</strong> {ex.scale}</p>
    {_oefen && (<p style="margin:0 0 18px"><a href={`/oefenen/${_oefen.slug}/`} class="btn btn-ghost">Oefen met meer vragen &rarr;</a></p>)}
    <div class="vv-cta">
      <div class="vv-copy">
        <strong>Alle voorbeeldvragen ontvangen?</strong>
        <span>Laat je e-mail achter en we sturen je een set voorbeeldvragen van {a.title}, plus uitleg over de rapportage.</span>
      </div>
      <form class="vv-form" action={formAction} method="POST" enctype={FORMSPREE_ENDPOINT ? "application/x-www-form-urlencoded" : "text/plain"}>
        <input type="hidden" name="onderwerp" value={`Voorbeeldvragen ${a.title}`} />
        <input type="hidden" name="assessment" value={a.title} />
        <input type="email" name="email" required placeholder="jouw@werkmail.nl" aria-label="Werk e-mail" />
        <button type="submit" class="btn btn-primary">Stuur mij de vragen</button>
      </form>
    </div>
  </div>
</div></section>

  <div class="infobar">
    <div class="wrap">
      <div class="info-grid">
        <div><div class="lbl">Tijd</div><div class="v">{a.time}</div></div>
        <div><div class="lbl">Vorm</div><div class="v">{a.form}</div></div>
        <div><div class="lbl">Feedback</div><div class="v">{a.feedback}</div></div>
        <div><div class="lbl">Extra</div><div class="v">{a.extra}</div></div>
      </div>
    </div>
  </div>

  <section>
    <div class="wrap">
      <div class="eyebrow">Uitleg</div>
      <h2 class="section-title">{a.title}</h2>
      <div class="explain">
        <div>
          {a.intro.map((p) => <p>{p}</p>)}
          {extra && extra.aliasNote && (<p class="alias-note" set:html={extra.aliasNote}></p>)}
          {a.traits.length > 0 && <ul class="traits">{a.traits.map((t) => <li>{t}</li>)}</ul>}
          {a.body.map((p) => <p>{p}</p>)}
          <p class="assess-usage">{[a.traits && a.traits.length ? "De test meet " + a.traits.join(", ") + ". " : "", a.phase ? "Je zet deze test in binnen de HR-cyclus: " + a.phase + ". " : "", a.feedback ? a.feedback + " " : "", a.time ? "Invullen duurt " + a.time + (a.form ? " (" + a.form + ")" : "") + " en je ontvangt de uitkomsten in je inbox, zonder pdf om te downloaden." : ""].join("")}</p>
          <a href="#request" class="btn btn-primary" style="margin-top:8px">Direct starten</a>
        </div>
        <div class="pentagon">
          <img src={a.dimImage || a.image} alt={`${a.title} in de praktijk`} loading="lazy" style="width:100%;border-radius:16px;display:block;box-shadow:var(--shadow);aspect-ratio:4/3;object-fit:cover" />
          <p style="color:var(--muted);font-size:14px;margin-top:12px">{a.benefit || "De kerndimensies van dit assessment, vertaald naar werkgerelateerde inzichten."}</p>
        </div>
      </div>
    </div>
  </section>

  {extra && extra.blocks && extra.blocks.length > 0 && (
    <section class="bg-soft"><div class="wrap" style="max-width:880px">
      {extra.blocks.map((b) => (
        <div class="xblock">
          <h3 class="xblock-h">{b.title}</h3>
          {b.lead && <p class="xblock-lead">{b.lead}</p>}
          {b.type === "list" && b.items.length > 0 && (
            <ul class="xblock-list">{b.items.map((it) => <li>{it}</li>)}</ul>
          )}
          {b.type === "text" && b.text && <p class="xblock-text">{b.text}</p>}
        </div>
      ))}
    </div></section>
  )}

  {theory && (
    <section><div class="wrap" style="max-width:880px">
      <div class="eyebrow" style="color:var(--gold)">{theory.modelLabel}</div>
      <h2 class="section-title">{theory.title}</h2>
      <div class="theory-card">
        <h3 class="theory-name">{theory.name}</h3>
        <p class="theory-desc">{theory.desc}</p>
        <div class="theory-reflbl">{theory.refLabel}</div>
        <ul class="theory-refs">{theory.refs.map((r) => <li>{r}</li>)}</ul>
        <p class="theory-note">{theory.note}</p>
      </div>
    </div></section>
  )}

  {a.quote.text && (
    <section class="quote">
      <div class="wrap">
        <img class="quote-photo" src="/media/team/floor-hendriks.webp" alt={`${a.quote.author}, ${a.quote.role} bij hrmforce`} width="112" height="112" loading="lazy" />
        <div>
          <h3>{a.quote.heading}</h3>
          <blockquote>"{a.quote.text}"</blockquote>
          <div class="who"><b>{a.quote.author}</b>, {a.quote.role}</div>
          <a class="quote-cta" href={localizePath("/over-ons/", lang)}>Maak kennis met het team &rarr;</a>
        </div>
      </div>
    </section>
  )}

  <ReviewSlider />

  <section>
    <div class="wrap">
      <div class="center">
        <div class="eyebrow">Veelgestelde vragen</div>
        <h2 class="section-title" style="margin-bottom:42px">Alles over {a.title}</h2>
      </div>
      <div style="max-width:820px;margin:0 auto">
        {allFaq.map((f) => (
          <div class="faq-item">
            <div class="faq-q">{f.q}<span class="pl">+</span></div>
            <div class="faq-a"><p>{f.a}</p></div>
          </div>
        ))}
      </div>
    </div>
  </section>

  {related.length > 0 && (
    <section style="background:var(--bg)">
      <div class="wrap">
        <div class="center">
          <div class="eyebrow">Ook interessant</div>
          <h2 class="section-title" style="margin-bottom:36px">Gerelateerde assessments</h2>
        </div>
        <div class="cards">
          {related.map((r) => (
            <a class="card" href={localizePath(`/assessments/${r.slug}/`, lang)} style="text-decoration:none;color:inherit;display:flex;flex-direction:column">
              {r.image && <Img class="rel-img" src={r.image} alt={r.title} loading="lazy" />}
              <h3>{r.title}</h3>
              <p style="flex:1">{r.goal}</p>
              <span class="readmore">Bekijk assessment &rarr;</span>
            </a>
          ))}
        </div>
      </div>
    </section>
  )}

  <section style="background:var(--bg)">
    <div class="wrap">
      <div class="center">
        <div class="eyebrow" style="justify-content:center">Hoe werkt het</div>
        <h2 class="section-title">Zo zet je {a.title} in, in 3 stappen</h2>
      </div>
      <div class="order-steps">
        <div class="ostep"><span class="on">1</span><h4>Kies je vorm</h4><p>Neem los af via de shop, of start met een eigen portal op licentiebasis voor onbeperkt gebruik.</p></div>
        <div class="ostep"><span class="on">2</span><h4>Nodig kandidaten uit</h4><p>Verstuur in één klik een persoonlijke uitnodigingslink. Kandidaten vullen online in, in hun eigen taal.</p></div>
        <div class="ostep"><span class="on">3</span><h4>Ontvang het rapport</h4><p>Zodra de vragenlijst is ingevuld, staat het heldere rapport klaar, direct bruikbaar in je gesprek of besluit.</p></div>
      </div>
      <div class="center" style="margin-top:26px">
        <a href={localizePath("/contact/", lang)} class="btn btn-primary">Plan een gratis demo</a>
        <a href={localizePath("/tarieven/", lang)} class="btn btn-ghost" style="margin-left:8px">Bekijk de licentieopties</a>
      </div>
    </div>
  </section>

  {kcRelated.length > 0 && (
    <section>
      <div class="wrap">
        <div class="center">
          <div class="eyebrow">Verder lezen</div>
          <h2 class="section-title" style="margin-bottom:36px">Meer weten uit ons kenniscentrum</h2>
        </div>
        <div class="cards">
          {kcRelated.map((p) => (
            <a class="card" href={navHref(`/kenniscentrum/${p.slug}/`, lang, validPaths)} style="text-decoration:none;color:inherit;display:flex;flex-direction:column">
              <span class="eyebrow" style="color:var(--gold)">{p.category}</span>
              <h3>{p.title}</h3>
              <p style="flex:1">{p.excerpt}</p>
              <span class="readmore">Lees het artikel &rarr;</span>
            </a>
          ))}
        </div>
      </div>
    </section>
  )}

  <section class="formsec" id="request">
    <div class="wrap">
      <div class="center">
        <div class="eyebrow">Aanvragen</div>
        <h2 class="section-title">{a.title} aanvragen</h2>
        <p class="lead" style="margin-bottom:36px">Vul het formulier in en krijg binnen 24 uur toegang.</p>
      </div>
      <form class="formcard" action={formAction} method="POST" enctype={FORMSPREE_ENDPOINT ? "application/x-www-form-urlencoded" : "text/plain"}>
        <div class="frow">
          <div class="fg"><label>Voornaam *</label><input type="text" name="voornaam" required /></div>
          <div class="fg"><label>Werk e-mail *</label><input type="email" name="email" required /></div>
        </div>
        <div class="fg"><label>Bedrijfsnaam</label><input type="text" name="bedrijf" /></div>
        <button type="submit" class="btn btn-primary">Verzenden</button>
      </form>
    </div>
  </section>
</Base>

<style>
  .device .screen .report-img{
    display:block;
    width:100%;
    height:auto;
    max-height:300px;
    object-fit:cover;
    object-position:top center;
    border-radius:8px;
    margin-top:10px;
  }
  .pricebox{
    display:inline-flex;flex-direction:column;gap:2px;
    background:rgba(255,255,255,.07);border:1px solid rgba(255,255,255,.16);
    border-left:3px solid var(--gold);
    padding:10px 16px;border-radius:10px;margin:16px 0 6px;max-width:420px;
  }
  .pricebox-label{color:#c4d2e6;font-size:12px;text-transform:uppercase;letter-spacing:.5px;font-weight:700}
  .pricebox-amt{color:#fff;font-size:1.45rem;font-weight:800;line-height:1.15;letter-spacing:-.01em}
  .pricebox-note{color:#aebfd4;font-size:12.5px;line-height:1.45}
  .rel-img{display:block;width:100%;height:150px;object-fit:contain;background:#fff;border-radius:8px;margin-bottom:14px;padding:10px}
  .readmore{color:var(--blue);font-weight:600;font-size:15px;margin-top:12px}
  .portal-nudge{color:#c4d2e6;font-size:13.5px;margin-top:14px;max-width:460px}
  .portal-nudge a{color:#fff;font-weight:700;border-bottom:1px solid var(--gold)}
  .order-steps{display:grid;grid-template-columns:repeat(3,1fr);gap:20px;margin-top:32px}
  .ostep{background:#fff;border:1px solid var(--line);border-radius:14px;padding:24px 22px;text-align:center}
  .ostep .on{display:inline-flex;align-items:center;justify-content:center;width:36px;height:36px;border-radius:50%;background:var(--navy);color:#fff;font-weight:800;margin-bottom:12px}
  .ostep h4{color:var(--navy);font-size:1.05rem;margin-bottom:6px}
  .ostep p{color:var(--muted);font-size:14px}
  @media(max-width:760px){.order-steps{grid-template-columns:1fr}}
  .qshots{padding:48px 0}
  .infobar .info-grid{grid-template-columns:repeat(4,minmax(0,1fr));gap:12px;padding:22px 0}
  .infobar .info-grid>div{background:var(--bg-soft);border:1px solid var(--line);border-radius:12px;padding:14px 16px}
  .infobar .info-grid .lbl{font-size:11.5px;margin-bottom:2px}
  .infobar .info-grid .v{color:var(--navy);font-size:14.5px;font-weight:600;line-height:1.4}
  @media(max-width:880px){.infobar .info-grid{grid-template-columns:1fr 1fr}}
  .quote-photo{width:112px;height:112px;border-radius:50%;object-fit:cover;flex:none;border:3px solid rgba(255,255,255,.35)}
  .quote-cta{display:inline-block;margin-top:14px;color:#fff;font-weight:700;font-size:14.5px;border-bottom:2px solid var(--gold);padding-bottom:2px}
  .qex{margin-top:34px;padding-top:30px;border-top:1px solid var(--line)}
  .qex-h{color:var(--navy);font-size:1.35rem;margin:0 0 6px}
  .qex-lead{color:var(--muted);max-width:640px;margin:0 0 20px}
  .qex-list{display:flex;flex-direction:column;gap:10px}
