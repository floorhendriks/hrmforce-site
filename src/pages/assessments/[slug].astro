---
import Base from "../../layouts/Base.astro";
import { assessments } from "../../data/assessments.js";
import { shopInfo } from "../../data/assessment-shop.js";
import { FORMSPREE_ENDPOINT, CONTACT_EMAIL } from "../../data/site-config.js";
import { getLangFromUrl, localizePath } from "../../i18n/utils.js";
import { examplesFor } from "../../data/assessment-examples.js";
import { generalFaq } from "../../data/general-faq.js";

const formAction = FORMSPREE_ENDPOINT || `mailto:${CONTACT_EMAIL}`;

// Alle assessments komen uit het lokale databestand (36 stuks), zodat álle
// detailpagina's gegenereerd worden ongeacht de Sanity-inhoud.
export async function getStaticPaths() {
  return assessments.map((a) => ({ params: { slug: a.slug }, props: { a } }));
}

const lang = getLangFromUrl(Astro.url);
let a = Astro.props.a;
if (!a) {
  const { sanity, pick } = await import("../../lib/sanity.js");
  const { assessmentBySlug } = await import("../../lib/queries.js");
  const r = await sanity.fetch(assessmentBySlug, { slug: Astro.params.slug });
  const initials = (r?.quote?.author || "").split(" ").map((w) => w[0]).join("").slice(0, 2);
  a = {
    title: pick(r.title, lang), phase: pick(r.phase, lang), goal: pick(r.goal, lang),
    time: pick(r.time, lang), form: pick(r.form, lang), feedback: pick(r.feedback, lang), extra: pick(r.extra, lang),
    traits: (r.traits || []).map((t) => pick(t, lang)),
    intro: (r.intro || []).map((p) => pick(p, lang)),
    body: (r.body || []).map((p) => pick(p, lang)),
    quote: { heading: pick(r.quote?.heading, lang), text: pick(r.quote?.text, lang), author: r.quote?.author || "", role: pick(r.quote?.role, lang), initials },
    faq: (r.faq || []).map((f) => ({ q: pick(f.q, lang), a: pick(f.a, lang) })),
    metaTitle: pick(r.title, lang), metaDescription: pick(r.goal, lang), related: [],
  };
}
const assessHref = localizePath("/online-assessments/", lang);
const ex = examplesFor(Astro.params.slug, lang);
const _specQ = new Set((a.faq || []).map((f) => (f.q || "").trim().toLowerCase()));
const allFaq = [...(a.faq || []), ...generalFaq(lang).filter((g) => !_specQ.has((g.q || "").trim().toLowerCase()))];

// Shop-info (prijs + bestellink) op basis van de huidige slug.
const shop = shopInfo(Astro.params.slug);

// Gerelateerde assessments: koppel de titels uit a.related aan echte pagina's.
const byTitle = new Map(assessments.map((x) => [x.title, x]));
const related = (a.related || [])
  .map((t) => byTitle.get(t))
  .filter(Boolean)
  .slice(0, 3)
  .map((x) => ({ title: x.title, slug: x.slug, image: x.image, goal: x.goal }));
const _canon = new URL(Astro.url.pathname, "https://hrmforce.com").href;
const _crumbLd = { "@context": "https://schema.org", "@type": "BreadcrumbList", itemListElement: [
  { "@type": "ListItem", position: 1, name: "Home", item: "https://hrmforce.com/" },
  { "@type": "ListItem", position: 2, name: "Online assessments", item: new URL(assessHref, "https://hrmforce.com").href },
  { "@type": "ListItem", position: 3, name: a.title, item: _canon },
] };
const _faqLd = { "@context": "https://schema.org", "@type": "FAQPage", mainEntity: (allFaq || []).map((f) => ({ "@type": "Question", name: f.q, acceptedAnswer: { "@type": "Answer", text: f.a } })) };
const _offerLd = (shop && shop.price)
  ? { "@context": "https://schema.org", "@type": "Product", name: a.title, description: a.goal, brand: { "@type": "Brand", name: "hrmforce" }, ...(a.image ? { image: a.image } : {}), offers: { "@type": "Offer", price: String(shop.price), priceCurrency: "EUR", availability: "https://schema.org/InStock", url: _canon } }
  : { "@context": "https://schema.org", "@type": "Service", name: a.title, description: a.goal, provider: { "@type": "Organization", name: "hrmforce" }, areaServed: "EU" };
---
<Base title={a.metaTitle} description={a.metaDescription} active="assessments">
  <script type="application/ld+json" is:inline set:html={JSON.stringify(_offerLd)}></script>
  <script type="application/ld+json" is:inline set:html={JSON.stringify(_faqLd)}></script>
  <script type="application/ld+json" is:inline set:html={JSON.stringify(_crumbLd)}></script>

  <div class="crumb">
    <div class="wrap"><a href={localizePath("/", lang)}>Home</a> › <a href={assessHref}>Online assessments</a> › <span>{a.title}</span></div>
  </div>

  <section class="ahero">
    <div class="wrap">
      <div>
        <div class="eyebrow">Online assessments</div>
        <h1>{a.title}</h1>
        <div class="meta-row"><span class="lbl">Fase</span><span class="val">{a.phase}</span></div>
        <div class="meta-row"><span class="lbl">Doel</span><span class="val">{a.goal}</span></div>
        {shop.price && (
          <div class="pricebox">
            <span class="pricebox-label">Direct afnemen vanaf</span>
            <span class="pricebox-amt">&euro;{shop.price}</span>
            <span class="pricebox-note">per assessment &middot; betaal achteraf</span>
          </div>
        )}
        <div class="btns">
          <a href={localizePath("/contact/", lang)} class="btn btn-primary">Plan een gratis demo &rarr;</a>
          <a href={shop.url} class="btn btn-light" rel="noopener">
            {shop.price ? "Los bestellen" : "Bekijk in de shop"}
          </a>
        </div>
        <p class="portal-nudge">Structureel inzetten? Start met een <a href={localizePath("/tarieven/", lang)}>eigen portal op licentiebasis</a> — onbeperkt afnemen tegen een vaste jaarprijs.</p>
        <div class="guarantee">
          <strong style="color:#fff">Wetenschappelijk gevalideerd</strong>
          <span><span class="stars">★★★★★</span> 10.000+ deelnemers · <b style="color:#fff">4,9/5 sterren</b></span>
        </div>
      </div>
      <div class="device">
        <div class="screen">
          <span class="chip">Voorbeeldrapport</span>
          {a.image ? (
            <img class="report-img" src={a.image} alt={a.title} loading="lazy" />
          ) : (
            a.traits.map((t, i) => (
              <div class="traitbar"><span>{t}</span><div class="track"><div class="fill" style={`width:${40 + ((i * 13) % 50)}%`}></div></div></div>
            ))
          )}
        </div>
      </div>
    </div>
  </section>

<section class="qshots"><div class="wrap">
  <div class="eyebrow" style="color:var(--gold)">Zo werkt het</div>
  <h2 class="qshots-h">Een kijkje in de vragenlijst</h2>
  <p class="qshots-lead">Zo ziet de vragenlijst er voor je kandidaten uit, van uitnodiging tot afronding.</p>
  <div class="qshots-track">
    <figure class="qshot"><img src="/mockups/vragenlijst-intro.svg" alt="Startscherm van de vragenlijst" loading="eager" /><figcaption>Starten in eigen taal en tempo</figcaption></figure>
    <figure class="qshot"><img src="/mockups/vragenlijst-vraag.svg" alt="Vraagscherm met antwoordschaal" loading="eager" /><figcaption>Stellingen met een duidelijke antwoordschaal</figcaption></figure>
    <figure class="qshot"><img src="/mockups/vragenlijst-afgerond.svg" alt="Afrondscherm van de vragenlijst" loading="eager" /><figcaption>Uitkomsten bespreek je persoonlijk</figcaption></figure>
  </div>
</div></section>

  <div class="infobar">
    <div class="wrap">
      <div class="info-grid">
        <div><div class="lbl">Tijd</div><div class="v">{a.time}</div></div>
        <div><div class="lbl">Vorm</div><div class="v">{a.form}</div></div>
        <div><div class="lbl">Feedback</div><div class="v">{a.feedback}</div></div>
        <div><div class="lbl">Extra</div><div class="v">{a.extra}</div></div>
      </div>
    </div>
  </div>

  <section>
    <div class="wrap">
      <div class="eyebrow">Uitleg</div>
      <h2 class="section-title">{a.title}</h2>
      <div class="explain">
        <div>
          {a.intro.map((p) => <p>{p}</p>)}
          {a.traits.length > 0 && <ul class="traits">{a.traits.map((t) => <li>{t}</li>)}</ul>}
          {a.body.map((p) => <p>{p}</p>)}
          <a href="#request" class="btn btn-primary" style="margin-top:8px">Direct starten</a>
        </div>
        <div class="pentagon">
          <div class="ring"></div>
          <p style="color:var(--muted);font-size:14px">De kerndimensies van dit assessment, vertaald naar werkgerelateerde inzichten.</p>
        </div>
      </div>
    </div>
  </section>

  {a.quote.text && (
    <section class="quote">
      <div class="wrap">
        <div class="avatar">{a.quote.initials}</div>
        <div>
          <h3>{a.quote.heading}</h3>
          <blockquote>"{a.quote.text}"</blockquote>
          <div class="who"><b>{a.quote.author}</b> — {a.quote.role}</div>
        </div>
      </div>
    </section>
  )}

  <section class="bg-soft"><div class="wrap" style="max-width:860px">
    <div class="eyebrow" style="color:var(--gold)">{ex.tag}</div>
    <h2 class="section-title">{ex.title}</h2>
    <p class="lead" style="margin-bottom:22px">{ex.intro}</p>
    <div style="display:flex;flex-direction:column;gap:12px">
      {ex.items.map((qq, i) => (
        <div style="display:flex;gap:14px;align-items:flex-start;background:#fff;border:1px solid var(--line);border-left:3px solid var(--gold);border-radius:12px;padding:16px 18px;box-shadow:var(--shadow-xs)">
          <span style="flex:none;width:28px;height:28px;border-radius:50%;background:var(--navy);color:#fff;font-weight:800;font-size:14px;display:flex;align-items:center;justify-content:center">{i + 1}</span>
          <span style="color:var(--navy);font-weight:600;font-size:15px;line-height:1.5">{qq}</span>
        </div>
      ))}
    </div>
    <p style="color:var(--muted);font-size:14px;margin-top:16px"><strong style="color:var(--navy)">{ex.scaleLabel}:</strong> {ex.scale}</p>
  </div></section>

  <section>
    <div class="wrap">
      <div class="center">
        <div class="eyebrow">Veelgestelde vragen</div>
        <h2 class="section-title" style="margin-bottom:42px">Alles over {a.title}</h2>
      </div>
      <div style="max-width:820px;margin:0 auto">
        {allFaq.map((f) => (
          <div class="faq-item">
            <div class="faq-q">{f.q}<span class="pl">+</span></div>
            <div class="faq-a"><p>{f.a}</p></div>
          </div>
        ))}
      </div>
    </div>
  </section>

  {related.length > 0 && (
    <section style="background:var(--bg)">
      <div class="wrap">
        <div class="center">
          <div class="eyebrow">Ook interessant</div>
          <h2 class="section-title" style="margin-bottom:36px">Gerelateerde assessments</h2>
        </div>
        <div class="cards">
          {related.map((r) => (
            <a class="card" href={localizePath(`/assessments/${r.slug}/`, lang)} style="text-decoration:none;color:inherit;display:flex;flex-direction:column">
              {r.image && <img class="rel-img" src={r.image} alt={r.title} loading="lazy" />}
              <h3>{r.title}</h3>
              <p style="flex:1">{r.goal}</p>
              <span class="readmore">Bekijk assessment &rarr;</span>
            </a>
          ))}
        </div>
      </div>
    </section>
  )}

  <section style="background:var(--bg)">
    <div class="wrap">
      <div class="center">
        <div class="eyebrow" style="justify-content:center">Hoe werkt het</div>
        <h2 class="section-title">Zo zet je {a.title} in — in 3 stappen</h2>
      </div>
      <div class="order-steps">
        <div class="ostep"><span class="on">1</span><h4>Kies je vorm</h4><p>Neem los af via de shop, of start met een eigen portal op licentiebasis voor onbeperkt gebruik.</p></div>
        <div class="ostep"><span class="on">2</span><h4>Nodig kandidaten uit</h4><p>Verstuur in één klik een persoonlijke uitnodigingslink. Kandidaten vullen online in, in hun eigen taal.</p></div>
        <div class="ostep"><span class="on">3</span><h4>Ontvang het rapport</h4><p>Zodra de vragenlijst is ingevuld, staat het heldere rapport klaar — direct bruikbaar in je gesprek of besluit.</p></div>
      </div>
      <div class="center" style="margin-top:26px">
        <a href={localizePath("/contact/", lang)} class="btn btn-primary">Plan een gratis demo</a>
        <a href={localizePath("/tarieven/", lang)} class="btn btn-ghost" style="margin-left:8px">Bekijk de licentieopties</a>
      </div>
    </div>
  </section>

  <section class="formsec" id="request">
    <div class="wrap">
      <div class="center">
        <div class="eyebrow">Aanvragen</div>
        <h2 class="section-title">{a.title} aanvragen</h2>
        <p class="lead" style="margin-bottom:36px">Vul het formulier in en krijg binnen 24 uur toegang.</p>
      </div>
      <form class="formcard" action={formAction} method="POST" enctype={FORMSPREE_ENDPOINT ? "application/x-www-form-urlencoded" : "text/plain"}>
        <div class="frow">
          <div class="fg"><label>Voornaam *</label><input type="text" name="voornaam" required /></div>
          <div class="fg"><label>Werk e-mail *</label><input type="email" name="email" required /></div>
        </div>
        <div class="fg"><label>Bedrijfsnaam</label><input type="text" name="bedrijf" /></div>
        <button type="submit" class="btn btn-primary">Verzenden</button>
      </form>
    </div>
  </section>
</Base>

<style>
  .device .screen .report-img{
    display:block;
    width:100%;
    height:auto;
    max-height:300px;
    object-fit:cover;
    object-position:top center;
    border-radius:8px;
    margin-top:10px;
  }
  .pricebox{
    display:inline-flex;flex-direction:column;gap:2px;
    background:rgba(255,255,255,.08);border:1px solid rgba(255,255,255,.18);
    border-left:3px solid var(--gold);
    padding:12px 18px;border-radius:10px;margin:18px 0 6px;
  }
  .pricebox-label{color:#c4d2e6;font-size:12.5px;text-transform:uppercase;letter-spacing:.6px;font-weight:700}
  .pricebox-amt{color:#fff;font-size:1.9rem;font-weight:800;line-height:1.1}
  .pricebox-note{color:#aebfd4;font-size:13px}
  .rel-img{display:block;width:100%;height:150px;object-fit:contain;background:#fff;border-radius:8px;margin-bottom:14px;padding:10px}
  .readmore{color:var(--blue);font-weight:600;font-size:15px;margin-top:12px}
  .portal-nudge{color:#c4d2e6;font-size:13.5px;margin-top:14px;max-width:460px}
  .portal-nudge a{color:#fff;font-weight:700;border-bottom:1px solid var(--gold)}
  .order-steps{display:grid;grid-template-columns:repeat(3,1fr);gap:20px;margin-top:32px}
  .ostep{background:#fff;border:1px solid var(--line);border-radius:14px;padding:24px 22px;text-align:center}
  .ostep .on{display:inline-flex;align-items:center;justify-content:center;width:36px;height:36px;border-radius:50%;background:var(--navy);color:#fff;font-weight:800;margin-bottom:12px}
  .ostep h4{color:var(--navy);font-size:1.05rem;margin-bottom:6px}
  .ostep p{color:var(--muted);font-size:14px}
  @media(max-width:760px){.order-steps{grid-template-columns:1fr}}
  .qshots{padding:48px 0}
  .qshots-h{margin:6px 0 6px}
  .qshots-lead{color:var(--muted);max-width:620px;margin:0 0 22px}
  .qshots-track{display:flex;gap:20px;overflow-x:auto;scroll-snap-type:x mandatory;padding-bottom:12px;-webkit-overflow-scrolling:touch}
  .qshot{flex:0 0 88%;max-width:680px;scroll-snap-align:center;margin:0}
  .qshot img{width:100%;height:auto;border-radius:14px;border:1px solid var(--line);box-shadow:var(--shadow-sm);display:block}
  .qshot figcaption{margin-top:10px;color:var(--muted);font-size:14px;text-align:center}
  @media(min-width:900px){ .qshot{flex-basis:46%} }
</style>
