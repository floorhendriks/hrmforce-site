---
import Base from "../../layouts/Base.astro";
import { FORMSPREE_ENDPOINT } from "../../data/site-config.js";

const formAction = FORMSPREE_ENDPOINT || "https://formspree.io/f/mqpznaqn";

const gvzFaq = [
  { q: "Hoe snel kan ik live met de Geschikt voor Zorg-test?", a: "Meestal binnen enkele werkdagen. Samen met een GVZ-consultant bepalen we de competenties en zetten we de test en landingspagina op." },
  { q: "Voor welke functies en doelgroepen werkt het?", a: "Voor vrijwel elke rol in de zorg — van cliëntondersteuner en begeleider tot doktersassistent en zij-instromer. Je kiest uit ruim 50 competenties per vacature." },
  { q: "Hoe zit het met privacy en de AVG?", a: "Kandidaatgegevens worden verwerkt volgens de AVG en uitsluitend gebruikt voor de matching en selectie waarvoor de kandidaat de test invult." },
  { q: "Wat kost het?", a: "Er zijn twee opties: Standaard (tot 1500 werknemers) en Custom (1500+), beide met onbeperkte afname. Campagnes zijn optioneel. Neem contact op voor een prijs op maat." },
  { q: "Zit ik ergens aan vast met de demo?", a: "Nee. De demo is gratis en vrijblijvend. Je doet zelf de test en ontvangt een voorbeeldrapportage per e-mail." },
  { q: "Werken jullie ook samen met werk-leertrajecten?", a: "Ja. We combineren de matching met zij-instroom- en werk-leertrajecten (zoals bij SEIN en Odion) voor duurzame, vaste instroom." },
];
const _gvzCanon = new URL(Astro.url.pathname, "https://hrmforce.com").href;
const gvzSchema = [
  { "@context": "https://schema.org", "@type": "Service", name: "Geschikt voor Zorg-test", serviceType: "Werving en selectie in de zorg", provider: { "@type": "Organization", name: "hrmforce" }, areaServed: "NL", description: "Data-gedreven matching en voorselectie voor zorgorganisaties: vind de juiste medewerker voor iedere doelgroep in de zorg." },
  { "@context": "https://schema.org", "@type": "BreadcrumbList", itemListElement: [
    { "@type": "ListItem", position: 1, name: "Home", item: "https://hrmforce.com/" },
    { "@type": "ListItem", position: 2, name: "Geschikt voor de Zorg", item: _gvzCanon },
  ] },
  { "@context": "https://schema.org", "@type": "FAQPage", mainEntity: gvzFaq.map((f) => ({ "@type": "Question", name: f.q, acceptedAnswer: { "@type": "Answer", text: f.a } })) },
];
---
<Base
  title="Geschikt voor de Zorg | Hrmforce"
  description="Met de Geschikt voor Zorg-test vind je de juiste persoon voor iedere doelgroep in de zorg. Data-gedreven matching met 90% retentie."
  active=""
>
  <script type="application/ld+json" is:inline set:html={JSON.stringify(gvzSchema)}></script>
  <div class="crumb"><div class="wrap"><a href="/">Home</a> › <span>Geschikt voor de Zorg</span></div></div>

  <section class="ahero"><div class="wrap">
    <div>
      <div class="eyebrow" style="color:var(--gold)">Geschikt voor de Zorg</div>
      <h1>Zorgmedewerkers vinden voor de moeilijkste vacatures?</h1>
      <p style="color:#dbe6f5;font-size:19px;max-width:640px;margin-bottom:8px">
        Met de Geschikt voor Zorg-test vind je de juiste persoon voor iedere doelgroep in de zorg. Ook voor de meest complexe groepen.
      </p>
      <div class="btns">
        <a href="#demo" class="btn btn-primary">Vraag een gratis demo aan</a>
        <a href="/geschiktvoorzorg/klantcases/" class="btn btn-light">Bekijk klantcases</a>
      </div>
      <div class="guarantee">
        <span class="stars">★★★★★</span>
        <span><b style="color:#fff">90%</b> van onze matches wil minimaal 5 jaar in dezelfde rol blijven.</span>
      </div>
    </div>
    <div class="device"><div class="screen">
      <span class="chip">Voorbeeldrapport</span>
      <div class="traitbar"><span>Match doelgroep</span><div class="track"><div class="fill" style="width:88%"></div></div></div>
      <div class="traitbar"><span>Competenties</span><div class="track"><div class="fill" style="width:76%"></div></div></div>
      <div class="traitbar"><span>Beschikbaarheid</span><div class="track"><div class="fill" style="width:64%"></div></div></div>
      <div class="traitbar"><span>Motivatie</span><div class="track"><div class="fill" style="width:81%"></div></div></div>
    </div></div>
  </div></section>

  <section><div class="wrap">
    <div class="eyebrow">Data-gedreven aanpak</div>
    <h2 class="section-title">Data-gedreven aanpak. Bewezen succes.</h2>
    <div class="explain">
      <div>
        <p>Geschikt voor Zorg vindt voor iedere cliënt en doelgroep de medewerker die bij ze past. Onze matching-methode is gebaseerd op onderzoek naar duizenden zorgmedewerkers.</p>
        <p>Inmiddels hebben wij meer dan acht jaar onderzoek achter de rug in samenwerking met PFZW en diverse zorginstellingen. We zien dat de profielen steeds scherper worden. De test nodigt mensen uit om over zichzelf na te denken en geeft suggesties over de slagingskans van de kandidaat. Het afgelopen jaar zijn meer dan 600 (nieuwe) zorgmedewerkers aan het werk gegaan door onze matching.</p>
        <p>Personeelsverloop kost een zorgorganisatie veel geld en productiviteit. Het vervangen van een gespecialiseerde zorgverlener kan oplopen tot 200% van het jaarsalaris van die medewerker.* Met een goede voorselectie voorkom je onnodig verloop en dure inhuur van ZZP'ers.</p>
        <p style="color:var(--muted);font-size:13px">*Gebaseerd op onderzoek van de Society for Human Resource Management.</p>
      </div>
      <div class="pentagon">
        <div style="font-size:56px;font-weight:800;color:var(--navy)">90%</div>
        <p style="color:var(--muted);font-size:15px">van onze matches wil minimaal 5 jaar in dezelfde rol blijven.</p>
      </div>
    </div>
  </div></section>

  <section class="formsec"><div class="wrap">
    <div class="explain">
      <div class="card" style="box-shadow:none">
        <h3>Werkzoekenden krijgen</h3>
        <ul class="traits">
          <li>Direct een duidelijk beeld van zichzelf t.o.v. het gezochte profiel</li>
          <li>Een beeld van de waarden van de organisatie</li>
          <li>Inzicht in de gevraagde competenties voor de doelgroep</li>
          <li>De mogelijkheid om een cv toe te voegen</li>
          <li>Een persoonlijke en warme eerste indruk van de organisatie</li>
        </ul>
      </div>
      <div class="card" style="box-shadow:none">
        <h3>Als recruiter krijg je</h3>
        <ul class="traits">
          <li>Toetsing op vooraf geselecteerde, relevante competenties</li>
          <li>Een beeld van de kandidaat op basis van persoonlijkheid</li>
          <li>Input op harde voorwaarden zoals werktijden en beschikbaarheid</li>
          <li>Beeld van de reactie op praktijksituaties</li>
          <li>Cv-inzage en antwoord op motivatievragen</li>
        </ul>
      </div>
    </div>
    <p style="max-width:820px;margin-top:24px">Met deze voorselectie voer je als recruiter een gericht gesprek. Je hoeft je niet meer te focussen op harde voorwaarden, maar hebt de ruimte om je te richten op verdiepende vragen over het rapport en de persoon. Kies uit wel 50 competenties die je wilt meten voor je vacatures, werk-leertrajecten of interne assessments.</p>
    <a href="#demo" class="btn btn-primary" style="margin-top:12px">Vraag een gratis demo aan</a>
  </div></section>

  <section><div class="wrap">
    <div class="center">
      <div class="eyebrow">Zo werkt het</div>
      <h2 class="section-title">Van vacature naar de juiste match — in 4 stappen</h2>
    </div>
    <div class="gvz-steps">
      <div class="gvz-step"><span class="gvz-n">1</span><h3>Competenties kiezen</h3><p>Samen met een GVZ-consultant bepaal je de competenties en eisen die passen bij jouw doelgroep en vacatures.</p></div>
      <div class="gvz-step"><span class="gvz-n">2</span><h3>Test &amp; campagne live</h3><p>We zetten de test en een eigen landingspagina op en starten gerichte wervingscampagnes (Facebook, Instagram, Google Ads).</p></div>
      <div class="gvz-step"><span class="gvz-n">3</span><h3>Kandidaten matchen</h3><p>Werkzoekenden vullen de test in en voegen hun cv toe. Jij verzamelt geschikte leads in een overzichtelijk dashboard.</p></div>
      <div class="gvz-step"><span class="gvz-n">4</span><h3>Gericht gesprek</h3><p>Je voert een verdiepend gesprek op basis van het rapport — de harde voorwaarden zijn al getoetst.</p></div>
    </div>
  </div></section>

  <section class="bg-soft"><div class="wrap">
    <div class="center">
      <div class="eyebrow">Klantcases</div>
      <h2 class="section-title">Zorgorganisaties die met ons matchen</h2>
      <p class="lead center" style="max-width:720px;margin:0 auto 40px">Van ouderenzorg tot gehandicaptenzorg en eerstelijnszorg — tientallen organisaties vinden met Geschikt voor Zorg duurzaam de juiste mensen.</p>
    </div>
    <div class="gvz-cases">
      <article class="gvz-case">
        <span class="gvz-logo"><img src="https://hrmforce.com/wp-content/uploads/2026/02/thumbnail_Icare-logo-600x600px-300x300-1-qfxfdksl7marcg5qemazeepsa83pdkbtgy98sq0vis.png" alt="Icare" loading="lazy" onerror="this.parentNode.classList.add('is-txt');this.remove();"><b>Icare</b></span>
        <span class="gvz-metric">150+ aangenomen &middot; 350+ matches</span>
        <p>Werving en selectie voor zij-instromers als cli&euml;ntondersteuner. Via gerichte campagnes en een eigen landingspagina bereikten we tienduizenden mensen.</p>
        <blockquote>&ldquo;Er is geen tekort aan arbeid, maar een tekort aan match. De match maken, dat doet Geschikt voor Zorg &mdash; wat een succes!&rdquo;</blockquote>
        <div class="gvz-who"><b>Sietske Ras</b> &mdash; Relatiemanager &amp; Projectleider, Icare GewoonThuis</div>
      </article>
      <article class="gvz-case">
        <span class="gvz-logo"><img src="https://hrmforce.com/wp-content/uploads/2026/02/SEIN_LOGO-ZONDER_FC-q5v7mio840kgvoyp2yme678z481h30kb0xmg6u4tp8.png" alt="SEIN" loading="lazy" onerror="this.parentNode.classList.add('is-txt');this.remove();"><b>SEIN</b></span>
        <span class="gvz-metric">Zij-instroomklassen gevuld</span>
        <p>Expertisecentrum voor epilepsie en slaapgeneeskunde (~1500 medewerkers). Wij vullen jaarlijks de WelSEIN-klas en de Nachtzorgklassen met vast personeel.</p>
        <blockquote>&ldquo;In heel korte tijd een topresultaat neergezet. Prettige samenwerking, duidelijke en snelle terugkoppeling en een fijn team!&rdquo;</blockquote>
        <div class="gvz-who"><b>Marjolijn Vijverberg</b> &mdash; Adviseur recruitment, SEIN</div>
      </article>
      <article class="gvz-case">
        <span class="gvz-logo"><img src="https://hrmforce.com/wp-content/uploads/2026/02/download-qfxffxe2apikdcquomvemtd9qwiqmbnnskyxzmjfb6.png" alt="Odion" loading="lazy" onerror="this.parentNode.classList.add('is-txt');this.remove();"><b>Odion</b></span>
        <span class="gvz-metric">63 locaties &middot; 1.750 cli&euml;nten</span>
        <p>Gehandicaptenzorg in Zaanstreek, Kennemerland en Waterland. Wij richtten werving en selectie in voor zij-instroomklassen en zorgprofessionals.</p>
        <blockquote>&ldquo;Data-gedreven diensten en toch persoonlijk. De mensen hier hebben een zorghart &mdash; geen marketingpraatje. Dat maakt de samenwerking heel fijn!&rdquo;</blockquote>
        <div class="gvz-who"><b>Odion</b> &mdash; Werving &amp; selectie</div>
      </article>
    </div>
    <p class="gvz-trust-h">Duurzaam partner van tientallen zorgorganisaties</p>
    <div class="gvz-logos">
      <img src="https://hrmforce.com/wp-content/uploads/2026/02/SEIN_LOGO-ZONDER_FC-q5v7mio840kgvoyp2yme678z481h30kb0xmg6u4tp8.png" alt="SEIN" loading="lazy" />
      <img src="https://hrmforce.com/wp-content/uploads/2026/02/thumbnail_Icare-logo-600x600px-300x300-1-qfxfdksl7marcg5qemazeepsa83pdkbtgy98sq0vis.png" alt="Icare" loading="lazy" />
      <img src="https://hrmforce.com/wp-content/uploads/2026/02/download-qfxffxe2apikdcquomvemtd9qwiqmbnnskyxzmjfb6.png" alt="Odion" loading="lazy" />
      <img src="https://hrmforce.com/wp-content/uploads/2026/02/956_abnambrobank-e1701119089879-qfztkr6zzabcnsmc0zgw4bz5isxn8hq8s977wswsvs.jpg" alt="ABN AMRO" loading="lazy" />
      <img src="https://hrmforce.com/wp-content/uploads/2026/02/zonboog-e1618846430923-qfztiicvnj8oxbvr50iz5wdifo02uitbt53gn08nqw.png" alt="Zonboog" loading="lazy" />
    </div>
    <div class="center" style="margin-top:26px"><a href="/geschiktvoorzorg/klantcases/" class="btn btn-primary">Bekijk alle klantcases &rarr;</a></div>
  </div></section>

  <section><div class="wrap">
    <div class="center">
      <div class="eyebrow">Twee opties</div>
      <h2 class="section-title">Zet de Geschikt voor Zorg-test in voor jouw organisatie</h2>
    </div>
    <div class="cards" style="grid-template-columns:repeat(2,1fr)">
      <div class="card">
        <h3>Standaard</h3>
        <p>Voor regionale organisaties (tot 1500 werknemers)</p>
        <ul class="traits">
          <li>Onbeperkte afname van de test</li>
          <li>Dashboard met verzamelde leads en cv's</li>
          <li>Opstart en support door een GVZ-consultant</li>
          <li>Optioneel: doorlopende wervingscampagnes (Facebook, Instagram, Google Ads)</li>
        </ul>
      </div>
      <div class="card">
        <h3>Custom</h3>
        <p>Voor regionale organisaties (1500+ werknemers)</p>
        <ul class="traits">
          <li>Onbeperkte afname van de test</li>
          <li>Dashboard met leads en cv's + eigen landingspagina</li>
          <li>Custom look-and-feel van test en rapportage</li>
          <li>Eigen vragen, eisen en motivatievragen toevoegen</li>
          <li>Optioneel: custom wervingscampagnes</li>
        </ul>
      </div>
    </div>
    <div class="center" style="margin-top:30px"><a href="/contact/" class="btn btn-primary">Contact opnemen voor alle opties</a></div>
  </div></section>

  <section class="bg-soft"><div class="wrap" style="max-width:840px">
    <div class="center">
      <div class="eyebrow">Veelgestelde vragen</div>
      <h2 class="section-title">Alles over de Geschikt voor Zorg-test</h2>
    </div>
    {gvzFaq.map((f) => (
      <div class="faq-item">
        <div class="faq-q">{f.q}<span class="pl">+</span></div>
        <div class="faq-a"><p>{f.a}</p></div>
      </div>
    ))}
  </div></section>

  <section class="formsec" id="demo"><div class="wrap">
    <div class="center">
      <div class="eyebrow">Gratis demo</div>
      <h2 class="section-title">Vraag een gratis demo aan</h2>
      <p class="lead center" style="max-width:640px;margin:0 auto 8px">Doe zelf de test en ontvang een voorbeeldrapportage. Gratis &middot; geen verplichting &middot; per e-mail.</p>
    </div>
    <form class="gvz-form" id="gvzForm" method="POST" action={formAction}>
      <input type="hidden" name="_subject" value="Demo-aanvraag Geschikt voor Zorg" />
      <div class="gvz-form-row">
        <input type="text" name="naam" placeholder="Naam" required />
        <input type="email" name="email" placeholder="Werk e-mailadres" required />
      </div>
      <div class="gvz-form-row">
        <input type="text" name="organisatie" placeholder="Organisatie" />
        <input type="text" name="vacatures" placeholder="Aantal openstaande vacatures (optioneel)" />
      </div>
      <button type="submit" class="btn btn-primary" id="gvzBtn">Vraag de gratis demo aan</button>
      <p class="gvz-form-done" id="gvzDone" hidden>Bedankt! We sturen de voorbeeldrapportage zo snel mogelijk per e-mail.</p>
      <p class="gvz-form-note">We gebruiken je gegevens alleen om je de demo en rapportage te sturen.</p>
    </form>
  </div></section>

  <section class="cta"><div class="wrap">
    <h2>Samen werving met een zorghart</h2>
    <p>Sinds 2014 ontwikkelen wij digitale oplossingen voor problemen in de zorg. We zetten ons in voor duurzame inzetbaarheid en het oplossen van het personeelstekort, zodat er meer zorgmedewerkers komen die werken op de plek waar ze goed passen.</p>
    <div class="btns">
      <a href="/geschiktvoorzorg/over-ons/" class="btn btn-light">Over ons</a>
      <a href="/contact/" class="btn btn-primary">Neem contact op</a>
    </div>
  </div></section>
</Base>

<style>
  .gvz-cases { display: grid; grid-template-columns: repeat(3, 1fr); gap: 22px; }
  @media (max-width: 900px) { .gvz-cases { grid-template-columns: 1fr; } }
  .gvz-case { background: #fff; border: 1px solid var(--line); border-radius: 16px; padding: 26px 24px; box-shadow: var(--shadow-sm); display: flex; flex-direction: column; border-top: 3px solid var(--gold); }
  .gvz-org { font-size: 1.25rem; font-weight: 800; color: var(--navy); }
  .gvz-metric { display: inline-block; align-self: flex-start; background: #e8f0fe; color: var(--navy); font-size: 12.5px; font-weight: 700; padding: 4px 11px; border-radius: 999px; margin: 8px 0 12px; }
  .gvz-case p { color: var(--muted); font-size: 14.5px; line-height: 1.55; margin: 0 0 12px; }
  .gvz-case blockquote { color: var(--navy); font-weight: 600; font-size: 14.5px; line-height: 1.5; font-style: italic; border-left: 3px solid var(--gold); padding-left: 14px; margin: 0 0 14px; flex: 1; }
  .gvz-who { font-size: 13px; color: var(--muted); }
  .gvz-who b { color: var(--navy); }
  .gvz-trust { text-align: center; color: var(--muted); font-size: 14px; margin-top: 26px; }
  .gvz-logo { display: flex; align-items: center; height: 46px; margin-bottom: 4px; }
  .gvz-logo img { max-height: 42px; max-width: 160px; width: auto; object-fit: contain; display: block; }
  .gvz-logo b { display: none; font-size: 1.2rem; font-weight: 800; color: var(--navy); }
  .gvz-logo.is-txt b { display: inline; }
  .gvz-trust-h { text-align: center; color: var(--navy); font-weight: 700; font-size: 1.05rem; margin: 40px 0 0; }
  .gvz-logos { display: flex; flex-wrap: wrap; align-items: center; justify-content: center; gap: 36px; margin-top: 22px; }
  .gvz-logos img { max-height: 46px; max-width: 130px; width: auto; object-fit: contain; filter: grayscale(1); opacity: .72; transition: filter .2s, opacity .2s; }
  .gvz-logos img:hover { filter: none; opacity: 1; }
  .gvz-steps { display: grid; grid-template-columns: repeat(4, 1fr); gap: 20px; margin-top: 36px; }
  @media (max-width: 900px) { .gvz-steps { grid-template-columns: 1fr 1fr; } }
  @media (max-width: 560px) { .gvz-steps { grid-template-columns: 1fr; } }
  .gvz-step { background: #fff; border: 1px solid var(--line); border-radius: 14px; padding: 24px 22px; box-shadow: var(--shadow-xs); }
  .gvz-n { display: inline-flex; align-items: center; justify-content: center; width: 34px; height: 34px; border-radius: 50%; background: var(--navy); color: #fff; font-weight: 800; margin-bottom: 12px; }
  .gvz-step h3 { color: var(--navy); font-size: 1.05rem; margin-bottom: 6px; }
  .gvz-step p { color: var(--muted); font-size: 14px; line-height: 1.55; }
  .gvz-form { max-width: 640px; margin: 30px auto 0; }
  .gvz-form-row { display: flex; gap: 12px; margin-bottom: 12px; }
  @media (max-width: 560px) { .gvz-form-row { flex-direction: column; } }
  .gvz-form input { width: 100%; padding: 12px 14px; border: 1px solid var(--line-strong); border-radius: 10px; font-family: inherit; font-size: 15px; }
  .gvz-form input:focus { outline: 2px solid var(--blue); border-color: var(--blue); }
  .gvz-form .btn { width: 100%; margin-top: 4px; }
  .gvz-form-done { color: #1a8a55; font-weight: 700; text-align: center; margin-top: 12px; }
  .gvz-form-note { color: var(--muted); font-size: 12.5px; text-align: center; margin-top: 12px; }
</style>

<script is:inline>
  (function () {
    var f = document.getElementById("gvzForm");
    if (!f) return;
    f.addEventListener("submit", function (e) {
      e.preventDefault();
      var btn = document.getElementById("gvzBtn");
      btn.disabled = true; btn.textContent = "Versturen…";
      fetch(f.getAttribute("action"), { method: "POST", headers: { Accept: "application/json" }, body: new FormData(f) })
        .then(function (r) {
          if (r.ok) { Array.prototype.forEach.call(f.querySelectorAll("input, button"), function (el) { el.style.display = "none"; }); document.getElementById("gvzDone").hidden = false; }
          else { btn.disabled = false; btn.textContent = "Vraag de gratis demo aan"; }
        })
        .catch(function () { btn.disabled = false; btn.textContent = "Vraag de gratis demo aan"; });
    });
  })();
</script>
