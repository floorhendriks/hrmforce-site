---
import Base from "../../layouts/Base.astro";
import { landings } from "../../data/landings.js";
import { assessments } from "../../data/assessments.js";
import { FORMSPREE_ENDPOINT, CONTACT_EMAIL } from "../../data/site-config.js";

export function getStaticPaths() {
  return landings.map((l) => ({ params: { slug: l.slug }, props: { l } }));
}

const { l } = Astro.props;
const formAction = FORMSPREE_ENDPOINT || `mailto:${CONTACT_EMAIL}`;
const bySlug = new Map(assessments.map((a) => [a.slug, a]));
const linked = (l.assessmentSlugs || []).map((s) => bySlug.get(s)).filter(Boolean);
const _canon = new URL(Astro.url.pathname, "https://hrmforce.com").href;
const _crumbLd = { "@context": "https://schema.org", "@type": "BreadcrumbList", itemListElement: [
  { "@type": "ListItem", position: 1, name: "Home", item: "https://hrmforce.com/" },
  { "@type": "ListItem", position: 2, name: "Toepassingen", item: "https://hrmforce.com/toepassingen/" },
  { "@type": "ListItem", position: 3, name: l.title, item: _canon },
] };
const _svcLd = { "@context": "https://schema.org", "@type": "Service", name: l.title, description: l.metaDescription, provider: { "@type": "Organization", name: "hrmforce" }, areaServed: "EU" };
const _faqLd = { "@context": "https://schema.org", "@type": "FAQPage", mainEntity: (l.faq || []).map((f) => ({ "@type": "Question", name: f.q, acceptedAnswer: { "@type": "Answer", text: f.a } })) };
---
<Base title={l.metaTitle} description={l.metaDescription} active="solutions">
  <script type="application/ld+json" is:inline set:html={JSON.stringify(_crumbLd)}></script>
  <script type="application/ld+json" is:inline set:html={JSON.stringify(_svcLd)}></script>
  <script type="application/ld+json" is:inline set:html={JSON.stringify(_faqLd)}></script>

  <div class="crumb"><div class="wrap"><a href="/">Home</a> › <a href="/toepassingen/">Toepassingen</a> › <span>{l.title}</span></div></div>

  <section class="ahero"><div class="wrap" style="display:block">
    <div class="eyebrow" style="color:var(--gold)">{l.eyebrow}</div>
    <h1>{l.hero}</h1>
    <p style="color:#c4d2e6;font-size:18px;max-width:760px;margin-top:10px">{l.intro}</p>
    <div class="btns" style="margin-top:18px">
      <a href="/contact/" class="btn btn-primary">Plan een gratis demo &rarr;</a>
      <a href="/online-assessments/" class="btn btn-ghost" style="color:#fff;border-color:rgba(255,255,255,.6)">Bekijk alle assessments</a>
    </div>
  </div></section>

  <section><div class="wrap">
    <div class="eyebrow">Herkenbaar?</div>
    <h2 class="section-title">Waar loop je tegenaan</h2>
    <div class="lp-pains">
      {l.pains.map((p) => (<div class="lp-pain"><span aria-hidden="true">•</span><p>{p}</p></div>))}
    </div>
  </div></section>

  <section class="bg-soft"><div class="wrap">
    <div class="eyebrow" style="color:var(--gold)">Onze aanpak</div>
    <h2 class="section-title">Zo helpt hrmforce</h2>
    <div class="lp-grid">
      {l.approach.map((a) => (<div class="lp-card"><h3>{a.h}</h3><p>{a.p}</p></div>))}
    </div>
  </div></section>

  {linked.length > 0 && (
    <section><div class="wrap">
      <div class="center"><div class="eyebrow">Passende instrumenten</div>
        <h2 class="section-title" style="margin-bottom:36px">Assessments die hier vaak bij passen</h2></div>
      <div class="cards">
        {linked.map((a) => (
          <a class="card" href={`/assessments/${a.slug}/`} style="text-decoration:none;color:inherit;display:flex;flex-direction:column">
            <h3>{a.title}</h3>
            <p style="flex:1">{a.goal}</p>
            <span class="readmore">Bekijk assessment &rarr;</span>
          </a>
        ))}
      </div>
    </div></section>
  )}

  {l.faq.length > 0 && (
    <section class="bg-soft"><div class="wrap" style="max-width:820px">
      <div class="center"><div class="eyebrow">Veelgestelde vragen</div>
        <h2 class="section-title" style="margin-bottom:36px">Vragen over {l.title.toLowerCase()}</h2></div>
      {l.faq.map((f) => (
        <div class="faq-item"><div class="faq-q">{f.q}<span class="pl">+</span></div><div class="faq-a"><p>{f.a}</p></div></div>
      ))}
    </div></section>
  )}

  <section class="formsec" id="request"><div class="wrap">
    <div class="center"><div class="eyebrow">Sparren?</div>
      <h2 class="section-title">Ontdek wat past bij jouw situatie</h2>
      <p class="lead" style="margin-bottom:36px">Laat je gegevens achter, dan denken we vrijblijvend mee over de juiste aanpak.</p></div>
    <form class="formcard" action={formAction} method="POST" enctype={FORMSPREE_ENDPOINT ? "application/x-www-form-urlencoded" : "text/plain"}>
      <input type="hidden" name="onderwerp" value={`Interesse: ${l.title}`} />
      <div class="frow">
        <div class="fg"><label>Voornaam *</label><input type="text" name="voornaam" required /></div>
        <div class="fg"><label>Werk e-mail *</label><input type="email" name="email" required /></div>
      </div>
      <div class="fg"><label>Bedrijfsnaam</label><input type="text" name="bedrijf" /></div>
      <button type="submit" class="btn btn-primary">Verzenden</button>
    </form>
  </div></section>
</Base>

<style>
  .lp-pains{display:grid;grid-template-columns:repeat(3,1fr);gap:18px;margin-top:26px}
  .lp-pain{display:flex;gap:12px;background:#fff;border:1px solid var(--line);border-left:3px solid var(--gold);border-radius:12px;padding:18px 20px;box-shadow:var(--shadow-xs)}
  .lp-pain span{color:var(--gold);font-weight:800;font-size:20px;line-height:1.2}
  .lp-pain p{margin:0;color:var(--navy);font-weight:600;font-size:15px;line-height:1.5}
  .lp-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:20px;margin-top:26px}
  .lp-card{background:#fff;border:1px solid var(--line);border-radius:16px;padding:24px}
  .lp-card h3{color:var(--navy);font-size:1.1rem;margin:0 0 8px}
  .lp-card p{color:var(--muted);font-size:15px;line-height:1.6;margin:0}
  @media(max-width:820px){.lp-pains,.lp-grid{grid-template-columns:1fr}}
</style>
