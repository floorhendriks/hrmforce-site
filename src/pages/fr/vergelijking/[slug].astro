---
import Base from "../../../layouts/Base.astro";
import Vergelijking from "../../../components/Vergelijking.astro";
import { VERG_UI, COMPETITORS } from "../../../data/vergelijking-content.js";
export function getStaticPaths(){ return Object.keys(COMPETITORS).map((slug)=>({ params:{slug}, props:{slug} })); }
const { slug } = Astro.props; const t = VERG_UI.fr; const c = COMPETITORS[slug];
---
<Base title={`${t.altPrefix} ${c.name} | hrmforce`} description={`hrmforce face à ${c.name} : ce que mesurent les instruments, dans quelles langues ils existent et ce que coûte une licence. Sans discours commercial.`} active=""><Vergelijking slug={slug} lang="fr" /></Base>
