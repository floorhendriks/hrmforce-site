---
import Base from "../../layouts/Base.astro";

const offices = [
  {
    naam: "hrmforce Germany",
    regels: ["Theodorstrasse 105", "40472 Dusseldorf", "Germany"],
    tel: "+31 (0)88 88 321 88",
    telHref: "tel:+31888832188",
    mail: "service@hrmforce.com",
  },
  {
    naam: "hrmforce Belgium",
    regels: ["Bridge Building", "Keizer Karellaan 584", "1082 Sint-Agatha-Berchem", "Belgium"],
    tel: "+31 (0)88 88 321 88",
    telHref: "tel:+31888832188",
    mail: "belgium@hrmforce.com",
  },
  {
    naam: "hrmforce France",
    regels: ["5 Place de la Pyramide Tour Ariane", "92800, Paris, Hauts-de-Seine", "France"],
    tel: "+31 (0)88 88 321 88",
    telHref: "tel:+31888832188",
    mail: "france@hrmforce.com",
  },
  {
    naam: "hrmforce India",
    regels: ["Plot #27, 1-4-190/27/1/A, Phase-I,", "Bhaskara Rao Nagar Sainikpuri P.O.", "Secunderabad 500 094", "Telangana, India"],
    tel: "+91 89787 86121",
    telHref: "tel:+918978786121",
    mail: "india@hrmforce.com",
  },
  {
    naam: "hrmforce Romania",
    regels: ["Ploiesti Street, No 9", "400157 Cluj-Napoca", "Romania"],
    tel: "+31 (0)88 88 321 88",
    telHref: "tel:+31888832188",
    mail: "office@hrmforce.com",
  },
  {
    naam: "hrmforce Spain",
    regels: ["Carrer de les Barques 2 2e etage", "46002 Valencia", "Valencia, Spain"],
    tel: "+31 (0)88 88 321 88",
    telHref: "tel:+31888832188",
    mail: "atencioncliente@hrmforce.com",
  },
];
---
<Base
  title="Contact - hrmforce"
  description="Nous sommes heureux de vous apporter le soutien necessaire et de trouver avec vous la meilleure solution possible. N'hesitez pas a contacter directement l'un de nos conseillers."
  active="contact"
>
  <div class="crumb">
    <div class="wrap"><a href="/fr/">Home</a> &rsaquo; <span>Contact</span></div>
  </div>

  <section class="ahero">
    <div class="wrap" style="display:block">
      <div class="eyebrow" style="color:var(--gold)">Contact</div>
      <h1>Des questions ? Contactez-nous.</h1>
      <p style="color:#c4d2e6;font-size:19px;max-width:820px;margin-top:8px">
        Nous sommes heureux de vous apporter le soutien necessaire et cherchons avec vous la meilleure solution possible.
        N'hesitez pas a contacter directement l'un de nos conseillers. Remplissez le formulaire de contact ou appelez-nous.
      </p>
    </div>
  </section>

  <section class="formsec">
    <div class="wrap contact-grid">
      <div class="contact-info">
        <div class="eyebrow">siege hrmforce</div>
        <h2 class="section-title" style="font-size:26px">Amsterdam</h2>
        <p class="addr">
          Solitudolaan 396<br />
          1096 DS Amsterdam<br />
          The Netherlands
        </p>

        <ul class="contact-list">
          <li><span class="lbl">Telephone</span> <a href="tel:+31888832188">+31 (0)88 88 321 88</a></li>
          <li><span class="lbl">E-mail</span> <a href="mailto:service@hrmforce.com">service@hrmforce.com</a></li>
        </ul>

        <p class="hours">
          <strong>Disponibilite</strong><br />
          Nos conseillers sont disponibles du lundi au vendredi de 8h00 a 18h00.
        </p>

        <ul class="legal">
          <li><span class="lbl">CCI Amsterdam</span> 34369982</li>
          <li><span class="lbl">TVA</span> NL821671480B01</li>
          <li><span class="lbl">Banque</span> NL31 RABO 0155 7584 11</li>
        </ul>

        <div class="map">
          <iframe
            title="Emplacement hrmforce Amsterdam"
            src="https://maps.google.com/maps?q=Solitudolaan%20396%2C%201096%20DS%20Amsterdam&t=&z=15&ie=UTF8&iwloc=&output=embed"
            loading="lazy"
            referrerpolicy="no-referrer-when-downgrade"
          ></iframe>
        </div>
      </div>

      <div>
        <div class="eyebrow">Formulaire de contact</div>
        <h2 class="section-title" style="font-size:26px">Envoyez-nous un message</h2>
        <form
          id="contactForm"
          class="formcard"
          action="mailto:service@hrmforce.com"
          method="POST"
          enctype="text/plain"
          novalidate
        >
          <div class="frow">
            <div class="fg">
              <label for="firstname">Prenom *</label>
              <input type="text" id="firstname" name="firstname" required />
            </div>
            <div class="fg">
              <label for="surname">Nom *</label>
              <input type="text" id="surname" name="surname" required />
            </div>
          </div>
          <div class="frow">
            <div class="fg">
              <label for="company">Societe *</label>
              <input type="text" id="company" name="company" required />
            </div>
            <div class="fg">
              <label for="phone">Telephone *</label>
              <input type="tel" id="phone" name="phone" required />
            </div>
          </div>
          <div class="fg">
            <label for="email">Adresse e-mail *</label>
            <input type="email" id="email" name="email" required />
          </div>
          <div class="fg">
            <label for="subject">Sujet *</label>
            <input type="text" id="subject" name="subject" required />
          </div>
          <div class="fg">
            <label for="message">Votre message *</label>
            <textarea id="message" name="message" rows="5" required></textarea>
          </div>
          <div class="next-steps"><strong>Que se passe-t-il ensuite ?</strong><ol><li>Nous repondons sous 1 jour ouvre.</li><li>Un court echange, adapte a votre question.</li><li>Une demo personnalisee, sans engagement.</li></ol><div class="ns-proof"><span class="ns-stars">&#9733;&#9733;&#9733;&#9733;&#9733;</span> 10 000+ participants &middot; 1 200+ organisations &middot; 4,9/5</div></div>
          <p id="formMsg" class="form-msg" role="status" aria-live="polite"></p>
          <button type="submit" class="btn btn-primary">Envoyer</button>
          <p class="privacy-note">
            En envoyant ce formulaire, vous acceptez notre
            <a href="/fr/support/">declaration de confidentialite</a>.
          </p>
        </form>
        <div class="person-card"><img src="/media/team/floor-hendriks.webp" alt="Floor Hendriks, fondatrice de hrmforce" width="72" height="72" loading="lazy" /><div><strong>Vous preferez un contact personnel ?</strong><span>Nous vous aidons volontiers. Appelez ou ecrivez-nous, nous repondons vite.</span><span class="person-name">Floor Hendriks &middot; fondatrice de hrmforce &middot; plus de 20 ans d'expérience</span></div></div>
      </div>
    </div>
  </section>

  <section>
    <div class="wrap">
      <div class="eyebrow">Nos bureaux</div>
      <h2 class="section-title">hrmforce dans le monde</h2>
      <p class="lead">Outre notre siege a Amsterdam, nous sommes egalement presents a l'international.</p>
      <div class="office-grid">
        {offices.map((o) => (
          <div class="office-card">
            <h3>{o.naam}</h3>
            <p class="addr">{o.regels.map((r, i) => (<>{r}{i < o.regels.length - 1 && <br />}</>))}</p>
            <p class="office-contact">
              <a href={o.telHref}>{o.tel}</a><br />
              <a href={`mailto:${o.mail}`}>{o.mail}</a>
            </p>
          </div>
        ))}
      </div>
      <div class="cmap">
        <iframe title="Emplacement hrmforce Amsterdam" src="https://maps.google.com/maps?q=Solitudolaan%20396%2C%201096%20DS%20Amsterdam&t=&z=15&ie=UTF8&iwloc=&output=embed" loading="lazy" referrerpolicy="no-referrer-when-downgrade"></iframe>
      </div>
    </div>
  </section>

  <style>
    .contact-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 48px;
      align-items: start;
    }
    .contact-info .addr {
      color: var(--muted);
      font-size: 16px;
      margin-bottom: 18px;
    }
    .contact-list,
    .legal {
      list-style: none;
      margin: 0 0 18px;
    }
    .contact-list li,
    .legal li {
      padding: 8px 0;
      border-bottom: 1px dashed var(--line);
      color: var(--text);
      font-size: 15px;
    }
    .contact-list a { color: var(--blue); font-weight: 600; }
    .contact-list a:hover { text-decoration: underline; }
    .lbl {
      display: inline-block;
      min-width: 130px;
      color: var(--navy);
      font-weight: 700;
      font-size: 13px;
      text-transform: uppercase;
      letter-spacing: .4px;
    }
    .hours {
      background: var(--bg);
      border-left: 3px solid var(--gold);
      padding: 14px 16px;
      border-radius: 8px;
      color: var(--muted);
      font-size: 15px;
      margin-bottom: 18px;
    }
    .hours strong { color: var(--navy); }
    .map {
      margin-top: 8px;
      border-radius: var(--radius);
      overflow: hidden;
      border: 1px solid var(--line);
      box-shadow: var(--shadow);
    }
    .map iframe {
      width: 100%;
      height: 260px;
      border: 0;
      display: block;
    }
    .form-msg {
      display: none;
      margin-bottom: 16px;
      padding: 12px 14px;
      border-radius: 10px;
      font-size: 14px;
      font-weight: 600;
    }
    .form-msg.error {
      display: block;
      background: #fff3f0;
      border: 1px solid var(--accent);
      color: #8a4a25;
    }
    .form-msg.success {
      display: block;
      background: #eef7ee;
      border: 1px solid #57a05a;
      color: #2f6b32;
    }
    .privacy-note {
      margin-top: 14px;
      font-size: 13px;
      color: var(--muted);
    }
    .privacy-note a { color: var(--blue); }
    .office-grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 24px;
      margin-top: 34px;
    }
    .office-card {
      background: #fff;
      border: 1px solid var(--line);
      border-radius: var(--radius);
      padding: 26px;
      box-shadow: var(--shadow);
    }
    .office-card h3 { font-size: 18px; margin-bottom: 10px; }
    .office-card .addr { color: var(--muted); font-size: 15px; margin-bottom: 12px; }
    .office-contact a { color: var(--blue); font-weight: 600; font-size: 15px; }
    .office-contact a:hover { text-decoration: underline; }
    @media (max-width: 880px) {
      .contact-grid { grid-template-columns: 1fr; }
      .office-grid { grid-template-columns: 1fr; }
    }

  .next-steps{background:var(--bg-soft);border:1px solid var(--line);border-radius:12px;padding:16px 18px;margin:4px 0 18px}
  .next-steps strong{color:var(--navy);font-size:14.5px;display:block;margin-bottom:8px}
  .next-steps ol{margin:0 0 10px 18px;padding:0;color:var(--text);font-size:14px;line-height:1.5}
  .next-steps li{margin:3px 0}
  .ns-proof{color:var(--muted);font-size:13px;padding-top:8px;border-top:1px solid var(--line)}
  .ns-stars{color:var(--gold);letter-spacing:1px}

  .person-card{display:flex;gap:16px;align-items:center;background:var(--bg-soft);border:1px solid var(--line);border-radius:14px;padding:16px 18px;margin:22px 0 0}
  .person-card img{width:72px;height:72px;border-radius:50%;object-fit:cover;flex:none;border:2px solid #fff;box-shadow:var(--shadow-xs)}
  .person-card strong{display:block;color:var(--navy);font-size:15.5px;margin-bottom:2px}
  .person-card span{display:block;color:var(--muted);font-size:14px;line-height:1.45}
  .person-card .person-name{color:var(--navy);font-weight:700;font-size:13px;margin-top:6px}
  .cmap{margin-top:28px;border-radius:var(--radius);overflow:hidden;border:1px solid var(--line)}
  .cmap iframe{width:100%;height:340px;border:0;display:block}
</style>

  <script is:inline>
    (function () {
      var form = document.getElementById("contactForm");
      if (!form) return;
      var msg = document.getElementById("formMsg");
      form.addEventListener("submit", function (e) {
        var required = form.querySelectorAll("[required]");
        var missing = [];
        required.forEach(function (el) {
          if (!el.value.trim()) missing.push(el);
        });
        var email = form.querySelector("#email");
        var emailOk = email && /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email.value.trim());
        if (missing.length > 0 || !emailOk) {
          e.preventDefault();
          msg.className = "form-msg error";
          msg.textContent = missing.length > 0
            ? "Veuillez remplir tous les champs obligatoires avant d'envoyer."
            : "Veuillez saisir une adresse e-mail valide.";
          (missing[0] || email).focus();
          return;
        }
        msg.className = "form-msg success";
        msg.textContent = "Merci ! Votre message va s'ouvrir dans votre programme de messagerie. Nous vous contacterons des que possible.";
      });
    })();
  </script>
</Base>
