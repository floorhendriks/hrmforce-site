---
import Base from "../../../layouts/Base.astro";
import Oefentest from "../../../components/Oefentest.astro";
import { ONDERDELEN, OT_UI } from "../../../data/oefentest-ui.js";
import numeriek from "../../../data/oefenbank/numeriek.fr.json";
import verbaal from "../../../data/oefenbank/verbaal.fr.json";
import calculation from "../../../data/oefenbank/calculation.fr.json";
import ruimtelijk from "../../../data/oefenbank/ruimtelijk.fr.json";
import abstract from "../../../data/oefenbank/abstract.fr.json";
const BANKEN = { numeriek, verbaal, calculation, ruimtelijk, abstract };
export function getStaticPaths() {
  return Object.entries(ONDERDELEN).map(([sleutel, o]) => ({
    params: { onderdeel: o.slug["fr"] }, props: { sleutel, o },
  }));
}
const { sleutel, o } = Astro.props;
const t = OT_UI["fr"];
const naam = o.naam["fr"];
---
<Base lang="fr" title={`${naam} | ${t.eyebrow} | hrmforce`} description={o.lead["fr"]} active="">
  <Oefentest onderdeel={sleutel} lang="fr" bank={BANKEN[sleutel]} />
</Base>
