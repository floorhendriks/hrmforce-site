[{"id":"bigfive-001","d":0,"k":1,"q":"Kokeilen mielelläni uusia työtapoja"},{"id":"bigfive-002","d":0,"k":1,"q":"Luen mielelläni aiheista oman alani ulkopuolelta"},{"id":"bigfive-003","d":0,"k":1,"q":"Mietin usein vaihtoehtoja sille, miten asiat nykyään tehdään"},{"id":"bigfive-004","d":0,"k":1,"q":"Minulle uusi ajatus innostaa minut nopeasti"},{"id":"bigfive-005","d":0,"k":1,"q":"Etsin vapaa-ajallani uusia kokemuksia"},{"id":"bigfive-006","d":0,"k":1,"q":"Kysyn aina, miksi jokin työtapa on sellainen kuin on"},{"id":"bigfive-007","d":0,"k":-1,"q":"Pysyn mieluiten toimivaksi todetussa tavassa"},{"id":"bigfive-008","d":0,"k":-1,"q":"Mielestäni abstraktit keskustelut tuottavat vähän"},{"id":"bigfive-009","d":0,"k":-1,"q":"Pidän kiinteästä rutiinista enemmän kuin joka kerta uudesta"},{"id":"bigfive-010","d":0,"k":-1,"q":"Taide ja kulttuuri merkitsevät minulle vähän"},{"id":"bigfive-011","d":1,"k":1,"q":"Saatan loppuun sen, minkä aloitan"},{"id":"bigfive-012","d":1,"k":1,"q":"Suunnittelen työni etukäteen"},{"id":"bigfive-013","d":1,"k":1,"q":"Pidän kiinni sopimuksista, myös pienistä"},{"id":"bigfive-014","d":1,"k":1,"q":"Pidän paperini järjestyksessä"},{"id":"bigfive-015","d":1,"k":1,"q":"Tarkistan työni ennen kuin luovutan sen"},{"id":"bigfive-016","d":1,"k":1,"q":"Pysyn määräajoissa"},{"id":"bigfive-017","d":1,"k":-1,"q":"Lykkään tehtäviä, joista en pidä"},{"id":"bigfive-018","d":1,"k":-1,"q":"Työskentelen mieluummin spontaanisti kuin suunnitelman mukaan"},{"id":"bigfive-019","d":1,"k":-1,"q":"Hukkaan usein tavaroitani"},{"id":"bigfive-020","d":1,"k":-1,"q":"Aloitan usein uutta ennen kuin edellinen on valmis"},{"id":"bigfive-021","d":2,"k":1,"q":"Lähestyn helposti tuntemattomia ihmisiä"},{"id":"bigfive-022","d":2,"k":1,"q":"Juttelen mielelläni ihmisten kanssa, jotka olen juuri tavannut"},{"id":"bigfive-023","d":2,"k":1,"q":"Viihdyn suuressa ryhmässä"},{"id":"bigfive-024","d":2,"k":1,"q":"Olen keskustelussa usein ensimmäinen, joka puhuu"},{"id":"bigfive-025","d":2,"k":1