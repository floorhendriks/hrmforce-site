 "skill_types": {
  "K": {
   "label": {
    "nl": "Kennis",
    "en": "Knowledge"
   },
   "note": {
    "nl": "Declaratieve vakkennis. Meet met een kennistoets, niet met een vragenlijst.",
    "en": "Declarative knowledge. Measure with a knowledge test, not a questionnaire."
   }
  },
  "V": {
   "label": {
    "nl": "Vaardigheid",
    "en": "Skill"
   },
   "note": {
    "nl": "Toegepast en aanleerbaar. Meet met een werkproef of gestructureerde beoordeling.",
    "en": "Applied and learnable. Measure with a work sample or structured assessment."
   }
  },
  "G": {
   "label": {
    "nl": "Gedragscompetentie",
    "en": "Behavioural competence"
   },
   "note": {
    "nl": "Dispositioneel gedrag. Koppelt aan de Big Fifty en 360 feedback. Niet in drie maanden ontwikkelbaar.",
    "en": "Dispositional behaviour. Links to Big Fifty and 360 feedback. Not developed in three months."
   }
  },
  "T": {
   "label": {
    "nl": "Tool of technologie",
    "en": "Tool or technology"
   },
   "note": {
    "nl": "Concreet gereedschap of pakket. Verwacht hoge veroudering, herzie jaarlijks.",
    "en": "A concrete tool or package. Expect rapid obsolescence, review annually."
   }
  },
  "A": {
   "label": {
    "nl": "Aanleg of vermogen",
    "en": "Ability"
   },
   "note": {
    "nl": "Relatief stabiele capaciteit. Meet met de Ability Scan of een simulatie. Niet trainbaar naar een hoger niveau.",
    "en": "Relatively stable capacity. Measure with the Ability Scan or a simulation. Not trainable to a higher level."
   }
  }
