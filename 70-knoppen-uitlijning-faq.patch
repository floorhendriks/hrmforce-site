+++ b/src/pages/[lang]/assessments/[slug].astro
@@ -330,12 +330,15 @@ const MC_BEZIG = { nl: "Verzenden…", en: "Sending…", de: "Wird gesendet…",
             <div class="faq-a"><p>{f.a}</p></div>
           </div>
         ))}
+        {/* Deze twee knoppen stonden buiten de wrap, dus zonder de marge van de
+            pagina. Op een breed scherm plakten ze tegen de linkerrand in plaats
+            van onder de vragen. Ze staan nu in dezelfde kolom als de vragen. */}
+        <div class="faq-knoppen">
+          <a href="#request" class="btn btn-primary">{t.blokCta.replace("{t}", a.title)}</a>
+          <a href={localizePath("/contact/", lang)} class="btn btn-ghost">{t.faqCta}</a>
+        </div>
       </div>
     </div>
-      <div class="center" style="margin-top:24px">
