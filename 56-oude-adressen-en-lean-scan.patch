index 96a2223..e6842c1 100644
--- a/public/_redirects
+++ b/public/_redirects
@@ -37,6 +37,17 @@
 /ro/toepassingen/onderwijs/ /ro/sectoren/onderwijs/ 301
 /ro/toepassingen/industrie/ /ro/sectoren/industrie/ 301
 
