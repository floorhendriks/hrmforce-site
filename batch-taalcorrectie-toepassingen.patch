diff --git a/src/components/Toepassing.astro b/src/components/Toepassing.astro
new file mode 100644
index 0000000..c5070f2
--- /dev/null
+++ b/src/components/Toepassing.astro
@@ -0,0 +1,120 @@
+---
+import { LAND_UI } from "../data/landings.js";
+import { assessments } from "../data/assessments.js";
+import { assessmentsI18n } from "../data/assessments-i18n.js";
+import { localizePath } from "../i18n/utils.js";
+import { FORMSPREE_ENDPOINT, CONTACT_EMAIL } from "../data/site-config.js";
+
+const { l, lang = "nl" } = Astro.props;
+const t = l.i18n[lang] || l.i18n.nl;
+const ui = LAND_UI[lang] || LAND_UI.nl;
+const formAction = FORMSPREE_ENDPOINT || `mailto:${CONTACT_EMAIL}`;
+
+const bySlug = new Map(assessments.map((a) => [a.slug, a]));
+function locAssess(slug) {
+  const base = bySlug.get(slug);
+  if (!base) return null;
+  if (lang === "nl") return { slug, title: base.title, goal: base.goal };
+  const loc = assessmentsI18n?.[lang]?.[slug];
+  return { slug, title: loc?.title || base.title, goal: loc?.goal || base.goal };
+}
+const linked = (l.assessmentSlugs || []).map(locAssess).filter(Boolean);
+
+const toepPath = localizePath("/toepassingen/", lang);
+const contactPath = localizePath("/contact/", lang);
+const onlinePath = localizePath("/online-assessments/", lang);
+const assessPath = (slug) => localizePath(`/assessments/${slug}/`, lang);
+
+const _canon = new URL(Astro.url.pathname, "https://hrmforce.com").href;
+const _crumbLd = { "@context": "https://schema.org", "@type": "BreadcrumbList", itemListElement: [
+  { "@type": "ListItem", position: 1, name: ui.home, item: "https://hrmforce.com/" },
+  { "@type": "ListItem", position: 2, name: ui.toep, item: `https://hrmforce.com${toepPath}` },
+  { "@type": "ListItem", position: 3, name: t.title, item: _canon },
+] };
+const _svcLd = { "@context": "https://schema.org", "@type": "Service", name: t.title, description: t.metaDescription, provider: { "@type": "Organization", name: "hrmforce" }, areaServed: "EU" };
+const _faqLd = { "@context": "https://schema.org", "@type": "FAQPage", mainEntity: (t.faq || []).map((f) => ({ "@type": "Question", name: f.q, acceptedAnswer: { "@type": "Answer", text: f.a } })) };
+---
+<script type="application/ld+json" is:inline set:html={JSON.stringify(_crumbLd)}></script>
+<script type="application/ld+json" is:inline set:html={JSON.stringify(_svcLd)}></script>
+<script type="application/ld+json" is:inline set:html={JSON.stringify(_faqLd)}></script>
+
+<div class="crumb"><div class="wrap"><a href={localizePath("/", lang)}>{ui.home}</a> &rsaquo; <a href={toepPath}>{ui.toep}</a> &rsaquo; <span>{t.title}</span></div></div>
+
+<section class="ahero"><div class="wrap" style="display:block">
+  <div class="eyebrow" style="color:var(--gold)">{t.eyebrow}</div>
+  <h1>{t.hero}</h1>
+  <p style="color:#c4d2e6;font-size:18px;max-width:760px;margin-top:10px">{t.intro}</p>
+  <div class="btns" style="margin-top:18px">
+    <a href={contactPath} class="btn btn-primary">{ui.demo} &rarr;</a>
+    <a href={onlinePath} class="btn btn-ghost" style="color:#fff;border-color:rgba(255,255,255,.6)">{ui.allass}</a>
+  </div>
+</div></section>
+
+<section><div class="wrap">
+  <div class="eyebrow">{ui.painsEy}</div>
+  <h2 class="section-title">{ui.painsT}</h2>
+  <div class="lp-pains">
+    {t.pains.map((p) => (<div class="lp-pain"><span aria-hidden="true">&bull;</span><p>{p}</p></div>))}
+  </div>
+</div></section>
+
+<section class="bg-soft"><div class="wrap">
+  <div class="eyebrow" style="color:var(--gold)">{ui.apEy}</div>
+  <h2 class="section-title">{ui.apT}</h2>
+  <div class="lp-grid">
+    {t.approach.map((a) => (<div class="lp-card"><h3>{a.h}</h3><p>{a.p}</p></div>))}
+  </div>
+</div></section>
+
+{linked.length > 0 && (
+  <section><div class="wrap">
+    <div class="center"><div class="eyebrow">{ui.linkEy}</div>
+      <h2 class="section-title" style="margin-bottom:36px">{ui.linkT}</h2></div>
+    <div class="cards">
+      {linked.map((a) => (
+        <a class="card" href={assessPath(a.slug)} style="text-decoration:none;color:inherit;display:flex;flex-direction:column">
+          <h3>{a.title}</h3>
+          <p style="flex:1">{a.goal}</p>
+          <span class="readmore">{ui.linkCta} &rarr;</span>
+        </a>
+      ))}
+    </div>
+  </div></section>
+)}
+
+{t.faq.length > 0 && (
+  <section class="bg-soft"><div class="wrap" style="max-width:820px">
+    <div class="center"><div class="eyebrow">{ui.faqEy}</div>
+      <h2 class="section-title" style="margin-bottom:36px">{ui.faqPre} {t.title.toLowerCase()}</h2></div>
+    {t.faq.map((f) => (
+      <div class="faq-item"><div class="faq-q">{f.q}<span class="pl">+</span></div><div class="faq-a"><p>{f.a}</p></div></div>
+    ))}
+  </div></section>
+)}
+
+<section class="formsec" id="request"><div class="wrap">
+  <div class="center"><div class="eyebrow">{ui.formEy}</div>
+    <h2 class="section-title">{ui.formT}</h2>
+    <p class="lead" style="margin-bottom:36px">{ui.formLead}</p></div>
+  <form class="formcard" action={formAction} method="POST" enctype={FORMSPREE_ENDPOINT ? "application/x-www-form-urlencoded" : "text/plain"}>
+    <input type="hidden" name="onderwerp" value={`${ui.interest}: ${t.title}`} />
+    <div class="frow">
+      <div class="fg"><label>{ui.fn} *</label><input type="text" name="voornaam" required /></div>
+      <div class="fg"><label>{ui.we} *</label><input type="email" name="email" required /></div>
+    </div>
+    <div class="fg"><label>{ui.comp}</label><input type="text" name="bedrijf" /></div>
+    <button type="submit" class="btn btn-primary">{ui.send}</button>
+  </form>
+</div></section>
+
+<style>
+  .lp-pains{display:grid;grid-template-columns:repeat(3,1fr);gap:18px;margin-top:26px}
+  .lp-pain{display:flex;gap:12px;background:#fff;border:1px solid var(--line);border-left:3px solid var(--gold);border-radius:12px;padding:18px 20px;box-shadow:var(--shadow-xs)}
+  .lp-pain span{color:var(--gold);font-weight:800;font-size:20px;line-height:1.2}
+  .lp-pain p{margin:0;color:var(--navy);font-weight:600;font-size:15px;line-height:1.5}
+  .lp-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:20px;margin-top:26px}
+  .lp-card{background:#fff;border:1px solid var(--line);border-radius:16px;padding:24px}
+  .lp-card h3{color:var(--navy);font-size:1.1rem;margin:0 0 8px}
+  .lp-card p{color:var(--muted);font-size:15px;line-height:1.6;margin:0}
+  @media(max-width:820px){.lp-pains,.lp-grid{grid-template-columns:1fr}}
+</style>
diff --git a/src/components/ToepassingenIndex.astro b/src/components/ToepassingenIndex.astro
new file mode 100644
index 0000000..a414809
--- /dev/null
+++ b/src/components/ToepassingenIndex.astro
@@ -0,0 +1,51 @@
+---
+import { landings, LAND_UI } from "../data/landings.js";
+import { localizePath } from "../i18n/utils.js";
+
+const { lang = "nl" } = Astro.props;
+const ui = LAND_UI[lang] || LAND_UI.nl;
+const usecases = landings.filter((l) => l.kind === "usecase");
+const sectors = landings.filter((l) => l.kind === "sector");
+const tp = (slug) => localizePath(`/toepassingen/${slug}/`, lang);
+const T = (l) => (l.i18n[lang] || l.i18n.nl);
+---
+<div class="crumb"><div class="wrap"><a href={localizePath("/", lang)}>{ui.home}</a> &rsaquo; <span>{ui.toep}</span></div></div>
+
+<section class="ahero"><div class="wrap" style="display:block">
+  <div class="eyebrow" style="color:var(--gold)">{ui.toep}</div>
+  <h1>{ui.idxHero}</h1>
+  <p style="color:#c4d2e6;font-size:18px;max-width:760px;margin-top:10px">{ui.idxIntro}</p>
+</div></section>
+
+<section><div class="wrap">
+  <div class="eyebrow">{ui.perGoal}</div>
+  <h2 class="section-title" style="margin-bottom:32px">{ui.toep}</h2>
+  <div class="cards">
+    {usecases.map((l) => (
+      <a class="card" href={tp(l.slug)} style="text-decoration:none;color:inherit;display:flex;flex-direction:column">
+        <h3>{T(l).title}</h3><p style="flex:1">{T(l).intro}</p><span class="readmore">{ui.readmore} &rarr;</span>
+      </a>
+    ))}
+  </div>
+</div></section>
+
+<section class="bg-soft"><div class="wrap">
+  <div class="eyebrow" style="color:var(--gold)">{ui.perSector}</div>
+  <h2 class="section-title" style="margin-bottom:32px">{ui.sectors}</h2>
+  <div class="cards">
+    <a class="card" href={"/geschiktvoorzorg/"} style="text-decoration:none;color:inherit;display:flex;flex-direction:column">
+      <h3>{ui.zorgT}</h3><p style="flex:1">{ui.zorgD}</p><span class="readmore">{ui.readmore} &rarr;</span>
+    </a>
+    {sectors.map((l) => (
+      <a class="card" href={tp(l.slug)} style="text-decoration:none;color:inherit;display:flex;flex-direction:column">
+        <h3>{T(l).title}</h3><p style="flex:1">{T(l).intro}</p><span class="readmore">{ui.readmore} &rarr;</span>
+      </a>
+    ))}
+  </div>
+</div></section>
+
+<section class="cta"><div class="wrap" style="padding:56px 0;text-align:center">
+  <h2 style="color:#fff">{ui.ctaT}</h2>
+  <p style="color:rgba(255,255,255,.9);max-width:620px;margin:12px auto 0">{ui.ctaD}</p>
+  <div class="btns" style="justify-content:center;margin-top:20px"><a href={localizePath("/contact/", lang)} class="btn btn-light">{ui.ctaBtn}</a></div>
+</div></section>
