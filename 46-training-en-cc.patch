+// Adressen samenvoegen, ontdubbeld, ook als een variabele meerdere adressen
+// met komma's bevat.
+function adressen(...regels) {
+  const uit = [];
+  regels.forEach((r) => String(r || "").split(",").forEach((a) => {
+    const x = a.trim();
+    if (x && !uit.includes(x)) uit.push(x);
+  }));
+  return uit;
+}
+
