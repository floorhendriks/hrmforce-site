+---
+import Base from "../../layouts/Base.astro";
+import LogoSlider from "../../components/LogoSlider.astro";
+import { assessments } from "../../data/assessments.js";
+
+// Alle assessments klikbaar tonen, gegroepeerd is niet nodig: één net raster.
+const list = assessments.map((a) => ({ title: a.title, slug: a.slug, goal: a.goal || "", phase: a.phase || "" }));
+---
+<Base title="Live Assessments | Door assessoren begeleid | hrmforce" description="Naast onze online tests begeleiden onze assessoren live assessments voor selectie, ontwikkeling en loopbaan. Bekijk alle beschikbare assessments." active="advice">
+  <div class="crumb">
+    <div class="wrap"><a href="/">Home</a> &rsaquo; <a href="/advies/">Advies</a> &rsaquo; <span>Live Assessments</span></div>
+  </div>
+
+  <section class="ahero">
+    <div class="wrap" style="display:block">
+      <div class="eyebrow" style="color:var(--gold)">Advies</div>
+      <h1>Live Assessments</h1>
+      <p style="color:#c4d2e6;font-size:19px;max-width:820px;margin-top:8px">Naast de zelfservice online tests begeleiden onze <strong>assessoren</strong> live assessments: van selectie- en ontwikkelassessments tot loopbaan- en teamtrajecten. We stellen op basis van je vraagstuk de juiste combinatie van vragenlijsten samen en koppelen de uitkomsten persoonlijk terug.</p>
+      <div class="btns" style="margin-top:16px">
+        <a href="/contact/" class="btn btn-primary">Plan een gratis demo</a>
+        <a href="/assessment-overzicht/" class="btn btn-light">Naar het volledige overzicht</a>
+      </div>
+    </div>
+  </section>
+
+  <LogoSlider heading="Organisaties die u voorgingen" />
+
+  <section>
+    <div class="wrap">
+      <div class="eyebrow">Beschikbare assessments</div>
+      <h2 class="section-title">Alle assessments, klikbaar</h2>
+      <p class="lead" style="margin-bottom:24px">Elk assessment is los in te zetten of te combineren binnen een begeleid traject. Klik door voor de uitleg, voorbeeldvragen en de wetenschappelijke onderbouwing.</p>
+      <div class="la-grid">
+        {list.map((a) => (
+          <a class="la-card" href={`/assessments/${a.slug}/`}>
+            <h3>{a.title}</h3>
+            {a.goal && <p>{a.goal}</p>}
+            {a.phase && <span class="la-phase">{a.phase}</span>}
+            <span class="la-more">Bekijk assessment &rarr;</span>
+          </a>
+        ))}
+      </div>
+    </div>
+  </section>
+
+  <section class="cta">
+    <div class="wrap">
+      <h2>Niet zeker welk assessment past?</h2>
+      <p>Onze assessoren denken met je mee en stellen het traject samen op basis van jouw doel en functie.</p>
+      <div class="btns">
+        <a href="/contact/" class="btn btn-primary">Plan een demo</a>
+        <a href="/testkiezer/" class="btn btn-light">Gebruik de testkiezer</a>
+      </div>
+    </div>
+  </section>
+</Base>
+
+<style>
+  .la-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 18px; margin-top: 8px; }
+  .la-card { display: flex; flex-direction: column; background: #fff; border: 1px solid var(--line); border-left: 3px solid var(--gold); border-radius: 14px; padding: 20px 22px; box-shadow: var(--shadow-xs); text-decoration: none; transition: transform .15s, box-shadow .15s; }
+  .la-card:hover { transform: translateY(-3px); box-shadow: var(--shadow-md); }
+  .la-card h3 { color: var(--navy); font-size: 17px; font-weight: 800; margin: 0 0 8px; }
+  .la-card p { color: var(--muted); font-size: 14px; line-height: 1.5; margin: 0 0 12px; flex: 1; }
+  .la-phase { color: var(--blue); font-size: 12px; font-weight: 700; margin-bottom: 10px; }
+  .la-more { color: var(--navy); font-size: 14px; font-weight: 700; }
+  @media (max-width: 880px) { .la-grid { grid-template-columns: 1fr 1fr; } }
+  @media (max-width: 560px) { .la-grid { grid-template-columns: 1fr; } }
+</style>
