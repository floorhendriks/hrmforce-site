+const _crumbLd = { "@context":"https://schema.org","@type":"BreadcrumbList", itemListElement:[
+  {"@type":"ListItem",position:1,name:"Home",item:"https://hrmforce.com/"},
+  {"@type":"ListItem",position:2,name:t.crumb,item:`https://hrmforce.com${localizePath("/vergelijking/", lang)}`},
+  {"@type":"ListItem",position:3,name:`${t.altPrefix} ${comp.name}`,item:_canon},
+]};
+---
+<script type="application/ld+json" is:inline set:html={JSON.stringify(_crumbLd)}></script>
+<div class="crumb"><div class="wrap"><a href={localizePath("/", lang)}>Home</a> &rsaquo; <a href={localizePath("/vergelijking/", lang)}>{t.crumb}</a> &rsaquo; <span>{comp.name}</span></div></div>
+
+<section class="ahero"><div class="wrap" style="display:block">
