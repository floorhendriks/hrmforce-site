+  <p style="color:#c4d2e6;font-size:18px;max-width:760px;margin-top:10px">{comp.intro}</p>
+  <p style="color:#93a7c4;font-size:13px;max-width:760px;margin-top:12px">{t.neutralNote}</p>
+</div></section>
+
+<section><div class="wrap">
+  <div class="eyebrow">{t.diffTitle}</div>
+  <h2 class="section-title" style="margin-bottom:26px">{t.diffTitle}</h2>
