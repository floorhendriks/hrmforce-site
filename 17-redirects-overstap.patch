+# WordPress-archieven. Deze prefixen hebben geen enkele echte pagina op de
+# nieuwe site, dus een wildcard is hier veilig.
+/product-categorie/*      /shop/           301
+/news_category/*          /kenniscentrum/  301
+/testimonials-category/*  /klantcases/     301
+/partner_categorie/*      /partners/       301
+/carousels-category/*     /               301
+/advies_categorieen/training/  /advies/trainingen/  301
