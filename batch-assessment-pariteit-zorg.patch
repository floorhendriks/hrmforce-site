--- a/src/components/ToepassingenIndex.astro
+++ b/src/components/ToepassingenIndex.astro
@@ -7,6 +7,7 @@ const ui = LAND_UI[lang] || LAND_UI.nl;
 const usecases = landings.filter((l) => l.kind === "usecase");
