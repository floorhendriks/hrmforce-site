+// Voorbeeldrapportage per assessment. De dimensies komen uit de test zelf, de
+// scores zijn afgeleid van de slug zodat elke test een eigen, vast beeld heeft.
+// Het is nadrukkelijk een voorbeeld, dat staat ook in het bijschrift.
+const _dvHash = (str) => {
+  let h = 2166136261;
+  for (let i = 0; i < str.length; i++) { h ^= str.charCodeAt(i); h = Math.imul(h, 16777619); }
+  return ((h >>> 0) % 1000) / 1000;
+};
+const _dvDims = (a.traits && a.traits.length ? a.traits : []).slice(0, 6);
+const dvRijen = _dvDims.map((n) => ({ n, v: Math.round((2.4 + _dvHash(a.slug + "|" + n) * 2.2) * 10) / 10 }));
+const dvNorm = /capacit|cognit|abstract|numer|verbaal|redeneer|ability|iq|intelligen|aanleg/i
+  .test(`${a.slug} ${a.title} ${(a.traits || []).join(" ")}`);
+const dvSoort = dvNorm || dvRijen.length < 3 ? "normverdeling" : "competentieprofiel";
