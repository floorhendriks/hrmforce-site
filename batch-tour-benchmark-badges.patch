diff --git a/src/components/Rondleiding.astro b/src/components/Rondleiding.astro
new file mode 100644
index 0000000..fe5731a
--- /dev/null
+++ b/src/components/Rondleiding.astro
@@ -0,0 +1,97 @@
+---
+import Img from "./Img.astro";
+import { TOUR_UI, TOUR_IMGS } from "../data/rondleiding-content.js";
+import { localizePath } from "../i18n/utils.js";
+const { lang = "nl" } = Astro.props;
+const t = TOUR_UI[lang] || TOUR_UI.nl;
+const steps = t.steps.map((s, i) => ({ ...s, img: TOUR_IMGS[i] }));
+---
+<div class="crumb"><div class="wrap"><a href={localizePath("/", lang)}>Home</a> &rsaquo; <span>{t.crumb}</span></div></div>
+
+<section class="ahero"><div class="wrap" style="display:block">
+  <div class="eyebrow" style="color:var(--gold)">{t.eyebrow}</div>
+  <h1>{t.hero}</h1>
+  <p style="color:#c4d2e6;font-size:18px;max-width:720px;margin-top:10px">{t.intro}</p>
+</div></section>
+
+<section><div class="wrap">
+  <div class="tour" id="tour" data-steplabel={t.stepLabel}>
+    <div class="tour-tabs" role="tablist">
+      {steps.map((s, i) => (
+        <button class:list={["tour-tab", { active: i === 0 }]} data-i={i} role="tab" aria-selected={i === 0 ? "true" : "false"}>
+          <span class="tour-num">{i + 1}</span><span class="tour-tab-txt">{s.title}</span>
+        </button>
+      ))}
+    </div>
+    <div class="tour-stage">
+      <div class="tour-media">
+        {steps.map((s, i) => (
+          <figure class:list={["tour-slide", { active: i === 0 }]} data-i={i}>
+            <Img src={s.img} alt={s.alt} loading={i === 0 ? "eager" : "lazy"} />
+          </figure>
+        ))}
+      </div>
+      <div class="tour-copy">
+        <span class="tour-steplabel"><span id="tourStepNum">1</span> / {steps.length}</span>
+        <h2 id="tourTitle">{steps[0].title}</h2>
+        <p id="tourText">{steps[0].text}</p>
+        <div class="tour-nav">
+          <button class="btn btn-ghost" id="tourPrev" disabled>&larr; {t.prev}</button>
+          <button class="btn btn-primary" id="tourNext">{t.next} &rarr;</button>
+        </div>
+      </div>
+    </div>
+  </div>
+</div></section>
+
+<section class="cta"><div class="wrap" style="padding:56px 0;text-align:center">
+  <h2 style="color:#fff">{t.ctaTitle}</h2>
+  <p style="color:rgba(255,255,255,.9);max-width:620px;margin:12px auto 0">{t.ctaText}</p>
+  <div class="btns" style="justify-content:center;margin-top:20px">
+    <a href={localizePath("/contact/", lang)} class="btn btn-light">{t.ctaBtn}</a>
+    <a href={localizePath("/online-assessments/", lang)} class="btn btn-ghost" style="color:#fff;border-color:rgba(255,255,255,.6)">{t.secondary}</a>
+  </div>
+</div></section>
+
+<script is:inline>
+  (function () {
+    var root = document.getElementById("tour"); if (!root) return;
+    var tabs = [].slice.call(root.querySelectorAll(".tour-tab"));
+    var slides = [].slice.call(root.querySelectorAll(".tour-slide"));
+    var titleEl = document.getElementById("tourTitle"), textEl = document.getElementById("tourText"), numEl = document.getElementById("tourStepNum");
+    var prev = document.getElementById("tourPrev"), next = document.getElementById("tourNext");
+    var cur = 0, total = slides.length;
+    function show(i) {
+      cur = Math.max(0, Math.min(total - 1, i));
+      tabs.forEach(function (tb, k) { tb.classList.toggle("active", k === cur); tb.setAttribute("aria-selected", k === cur ? "true" : "false"); });
+      slides.forEach(function (sl, k) { sl.classList.toggle("active", k === cur); });
+      titleEl.textContent = window.__tourSteps[cur].title;
+      textEl.textContent = window.__tourSteps[cur].text;
+      numEl.textContent = cur + 1;
+      prev.disabled = cur === 0; next.disabled = cur === total - 1;
+    }
+    tabs.forEach(function (tb) { tb.addEventListener("click", function () { show(+tb.getAttribute("data-i")); }); });
+    prev.addEventListener("click", function () { show(cur - 1); });
+    next.addEventListener("click", function () { show(cur + 1); });
+  })();
+</script>
+<script is:inline set:html={`window.__tourSteps=${JSON.stringify(steps.map(s=>({title:s.title,text:s.text})))};`}></script>
+
+<style>
+  .tour{display:flex;flex-direction:column;gap:20px}
+  .tour-tabs{display:flex;gap:10px;flex-wrap:wrap}
+  .tour-tab{display:flex;align-items:center;gap:10px;background:#fff;border:1px solid var(--line);border-radius:12px;padding:12px 16px;cursor:pointer;font-family:inherit;font-size:14.5px;font-weight:600;color:var(--muted);transition:border-color .2s,color .2s,box-shadow .2s}
+  .tour-tab.active{color:var(--navy);border-color:var(--gold);box-shadow:var(--shadow-xs)}
+  .tour-num{flex:none;width:26px;height:26px;border-radius:50%;background:var(--bg-soft);color:var(--navy);font-weight:800;font-size:13px;display:flex;align-items:center;justify-content:center}
+  .tour-tab.active .tour-num{background:var(--navy);color:#fff}
+  .tour-stage{display:grid;grid-template-columns:minmax(0,1.3fr) minmax(0,1fr);gap:32px;align-items:center;background:var(--bg-soft);border:1px solid var(--line);border-radius:18px;padding:26px}
+  .tour-media{position:relative;min-height:220px}
+  .tour-slide{margin:0;opacity:0;position:absolute;inset:0;transition:opacity .3s ease;pointer-events:none}
+  .tour-slide.active{opacity:1;position:relative;pointer-events:auto}
+  .tour-slide img{width:100%;height:auto;border-radius:14px;border:1px solid var(--line);box-shadow:var(--shadow-sm);display:block}
+  .tour-steplabel{color:var(--gold);font-weight:800;font-size:13px;letter-spacing:.5px}
+  .tour-copy h2{color:var(--navy);font-size:1.4rem;margin:8px 0 10px;letter-spacing:-.02em}
+  .tour-copy p{color:var(--text);font-size:15.5px;line-height:1.6;margin:0 0 20px}
+  .tour-nav{display:flex;gap:10px}
+  @media(max-width:820px){.tour-stage{grid-template-columns:1fr;gap:20px}}
+</style>
diff --git a/src/components/TrustBadges.astro b/src/components/TrustBadges.astro
new file mode 100644
index 0000000..a5ca32a
--- /dev/null
+++ b/src/components/TrustBadges.astro
@@ -0,0 +1,27 @@
+---
+import { REVIEWS_EXTERNAL } from "../data/site-config.js";
+import { getLangFromUrl } from "../i18n/utils.js";
+const lang = getLangFromUrl(Astro.url);
+const LABEL = { nl:"Beoordeeld op", en:"Reviewed on", de:"Bewertet auf", fr:"Évalué sur", es:"Valorado en", ro:"Evaluat pe" }[lang] || "Beoordeeld op";
+const NAMES = { google:"Google", g2:"G2", capterra:"Capterra", trustpilot:"Trustpilot" };
+const badges = Object.entries(REVIEWS_EXTERNAL).filter(([, url]) => url).map(([k, url]) => ({ k, url, name: NAMES[k] }));
+---
+{badges.length > 0 && (
+  <div class="trust-badges"><span class="tb-label">{LABEL}</span>
+    <div class="tb-items">
+      {badges.map((b) => (
+        <a class="tb-badge" href={b.url} target="_blank" rel="noopener nofollow">
+          <span class="tb-stars">★★★★★</span><span class="tb-name">{b.name}</span>
+        </a>
+      ))}
+    </div>
+  </div>
+)}
+<style>
+  .trust-badges{display:flex;align-items:center;gap:16px;flex-wrap:wrap;justify-content:center;padding:20px;border-top:1px solid var(--line)}
+  .tb-label{color:var(--muted);font-size:13px;font-weight:700;text-transform:uppercase;letter-spacing:.5px}
+  .tb-items{display:flex;gap:12px;flex-wrap:wrap}
+  .tb-badge{display:inline-flex;align-items:center;gap:8px;background:#fff;border:1px solid var(--line);border-radius:10px;padding:8px 14px;box-shadow:var(--shadow-xs);text-decoration:none}
+  .tb-badge .tb-stars{color:var(--gold);font-size:14px}
+  .tb-badge .tb-name{color:var(--navy);font-weight:700;font-size:14px}
+</style>
