-      var PIN = [["big fifty", "big five", "big50"], ["ability scan", "cognitiev", "cognitieve", "capaciteit"], ["motivation", "drijfver"], ["360"]];
-      function pinRank(title) { var t = (title || "").toLowerCase(); for (var i = 0; i < PIN.length; i++) { for (var j = 0; j < PIN[i].length; j++) { if (t.indexOf(PIN[i][j]) > -1) return i; } } return 99; }
+      // Vaste bovenste rij: exact de 4 hrmforce-vlaggenschepen (Reflector/Talogy/MQ-varianten blijven op titelvolgorde).
+      var PIN_EXACT = ["big 5 test | big fifty personality", "ability scan", "motivation", "360 graden feedback"];
+      function pinRank(title) { var t = (title || "").toLowerCase().trim(); var i = PIN_EXACT.indexOf(t); return i > -1 ? i : 99; }
