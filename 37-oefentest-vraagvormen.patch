+const TEKENS = {
+  nl: ["cirkel", "driehoek", "vierkant", "kruis", "ster", "balk"],
+  en: ["circle", "triangle", "square", "cross", "star", "bar"],
+  de: ["Kreis", "Dreieck", "Quadrat", "Kreuz", "Stern", "Balken"],
+  fr: ["cercle", "triangle", "carré", "croix", "étoile", "barre"],
