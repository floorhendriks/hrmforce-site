diff --git a/src/components/OefentestOverzicht.astro b/src/components/OefentestOverzicht.astro
new file mode 100644
index 0000000..3be1323
--- /dev/null
+++ b/src/components/OefentestOverzicht.astro
@@ -0,0 +1,65 @@
+---
+/* Overzicht van de vijf oefenonderdelen. Vanaf hier kiest de oefenaar een
+   onderdeel; de bank zelf zit op de pagina van dat onderdeel. */
+import { ONDERZOEK_UI, ONDERDELEN } from "../data/oefentest-ui.js";
+import { localizePath } from "../i18n/utils.js";
+const { lang = "nl" } = Astro.props;
+const u = ONDERZOEK_UI[lang] || ONDERZOEK_UI.nl;
+const basis = localizePath("/oefentest/", lang);
+const voorbereidingHref = localizePath("/voorbereiding/", lang);
+const onderdelen = Object.entries(ONDERDELEN).map(([sleutel, o]) => ({
+  sleutel,
+  href: `${basis}${o.slug[lang] || o.slug.nl}/`,
+  naam: o.naam[lang] || o.naam.nl,
+  lead: o.lead[lang] || o.lead.nl,
+}));
+const MEER = {
+  nl: { kop: "Meer voorbereiding", link: "Naar de voorbereidingspagina" },
+  en: { kop: "More preparation", link: "To the preparation page" },
+  de: { kop: "Mehr Vorbereitung", link: "Zur Vorbereitungsseite" },
+  fr: { kop: "Plus de préparation", link: "Vers la page de préparation" },
+  es: { kop: "Más preparación", link: "Ir a la página de preparación" },
+  ro: { kop: "Mai multă pregătire", link: "Spre pagina de pregătire" },
+};
+const meer = MEER[lang] || MEER.nl;
+---
+<div class="crumb"><div class="wrap">
+  <a href={localizePath("/", lang)}>Home</a> &rsaquo; <span>{u.title}</span>
+</div></div>
+
+<section class="ahero"><div class="wrap" style="display:block">
+  <div class="eyebrow">{u.eyebrow}</div>
+  <h1>{u.title}</h1>
+  <p style="max-width:820px;color:var(--muted);font-size:17px;line-height:1.6;margin:10px 0 0">{u.lead}</p>
+</div></section>
+
+<section><div class="wrap" style="display:block">
+  <div class="oo-grid">
+    {onderdelen.map((o) => (
+      <a class="oo-kaart" href={o.href}>
+        <span class="oo-naam">{o.naam}</span>
+        <span class="oo-lead">{o.lead}</span>
+        <span class="oo-cta">{u.cta} &rarr;</span>
+      </a>
+    ))}
+  </div>
+</div></section>
+
+<section class="bg-soft"><div class="wrap" style="display:block">
+  <div class="eyebrow">{meer.kop}</div>
+  <h2 class="section-title">{meer.kop}</h2>
+  <div class="btns" style="margin-top:14px">
+    <a href={voorbereidingHref} class="btn btn-primary">{meer.link}</a>
+  </div>
+</div></section>
+
+<style>
+  .oo-grid { display:grid; grid-template-columns:repeat(3,1fr); gap:16px; }
+  .oo-kaart { display:flex; flex-direction:column; gap:9px; background:#fff; border:1px solid var(--line); border-radius:var(--radius); padding:22px 24px; text-decoration:none; }
+  .oo-kaart:hover { box-shadow:var(--shadow-sm); }
+  .oo-naam { color:var(--navy); font-weight:800; font-size:18px; }
+  .oo-lead { color:var(--muted); font-size:14.5px; line-height:1.6; }
+  .oo-cta { color:var(--blue); font-weight:700; font-size:14px; margin-top:auto; padding-top:4px; }
+  @media (max-width:980px) { .oo-grid { grid-template-columns:repeat(2,1fr); } }
+  @media (max-width:640px) { .oo-grid { grid-template-columns:1fr; } }
+</style>
