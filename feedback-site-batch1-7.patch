diff --git a/src/components/PlanBlock.astro b/src/components/PlanBlock.astro
new file mode 100644
index 0000000..9998214
--- /dev/null
+++ b/src/components/PlanBlock.astro
@@ -0,0 +1,74 @@
+---
+// Vaste bouwsteen voor oplossingen-, advies- en trainingspagina's:
+// een stappenplan met uitkomst, plus een rolverdeling (hrmforce vs. organisatie).
+const { plan, roles, rolesEyebrow = "Rolverdeling", hrmLabel = "hrmforce doet", orgLabel = "Jullie doen", tone = "soft" } = Astro.props;
+---
+{plan && (
+  <section class={tone === "soft" ? "bg-soft" : ""}>
+    <div class="wrap" style="display:block">
+      <div class="center">
+        {plan.eyebrow && <div class="eyebrow" style="justify-content:center">{plan.eyebrow}</div>}
+        <h2 class="section-title">{plan.title}</h2>
+        {plan.lead && <p class="lead" style="max-width:740px;margin:0 auto 8px">{plan.lead}</p>}
+      </div>
+      <ol class="planlist">
+        {plan.steps.map((st, i) => (
+          <li class="planstep">
+            <span class="pl-n">{i + 1}</span>
+            <div>
+              <h3>{st.t}</h3>
+              <p>{st.d}</p>
+            </div>
+          </li>
+        ))}
+      </ol>
+      {plan.outcome && (
+        <p class="plan-outcome"><span class="po-ic" aria-hidden="true">&check;</span>{plan.outcome}</p>
+      )}
+    </div>
+  </section>
+)}
+
+{roles && (
+  <section>
+    <div class="wrap" style="display:block">
+      <div class="center">
+        <div class="eyebrow" style="justify-content:center">{rolesEyebrow}</div>
+        <h2 class="section-title" style="margin-bottom:30px">{roles.title}</h2>
+      </div>
+      <div class="rolegrid">
+        <div class="rolecard hrm">
+          <h3>{hrmLabel}</h3>
+          <ul>{roles.hrmforce.map((r) => <li>{r}</li>)}</ul>
+        </div>
+        <div class="rolecard org">
+          <h3>{orgLabel}</h3>
+          <ul>{roles.org.map((r) => <li>{r}</li>)}</ul>
+        </div>
+      </div>
+    </div>
+  </section>
+)}
+
+<style>
+  .planlist { list-style:none; margin:34px auto 0; padding:0; display:flex; flex-direction:column; gap:14px; max-width:900px; }
+  .planstep { display:flex; gap:18px; align-items:flex-start; background:#fff; border:1px solid var(--line); border-radius:14px; padding:22px 24px; box-shadow:var(--shadow-xs); transition:transform .2s ease, box-shadow .2s ease; }
+  .planstep:hover { transform:translateY(-3px); box-shadow:var(--shadow-md); }
+  .pl-n { flex:none; width:34px; height:34px; border-radius:50%; background:var(--navy); color:#fff; font-weight:800; display:flex; align-items:center; justify-content:center; }
+  .planstep h3 { color:var(--navy); font-size:1.08rem; margin:4px 0 6px; }
+  .planstep p { color:var(--muted); font-size:15px; line-height:1.6; margin:0; }
+  .plan-outcome { display:flex; gap:12px; align-items:flex-start; max-width:900px; margin:20px auto 0; background:var(--navy); color:#fff; border-radius:14px; padding:20px 24px; font-size:15.5px; line-height:1.6; font-weight:600; }
+  .po-ic { flex:none; width:26px; height:26px; border-radius:50%; background:var(--gold); color:#3a2a00; font-weight:800; display:flex; align-items:center; justify-content:center; margin-top:1px; }
+  .rolegrid { display:grid; grid-template-columns:1fr 1fr; gap:22px; max-width:940px; margin:0 auto; }
+  .rolecard { border:1px solid var(--line); border-radius:16px; padding:26px 24px; background:#fff; box-shadow:var(--shadow-xs); transition:transform .2s ease, box-shadow .2s ease; }
+  .rolecard:hover { transform:translateY(-3px); box-shadow:var(--shadow-md); }
+  .rolecard.hrm { border-left:4px solid var(--accent); }
+  .rolecard.org { border-left:4px solid var(--gold); }
+  .rolecard h3 { color:var(--navy); font-size:1.1rem; margin:0 0 14px; }
+  .rolecard ul { list-style:none; margin:0; padding:0; display:flex; flex-direction:column; gap:10px; }
+  .rolecard li { color:var(--text); font-size:15px; line-height:1.5; padding-left:26px; position:relative; }
+  .rolecard li::before { content:"\2713"; position:absolute; left:0; top:0; color:var(--accent); font-weight:800; }
+  .rolecard.org li::before { color:var(--gold); }
+  @media (max-width:820px) { .rolegrid { grid-template-columns:1fr; } .planstep { padding:18px; gap:14px; } }
+  @media (prefers-reduced-motion: reduce) { .planstep:hover, .rolecard:hover { transform:none; } }
+</style>
diff --git a/src/components/SocialProof.astro b/src/components/SocialProof.astro
new file mode 100644
index 0000000..ed69879
--- /dev/null
+++ b/src/components/SocialProof.astro
@@ -0,0 +1,56 @@
+---
+// Compacte sociale-bewijskracht-balk: Google-beoordeling, ITC-lidmaatschap en reactietijd.
+// Herbruikbaar op assessment-, oplossingen- en adviespagina's.
+import { REVIEWS_EXTERNAL } from "../data/site-config.js";
+import { getLangFromUrl, localizePath } from "../i18n/utils.js";
+
+const lang = Astro.props.lang || getLangFromUrl(Astro.url);
+const tone = Astro.props.tone || "light"; // light | soft
+const T = {
+  nl: { score: "4,9", google: "op Google", googleSub: "klantbeoordelingen", itc: "Lid International Test Commission", itcSub: "internationale richtlijnen voor testgebruik", react: "Binnen 24 uur reactie", reactSub: "werkdagen, van een specialist" },
+  en: { score: "4.9", google: "on Google", googleSub: "customer reviews", itc: "Member International Test Commission", itcSub: "international guidelines for test use", react: "Reply within 24 hours", reactSub: "working days, from a specialist" },
+  de: { score: "4,9", google: "auf Google", googleSub: "Kundenbewertungen", itc: "Mitglied International Test Commission", itcSub: "internationale Richtlinien für Testeinsatz", react: "Antwort innerhalb von 24 Stunden", reactSub: "werktags, von einem Spezialisten" },
+  fr: { score: "4,9", google: "sur Google", googleSub: "avis clients", itc: "Membre International Test Commission", itcSub: "directives internationales sur les tests", react: "Réponse sous 24 heures", reactSub: "jours ouvrés, par un spécialiste" },
+  es: { score: "4,9", google: "en Google", googleSub: "reseñas de clientes", itc: "Miembro International Test Commission", itcSub: "directrices internacionales sobre tests", react: "Respuesta en 24 horas", reactSub: "días laborables, de un especialista" },
+  ro: { score: "4,9", google: "pe Google", googleSub: "recenzii ale clienților", itc: "Membru International Test Commission", itcSub: "ghiduri internaționale pentru teste", react: "Răspuns în 24 de ore", reactSub: "zile lucrătoare, de la un specialist" },
+}[lang] || {};
+const googleUrl = REVIEWS_EXTERNAL?.google || "";
+const trustHref = localizePath("/trust/", lang);
+---
+<section class={"socialproof " + tone}>
+  <div class="wrap" style="display:block">
+    <div class="sp-row">
+      <a class="sp-item" href={googleUrl || trustHref} target={googleUrl ? "_blank" : null} rel={googleUrl ? "noopener nofollow" : null}>
+        <span class="sp-ic stars" aria-hidden="true">★★★★★</span>
+        <span class="sp-txt"><b>{T.score} {T.google}</b><em>{T.googleSub}</em></span>
+      </a>
+      <a class="sp-item" href={trustHref}>
+        <span class="sp-ic" aria-hidden="true">
+          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3l8 3v6c0 4.5-3.2 7.9-8 9-4.8-1.1-8-4.5-8-9V6z"/><path d="M9 12l2 2 4-4"/></svg>
+        </span>
+        <span class="sp-txt"><b>{T.itc}</b><em>{T.itcSub}</em></span>
+      </a>
+      <div class="sp-item">
+        <span class="sp-ic" aria-hidden="true">
+          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/></svg>
+        </span>
+        <span class="sp-txt"><b>{T.react}</b><em>{T.reactSub}</em></span>
+      </div>
+    </div>
+  </div>
+</section>
+<style>
+  .socialproof { background:#fff; border-bottom:1px solid var(--line); }
+  .socialproof.soft { background:var(--bg-soft); }
+  .socialproof .wrap { padding-top:20px; padding-bottom:20px; }
+  .sp-row { display:grid; grid-template-columns:repeat(3,1fr); gap:16px; }
+  .sp-item { display:flex; align-items:center; gap:12px; text-decoration:none; color:inherit; padding:6px 2px; min-width:0; }
+  a.sp-item:hover .sp-txt b { color:var(--accent); }
+  .sp-ic { flex:none; width:40px; height:40px; border-radius:11px; background:var(--bg-soft); color:var(--navy); display:inline-flex; align-items:center; justify-content:center; }
+  .sp-ic svg { width:21px; height:21px; }
+  .sp-ic.stars { background:transparent; color:var(--gold); width:auto; letter-spacing:1px; font-size:15px; }
+  .sp-txt { display:flex; flex-direction:column; min-width:0; }
+  .sp-txt b { color:var(--navy); font-size:14.5px; font-weight:700; line-height:1.3; }
+  .sp-txt em { color:var(--muted); font-style:normal; font-size:12.5px; }
+  @media (max-width:820px) { .sp-row { grid-template-columns:1fr; gap:10px; } .socialproof .wrap { padding-top:16px; padding-bottom:16px; } }
+</style>
