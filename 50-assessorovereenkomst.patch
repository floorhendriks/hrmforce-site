+// Beelden voor de assessorovereenkomst, als JPEG ingebed zodat de Function
+// niets hoeft op te halen. Het logo is hetzelfde bestand als op de factuur.
+export const LOGO = { w: 300, h: 75, b64: "" };
+// Handtekening van Floor Hendriks, uit het Word-origineel.
+export const HANDTEKENING = { w: 278, h: 139, b64: "" };
+// Paraaf van Floor Hendriks voor de voettekst.
+export const PARAAF = { w: 118, h: 232, b64: "" };
