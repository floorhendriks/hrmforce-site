+        <select id="ctCamKies"></select>
+      </label>
+    </div>
+
+    <div class="ct-card">
+      <div class="ct-kop"><h3>{t.mic.title}</h3><span class="ct-st" id="ctMicSt" data-st="wacht">{t.resultaat.nietGetest}</span></div>
+      <p class="ct-msg" id="ctMicMsg">{t.mic.hint}</p>
+      <div class="ct-meter" aria-hidden="true"><span id="ctMicBalk"></span></div>
+      <p class="ct-meter-label">{t.mic.niveau}</p>
+      <dl class="ct-feiten" id="ctMicFeiten" hidden>
+        <dt>{t.mic.apparaat}</dt><dd id="ctMicNaam">-</dd>
+      </dl>
+      <label class="ct-kies" id="ctMicKiesWrap" hidden>
+        <span>{t.mic.kies}</span>
+        <select id="ctMicKies"></select>
+      </label>
+    </div>
+
+    <div class="ct-card">
+      <div class="ct-kop"><h3>{t.speaker.title}</h3><span class="ct-st" id="ctGelSt" data-st="wacht">{t.resultaat.nietGetest}</span></div>
+      <p class="ct-msg" id="ctGelMsg">{t.speaker.hint}</p>
+      <button type="button" id="ctToon" class="btn btn-ghost btn-sm">{t.speaker.play}</button>
+      <div class="ct-vraag" id="ctGelVraag" hidden>
+        <p>{t.speaker.vraag}</p>
+        <div class="ct-vraag-knoppen">
+          <button type="button" class="btn btn-ghost btn-sm" id="ctGelJa">{t.speaker.ja}</button>
+          <button type="button" class="btn btn-ghost btn-sm" id="ctGelNee">{t.speaker.nee}</button>
+        </div>
+      </div>
+    </div>
+
+    <div class="ct-card">
+      <div class="ct-kop"><h3>{t.systeem.title}</h3><span class="ct-st" id="ctSysSt" data-st="wacht">{t.resultaat.nietGetest}</span></div>
+      <dl class="ct-feiten">
+        <dt>{t.systeem.browser}</dt><dd id="ctSysBrowser">-</dd>
+        <dt>{t.systeem.os}</dt><dd id="ctSysOs">-</dd>
+        <dt>{t.systeem.scherm}</dt><dd id="ctSysScherm">-</dd>
+        <dt>{t.systeem.verbinding}</dt><dd id="ctSysNet">-</dd>
+      </dl>
+      <p class="ct-msg" id="ctSysMsg"></p>
+    </div>
+
+    <div class="ct-card ct-card-net">
+      <div class="ct-kop"><h3>{t.netwerk.title}</h3><span class="ct-st" id="ctNetSt" data-st="wacht">{t.resultaat.nietGetest}</span></div>
+      <p class="ct-msg" id="ctNetMsg">{t.netwerk.hint}</p>
+    </div>
+
+    <div class="ct-card ct-card-res">
+      <div class="ct-kop"><h3>{t.resultaat.title}</h3></div>
+      <ul class="ct-res" id="ctRes"></ul>
+      <button type="button" id="ctKopieer" class="btn btn-ghost btn-sm">{t.resultaat.kopieer}</button>
