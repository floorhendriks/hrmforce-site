+      es: (p,j) => `${getal(p.deel,"es")} / ${getal(p.tot,"es")} = ${procent(j,"es",1)}.`,
+      ro: (p,j) => `${getal(p.deel,"ro")} / ${getal(p.tot,"ro")} = ${procent(j,"ro",1)}.`,
