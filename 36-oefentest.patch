+      return { p: { pa, pb, qa, qb }, juist, afl, toon: (v, t) => euro(v, t, 2) };
+    },
+  },
+
+  // 4. gemiddelde met een ontbrekende waarde
+  gemiddelde: {
+    tekst: {
