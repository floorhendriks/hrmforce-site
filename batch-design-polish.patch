From 6bcab3396b1ea5b94e92cf3c93be51134fbf8c98 Mon Sep 17 00:00:00 2001
From: Floor Hendriks <f.hendriks@hrmforce.com>
Date: Mon, 7 Sep 2026 21:02:11 +0200
Subject: [PATCH] Design: fix mobiele hero-overflow (grid minmax(0,1fr)),
 zwevende demo-knop verbergen op mobiel (botste met Henry), logoslider beter
 leesbaar (opacity .8), subtiele sectiebanding op bg-soft, strakkere
 letter-spacing op grote koppen

---
 src/components/LogoSlider.astro |  2 +-
 src/layouts/Base.astro          |  6 ++++++
 src/styles/global.css           | 18 ++++++++++--------
 3 files changed, 17 insertions(+), 9 deletions(-)

diff --git a/src/components/LogoSlider.astro b/src/components/LogoSlider.astro
index 1564fb3..c94c73e 100644
--- a/src/components/LogoSlider.astro
+++ b/src/components/LogoSlider.astro
@@ -52,7 +52,7 @@ const track = logos.concat(logos);
   .ls-track{ display:flex; align-items:center; gap:54px; width:max-content; animation:ls-scroll 48s linear infinite; }
   .ls-viewport:hover .ls-track{ animation-play-state:paused; }
   .ls-item{ flex:0 0 auto; display:flex; align-items:center; justify-content:center; height:56px; }
-  .ls-item img{ height:auto; width:auto; max-height:52px; max-width:150px; object-fit:contain; display:block; filter:grayscale(100%); opacity:.62; transition:filter .25s ease, opacity .25s ease; }
+  .ls-item img{ height:auto; width:auto; max-height:52px; max-width:150px; object-fit:contain; display:block; filter:grayscale(100%); opacity:.8; transition:filter .25s ease, opacity .25s ease; }
   .ls-item img:hover{ filter:grayscale(0); opacity:1; }
   .ls-note{ text-align:center; color:var(--muted); font-size:13px; margin:16px auto 0; max-width:620px; }
   @keyframes ls-scroll{ from{transform:translateX(0)} to{transform:translateX(-50%)} }
diff --git a/src/layouts/Base.astro b/src/layouts/Base.astro
index 5efe3d0..d3e0f83 100644
--- a/src/layouts/Base.astro
+++ b/src/layouts/Base.astro
@@ -131,6 +131,7 @@ const orgLd = {
     <style is:global>
       /* Henry-bubbel boven de sticky demo-knop plaatsen */
       #hrmforce-chatbot { bottom: 88px !important; right: 20px !important; }
+      @media (max-width: 720px) { #hrmforce-chatbot { bottom: 20px !important; right: 14px !important; } }
     </style>
   </body>
 </html>
@@ -164,4 +165,9 @@ const orgLd = {
   @media (max-width: 560px) {
     .sticky-demo { right: 14px; bottom: 14px; padding: 12px 18px; }
   }
+  /* Op mobiel volstaan de header-CTA en de scroll-CTA-balk; de zwevende
+     demo-knop botst met de Henry-chatbubbel, dus die verbergen we. */
+  @media (max-width: 720px) {
+    .sticky-demo { display: none; }
+  }
 </style>
diff --git a/src/styles/global.css b/src/styles/global.css
index 1880870..d388c16 100644
--- a/src/styles/global.css
+++ b/src/styles/global.css
@@ -174,7 +174,7 @@ section{padding:clamp(48px,6vw,88px) 0}
 /* Frivool micro-accent: gouden streepje voor de eyebrow */
 .eyebrow::before{content:"";width:22px;height:3px;border-radius:2px;background:var(--gold);display:inline-block;flex:none}
 .center .eyebrow{justify-content:center}
-h2.section-title{font-size:clamp(1.6rem,1.25rem + 1.6vw,2.25rem);font-weight:800;margin-bottom:14px;color:var(--navy)}
+h2.section-title{font-size:clamp(1.6rem,1.25rem + 1.6vw,2.25rem);font-weight:800;letter-spacing:-.022em;margin-bottom:14px;color:var(--navy)}
 .sub{color:var(--muted);font-size:1.0625rem}
 .lead{color:var(--muted);font-size:clamp(1.05rem,1rem + .3vw,1.2rem);max-width:740px;line-height:1.6}
 .center{text-align:center}.center .lead,.center .sub{margin-left:auto;margin-right:auto}
@@ -187,8 +187,9 @@ h2.section-title{font-size:clamp(1.6rem,1.25rem + 1.6vw,2.25rem);font-weight:800
 .hero{position:relative;overflow:hidden;background:linear-gradient(160deg,var(--navy) 0%,var(--navy-deep) 100%);color:#fff;padding:clamp(56px,7vw,84px) 0 clamp(64px,8vw,96px)}
 .hero:before{content:"";position:absolute;top:-30%;right:-10%;width:60%;height:120%;background:radial-gradient(closest-side,rgba(70,145,206,.35),transparent 70%);pointer-events:none}
 .hero:after{content:"";position:absolute;bottom:-40%;left:-8%;width:45%;height:120%;background:radial-gradient(closest-side,rgba(252,193,27,.14),transparent 70%);pointer-events:none}
-.hero .wrap{position:relative;display:grid;grid-template-columns:1.1fr .9fr;gap:48px;align-items:center}
-.hero h1{color:#fff;font-size:clamp(2.1rem,1.4rem + 3vw,3rem);font-weight:800;letter-spacing:-.02em}
+.hero .wrap{position:relative;display:grid;grid-template-columns:minmax(0,1.1fr) minmax(0,.9fr);gap:48px;align-items:center}
+.hero .wrap>*{min-width:0}
+.hero h1{color:#fff;font-size:clamp(2.1rem,1.4rem + 3vw,3rem);font-weight:800;letter-spacing:-.032em;line-height:1.06}
 .hero h1 em{color:var(--gold);font-style:normal}
 .hero .sub{font-size:clamp(1.05rem,1rem + .4vw,1.2rem);color:#c4d2e6;margin:22px 0 14px;font-weight:500}
 .hero ul{list-style:none;margin:20px 0 32px;padding:0}
@@ -201,7 +202,7 @@ h2.section-title{font-size:clamp(1.6rem,1.25rem + 1.6vw,2.25rem);font-weight:800
 .hero-card .bar.b1{width:80%}.hero-card .bar.b2{width:62%;background:#dbe6fb}.hero-card .bar.b3{width:90%}
 .hero-card .chip{display:inline-block;background:var(--blue);color:#fff;font-size:12px;font-weight:600;padding:4px 12px;border-radius:var(--radius-pill);margin-bottom:12px}
 .donut{width:120px;height:120px;border-radius:50%;margin:14px auto 0;background:conic-gradient(var(--navy) 0 62%,var(--gold) 62% 84%,var(--blue) 84% 100%)}
-@media(max-width:880px){.hero .wrap{grid-template-columns:1fr}}
+@media(max-width:880px){.hero .wrap{grid-template-columns:minmax(0,1fr)}}
 
 /* ---------- Kaarten (3 kolommen) ---------- */
 .cards{display:grid;grid-template-columns:repeat(3,1fr);gap:24px;margin-top:42px}
@@ -292,9 +293,10 @@ footer a:hover{color:#fff;opacity:1}
 
 .ahero{position:relative;overflow:hidden;background:linear-gradient(160deg,var(--navy) 0%,var(--navy-deep) 100%);color:#fff;padding:clamp(48px,6vw,64px) 0 clamp(56px,7vw,72px)}
 .ahero:before{content:"";position:absolute;top:-30%;right:-10%;width:55%;height:120%;background:radial-gradient(closest-side,rgba(70,145,206,.32),transparent 70%);pointer-events:none}
-.ahero .wrap{position:relative;display:grid;grid-template-columns:1fr 1fr;gap:48px;align-items:center}
+.ahero .wrap{position:relative;display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1fr);gap:48px;align-items:center}
+.ahero .wrap>*{min-width:0}
 .ahero .eyebrow{color:var(--gold)}
-.ahero h1{color:#fff;font-size:clamp(1.9rem,1.4rem + 2.4vw,2.5rem);font-weight:800;letter-spacing:-.02em;margin-bottom:22px}
+.ahero h1{color:#fff;font-size:clamp(1.9rem,1.4rem + 2.4vw,2.5rem);font-weight:800;letter-spacing:-.028em;line-height:1.08;margin-bottom:22px}
 .meta-row{margin-bottom:10px}
 .meta-row .lbl{color:var(--gold);font-weight:700;font-size:13px;text-transform:uppercase;letter-spacing:.5px;display:block}
 .meta-row .val{color:#dbe6f5}
@@ -308,7 +310,7 @@ footer a:hover{color:#fff;opacity:1}
 .traitbar span{width:120px;color:var(--muted)}
 .traitbar .track{flex:1;height:9px;background:var(--bg);border-radius:6px;overflow:hidden}
 .traitbar .fill{height:100%;background:linear-gradient(90deg,var(--blue),var(--navy));border-radius:6px}
-@media(max-width:880px){.ahero .wrap{grid-template-columns:1fr}}
+@media(max-width:880px){.ahero .wrap{grid-template-columns:minmax(0,1fr)}}
 
 .infobar{background:#fff;border-bottom:1px solid var(--line)}
 .info-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:24px;padding:30px 0}
@@ -386,7 +388,7 @@ footer a:hover{color:#fff;opacity:1}
 .mt-0{margin-top:0}.mt-2{margin-top:var(--sp-2)}.mt-4{margin-top:var(--sp-4)}
 .mt-6{margin-top:var(--sp-6)}.mt-8{margin-top:var(--sp-8)}
 .mb-0{margin-bottom:0}.mb-4{margin-bottom:var(--sp-4)}.mb-6{margin-bottom:var(--sp-6)}
-.bg-soft{background:var(--bg)}
+.bg-soft{background:var(--bg);box-shadow:inset 0 1px 0 var(--line),inset 0 -1px 0 var(--line)}
 .container-sm{max-width:820px;margin:0 auto}
 .hidden{display:none}
 
-- 
2.34.1

